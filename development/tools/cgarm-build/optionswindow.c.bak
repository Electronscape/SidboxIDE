static void SidboxDirect_On_btn2_Activate(void *source, int32_t a, int32_t b, int32_t c, int32_t d)
{
	const CGGadget gadget = source
		? API->gui->gadgets->get_id(source)
		: (CGGadget)0u;
	On_btn2_Activate(gadget, a, b, c, d);
}

