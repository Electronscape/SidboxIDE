static void OptionsWindow_bitmap2_SIDBOX_OnTab(void *source, int32_t a, int32_t b, int32_t c, int32_t d)
{
	(void)a; (void)b; (void)c; (void)d;
	const CGGadget clicked = API->gui->gadgets->get_id(source);
	if (clicked == bitmap2_tab_0) {
		API->gui->gadgets->set_group_visible(OptionsWindow, 1u, 1u);
		API->gui->gadgets->set_group_visible(OptionsWindow, 2u, 0u);
	}
	else if (clicked == bitmap2_tab_1) {
		API->gui->gadgets->set_group_visible(OptionsWindow, 1u, 0u);
		API->gui->gadgets->set_group_visible(OptionsWindow, 2u, 1u);
	}
}

// $IDE:OpenWindow //
void OptionsWindow_Create(void)
{
	if (OptionsWindow_is_open) {
		SBOS_WindowToFront(OptionsWindow);
		SBOS_WindowSetFocus(OptionsWindow);
		return;
	}

	OptionsWindow = SBOS_CreateWindow(&OptionsWindow, 8, 8, 405, 298, "Ye ol'e Options Test", SBX_WF_VISIBLE | SBX_WF_CLOSE | SBX_WF_TITLE_BAR | SBX_WF_ZORDER | SBX_WF_MINIMISE | SBX_WF_SCREENBOUND | SBX_WF_MOVEABLE);
	if (OptionsWindow == (CGWindow)0xFFu) {
		return;
	}
	OptionsWindow_is_open = 1u;
	SBOS_SetWindowProc(OptionsWindow, OptionsWindow_WindowProc);
	/* Window background pen 1 is stored by the designer.
	   The current public applet API does not export window_set_back_colour yet. */

	bitmap2 = API->gui->gadgets->canvas_create(OptionsWindow, 4, 28, 389, 205, CNV_BEVEL, GAD_TOOL_INSET);
	API->gui->gadgets->set_group_id(bitmap2, 0u);
	bitmap2_tab_0 = API->gui->gadgets->button_create(OptionsWindow, 4, 4, 194, 24, "General", GAD_TOOL_DEFAULT);
	API->gui->gadgets->set_group_id(bitmap2_tab_0, 0u);
	API->gui->gadgets->set_callback(bitmap2_tab_0, OptionsWindow_bitmap2_SIDBOX_OnTab, NULL);
	bitmap2_tab_1 = API->gui->gadgets->button_create(OptionsWindow, 198, 4, 195, 24, "Advanced", GAD_TOOL_DEFAULT);
	API->gui->gadgets->set_group_id(bitmap2_tab_1, 0u);
	API->gui->gadgets->set_callback(bitmap2_tab_1, OptionsWindow_bitmap2_SIDBOX_OnTab, NULL);
	API->gui->gadgets->set_bpen(bitmap2, 2);
	API->gui->gadgets->set_group_id(bitmap2, 0u);
	API->gui->gadgets->enabled(bitmap2, 1u);
	API->gui->gadgets->repaint(bitmap2);

	bitmap1 = API->gui->gadgets->bitmapview_create(OptionsWindow, 8, 32, 380, 196, 380, 196, BVF_SHOW_FRAME | BVF_SRC_ROWMAJOR, GAD_TOOL_INSET);
	SBOS_BitmapviewSetBitmap(bitmap1, bitmap1_pixels);
	SBOS_BitmapviewSetImageSize(bitmap1, 380, 196);
	API->gui->gadgets->set_group_id(bitmap1, 1u);
	API->gui->gadgets->enabled(bitmap1, 1u);
	API->gui->gadgets->repaint(bitmap1);

	btn2 = API->gui->gadgets->button_create(OptionsWindow, 8, 244, 90, 22, "Button", GAD_TOOL_DEFAULT);
	API->gui->gadgets->set_group_id(btn2, 0u);
	API->gui->gadgets->enabled(btn2, 1u);
	API->gui->gadgets->set_callback(btn2, SidboxDirect_On_btn2_Activate, NULL);
	API->gui->gadgets->repaint(btn2);

	canvas1 = API->gui->gadgets->canvas_create(OptionsWindow, 200, 244, 191, 22, CNV_BEVEL, GAD_TOOL_DEFAULT);
	API->gui->gadgets->set_bpen(canvas1, 2);
	API->gui->gadgets->set_group_id(canvas1, 0u);
	API->gui->gadgets->enabled(canvas1, 1u);
	API->gui->gadgets->set_callback(canvas1, SidboxDirect_On_canvas1_Activate, NULL);
	API->gui->gadgets->repaint(canvas1);

	lbl1 = API->gui->gadgets->label_create(OptionsWindow, 204, 247, 124, 14, "Sausages!", GAD_TOOL_DEFAULT);
	API->gui->gadgets->set_group_id(lbl1, 0u);
	API->gui->gadgets->enabled(lbl1, 1u);
	API->gui->gadgets->repaint(lbl1);

	btn1 = API->gui->gadgets->button_create(OptionsWindow, 100, 244, 90, 22, "Close", GAD_TOOL_DEFAULT);
	API->gui->gadgets->set_group_id(btn1, 0u);
	API->gui->gadgets->enabled(btn1, 1u);
	API->gui->gadgets->set_callback(btn1, SidboxDirect_On_btn1_Activate, NULL);
	API->gui->gadgets->repaint(btn1);

	bitmap3 = API->gui->gadgets->bitmapview_create(OptionsWindow, 8, 32, 161, 81, 160, 80, BVF_SHOW_FRAME | BVF_SRC_ROWMAJOR, GAD_TOOL_INSET);
	SBOS_BitmapviewSetBitmap(bitmap3, bitmap3_pixels);
	SBOS_BitmapviewSetImageSize(bitmap3, 160, 80);
	API->gui->gadgets->set_group_id(bitmap3, 2u);
	API->gui->gadgets->enabled(bitmap3, 1u);
	API->gui->gadgets->set_callback(bitmap3, SidboxDirect_On_bitmap3_Activate, SidboxDirect_On_bitmap3_Change);
	API->gui->gadgets->repaint(bitmap3);

	API->gui->gadgets->set_group_visible(OptionsWindow, 1u, 1u);
	API->gui->gadgets->set_group_visible(OptionsWindow, 2u, 0u);
	SBOS_WindowToFront(OptionsWindow);
	SBOS_WindowSetFocus(OptionsWindow);
	API->gui->gadgets->repaint(bitmap1);
	API->gui->gadgets->repaint(bitmap3);
}

static CGWindowProcRes OptionsWindow_WindowProc(CGWindow win, const CGMessage_t *m)
{
	if (!m) {
		return CGPROC_DEFAULT;
	}

	switch (m->mtype) {
	case CGMSG_WINDOW:
		switch (m->eventClass) {
		case CGEVT_WIN_CLOSE_REQUEST:
			/* <SIDBOX-GUI:USER WINDOW_CLOSE> */
			/* Put close-validation/user shutdown code here. */
			/* </SIDBOX-GUI:USER WINDOW_CLOSE> */
			OptionsWindow_is_open = 0u;
			SBOS_CloseWindow(win);
			return CGPROC_HANDLED;

		case CGEVT_SYS_REPAINT:
			/* BitmapViews must be restored after a system/window repaint. */
			API->gui->gadgets->repaint(bitmap1);
			API->gui->gadgets->repaint(bitmap3);
			/* Keep CoderGirl default dirty-rect/compositor processing. */
			return CGPROC_DEFAULT;

		default:
			break;
		}
		break;

	case CGMSG_GADGET:
		switch (m->eventClass) {
		case CGEVT_GAD_ACTIVATED:
			if (m->gadget == bitmap1) {
				On_bitmap1_Activate(m->gadget, m->a, m->b, m->c, m->d);
				return CGPROC_HANDLED;
			}
			break;

		case CGEVT_GAD_MOUSE_MOVE:
			if (m->gadget == bitmap1) {
				On_bitmap1_Change(m->gadget, m->a, m->b, m->c, m->d);
				return CGPROC_HANDLED;
			}
			break;

		default:
			break;
		}
		break;

	default:
		break;
	}

	/* Returning DEFAULT lets CoderGirl perform its normal window behaviour. */
	return CGPROC_DEFAULT;
}

