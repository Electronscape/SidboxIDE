static void On_menu_Edit_Test_2(cg_menu_t menu, cg_menuitem_t item, void *userdata);
static void SidboxDirect_On_bitmap1_Activate(void *source, int32_t a, int32_t b, int32_t c, int32_t d);
static void SidboxDirect_On_bitmap1_Change(void *source, int32_t a, int32_t b, int32_t c, int32_t d);

static void SidboxDirect_On_bitmap1_Activate(void *source, int32_t a, int32_t b, int32_t c, int32_t d)
{
	const CGGadget gadget = source
		? API->gui->gadgets->get_id(source)
		: (CGGadget)0u;
	On_bitmap1_Activate(gadget, a, b, c, d);
}

static void SidboxDirect_On_bitmap1_Change(void *source, int32_t a, int32_t b, int32_t c, int32_t d)
{
	const CGGadget gadget = source
		? API->gui->gadgets->get_id(source)
		: (CGGadget)0u;
	On_bitmap1_Change(gadget, a, b, c, d);
}

// $IDE:OpenWindow //
void MainWindow_Create(void)
{
	MainWindow = SBOS_CreateWindow(&MainWindow, 12, 28, 385, 273, "Gui designer V1.0", SBX_WF_VISIBLE | SBX_WF_CLOSE | SBX_WF_TITLE_BAR | SBX_WF_ZORDER | SBX_WF_MINIMISE | SBX_WF_MAXRESTORE | SBX_WF_SCREENBOUND | SBX_WF_MOVEABLE | SBX_WF_RESIZABLE);
	SBOS_SetWindowProc(MainWindow, MainWindow_WindowProc);
	/* Window background pen 1 is stored by the designer.
	   The current public applet API does not export window_set_back_colour yet. */

	MainWindow_Menu = SBOS_CreateMenuTitle("File|Edit");
	menu_File_New = SBOS_CreateMenuItem(&MainWindow_Menu, 0, "New");
	menu_File____ = SBOS_CreateMenuItem(&MainWindow_Menu, 0, "---");
	SBOS_MenuSetFlags(&menu_File____, 0, CG_MENUITEMF_SEPARATOR);
	menu_File_Exit = SBOS_CreateMenuItem(&MainWindow_Menu, 0, "Exit Now.");
	menu_Edit_Test_3 = SBOS_CreateMenuItem(&MainWindow_Menu, 1, "Test 1");
	menu_Edit_Test_2 = SBOS_CreateMenuItem(&MainWindow_Menu, 1, "Test 2");
	SBOS_AttachMenuToWindow(MainWindow_Menu, MainWindow);

	btn1 = API->gui->gadgets->button_create(MainWindow, 108, 104, 90, 26, "Test 1", GAD_TOOL_DEFAULT);
	API->gui->gadgets->enabled(btn1, 1u);
	API->gui->gadgets->repaint(btn1);

	btn2 = API->gui->gadgets->button_create(MainWindow, 108, 132, 90, 26, "options...", GAD_TOOL_DEFAULT);
	API->gui->gadgets->enabled(btn2, 1u);
	API->gui->gadgets->repaint(btn2);

	rad1 = API->gui->gadgets->radiobutton_create(MainWindow, 12, 32, 72, 17, "ATT 1", 0, 1, GAD_TOOL_DEFAULT);
	API->gui->gadgets->enabled(rad1, 1u);
	API->gui->gadgets->repaint(rad1);

	rad2 = API->gui->gadgets->radiobutton_create(MainWindow, 88, 32, 72, 17, "ATT 2", 0, 0, GAD_TOOL_DEFAULT);
	API->gui->gadgets->enabled(rad2, 1u);
	API->gui->gadgets->repaint(rad2);

	rad3 = API->gui->gadgets->radiobutton_create(MainWindow, 12, 52, 72, 17, "ATT 3", 1, 0, GAD_TOOL_DEFAULT);
	API->gui->gadgets->set_hpen(rad3, 11);
	API->gui->gadgets->enabled(rad3, 0u);
	API->gui->gadgets->repaint(rad3);

	rad4 = API->gui->gadgets->radiobutton_create(MainWindow, 88, 52, 72, 17, "ATT 4", 1, 1, GAD_TOOL_DEFAULT);
	API->gui->gadgets->enabled(rad4, 1u);
	API->gui->gadgets->repaint(rad4);

	sld1 = API->gui->gadgets->slider_create(MainWindow, 12, 72, 108, 28, 1, 0, 100, GAD_TOOL_DEFAULT);
	API->gui->gadgets->enabled(sld1, 1u);
	/* Initial value 0 is stored in the .sbui; current applet API has no exported value setter yet. */
	API->gui->gadgets->repaint(sld1);

	scroll1 = API->gui->gadgets->scrollbar_create(MainWindow, 12, 188, 357, 17, 1, 0, 25, 1, 10, 0);
	API->gui->gadgets->enabled(scroll1, 1u);
	/* Initial value 4 is stored in the .sbui; current applet API has no exported value setter yet. */
	API->gui->gadgets->repaint(scroll1);

	grid1 = API->gui->gadgets->gridselect_create(MainWindow, 12, 104, 29, 23, 3, 3, (1u), GAD_TOOL_DEFAULT);
	API->gui->gadgets->enabled(grid1, 1u);
	API->gui->gadgets->gridselect_set_cell_text(grid1, "ATT", 0);
	API->gui->gadgets->gridselect_set_cell_text(grid1, "HLP", 1);
	API->gui->gadgets->gridselect_set_cell_text(grid1, "GUM", 2);
	API->gui->gadgets->gridselect_set_cell_text(grid1, "BUM", 3);
	API->gui->gadgets->gridselect_set_cell_text(grid1, "FSH", 4);
	API->gui->gadgets->gridselect_set_cell_text(grid1, "ADD", 5);
	API->gui->gadgets->gridselect_set_cell_text(grid1, "SUB", 6);
	API->gui->gadgets->gridselect_set_cell_text(grid1, "DEC", 7);
	API->gui->gadgets->gridselect_set_cell_text(grid1, "INC", 8);
	API->gui->gadgets->repaint(grid1);

	txt1 = API->gui->gadgets->textbox_create(MainWindow, 208, 8, 157, 21, "Text", (0u), GAD_TOOL_DEFAULT);
	API->gui->gadgets->enabled(txt1, 0u);
	API->gui->gadgets->repaint(txt1);

	lbl1 = API->gui->gadgets->label_create(MainWindow, 12, 8, 77, 18, "Gui V1.0", GAD_TOOL_DEFAULT);
	API->gui->gadgets->enabled(lbl1, 1u);
	API->gui->gadgets->repaint(lbl1);

	bitmap1 = API->gui->gadgets->bitmapview_create(MainWindow, 208, 40, 160, 80, 160, 80, BVF_SHOW_FRAME | BVF_SRC_ROWMAJOR | BVF_PERSISTANT, GAD_TOOL_INSET);
	SBOS_BitmapviewSetBitmap(bitmap1, bitmap1_pixels);
	SBOS_BitmapviewSetImageSize(bitmap1, 160, 80);
	API->gui->gadgets->enabled(bitmap1, 1u);
	API->gui->gadgets->set_callback(bitmap1, SidboxDirect_On_bitmap1_Activate, SidboxDirect_On_bitmap1_Change);
	API->gui->gadgets->repaint(bitmap1);

	list1 = API->gui->gadgets->listbox_create(MainWindow, 208, 124, 161, 60, GAD_TOOL_DEFAULT);
	API->gui->gadgets->enabled(list1, 1u);
	/* ListBox owns no strings/model: build a caller-owned ItemList and attach it. */
	API->gui->gadgets->itemlist_init(&list1_items);
	API->gui->gadgets->itemlist_add(&list1_items, "Item 1", 0u);
	API->gui->gadgets->itemlist_add(&list1_items, "Item 2", 0u);
	API->gui->gadgets->itemlist_add(&list1_items, "Item 3", 0u);
	API->gui->gadgets->listbox_attach_itemlist(list1, &list1_items);
	API->gui->gadgets->repaint(list1);

	prg1 = API->gui->gadgets->progbar_create(MainWindow, 12, 208, 357, 18, GAD_TOOL_DEFAULT);
	API->gui->gadgets->enabled(prg1, 1u);
	API->gui->gadgets->progressbar_set_minmax(prg1, 0, 100);
	API->gui->gadgets->progressbar_set_value(prg1, 45);
	API->gui->gadgets->repaint(prg1);

	canvas2 = API->gui->gadgets->canvas_create(MainWindow, 124, 72, 74, 28, CNV_BEVEL, GAD_TOOL_DEFAULT | GAD_TOOL_INSET);
	API->gui->gadgets->set_bpen(canvas2, 2);
	API->gui->gadgets->enabled(canvas2, 1u);
	API->gui->gadgets->repaint(canvas2);

	chk1 = API->gui->gadgets->checkbox_create(MainWindow, 108, 160, 93, 20, "Checkbox", 1, GAD_TOOL_DEFAULT);
	API->gui->gadgets->enabled(chk1, 1u);
	API->gui->gadgets->repaint(chk1);

	btn3 = API->gui->gadgets->button_create(MainWindow, 112, 4, 90, 22, "Button", GAD_TOOL_DEFAULT);
	API->gui->gadgets->enabled(btn3, 1u);
	API->gui->gadgets->repaint(btn3);

	SBOS_WindowToFront(MainWindow);
	SBOS_WindowSetFocus(MainWindow);
	API->gui->gadgets->repaint(bitmap1);
}

static CGWindowProcRes MainWindow_WindowProc(CGWindow win, const CGMessage_t *m)
{
	if (!m) {
		return CGPROC_DEFAULT;
	}

	switch (m->mtype) {
	case CGMSG_WINDOW:
		switch (m->eventClass) {
		case CGEVT_WIN_CLOSE_REQUEST:
			/* <SIDBOX-GUI:USER WINDOW_CLOSE> */
			/* Put close-validation/user shutdown code here. */
			/* </SIDBOX-GUI:USER WINDOW_CLOSE> */
			API->gui->gadgets->listbox_attach_itemlist(list1, NULL);
			API->gui->gadgets->itemlist_deinit(&list1_items);
			SBOS_CloseWindow(win);
			SBOS_DestroyMenu(&MainWindow_Menu);
			return CGPROC_HANDLED;

		case CGEVT_SYS_REPAINT:
			/* BitmapViews must be restored after a system/window repaint. */
			API->gui->gadgets->repaint(bitmap1);
			/* Keep CoderGirl default dirty-rect/compositor processing. */
			return CGPROC_DEFAULT;

		default:
			break;
		}
		break;

	case CGMSG_GADGET:
		switch (m->eventClass) {
		case CGEVT_GAD_ACTIVATED:
			if (m->gadget == btn1) {
				On_btn1_Activate(m->gadget, m->a, m->b, m->c, m->d);
				return CGPROC_HANDLED;
			}
			if (m->gadget == btn2) {
				On_btn2_Activate(m->gadget, m->a, m->b, m->c, m->d);
				return CGPROC_HANDLED;
			}
			if (m->gadget == sld1) {
				On_sld1_Activate(m->gadget, m->a, m->b, m->c, m->d);
				return CGPROC_HANDLED;
			}
			if (m->gadget == scroll1) {
				On_scroll1_Activate(m->gadget, m->a, m->b, m->c, m->d);
				return CGPROC_HANDLED;
			}
			if (m->gadget == grid1) {
				On_grid1_Activate(m->gadget, m->a, m->b, m->c, m->d);
				return CGPROC_HANDLED;
			}
			if (m->gadget == txt1) {
				On_txt1_Activate(m->gadget, m->a, m->b, m->c, m->d);
				return CGPROC_HANDLED;
			}
			if (m->gadget == list1) {
				On_list1_Activate(m->gadget, m->a, m->b, m->c, m->d);
				return CGPROC_HANDLED;
			}
			if (m->gadget == canvas2) {
				On_canvas2_Activate(m->gadget, m->a, m->b, m->c, m->d);
				return CGPROC_HANDLED;
			}
			if (m->gadget == chk1) {
				On_chk1_Activate(m->gadget, m->a, m->b, m->c, m->d);
				return CGPROC_HANDLED;
			}
			if (m->gadget == btn3) {
				On_btn3_Activate(m->gadget, m->a, m->b, m->c, m->d);
				return CGPROC_HANDLED;
			}
			break;

		case CGEVT_GAD_RADIO_CHANGED:
			if (m->gadget == rad1) {
				On_rad1_Activate(m->gadget, m->a, m->b, m->c, m->d);
				On_rad1_Change(m->gadget, m->a, m->b, m->c, m->d);
				return CGPROC_HANDLED;
			}
			if (m->gadget == rad2) {
				On_rad2_Activate(m->gadget, m->a, m->b, m->c, m->d);
				On_rad2_Change(m->gadget, m->a, m->b, m->c, m->d);
				return CGPROC_HANDLED;
			}
			if (m->gadget == rad3) {
				On_rad3_Activate(m->gadget, m->a, m->b, m->c, m->d);
				On_rad3_Change(m->gadget, m->a, m->b, m->c, m->d);
				return CGPROC_HANDLED;
			}
			if (m->gadget == rad4) {
				On_rad4_Activate(m->gadget, m->a, m->b, m->c, m->d);
				On_rad4_Change(m->gadget, m->a, m->b, m->c, m->d);
				return CGPROC_HANDLED;
			}
			break;

		case CGEVT_GAD_SLIDERVAL_CHANGED:
			if (m->gadget == sld1) {
				On_sld1_Change(m->gadget, m->a, m->b, m->c, m->d);
				return CGPROC_HANDLED;
			}
			if (m->gadget == scroll1) {
				On_scroll1_Change(m->gadget, m->a, m->b, m->c, m->d);
				return CGPROC_HANDLED;
			}
			break;

		case CGEVT_GAD_GRID_CHANGED:
			if (m->gadget == grid1) {
				On_grid1_Change(m->gadget, m->a, m->b, m->c, m->d);
				return CGPROC_HANDLED;
			}
			break;

		case CGEVT_GAD_CARET_MOVED:
			if (m->gadget == txt1) {
				On_txt1_Change(m->gadget, m->a, m->b, m->c, m->d);
				return CGPROC_HANDLED;
			}
			break;

		case CGEVT_GAD_LISTBOX_CHANGED:
			if (m->gadget == list1) {
				On_list1_Change(m->gadget, m->a, m->b, m->c, m->d);
				return CGPROC_HANDLED;
			}
			break;

		case CGEVT_GAD_CHECKBOX_CHANGED:
			if (m->gadget == chk1) {
				On_chk1_Change(m->gadget, m->a, m->b, m->c, m->d);
				return CGPROC_HANDLED;
			}
			break;

		default:
			break;
		}
		break;

	case CGMSG_MENU:
		switch (m->eventClass) {
		case CGEVT_MENU_SELECTED:
			if ((cg_menu_t)m->a == MainWindow_Menu
			    && (cg_menuitem_t)m->b == menu_File_New) {
				On_menu_File_New((cg_menu_t)m->a, (cg_menuitem_t)m->b, NULL);
				return CGPROC_HANDLED;
			}
			if ((cg_menu_t)m->a == MainWindow_Menu
			    && (cg_menuitem_t)m->b == menu_File_Exit) {
				On_menu_File_Exit((cg_menu_t)m->a, (cg_menuitem_t)m->b, NULL);
				return CGPROC_HANDLED;
			}
			if ((cg_menu_t)m->a == MainWindow_Menu
			    && (cg_menuitem_t)m->b == menu_Edit_Test_3) {
				On_menu_Edit_Test_3((cg_menu_t)m->a, (cg_menuitem_t)m->b, NULL);
				return CGPROC_HANDLED;
			}
			if ((cg_menu_t)m->a == MainWindow_Menu
			    && (cg_menuitem_t)m->b == menu_Edit_Test_2) {
				On_menu_Edit_Test_2((cg_menu_t)m->a, (cg_menuitem_t)m->b, NULL);
				return CGPROC_HANDLED;
			}
			break;

		default:
			break;
		}
		break;

	default:
		break;
	}

	/* Returning DEFAULT lets CoderGirl perform its normal window behaviour. */
	return CGPROC_DEFAULT;
}

