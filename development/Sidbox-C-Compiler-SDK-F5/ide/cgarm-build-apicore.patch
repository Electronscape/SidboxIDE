+void writeApiCore(const fs::path &objcopy, const fs::path &object,
+                  const fs::path &file, bool verbose) {
+    runCommand({objcopy.string(), "-O", "binary", "--only-section=.sidc_apicore",
+                object.string(), file.string()}, verbose);
+    requireFile(file, "API core section");
+    const auto size = fs::file_size(file);
+    if (size < 20 || size > 4096)
+        throw Error("Invalid size for the API core section");
+    std::vector<unsigned char> bytes(static_cast<std::size_t>(size));
+    {
+        std::ifstream in(file, std::ios::binary);
+        if (!in.read(reinterpret_cast<char *>(bytes.data()),
+                     static_cast<std::streamsize>(bytes.size())) ||
+            std::memcmp(bytes.data(), "SBAPI01", 8) != 0)
+            throw Error("Invalid API core section in " + object.string());
+    }
+
+    // Same little-endian CRC32 trailer as the handheld's API core reader.
+    std::uint32_t crc = 0xffffffffu;
+    for (const unsigned char byte : bytes) {
+        crc ^= byte;
+        for (unsigned bit = 0; bit < 8; ++bit)
+            crc = (crc >> 1) ^ ((crc & 1u) ? 0xedb88320u : 0u);
+    }
+    crc = ~crc;
+    const unsigned char trailer[] = {
+        static_cast<unsigned char>(crc), static_cast<unsigned char>(crc >> 8),
+        static_cast<unsigned char>(crc >> 16), static_cast<unsigned char>(crc >> 24)
+    };
+    std::ofstream out(file, std::ios::binary | std::ios::app);
+    out.write(reinterpret_cast<const char *>(trailer), sizeof(trailer));
+    out.close();
+    if (!out) throw Error("Cannot append API core checksum: " + file.string());
+}
