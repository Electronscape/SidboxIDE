{
    "version": 2,
    "projectType": "gui",
    "appletFormat": "v2",
    "v2Linker": "llvm",
    "outputAppName": "compiler.app",
    "appSizeKb": 512,
    "v2HeapKb": 16,
    "v2StackKb": 8,
    "files": [
        "main.c",
        "compiler.c",
        "compiler.h",
        "apicore.h",
        "applet_v2_format.h",
        "generated_runtime.h"
    ],
    "openTabs": [
        "main.c",
        "compiler.c"
    ],
    "compiler": {
        "optimization": "-Os",
        "suppressWarnings": false,
        "wall": true,
        "wextra": false,
        "functionSections": true,
        "dataSections": true,
        "stackUsage": true,
        "extraFlags": "-include string.h -include stdlib.h"
    }
}
