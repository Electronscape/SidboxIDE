{
    "version": 2,
    "projectType": "gui",
    "appletFormat": "v2",
    "v2Linker": "llvm",
    "outputAppName": "large-source.app",
    "appSizeKb": 128,
    "v2HeapKb": 16,
    "v2StackKb": 8,
    "files": [
        "large-source.c"
    ],
    "openTabs": [
        "large-source.c"
    ],
    "compiler": {
        "optimization": "-Os",
        "suppressWarnings": false,
        "wall": true,
        "wextra": false,
        "functionSections": true,
        "dataSections": true,
        "stackUsage": true,
        "extraFlags": ""
    }
}
