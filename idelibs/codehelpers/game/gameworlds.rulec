static uint8_t gw_restoring_checkpoint;
static uint8_t gw_last_save_slot=255u;
static uint8_t pending_title_load_slot; /* slot+1; preserves owner-maintained main.c */
static uint8_t save_checkpoint_status;
static char saved_world_id[64];
static gameworlds_spawn_t saved_position;
static uint8_t saved_position_valid;
/* Preserve only the fresh run's initial state, up to the existing SAVE_LIMIT.
 * It is released as soon as the run writes its first TFCard checkpoint. */
static uint8_t *gw_fresh_bytes;
static uint32_t gw_fresh_length;
static uint8_t gw_fresh_capture_tried;
static uint8_t gw_fresh_start_enabled;
/* Three-phase, frame-synchronised transitions. All buffers remain owned by
 * the existing graphics system. Only 2 x 256 temporary CLUT words are used. */
#define GW_TRANSITION_NONE   0u
#define GW_TRANSITION_FADE   1u
#define GW_TRANSITION_LEFT   2u
#define GW_TRANSITION_RIGHT  3u
#define GW_TRANSITION_UP     4u
#define GW_TRANSITION_DOWN   5u
#define GW_TRANSITION_CIRCLE 6u
#define GW_PHASE_IDLE       0u
#define GW_PHASE_OUT        1u
#define GW_PHASE_OUT_DONE   2u
#define GW_PHASE_IN         3u
static uint8_t transition_phase;
static uint8_t transition_enabled;
static uint8_t transition_mode, transition_frames, transition_step;
static uint8_t transition_circle_origin, transition_camera_valid;
static int32_t transition_world_x, transition_world_y;
static int32_t transition_camera_x, transition_camera_y;
static uint32_t transition_front[256] __attribute__((aligned(32)));
static uint32_t transition_back[256] __attribute__((aligned(32)));
/* World-local lighting changes survive leaving and re-entering a world. */
/* Save the day/night phase for every visited world. Inactive worlds pause their
 * local clocks, rather than restarting at dawn each time a door is used. */
static uint32_t day_night_saved_tick[WORLD_COUNT];
static uint8_t day_night_saved_valid[WORLD_COUNT];
static uint8_t spotlight_override_valid[WORLD_COUNT];
static uint8_t spotlight_override_value[WORLD_COUNT];
static uint8_t spotlight_enabled;
static uint16_t spotlight_radius, spotlight_feather;
static uint8_t spotlight_center;
static int16_t spotlight_offset_x, spotlight_offset_y;
static uint8_t spotlight_mask_index = 255u;
static uint32_t spotlight_mask_colour = 0xff000000u;
static uint8_t spotlight_flip_x, spotlight_flip_y, spotlight_opacity = 100u;
static uint8_t spotlight_stable_dither = 1u, spotlight_anim_mode;
static uint8_t spotlight_anim_min, spotlight_anim_max;
static uint16_t spotlight_random_min_frames, spotlight_random_max_frames, spotlight_pulse_delay;
static uint16_t spotlight_anim_ticks;
static uint8_t spotlight_anim_frame, spotlight_anim_backward;
#if defined(gfx_drawbob)
static uint32_t spotlight_rng_state = 0x8abc1234u;
#endif
static uint8_t spotlight_feather_current;
static int32_t spotlight_camera_x, spotlight_camera_y;
static int32_t spotlight_player_x, spotlight_player_y;
/* At most eight precomputed integer-only feather BOBs, built on WORLD LOAD.
 * 768 KiB hard cap keeps the effect from exhausting 8 MiB SDRAM. */
#define SPOTLIGHT_RING_VARIANTS 8u
#define SPOTLIGHT_RING_BUDGET (768u * 1024u)
#if defined(gfx_drawbob)
static uint8_t *spotlight_ring_pixels[SPOTLIGHT_RING_VARIANTS];
static uint16_t spotlight_ring_side[SPOTLIGHT_RING_VARIANTS];
static uint8_t spotlight_ring_width[SPOTLIGHT_RING_VARIANTS];
static gfxbob_t spotlight_ring_bob[SPOTLIGHT_RING_VARIANTS] __attribute__((aligned(32)));
static uint8_t spotlight_ring_count;
#endif
/* Stage 5.152: optional world-local rain/snow/thunder, constant RAM use.
 * Stage 5.162:
 * hashed per-drop phases, three rain speed/length layers, and fresh horizontal
 * positions at every wrap remove the old three-column repeating appearance.
 * Nothing is rendered beyond the view. Existing storm/CLUT lighting unchanged. */
static void transition_restore_palette(void); /* CLUT source palette reset after lightning. */
static uint8_t weather_mode, weather_density, weather_colour_index, weather_strength;
static uint8_t weather_palette_strength, weather_palette_active;
static uint8_t weather_overlay_enabled;
static uint8_t weather_suspend_spotlight;
static int8_t weather_wind;
static uint8_t weather_particle_size;
static uint16_t weather_particle_tile;
static uint16_t weather_interval, weather_flash_delay;
static uint8_t weather_flash_phase;
static uint8_t weather_flash_peak;
static uint8_t weather_burst_remaining, weather_burst_pause;
static uint8_t weather_flash_duration; /* 6..80 frames, controlled by 0..100% duration slider. */
static uint8_t day_night_mode, day_night_strength;
static uint16_t day_night_day_frames, day_night_night_frames, day_night_fade_frames;
static uint32_t day_night_colour, day_night_tick;
static uint32_t weather_frame_tick;
static uint32_t weather_scatter_seed;
static uint32_t weather_random_state = 0x7beab187u;
/* Independent from the lightning PRNG, so rearranging raindrops never changes
 * the artist's carefully tuned lightning sequence, brightness or timing. */
static uint32_t weather_scatter_hash(uint32_t v)
{
    v ^= v >> 16;
    v *= 0x7feb352du;
    v ^= v >> 15;
    v *= 0x846ca68bu;
    return v ^ (v >> 16);
}
static uint32_t weather_rand(void)
{
    uint32_t r = weather_random_state;
    r ^= r << 13; r ^= r >> 17; r ^= r << 5;
    return weather_random_state = r ? r : 0x7beab187u;
}
static void weather_enter(const gameworlds_record_t *world)
{
    weather_mode = world->weather_mode <= 3u ? world->weather_mode : 0u;
    weather_density = world->weather_density > 64u ? 64u : world->weather_density;
    weather_wind = world->weather_wind;
    weather_particle_size = (world->weather_particle_size >= 2u && world->weather_particle_size <= 32u)
        ? world->weather_particle_size : 5u;
    weather_particle_tile = world->weather_particle_tile;
    weather_colour_index = world->weather_colour_index ? world->weather_colour_index : 15u;
    weather_interval = world->weather_lightning_interval >= 100u
        ? world->weather_lightning_interval : 350u;
    weather_strength = world->weather_lightning_strength <= 100u
        ? world->weather_lightning_strength : 75u;
    weather_palette_strength = world->weather_palette_flash_strength <= 100u
        ? world->weather_palette_flash_strength : 0u;
    weather_suspend_spotlight = !!world->weather_suspend_spotlight;
    weather_overlay_enabled = !!world->weather_lightning_overlay;
    /* Keep the encoded trailing registry field compatible. It now controls
     * the actual lightning pulse LENGTH, not just an easing profile.
     * 0% = 6 frames, 100% = 80 frames; 12% is a quick ~0.28s pulse. */
    const uint16_t length_percent = world->weather_curve_code >= 1u && world->weather_curve_code <= 101u
        ? (uint16_t)(world->weather_curve_code - 1u) : 25u;
    weather_flash_duration = (uint8_t)(6u + (length_percent * 74u) / 100u);
    /* Force the new world's palette binding, even when the target has clear
     * weather and no tint. Without this a previously tinted world can leak
     * into the first frame of an incoming transition. */
    weather_palette_active = 1u;
    weather_frame_tick = 0u;
    weather_flash_phase = 0u;
    weather_flash_peak = 0u;
    weather_burst_remaining = 0u;
    weather_burst_pause = 0u;
    day_night_mode = world->day_night_mode <= 2u ? world->day_night_mode : 0u;
    day_night_colour = 0xff000000u | (world->day_night_colour & 0xffffffu);
    day_night_strength = world->day_night_strength > 100u ? 100u : world->day_night_strength;
    day_night_day_frames = world->day_night_day_frames ? world->day_night_day_frames : 3000u;
    day_night_night_frames = world->day_night_night_frames ? world->day_night_night_frames : 3000u;
    day_night_fade_frames = world->day_night_fade_frames ? world->day_night_fade_frames : 500u;
    day_night_tick = world->day_night_start_at_night ?
        (uint32_t)day_night_day_frames + day_night_fade_frames : 0u;
    weather_random_state ^= (uint32_t)world->start_x ^ ((uint32_t)world->start_y << 11);
    if (!weather_random_state) weather_random_state = 0x7beab187u;
    /* Stable scatter based on this world's entry position. Do NOT consume a
     * weather_rand() call: that would alter the established lightning timing. */
    weather_scatter_seed = weather_scatter_hash(0x7beab187u ^
        ((uint32_t)world->start_x * 0x9e3779b9u) ^
        ((uint32_t)world->start_y * 0x85ebca6bu));
    weather_flash_delay = weather_interval;
}
static void gw_time_refresh(void);
static void weather_update(uint16_t frames)
{
    if (!active_world) return;
    if (day_night_mode == 2u) {
        const uint32_t cycle = (uint32_t)day_night_day_frames + day_night_night_frames +
            (uint32_t)day_night_fade_frames * 2u;
        if(cycle)day_night_tick = (day_night_tick + frames) % cycle;
    }
    gw_time_refresh();
    if (!weather_mode) return;
    for (uint16_t f = 0; f < frames; ++f) {
        ++weather_frame_tick; /* 32-bit clock: no visible restart every 5 minutes. */
        if (weather_mode != 3u) continue;
        /* Primary strike cadence keeps the same configured average and
         * +/-50% jitter. Count it continuously, even while pulses play. */
        if (weather_flash_delay > 0u) --weather_flash_delay;
        if (weather_flash_phase) --weather_flash_phase;
        else if (weather_burst_remaining) {
            /* Rare additional strokes in the same thunder event, with an
             * actual dark gap (never fast alternating full-screen strobe). */
            if (weather_burst_pause) --weather_burst_pause;
            else {
                --weather_burst_remaining;
                weather_flash_phase = weather_flash_duration;
                weather_flash_peak = (uint8_t)(25u + weather_rand() % 66u);
                weather_burst_pause = (uint8_t)(12u + weather_rand() % 29u);
            }
        } else if (!weather_flash_delay) {
            weather_flash_phase = weather_flash_duration;
            weather_flash_peak = (uint8_t)(65u + weather_rand() % 36u);
            /* 34% of thunder events get one extra strike, 10% get two.
             * The slider is still the mean time between PRIMARY strikes. */
            const uint32_t chance = weather_rand() % 100u;
            weather_burst_remaining = chance < 10u ? 2u : chance < 44u ? 1u : 0u;
            weather_burst_pause = (uint8_t)(12u + weather_rand() % 29u);
            weather_flash_delay = (uint16_t)(weather_interval / 2u +
                (weather_rand() % (uint32_t)weather_interval));
            if (weather_flash_delay < 100u) weather_flash_delay = 100u;
        }
    }
}
/* Duration-dependent, smooth lightning envelope at 50 Hz.
 * 0..100% adjusts the WHOLE pulse from 6 to 80 frames. Its apex is roughly
 * one third through the duration, with a longer, rounded fade-out. No peak
 * brightness or spotlight intensity is changed by the duration slider.
 * Reduced flashing is not a photosensitive-seizure safety guarantee. */
static uint8_t weather_curve_envelope(uint8_t position, uint8_t duration)
{
    if (duration < 6u || position >= duration - 1u) return 0u;
    const uint32_t peak = ((uint32_t)(duration - 1u) * 35u + 50u) / 100u;
    const uint32_t rise = peak > 1u ? peak : 2u;
    const uint32_t fall = (uint32_t)(duration - 1u) - rise;
    const uint32_t progress = position <= rise
        ? (uint32_t)position * 100u / rise
        : (uint32_t)(duration - 1u - position) * 100u / fall;
    /* Cubic smoothstep gives continuous attack/release intensity. */
    return (uint8_t)(progress * progress * (300u - 2u * progress) / 10000u);
}
static uint8_t weather_pulse(void)
{
    if (weather_mode != 3u || !weather_flash_phase) return 0u;
    return (uint8_t)((uint16_t)weather_curve_envelope(
        (uint8_t)(weather_flash_duration - weather_flash_phase), weather_flash_duration) *
        weather_flash_peak / 100u);
}
/* RGB palette tint: 0=day original colours, 100=maximum chosen night/fog tint.
 * Dusk and dawn use a cubic ease curve, without any floating-point work. */
static uint8_t day_night_mix(void)
{
    if (!day_night_mode || !day_night_strength) return 0u;
    if (day_night_mode == 1u) return day_night_strength;
    const uint32_t day = day_night_day_frames, fade = day_night_fade_frames;
    const uint32_t night = day_night_night_frames;
    const uint32_t t = day_night_tick;
    uint32_t progress;
    if (t < day) return 0u;
    if (t < day + fade) progress = (t - day) * 100u / fade;
    else if (t < day + fade + night) return day_night_strength;
    else progress = ((day + 2u*fade + night - t) * 100u) / fade;
    const uint32_t eased = progress * progress * (300u - 2u*progress) / 10000u;
    return (uint8_t)(eased * day_night_strength / 100u);
}

/* Stable, named status bits for user-authored main.c and engine effects.
 * This can be queried before drawing the spotlight because weather_update()
 * (called by gameworlds_update()) has already calculated the current pulse.
 * The renderer returns the same bits after drawing for existing call sites. */
uint8_t gameworlds_weather_status(void)
{
    if (!active_world || !weather_mode) return GAME_WEATHER_STATUS_NONE;
    uint8_t status = GAME_WEATHER_STATUS_PRECIPITATION;
    if (weather_pulse() != 0u && (weather_overlay_enabled || weather_palette_strength))
        status |= GAME_WEATHER_STATUS_LIGHTNING_FLASH;
    return status;
}

/* Day/night tint and lightning brightness share a single scene-palette path.
 * Indexed CLUT effects also colour HUD/dialogue pixels using those entries.
 * World transitions use the same composited colours, rather than reverting
 * to the un-tinted source palette until the wipe/fade has finished. */
static uint32_t weather_palette_blend(uint32_t source, uint32_t tint, uint16_t strength)
{
    const uint32_t inv = 100u - strength;
    const uint32_t r = (((source >> 16) & 255u) * inv + ((tint >> 16) & 255u) * strength + 50u) / 100u;
    const uint32_t g = (((source >> 8) & 255u) * inv + ((tint >> 8) & 255u) * strength + 50u) / 100u;
    const uint32_t b = ((source & 255u) * inv + (tint & 255u) * strength + 50u) / 100u;
    return (source & 0xff000000u) | (r << 16) | (g << 8) | b;
}
/* Colour used for lightning is derived from the selected weather entry.
 * Lightning must increase channel brightness, even if that palette entry is
 * blue or relatively dark. This never mutates the game's source .pal data. */
static uint32_t weather_palette_brighten(uint32_t colour, uint32_t flash_colour, uint16_t strength)
{
    uint32_t out = colour & 0xff000000u;
    for (uint8_t channel = 0; channel < 3u; ++channel) {
        const uint8_t shift = (uint8_t)(channel * 8u);
        const uint32_t value = (colour >> shift) & 255u;
        const uint32_t tint = (flash_colour >> shift) & 255u;
        /* 50%-100% of remaining headroom, tinted towards the selected hue.
         * Every channel stays the same or brightens; none become darker. */
        const uint32_t brighten = (255u - value) * (255u + tint) * strength / (510u * 100u);
        out |= (value + brighten) << shift;
    }
    return out;
}
static uint32_t weather_scene_colour(uint32_t source, uint32_t flash_colour,
                                     uint16_t night_mix, uint16_t flash_mix)
{
    uint32_t colour = night_mix ? weather_palette_blend(source, day_night_colour, night_mix) : source;
    if (flash_mix) colour = weather_palette_brighten(colour, flash_colour, flash_mix);
    return colour;
}
static void weather_palette_frame(void)
{
    if (!active_world) return;
    /* Rebind the ACTIVE world's composited palette before drawing every
     * transition frame. Previously this returned early during IN/OUT, leaving
     * the outgoing world's CLUT in use until transition_frame() at the end of
     * the draw loop. In a two-world change that produces visible old-world
     * fog/night colours while the new scene is being rendered. The wipe/fade
     * still applies its brightness/mask on top at the end of the frame. */
    const uint16_t night_mix = day_night_mix();
    const uint16_t flash_mix = (uint16_t)weather_pulse() * weather_palette_strength / 100u;
    if (!night_mix && !flash_mix) {
        if (weather_palette_active || transition_phase != GW_PHASE_IDLE) {
            weather_palette_active = 0u;
            transition_restore_palette();
        }
        return;
    }
    const uint32_t *front = active_world->front_palette ? active_world->front_palette() : NULL;
    const uint32_t *back = active_world->back_palette ? active_world->back_palette() : NULL;
    if (!front && !back) return;
    const uint32_t lightning_tint = front ? front[weather_colour_index] : 0xffffffffu;
    if (front) {
        for (uint16_t i = 0; i < 256u; ++i)
            transition_front[i] = weather_scene_colour(front[i], lightning_tint, night_mix, flash_mix);
        if (spotlight_enabled) transition_front[spotlight_mask_index] = spotlight_mask_colour;
#ifdef gfx_usefpalette
        gfx_usefpalette(transition_front);
#endif
    }
    if (back) {
        for (uint16_t i = 0; i < 256u; ++i)
            transition_back[i] = weather_scene_colour(back[i], lightning_tint, night_mix, flash_mix);
#ifdef gfx_usebpalette
        gfx_usebpalette(transition_back);
#endif
    }
    weather_palette_active = 1u;
}

void gameworlds_ui_full_brightness(void)
{
    if(!active_world)return;
    const uint32_t *front=active_world->front_palette?active_world->front_palette():NULL;
    const uint32_t *back=active_world->back_palette?active_world->back_palette():NULL;
#ifdef gfx_usefpalette
    if(front)gfx_usefpalette((uint32_t *)front);
#endif
#ifdef gfx_usebpalette
    if(back)gfx_usebpalette((uint32_t *)back);
#endif
}

/* Draw after FRONT tiles and spotlight but before the game HUD/dialogue.
 * Also optionally updates temporary FRONT/BACK CLUT copies. Never edits the
 * source .pal data; 0% restores the original unmodified world palette. */
uint8_t gameworlds_weather_frame(uint16_t width, uint16_t height)
{
    const uint8_t status = gameworlds_weather_status();
    if (!active_world || !width || !height) return status;
    weather_palette_frame(); /* Also drives CLEAR worlds' day/night colours. */
    if (!weather_mode) return status;
#if defined(gfx_rectf) && defined(gfx_setcolour)
    const uint16_t count = weather_density;
    const uint32_t tick = weather_frame_tick;
    const uint8_t rain = weather_mode != 2u;
    const int64_t camera_x = (int64_t)spotlight_camera_x;
    const int64_t camera_y = (int64_t)spotlight_camera_y;
    const int64_t wind_offset = (int64_t)weather_wind * (int64_t)tick;
    const int64_t shifted_x = camera_x - wind_offset;
    /* Floor division (also correct if the camera is temporarily negative).
     * Exactly two chunks on each axis cover any one LCD-sized viewport.
     * The scatter is anchored to WORLD chunks, not to the screen edges.
     * Walking left/right therefore moves flakes with the scenery. */
    const int64_t first_col = shifted_x >= 0 ? shifted_x / width :
        -((-(shifted_x + 1)) / width) - 1;
    gfx_setcolour(weather_colour_index);
    for (int rx = 0; rx < 2; ++rx) {
        const int64_t cell_x = first_col + rx;
        for (uint16_t i = 0; i < count; ++i) {
            /* Speed depends on X-cell and particle slot, NEVER on Y-cell.
             * This gives a single continuous path through successive rows. */
            const uint32_t motion = weather_scatter_hash(weather_scatter_seed ^
                ((uint32_t)(i + 1u) * 0x9e3779b9u) ^
                ((uint32_t)cell_x * 0x85ebca6bu));
            const uint8_t layer = (uint8_t)((motion >> 23) % 3u);
            const uint8_t speed = rain
                ? (uint8_t)((layer == 0u ? 4u : layer == 1u ? 7u : 11u) +
                    ((motion >> 16) % (layer == 0u ? 3u : layer == 1u ? 4u : 5u)))
                : (uint8_t)(1u + ((motion >> 16) % 3u));
            const uint8_t len = rain
                ? (uint8_t)((layer == 0u ? 3u : layer == 1u ? 5u : 7u) +
                    ((motion >> 12) % (layer == 2u ? 4u : 3u))) : 1u;
            const int64_t travel = (int64_t)(uint64_t)tick * speed;
            const int64_t source_y = camera_y - travel;
            const int64_t first_row = source_y >= 0 ? source_y / height :
                -((-(source_y + 1)) / height) - 1;
            for (int ry = 0; ry < 2; ++ry) {
                const int64_t cell_y = first_row + ry;
                const uint32_t seed = weather_scatter_hash(motion ^
                    ((uint32_t)cell_y * 0xc2b2ae35u));
                const int64_t x64 = cell_x * width +
                    (weather_scatter_hash(seed ^ 0x6d2b79f5u) % width) + wind_offset - camera_x;
                const int64_t y64 = cell_y * height + (seed % height) + travel - camera_y;
            if(x64 < -(int64_t)weather_particle_size || x64 >= width ||
               y64 < -(int64_t)weather_particle_size - len || y64 >= height)continue;
            const int32_t x = (int32_t)x64, y = (int32_t)y64;
            if (rain) {
                const int32_t start = y < 0 ? 0 : y;
                const int32_t finish = y + len < height ? y + len : height;
                if(x >= 0 && finish > start)gfx_rectf(x,start,1,finish-start);
            } else {
                uint8_t drawn = 0u;
#if defined(gfx_drawbob)
                if (active_world->weather_particle_pixels && active_world->weather_particle_source_size) {
                    const uint8_t tile_size = active_world->weather_particle_source_size;
                    gfxbob_t bob = {0};
                    bob.imgdat = (uint8_t *)active_world->weather_particle_pixels;
                    bob.index = 0u;
                    bob.atlas_stride = tile_size;
                    bob.atlas_height = tile_size;
                    bob.width = tile_size;
                    bob.height = tile_size;
                    bob.scale = (uint16_t)(((uint32_t)weather_particle_size * 100u) / tile_size);
                    if (!bob.scale) bob.scale = 1u;
                    bob.handle = BLIT_HANDLE_TOP_LEFT;
                    bob.drawx = (int16_t)x;
                    bob.drawy = (int16_t)y;
                    gfx_drawbob(&bob);
                    drawn = 1u;
                }
#endif
@IDE_IF{HAS_MAP}
                /* Reuse the already-loaded .map tile atlas. No per-particle PPB
                 * allocation. A missing atlas/invalid tile falls back to a circle. */
#if defined(gfx_drawbob)
                if (!drawn && weather_particle_tile && active_world->map) {
                    const game_tilemap_t *map = (const game_tilemap_t *)active_world->map;
                    if(map->atlas && map->tile_size && map->atlas_width &&
                       weather_particle_tile <= map->atlas_count) {
                        const uint32_t columns = map->atlas_width / map->tile_size;
                        if(columns) {
                            const uint32_t index = (uint32_t)weather_particle_tile - 1u;
                            const uint32_t col = index % columns;
                            gfxbob_t bob = {0};
                            bob.imgdat = (uint8_t *)map->atlas +
                                (index / columns) * (uint32_t)map->tile_size * map->atlas_width +
                                (col & ~255u) * map->tile_size;
                            bob.index = (uint8_t)(col & 255u);
                            bob.atlas_stride = map->atlas_width;
                            bob.atlas_height = map->tile_size;
                            bob.width = map->tile_size;
                            bob.height = map->tile_size;
                            bob.scale = (uint16_t)(((uint32_t)weather_particle_size * 100u) / map->tile_size);
                            if(!bob.scale)bob.scale=1u;
                            bob.handle = BLIT_HANDLE_TOP_LEFT;
                            bob.drawx = (int16_t)x;
                            bob.drawy = (int16_t)y;
                            gfx_drawbob(&bob);
                            drawn = 1u;
                        }
                    }
                }
#endif
@IDE_END
                if (!drawn) {
                    /* Three clipped horizontal bands form a filled rounded
                     * flake. Constant work per flake, even at 32px size. */
                    const int32_t size = weather_particle_size;
                    for (int band = 0; band < 3; ++band) {
                        const int32_t y0 = y + (size * band) / 3;
                        const int32_t y1 = y + (size * (band + 1)) / 3;
                        const int32_t inset = band == 1 ? 0 : size / 4;
                        const int32_t left = x + inset < 0 ? 0 : x + inset;
                        const int32_t right = x + size - inset > width ? width : x + size - inset;
                        const int32_t top = y0 < 0 ? 0 : y0;
                        const int32_t bottom = y1 > height ? height : y1;
                        if(right > left && bottom > top)
                            gfx_rectf(left,top,right-left,bottom-top);
                    }
                }
            }
            }
        }
    }
    if (weather_mode == 3u && weather_overlay_enabled && weather_flash_phase) {
        const uint16_t strength = (uint16_t)weather_pulse() * weather_strength / 100u;
        if (strength >= 100u) gfx_rectf(0, 0, width, height);
        else if (strength) {
            /* Sparse screen-space row coverage gives a very brief bright
             * flash using O(height) spans only, safe on the STM32. */
            for (uint16_t y = 0; y < height; ++y)
                if (((uint32_t)y * 37u + 13u) % 100u < strength)
                    gfx_rectf(0, y, width, 1);
        }
    }
#else
    (void)width; (void)height;
#endif
    return status;
}

static const uint8_t spotlight_bayer4[4][4] = {
    {0,8,2,10}, {12,4,14,6}, {3,11,1,9}, {15,7,13,5}
};

/* Restore the clock for this world only; inactive worlds do not advance.
 * No change to the generated per-world record layout or saved project JSON. */
/* A phase is DAY until full night begins; dawn becomes DAY when its
 * transition completes. Exactly one callback batch per boundary. */
static uint8_t gw_time_phase=255u;
static uint8_t gw_time_current_phase(void)
{
    if(day_night_mode==1u)return 1u; /* Fixed tint is deliberately NIGHT. */
    if(day_night_mode!=2u)return 0u;
    const uint32_t night_start=(uint32_t)day_night_day_frames+day_night_fade_frames;
    return day_night_tick>=night_start?1u:0u;
}
static void gw_time_dispatch(uint8_t phase)
{
    if(!active_world)return;
    const gw_time_action_t *actions=phase?active_world->night_actions:active_world->day_actions;
    uint16_t count=phase?active_world->night_action_count:active_world->day_action_count;
    if(!actions)return;
    for(uint16_t i=0;i<count;++i){
        const gw_time_action_t *a=&actions[i];
        if(a->npc){if(active_world->npc_set_active)active_world->npc_set_active(a->slot,a->action);}
        else if(active_world->object_set_active)active_world->object_set_active(a->slot,a->action);
    }
}
static void gw_time_refresh(void)
{
    if(!active_world || !day_night_mode)return;
    const uint8_t phase=gw_time_current_phase();
    if(phase!=gw_time_phase){gw_time_phase=phase;gw_time_dispatch(phase);}
}
static void day_night_save_active(void)
{
    if (!active_world || day_night_mode != 2u) return;
    const size_t index = (size_t)(active_world - worlds);
    if (index < WORLD_COUNT) {
        day_night_saved_tick[index] = day_night_tick;
        day_night_saved_valid[index] = 1u;
    }
}
static void day_night_restore_world(const gameworlds_record_t *world)
{
    if (!world || day_night_mode != 2u) return;
    const size_t index = (size_t)(world - worlds);
    if (index < WORLD_COUNT && day_night_saved_valid[index]) {
        const uint32_t cycle = (uint32_t)day_night_day_frames + day_night_night_frames +
            (uint32_t)day_night_fade_frames * 2u;
        if (cycle) day_night_tick = day_night_saved_tick[index] % cycle;
    }
}

/* Both effects on a Goto World doorway are configured on its selected
 * DESTINATION Player Start: OUT on the departing scene, IN on arrival.
 * This must not use active_spawn_id, which remembers an earlier arrival. */
static void transition_entry(const gameworlds_record_t *world, const char *id,
                             uint8_t *in, uint8_t *out, uint8_t *frames,
                             uint8_t *circle_origin, int32_t *x, int32_t *y)
{
    *in = world->transition_in;
    *out = world->transition_out;
    *frames = world->transition_frames ? world->transition_frames : 30u;
    *circle_origin = world->circle_origin;
    *x = world->start_x;
    *y = world->start_y;
    if (id && strcmp(id, "default") != 0) {
        for (uint16_t i = 0; i < world->named_spawn_count; ++i) {
            const gameworlds_named_spawn_t *start = &world->named_spawns[i];
            if (strcmp(start->id, id) != 0) continue;
            *in = start->transition_in;
            *out = start->transition_out;
            *frames = start->transition_frames ? start->transition_frames : 30u;
            *circle_origin = start->circle_origin;
            *x = start->x;
            *y = start->y;
            break;
        }
    }
    if (*in > GW_TRANSITION_CIRCLE) *in = GW_TRANSITION_NONE;
    if (*out > GW_TRANSITION_CIRCLE) *out = GW_TRANSITION_NONE;
    *circle_origin = (*circle_origin != 0u) ? 1u : 0u;
}
static void transition_begin(uint8_t phase, uint8_t mode, uint8_t frames,
                             uint8_t circle_origin, int32_t origin_x, int32_t origin_y)
{
    transition_phase = mode == GW_TRANSITION_NONE ? GW_PHASE_IDLE : phase;
    transition_mode = mode;
    transition_frames = frames ? frames : 30u;
    transition_step = 0;
    transition_circle_origin = circle_origin;
    transition_world_x = origin_x;
    transition_world_y = origin_y;
    transition_camera_valid = 0;
}
/* Never mutate the world palette. Reserve one entry in a CLUT COPY only.
 * Keeping that entry stable across title/world transitions prevents the mask
 * colour from briefly becoming the title's previous colour or fading red. */
static void spotlight_palette_copy(const uint32_t *source)
{
    if (!source) return;
    memcpy(transition_front, source, sizeof(transition_front));
    transition_front[spotlight_enabled ? spotlight_mask_index : 255u] =
        spotlight_enabled ? spotlight_mask_colour : 0xff000000u;
}
static void transition_restore_palette(void)
{
    if (!active_world) return;
    const uint32_t *front = active_world->front_palette ? active_world->front_palette() : NULL;
    const uint32_t *back = active_world->back_palette ? active_world->back_palette() : NULL;
    (void)front; (void)back; /* Minimal host-test API may omit gfx macros. */
#ifdef gfx_usefpalette
    if (front) {
        if (spotlight_enabled) {
            spotlight_palette_copy(front);
            gfx_usefpalette(transition_front);
        } else gfx_usefpalette((uint32_t *)front);
    }
#endif
#ifdef gfx_usebpalette
    if (back) gfx_usebpalette((uint32_t *)back);
#endif
}
/* PLAYER graph actions change only the active world's scene effects.
 * They never mutate palette assets, and rain/lightning uses existing timers.
 * The weather setting is intentionally restored from world config on re-entry. */
void gameworlds_weather_action(uint8_t mode)
{
    if (!active_world || mode > 3u) return;
    weather_mode = mode;
    if(mode && !weather_density)weather_density = 24u;
    if(mode==3u && !weather_overlay_enabled && !weather_palette_strength)
        weather_overlay_enabled = 1u;
    weather_frame_tick = 0u;
    weather_flash_phase = 0u;
    weather_burst_remaining = weather_burst_pause = 0u;
    weather_flash_delay = weather_interval;
    weather_palette_frame();
}
void gameworlds_weather_target_action(uint8_t mode, uint8_t action)
{
    if (!active_world || mode > 3u || action > 2u) return;
    if (mode == 0u) {
        // Clear Weather is a command rather than another precipitation mode.
        if (action != 0u) gameworlds_weather_action(0u);
        return;
    }
    if (action == 0u) { // Disable: don't erase somebody else's rain/snow/storm.
        if (weather_mode == mode) gameworlds_weather_action(0u);
    } else if (action == 1u) { // Enable.
        if (weather_mode != mode) gameworlds_weather_action(mode);
    } else { // Toggle, exactly once per invoked action.
        gameworlds_weather_action(weather_mode == mode ? 0u : mode);
    }
}
void gameworlds_daylight_action(uint8_t mode)
{
    if (!active_world || mode > 2u) return;
    // The world owns tint colour/strength. A world with no night tint
    // gets a moderate black tint rather than a silent no-op.
    day_night_mode = mode == 0u ? 0u : (mode == 1u ? 1u : 2u);
    if(mode && !day_night_strength)day_night_strength = 60u;
    if(mode == 2u) {
        const size_t index=(size_t)(active_world - worlds);
        const uint32_t cycle=(uint32_t)day_night_day_frames + day_night_night_frames +
            (uint32_t)day_night_fade_frames * 2u;
        if(index < WORLD_COUNT && day_night_saved_valid[index] && cycle)
            day_night_tick=day_night_saved_tick[index]%cycle;
        else day_night_tick=0u;
    }
    // DAY also executes authored day-phase actions when leaving fixed night.
    if(mode==0u) {
        if(gw_time_phase!=0u) {gw_time_phase=0u;gw_time_dispatch(0u);}
    } else gw_time_refresh();
    weather_palette_frame();
}
void gameworlds_spotlight_action(uint8_t action)
{
    if (!active_world || action > 2u) return;
    const uint8_t next = action == 2u ? (uint8_t)!spotlight_enabled : (uint8_t)(action == 1u);
    if (next == spotlight_enabled) return;
    spotlight_enabled = next;
    const size_t index = (size_t)(active_world - worlds);
    if (index < WORLD_COUNT) {
        spotlight_override_valid[index] = 1u;
        spotlight_override_value[index] = next;
    }
    if (transition_phase == GW_PHASE_IDLE) {
        transition_restore_palette();
        weather_palette_active = 0u;
        weather_palette_frame();
    }
}
static uint32_t transition_dim(uint32_t source, uint16_t brightness)
{
    /* CLUT layout AARRGGBB; keep alpha intact (index 0 stays transparent). */
    uint32_t r = ((source >> 16) & 255u) * brightness / 255u;
    uint32_t g = ((source >> 8) & 255u) * brightness / 255u;
    uint32_t b = (source & 255u) * brightness / 255u;
    return (source & 0xff000000u) | (r << 16) | (g << 8) | b;
}
/* True uniform CLUT fade for the defeat modal. Unlike tiled/dither masks,
 * every pixel dims smoothly together. Operates on temporary palette copies,
 * never mutating the PPB source or permanent world palette. */
void gameworlds_ui_fade(uint8_t brightness)
{
    if(!active_world)return;
#ifdef gfx_usefpalette
    const uint32_t *front=active_world->front_palette?active_world->front_palette():NULL;
    if(front){
        for(uint16_t i=0;i<256u;++i)transition_front[i]=transition_dim(front[i],brightness);
        gfx_usefpalette(transition_front);
    }
#endif
#ifdef gfx_usebpalette
    const uint32_t *back=active_world->back_palette?active_world->back_palette():NULL;
    if(back){
        for(uint16_t i=0;i<256u;++i)transition_back[i]=transition_dim(back[i],brightness);
        gfx_usebpalette(transition_back);
    }
#endif
}
#if defined(gfx_rectf) && defined(gfx_setcolour)
static uint32_t transition_isqrt(uint32_t number)
{
    /* Integer square root: circle wipe needs no floating point/libm. */
    uint32_t root = 0, bit = 1u << 30;
    while (bit > number) bit >>= 2;
    while (bit) {
        if (number >= root + bit) {
            number -= root + bit;
            root = (root >> 1) + bit;
        } else root >>= 1;
        bit >>= 2;
    }
    return root;
}
#endif
/* Integer math and sprite-relative 4x4 pattern. NEVER recalculate the
 * artwork during ordinary movement. Animation chooses a prebuilt BOB. */
#if defined(gfx_drawbob)
static void spotlight_ring_release(void)
{
    for (uint8_t i = 0u; i < SPOTLIGHT_RING_VARIANTS; ++i) {
        free(spotlight_ring_pixels[i]);
        spotlight_ring_pixels[i] = NULL;
        spotlight_ring_side[i] = 0u;
        spotlight_ring_width[i] = 0u;
        memset(&spotlight_ring_bob[i], 0, sizeof(spotlight_ring_bob[i]));
    }
    spotlight_ring_count = 0u;
}
static uint8_t spotlight_ring_width_for(uint8_t index, uint8_t count)
{
    if (spotlight_anim_mode == 0u || count < 2u)
        return (uint8_t)spotlight_feather;
    return (uint8_t)(spotlight_anim_min +
        ((uint32_t)(spotlight_anim_max - spotlight_anim_min) * index + (count - 1u)/2u) /
        (count - 1u));
}
static uint8_t spotlight_ring_allocate(uint8_t count)
{
    for (uint8_t i = 0u; i < count; ++i) {
        const uint8_t thick = spotlight_ring_width_for(i, count);
        spotlight_ring_width[i] = thick;
        if (!thick || !spotlight_opacity) continue;
        const int32_t inner = spotlight_radius;
        const int32_t outer = inner + thick;
        const uint16_t side = (uint16_t)(2 * outer + 1);
        const size_t bytes = (size_t)side * side;
        uint8_t *pixels = (uint8_t *)malloc(bytes);
        if (!pixels) return 0u;
        memset(pixels, 0, bytes);
        const int32_t inner2 = inner * inner, outer2 = outer * outer;
        const uint32_t range = (uint32_t)(outer2 - inner2);
        for (int32_t sy = 0; sy < side; ++sy) {
            const int32_t dy = sy - outer;
            for (int32_t sx = 0; sx < side; ++sx) {
                const int32_t dx = sx - outer, d2 = dx * dx + dy * dy;
                if (d2 <= inner2 || d2 >= outer2) continue;
                const uint32_t coverage = (uint32_t)(((uint64_t)(d2 - inner2) *
                    spotlight_opacity * 16u) / (range * 100u));
                const uint32_t threshold = coverage > 16u ? 16u : coverage;
                if (spotlight_bayer4[sy & 3][sx & 3] < threshold)
                    pixels[(size_t)sy * side + (size_t)sx] = spotlight_mask_index;
            }
        }
        spotlight_ring_pixels[i] = pixels;
        spotlight_ring_side[i] = side;
        gfxbob_t *bob = &spotlight_ring_bob[i];
        bob->imgdat = pixels;
        bob->atlas_stride = side;
        bob->atlas_height = side;
        bob->width = side;
        bob->height = side;
        bob->scale = 100u;
        bob->handle = BLIT_HANDLE_TOP_LEFT;
    }
    return 1u;
}
static void spotlight_ring_build(void)
{
    spotlight_ring_release();
    const uint8_t animated = spotlight_anim_mode != 0u &&
        spotlight_anim_min < spotlight_anim_max;
    uint8_t count = animated ? (uint8_t)(spotlight_anim_max - spotlight_anim_min + 1u) : 1u;
    if (count > SPOTLIGHT_RING_VARIANTS) count = SPOTLIGHT_RING_VARIANTS;
    /* Avoid making several gigantic BOBs when the artist increases radius.
     * Use fewer, coarser steps; do not allocate more than the memory budget. */
    for (;;) {
        size_t bytes = 0u;
        for (uint8_t i = 0; i < count; ++i) {
            const uint8_t thick = spotlight_ring_width_for(i, count);
            if (!thick) continue;
            const size_t side = (size_t)(2u * (spotlight_radius + thick) + 1u);
            bytes += side * side;
        }
        if (bytes <= SPOTLIGHT_RING_BUDGET && spotlight_ring_allocate(count)) {
            spotlight_ring_count = count;
            break;
        }
        spotlight_ring_release();
        if (count == 1u) break; /* may use legacy CPU fallback on OOM */
        --count;
    }
    /* If memory cannot fit two variants, hold a single cached feather. */
    if (spotlight_ring_count < 2u) spotlight_anim_mode = 0u;
    spotlight_anim_frame = 0u;
    spotlight_anim_backward = 0u;
    spotlight_anim_ticks = spotlight_anim_mode == 1u ? spotlight_random_min_frames
        : (spotlight_anim_mode == 2u ? spotlight_pulse_delay : 0u);
    spotlight_feather_current = spotlight_ring_count
        ? spotlight_ring_width[0] : (uint8_t)spotlight_feather;
}
#else
static void spotlight_ring_release(void) {}
static void spotlight_ring_build(void) {}
#endif

#if defined(gfx_drawbob)
static uint32_t spotlight_rand(void)
{
    /* Small stateful PRNG. No rand(), floating point or timer interrupts. */
    uint32_t r = spotlight_rng_state;
    r ^= r << 13; r ^= r >> 17; r ^= r << 5;
    return spotlight_rng_state = r;
}
#endif
static void spotlight_animation_tick(void)
{
#if defined(gfx_drawbob)
    if (spotlight_anim_mode == 0u || spotlight_ring_count < 2u) return;
    if (spotlight_anim_ticks > 0u) { --spotlight_anim_ticks; return; }
    if (spotlight_anim_mode == 1u) {
        /* Change to a different cached thickness after a random pause. */
        const uint8_t jump = (uint8_t)(1u + spotlight_rand() % (spotlight_ring_count - 1u));
        spotlight_anim_frame = (uint8_t)((spotlight_anim_frame + jump) % spotlight_ring_count);
        const uint16_t low = spotlight_random_min_frames;
        const uint16_t high = spotlight_random_max_frames;
        spotlight_anim_ticks = (uint16_t)(low + spotlight_rand() % (uint32_t)(high - low + 1u) - 1u);
    } else {
        if (!spotlight_anim_backward) {
            if (++spotlight_anim_frame >= spotlight_ring_count - 1u)
                spotlight_anim_backward = 1u;
        } else {
            if (spotlight_anim_frame) --spotlight_anim_frame;
            if (!spotlight_anim_frame) spotlight_anim_backward = 0u;
        }
        spotlight_anim_ticks = spotlight_pulse_delay - 1u;
    }
    spotlight_feather_current = spotlight_ring_width[spotlight_anim_frame];
#endif
}
/* Optional expensive path for <100% darkness. Draw repeating 4x4 coverage
 * as contiguous runs rather than one gfx_plot call per opaque pixel. */
static void spotlight_dither_segment(int32_t x0, int32_t x1, int32_t y, uint16_t opacity)
{
#if defined(gfx_rectf) && defined(gfx_setcolour)
    if (x1 <= x0 || !opacity) return;
    if (opacity >= 100u) { gfx_rectf(x0, y, x1 - x0, 1); return; }
    const uint32_t coverage = (opacity * 16u + 50u) / 100u;
    int32_t begin = -1;
    for (int32_t x = x0; x < x1; ++x) {
        const uint8_t dark = spotlight_bayer4[y & 3][x & 3] < coverage;
        if (dark && begin < 0) begin = x;
        if (!dark && begin >= 0) {
            gfx_rectf(begin, y, x - begin, 1);
            begin = -1;
        }
    }
    if (begin >= 0) gfx_rectf(begin, y, x1 - begin, 1);
#else
    (void)x0; (void)x1; (void)y; (void)opacity;
#endif
}
void gameworlds_transitions_enable(uint8_t enabled)
{
    if (!enabled) {
        transition_restore_palette();
        transition_phase = GW_PHASE_IDLE;
        transition_enabled = 0;
        return;
    }
    if (transition_enabled) return;
    transition_enabled = 1;
    /* The first gameworlds_start() runs before the front buffers exist.
     * Start its entrance effect only once main.c has finished setup. */
    if (active_world) {
        uint8_t in, out, frames, origin;
        int32_t x, y;
        transition_entry(active_world, active_spawn_id, &in, &out, &frames, &origin, &x, &y);
        transition_begin(GW_PHASE_IN, in, frames, origin, x, y);
    }
}
uint8_t gameworlds_transition_busy(void)
{ return transition_enabled && transition_phase != GW_PHASE_IDLE; }

void gameworlds_transition_camera(int32_t camera_x, int32_t camera_y)
{
    transition_camera_x = camera_x;
    transition_camera_y = camera_y;
    transition_camera_valid = 1;
}

void gameworlds_spotlight_camera(int32_t camera_x, int32_t camera_y)
{
    /* This existing per-frame call also supplies weather's world camera.
     * Preserve the user-maintained main.c unchanged. */
    spotlight_camera_x = camera_x;
    spotlight_camera_y = camera_y;
}

void gameworlds_spotlight_player(int32_t world_x, int32_t world_y)
{
    spotlight_player_x = world_x;
    spotlight_player_y = world_y;
}

void gameworlds_spotlight_frame(uint16_t width, uint16_t height)
{
    if (!spotlight_enabled || !active_world || !width || !height || !spotlight_opacity) return;
    /* Lightning fades the darkness instead of abruptly switching the spotlight
     * off. The normal opacity/state never changes, so overrides still work.
     * A pulse value of 0 leaves darkness alone; 100 fully reveals the scene. */
    uint8_t effective_spotlight_opacity = spotlight_opacity;
    uint8_t spotlight_flash = 0u;
    if (weather_suspend_spotlight &&
        (gameworlds_weather_status() & GAME_WEATHER_STATUS_LIGHTNING_FLASH)) {
        spotlight_flash = weather_pulse();
        effective_spotlight_opacity = (uint8_t)((uint16_t)spotlight_opacity *
            (100u - spotlight_flash) / 100u);
    }
    if (!effective_spotlight_opacity) return;
#if defined(gfx_rectf) && defined(gfx_setcolour)
    /* The user-owned main.c still passes the player WORLD origin. Determine
     * the actual drawn sprite centre and current flip flags here. */
    int32_t anchor_x = spotlight_player_x;
    int32_t anchor_y = spotlight_player_y;
    int32_t offset_x = spotlight_offset_x;
    int32_t offset_y = spotlight_offset_y;
@IDE_IF{HAS_SHARED_PLAYER}
    if (spotlight_center) {
        const uint32_t scale = gameplayer_sprite.scale ? gameplayer_sprite.scale : 100u;
        anchor_x += (int32_t)((uint32_t)gameplayer_sprite.width * scale / 200u);
        anchor_y += (int32_t)((uint32_t)gameplayer_sprite.height * scale / 200u);
    }
#ifdef BLIT_FLAG_FLIP_X
    if (spotlight_flip_x && (gameplayer_sprite.flags & BLIT_FLAG_FLIP_X)) offset_x = -offset_x;
    if (spotlight_flip_y && (gameplayer_sprite.flags & BLIT_FLAG_FLIP_Y)) offset_y = -offset_y;
#endif
@IDE_END
    int32_t cx = anchor_x + offset_x - spotlight_camera_x;
    int32_t cy = anchor_y + offset_y - spotlight_camera_y;
    if (cx < 0) cx = 0;
    if (cy < 0) cy = 0;
    if (cx >= (int32_t)width) cx = (int32_t)width - 1;
    if (cy >= (int32_t)height) cy = (int32_t)height - 1;
    spotlight_animation_tick();
    /* Dither BOB pattern is local to its artwork. Quantising the ENTIRE
     * aperture (mask + BOB) in 4px steps keeps Bayer coverage screen-stable
     * while walking. Switch off for a deliberately shimmering light. */
    if (spotlight_stable_dither) { cx = (cx + 2) & ~3; cy = (cy + 2) & ~3; }
    const int32_t inner = spotlight_radius > 0u ? (int32_t)spotlight_radius : 1;
    const int32_t outer = inner + (int32_t)spotlight_feather_current;
    const int32_t outer2 = outer * outer;
    /* Stage 5.161: the spotlight's reserved mask entry is already prepared
     * by weather_palette_frame(). NEVER rebuild transition_front from the
     * original .pal here: on entering a spotlight-enabled night world that
     * silently overwrote the destination's night tint with untinted colours.
     * In particular this happened between the weather pass and an incoming
     * circle transition in user-owned main.c. Recompose the ACTIVE world's
     * palette now, with its weather tint and spotlight mask intact. */
    weather_palette_frame();
    gfx_setcolour(spotlight_mask_index);
    /* Two solid outer strips per row. Cheap at 100% opacity; optional 4x4
     * patterned segments at lower opacity, with no full-frame buffer copy. */
    for (int32_t y = 0; y < height; ++y) {
        const int32_t dy = y - cy;
        const int32_t dy2 = dy * dy;
        if (dy2 >= outer2) {
            spotlight_dither_segment(0, width, y, effective_spotlight_opacity);
            continue;
        }
        const int32_t half = (int32_t)transition_isqrt((uint32_t)(outer2 - dy2));
        int32_t left = cx - half;
        int32_t right = cx + half + 1;
        if (left < 0) left = 0;
        if (right > width) right = width;
        spotlight_dither_segment(0, left, y, effective_spotlight_opacity);
        spotlight_dither_segment(right, width, y, effective_spotlight_opacity);
    }
    if (!spotlight_feather_current) return;
#if defined(gfx_drawbob)
    if (spotlight_ring_count && spotlight_ring_pixels[spotlight_anim_frame]) {
        /* Indexed PPB-like ring. Index 0 transparent, other pixels use
         * the world's reserved mask index. No per-frame dither plotting. */
        gfxbob_t bob = spotlight_ring_bob[spotlight_anim_frame];
        bob.drawx = (int16_t)(cx - outer);
        bob.drawy = (int16_t)(cy - outer);
#if defined(BLIT_FLAG_ALPHABLEND) && defined(BLIT_FLAG_TYPE_FADE_VALUE)
        if (spotlight_flash) {
            /* Fade the feather BOB using the same patterned alpha as leaves.
             * Temporary copy: never alter the precomputed BOB's attributes. */
            bob.flags |= BLIT_FLAG_ALPHABLEND;
            bob.flagval[BLIT_FLAG_TYPE_FADE_VALUE] = spotlight_flash;
        }
#endif
        gfx_drawbob(&bob);
        return;
    }
#endif
#if defined(gfx_plot)
    /* Allocation or minimal-test-renderer fallback; same 4x4 pattern. */
    const int32_t inner2 = inner * inner;
    const uint32_t range = (uint32_t)(outer2 - inner2);
    for (int32_t y = 0; y < height; ++y) {
        const int32_t dy = y - cy;
        for (int32_t x = 0; x < width; ++x) {
            const int32_t dx = x - cx;
            const int32_t d2 = dx * dx + dy * dy;
            if (d2 <= inner2 || d2 >= outer2) continue;
            const uint32_t threshold = (uint32_t)(((uint64_t)(d2 - inner2) *
                effective_spotlight_opacity * 16u) / (range * 100u));
            if (spotlight_bayer4[(y-cy+outer)&3][(x-cx+outer)&3] < threshold)
                gfx_plot(x, y);
        }
    }
#endif
#endif
}

void gameworlds_transition_frame(uint16_t width, uint16_t height)
{
    if (!transition_enabled || !active_world || transition_phase == GW_PHASE_IDLE ||
        transition_phase == GW_PHASE_OUT_DONE || !width || !height) return;
    const uint32_t *front = active_world->front_palette ? active_world->front_palette() : NULL;
    const uint32_t *back = active_world->back_palette ? active_world->back_palette() : NULL;
    /* The outgoing and incoming transitions use the CURRENT world's tint.
     * Otherwise the normal .pal reappears during fades and circle wipes. */
    const uint16_t night_mix = day_night_mix();
    const uint16_t flash_mix = (uint16_t)weather_pulse() * weather_palette_strength / 100u;
    const uint32_t lightning_tint = front ? front[weather_colour_index] : 0xffffffffu;
    const uint32_t progress = ((uint32_t)(transition_step + 1u) * 255u) / transition_frames;
    const uint32_t coverage = transition_phase == GW_PHASE_OUT ? progress : 255u - progress;
    if (transition_mode == GW_TRANSITION_FADE) {
        const uint16_t light = (uint16_t)(255u - coverage);
        if (front) {
            for (uint16_t i = 0; i < 256; ++i)
                transition_front[i] = transition_dim(
                    weather_scene_colour(front[i], lightning_tint, night_mix, flash_mix), light);
            /* The spotlight aperture must never inherit a fading title/world
             * colour. Its mask entry stays constant, even during Fade IN. */
            if (spotlight_enabled)
                transition_front[spotlight_mask_index] = spotlight_mask_colour;
#ifdef gfx_usefpalette
            gfx_usefpalette(transition_front);
#endif
        }
        if (back) {
            for (uint16_t i = 0; i < 256; ++i)
                transition_back[i] = transition_dim(
                    weather_scene_colour(back[i], lightning_tint, night_mix, flash_mix), light);
#ifdef gfx_usebpalette
            gfx_usebpalette(transition_back);
#endif
        }
    } else {
        /* Mask drawing uses the same reserved index as the spotlight. Old
         * non-spotlight worlds retain the original temporary index 255. */
        if (front) {
            for (uint16_t i = 0; i < 256u; ++i)
                transition_front[i] = weather_scene_colour(front[i], lightning_tint, night_mix, flash_mix);
            transition_front[spotlight_enabled ? spotlight_mask_index : 255u] =
                spotlight_enabled ? spotlight_mask_colour : 0xff000000u;
#ifdef gfx_usefpalette
            gfx_usefpalette(transition_front);
#endif
        }
        if (back) {
            for (uint16_t i = 0; i < 256u; ++i)
                transition_back[i] = weather_scene_colour(back[i], lightning_tint, night_mix, flash_mix);
#ifdef gfx_usebpalette
            gfx_usebpalette(transition_back);
#endif
        }
#if defined(gfx_rectf) && defined(gfx_setcolour)
        if (transition_mode == GW_TRANSITION_CIRCLE) {
            /* Black outside a shrinking (OUT) or expanding (IN) disk. */
            int32_t cx = (int32_t)width / 2, cy = (int32_t)height / 2;
            if (transition_circle_origin && transition_camera_valid) {
                cx = transition_world_x - transition_camera_x;
                cy = transition_world_y - transition_camera_y;
                /* Offscreen doorway/start: pin the centre to the nearest
                 * screen edge, rather than overflowing radius arithmetic. */
                if (cx < 0) cx = 0;
                if (cy < 0) cy = 0;
                if (cx > width) cx = width;
                if (cy > height) cy = height;
            }
            const int32_t far_x = cx > (int32_t)width - cx ? cx : (int32_t)width - cx;
            const int32_t far_y = cy > (int32_t)height - cy ? cy : (int32_t)height - cy;
            const uint32_t maxr = transition_isqrt((uint32_t)(far_x * far_x + far_y * far_y)) + 2u;
            const int32_t radius = (int32_t)((maxr * (255u - coverage)) / 255u);
            const int32_t rr = radius * radius;
            gfx_setcolour(spotlight_enabled ? spotlight_mask_index : 255u);
            for (int32_t y = 0; y < height; ++y) {
                const int32_t dy = y - cy;
                if (dy * dy >= rr) {
                    gfx_rectf(0, y, width, 1);
                } else {
                    const int32_t half = (int32_t)transition_isqrt((uint32_t)(rr - dy * dy));
                    int32_t left = cx - half;
                    int32_t right = cx + half + 1;
                    if (left > 0) gfx_rectf(0, y, left, 1);
                    if (right < width) gfx_rectf(right, y, width - right, 1);
                }
            }
        } else {
            const int32_t w = (int32_t)((width * coverage + 254u) / 255u);
            const int32_t h = (int32_t)((height * coverage + 254u) / 255u);
            gfx_setcolour(spotlight_enabled ? spotlight_mask_index : 255u);
            switch (transition_mode) {
            case GW_TRANSITION_LEFT:  if (w) gfx_rectf(width - w, 0, w, height); break;
            case GW_TRANSITION_RIGHT: if (w) gfx_rectf(0, 0, w, height); break;
            case GW_TRANSITION_UP:    if (h) gfx_rectf(0, height - h, width, h); break;
            case GW_TRANSITION_DOWN:  if (h) gfx_rectf(0, 0, width, h); break;
            }
        }
#endif /* gfx_rectf and gfx_setcolour */
    }
    ++transition_step;
    if (transition_step >= transition_frames) {
        if (transition_phase == GW_PHASE_OUT) {
            transition_phase = GW_PHASE_OUT_DONE;
        } else {
            transition_phase = GW_PHASE_IDLE;
            transition_restore_palette();
            weather_palette_frame(); /* No untinted single-frame pop at transition end. */
        }
    }
}
@IDE_IF{HAS_SHARED_PLAYER}
static game_tile_player_t *bound_player_physics;
uint8_t gameworlds_bind_player_physics(game_tile_player_t *player)
{
    if (!player || !active_world ||
        !gameplayer_apply_physics(player, active_world->physics_profile)) return 0;
    bound_player_physics = player;
    gameplayer_attack_set_facing(active_world->start_facing);
    return 1;
}
uint8_t gameworlds_player_sprite_origin(int32_t *x, int32_t *y)
{
    if (!bound_player_physics || !active_world || !x || !y) return 0u;
    *x=bound_player_physics->x100/100;
    *y=bound_player_physics->y100/100;
    return 1u;
}
uint8_t gameworlds_player_pickup_rect(int32_t *x, int32_t *y,
                                     uint16_t *w, uint16_t *h)
{
    if (!bound_player_physics || !active_world || !x || !y || !w || !h ||
        !bound_player_physics->hitbox_w || !bound_player_physics->hitbox_h)
        return 0u;
    /* These are WORLD coordinates. Do not modify physics or collision. */
    *x=bound_player_physics->x100/100 + bound_player_physics->hitbox_x;
    *y=bound_player_physics->y100/100 + bound_player_physics->hitbox_y;
    *w=bound_player_physics->hitbox_w;
    *h=bound_player_physics->hitbox_h;
    return 1u;
}
@IDE_END

static const gameworlds_record_t *find_world(const char *name)
{
    if (!name || !*name) return &worlds[0];
    for (size_t i = 0; i < WORLD_COUNT; ++i)
        if (strcmp(worlds[i].name, name) == 0) return &worlds[i];
    return 0;
}
uint8_t gameworlds_object_action(const char *world_name, uint16_t object_slot, uint8_t action)
{
    if (!world_name || action>2u) return 0;
    const gameworlds_record_t *world=find_world(world_name);
    if (!world) return 0;
    if (world==active_world) {
        if (!world->object_set_active) return 0;
        world->object_set_active(object_slot,action);
    } else {
        if (!world->object_remote_action) return 0;
        world->object_remote_action(object_slot,action);
    }
    return 1;
}
uint8_t gameworlds_npc_action(const char *world_name, uint16_t npc_slot, uint8_t action)
{
    if (!world_name || action > 2u) return 0;
    const gameworlds_record_t *world = find_world(world_name);
    if (!world) return 0;
    if (world == active_world) {
        if (!world->npc_set_active) return 0;
        world->npc_set_active(npc_slot, action);
    } else {
        if (!world->npc_remote_action) return 0;
        world->npc_remote_action(npc_slot, action);
    }
    return 1;
}
static void inventory_put(const char *name, uint16_t amount, void *user)
{
    (void)user;
    if (!name || !*name) return;
    for (uint16_t i = 0; i < inventory_count; ++i)
        if (strcmp(inventory[i].name, name) == 0) { inventory[i].amount = amount; return; }
    if (inventory_count < GAMEWORLDS_MAX_INVENTORY) {
        inventory[inventory_count].name = name;
        inventory[inventory_count].amount = amount;
        ++inventory_count;
    }
}
static uint32_t inventory_get(const char *name, void *user)
{
    (void)user;
    if (!name) return UINT32_MAX;
    for (uint16_t i = 0; i < inventory_count; ++i)
        if (strcmp(inventory[i].name, name) == 0) return inventory[i].amount;
    return UINT32_MAX; /* Not yet in backpack: retain world-defined initial. */
}
/* Stage 5.165: quest state is global, not per-world. No heap allocation.
 * Auto conditions recheck on world entry and gameplay ticks. Explicit event
 * conditions are signalled by gameplay via gameworlds_quest_event(). */
static int gw_quest_find(const char *id)
{
    if (!id || !*id) return -1;
    for (uint16_t i=0;i<GW_QUEST_COUNT;++i)
        if (strcmp(gw_quest_defs[i].id,id)==0) return (int)i;
    return -1;
}
static void gw_quest_reset(void)
{
    memset(gw_quest_done,0,sizeof(gw_quest_done));
    memset(gw_quest_status,0,sizeof(gw_quest_status));
    memset(gw_quest_step,0,sizeof(gw_quest_step));
    gw_quest_tracked=255u;gw_quest_ready=0u;
    gw_quest_notice_ready=0u;gw_quest_notice_kind=0u;gw_quest_notice_revision=0u;
}
static void gw_quest_unlock(void)
{
    for (uint16_t i=0;i<GW_QUEST_COUNT;++i) {
        if (gw_quest_status[i]==2u || gw_quest_status[i]==3u) continue;
        const int exclude=gw_quest_find(gw_quest_defs[i].excludes);
        if (exclude>=0 && gw_quest_status[exclude]==2u) {
            gw_quest_status[i]=3u;continue;
        }
        if (gw_quest_status[i]!=0u && gw_quest_status[i]!=4u)continue;
        /* Initially hidden quests must be explicitly offered by a dialogue.
         * Status 4 retains the offer while a prerequisite is unfinished. */
        if(gw_quest_status[i]==0u && gw_quest_defs[i].initially_hidden)continue;
        const int prerequisite=gw_quest_find(gw_quest_defs[i].requires);
        if (prerequisite<0 || gw_quest_status[prerequisite]==2u)
            gw_quest_status[i]=1u;
    }
}
static void gw_quest_notice_refresh(void)
{
    if (!gw_quest_notice_ready) {
        memcpy(gw_quest_notice_known,gw_quest_status,sizeof(gw_quest_notice_known));
        memcpy(gw_quest_notice_steps,gw_quest_step,sizeof(gw_quest_notice_steps));
        gw_quest_notice_ready=1u;
        return;
    }
    for(uint16_t i=0u;i<GW_QUEST_COUNT;++i) {
        const uint8_t before=gw_quest_notice_known[i],now=gw_quest_status[i];
        const uint16_t old_step=gw_quest_notice_steps[i],step=gw_quest_step[i];
        if(now!=before || step!=old_step) {
            /* A branch becoming excluded/locked is not a player notification.
             * Repeated refreshes produce no new event. */
            const uint8_t kind=now==2u?3u:(step>old_step?2u:
                                ((now==1u || now==4u) && before!=now?1u:0u));
            if(kind) {
                gw_quest_notice_index=i;
                gw_quest_notice_kind=kind;
                ++gw_quest_notice_revision;
                if(!gw_quest_notice_revision)++gw_quest_notice_revision;
            }
        }
        gw_quest_notice_known[i]=now;
        gw_quest_notice_steps[i]=step;
    }
}
uint8_t gameworlds_quest_notice(uint16_t *quest_index,uint32_t *revision)
{
    if(quest_index)*quest_index=gw_quest_notice_index;
    if(revision)*revision=gw_quest_notice_revision;
    return gw_quest_notice_kind;
}
static uint8_t gw_quest_is_done(uint16_t objective)
{
    return (uint8_t)((gw_quest_done[objective>>3u]>>(objective&7u))&1u);
}
static uint8_t gw_quest_mark(uint16_t quest,uint16_t offset)
{
    const gw_quest_def_t *q=&gw_quest_defs[quest];
    if(gw_quest_status[quest]!=1u || offset>=q->count)return 0u;
    if(q->unordered) {
        const uint16_t index=q->first+offset;
        if(gw_quest_is_done(index))return 0u;
        gw_quest_done[index>>3u]|=(uint8_t)(1u<<(index&7u));
    } else if(offset!=gw_quest_step[quest])return 0u;
    ++gw_quest_step[quest];
    if(gw_quest_step[quest]==q->count) {
        gw_quest_status[quest]=2u;
        /* A transition, never a continuous Boolean and never on restore.
         * The active world owns the graph; no cross-world sprite callbacks. */
        if(!applying && active_world && active_world->quest_completed)
            active_world->quest_completed(q->id);
    }
    return 1u;
}
static void gw_quest_refresh(void)
{
    if (!gw_quest_ready) {gw_quest_ready=1u;gw_quest_unlock();}
    if (active_world && active_world->inventory_store)
        active_world->inventory_store(inventory_put,0);
    /* Bounded loop: one quest completes at most its authored step count. */
    for (uint16_t iteration=0;iteration<GW_OBJECTIVE_COUNT+GW_QUEST_COUNT+1u;++iteration) {
        uint8_t changed=0;
        gw_quest_unlock();
        for (uint16_t i=0;i<GW_QUEST_COUNT;++i) {
            if (gw_quest_status[i]!=1u) continue;
            const gw_quest_def_t *q=&gw_quest_defs[i];
            if (gw_quest_step[i]>=q->count) {
                gw_quest_status[i]=2u; changed=1;continue;
            }
            /* Ordered quests inspect one step; unordered quests inspect all
             * not-yet-completed objectives, including world/item conditions. */
            for(uint16_t j=0;j<q->count;++j) {
                if(!q->unordered && j!=gw_quest_step[i])continue;
                if(q->unordered && gw_quest_is_done(q->first+j))continue;
                const gw_objective_def_t *o=&gw_objective_defs[q->first+j];
                const uint8_t world=strcmp(o->kind,"world")==0 && active_world &&
                                        strcmp(active_world->name,o->target)==0;
                const uint8_t item=strcmp(o->kind,"item")==0 &&
                                       inventory_get(o->target,0)!=UINT32_MAX &&
                                       inventory_get(o->target,0)>0u;
                if((world || item) && gw_quest_mark(i,j))changed=1;
                if(gw_quest_status[i]!=1u)break;
            }
        }
        if (!changed)break;
    }
    if (gw_quest_tracked>=GW_QUEST_COUNT || gw_quest_status[gw_quest_tracked]!=1u)
        gw_quest_tracked=255u;
    if (gw_quest_tracked==255u)
        for(uint16_t i=0;i<GW_QUEST_COUNT;++i)
            if(gw_quest_status[i]==1u) {gw_quest_tracked=(uint8_t)i;break;}
    gw_quest_notice_refresh();
}
/* Triggered when the player REACHES an authored dialogue node. Repeated
 * visits must not reset a completed or already accepted quest. */
uint8_t gameworlds_quest_enable(const char *quest_id)
{
    const int index=gw_quest_find(quest_id);
    if(index<0)return 0u;
    gw_quest_refresh();
    if(gw_quest_status[index]!=0u)return 0u;
    gw_quest_status[index]=4u; /* Offered; prerequisite may remain incomplete. */
    gw_quest_refresh();
    return 1u;
}
uint8_t gameworlds_quest_visible(uint16_t i)
{
    /* Reading journal visibility never needs to rescan inventory each frame.
     * Quest enable/advance and save/load already update the live status. */
    if(i>=GW_QUEST_COUNT)return 0u;
    if(!gw_quest_defs[i].initially_hidden)return 1u;
    return gw_quest_status[i]==1u || gw_quest_status[i]==2u ||
           gw_quest_status[i]==4u;
}
uint16_t gameworlds_quest_count(void) {return GW_QUEST_COUNT;}
const char *gameworlds_quest_id(uint16_t i)
{return i<GW_QUEST_COUNT ? gw_quest_defs[i].id : 0;}
const char *gameworlds_quest_title(uint16_t i)
{return i<GW_QUEST_COUNT ? gw_quest_defs[i].title : 0;}
const char *gameworlds_quest_description(uint16_t i)
{return i<GW_QUEST_COUNT ? gw_quest_defs[i].description : 0;}
uint32_t gameworlds_quest_revision(void) {return gw_quest_notice_revision;}
uint8_t gameworlds_quest_status(uint16_t i)
{gw_quest_refresh();return i<GW_QUEST_COUNT ? gw_quest_status[i] : 0u;}
uint16_t gameworlds_quest_current_step(uint16_t i)
{gw_quest_refresh();return i<GW_QUEST_COUNT ? gw_quest_step[i] : 0u;}
uint16_t gameworlds_quest_objective_count(uint16_t quest)
{return quest<GW_QUEST_COUNT ? gw_quest_defs[quest].count : 0u;}
const char *gameworlds_quest_objective_title_at(uint16_t quest,uint16_t objective)
{
    if(quest>=GW_QUEST_COUNT || objective>=gw_quest_defs[quest].count)return 0;
    return gw_objective_defs[gw_quest_defs[quest].first+objective].title;
}
uint8_t gameworlds_quest_objective_done_at(uint16_t quest,uint16_t objective)
{
    if(quest>=GW_QUEST_COUNT || objective>=gw_quest_defs[quest].count)return 0u;
    if(gw_quest_defs[quest].unordered)
        return gw_quest_is_done(gw_quest_defs[quest].first+objective);
    return (uint8_t)(gw_quest_step[quest]>objective);
}
uint8_t gameworlds_quest_is_unordered(uint16_t quest)
{return (uint8_t)(quest<GW_QUEST_COUNT && gw_quest_defs[quest].unordered);}
const char *gameworlds_quest_objective(uint16_t i)
{
    gw_quest_refresh();
    if(i>=GW_QUEST_COUNT || gw_quest_status[i]!=1u ||
       gw_quest_step[i]>=gw_quest_defs[i].count)return 0;
    const gw_quest_def_t *q=&gw_quest_defs[i];
    if(q->unordered) {
        for(uint16_t j=0;j<q->count;++j)
            if(!gw_quest_is_done(q->first+j))return gw_objective_defs[q->first+j].title;
        return 0;
    }
    return gw_objective_defs[q->first+gw_quest_step[i]].title;
}
const char *gameworlds_quest_hint(uint16_t i)
{
    gw_quest_refresh();
    if(i>=GW_QUEST_COUNT || gw_quest_status[i]!=1u ||
       gw_quest_step[i]>=gw_quest_defs[i].count)return 0;
    const gw_quest_def_t *q=&gw_quest_defs[i];
    if(q->unordered) {
        for(uint16_t j=0;j<q->count;++j)
            if(!gw_quest_is_done(q->first+j))return gw_objective_defs[q->first+j].hint;
        return 0;
    }
    return gw_objective_defs[q->first+gw_quest_step[i]].hint;
}
int16_t gameworlds_quest_tracked(void)
{gw_quest_refresh();return gw_quest_tracked==255u ? -1 : (int16_t)gw_quest_tracked;}
uint8_t gameworlds_quest_track(const char *id)
{
    gw_quest_refresh();
    const int index=gw_quest_find(id);
    if(index<0 || gw_quest_status[index]!=1u)return 0u;
    gw_quest_tracked=(uint8_t)index;return 1u;
}
uint8_t gameworlds_quest_event(const char *event_id)
{
    if(!event_id || !*event_id)return 0u;
    gw_quest_refresh();
    uint8_t advances=0u;
    for(uint16_t i=0;i<GW_QUEST_COUNT;++i) {
        if(gw_quest_status[i]!=1u || gw_quest_step[i]>=gw_quest_defs[i].count)continue;
        const gw_quest_def_t *q=&gw_quest_defs[i];
        for(uint16_t j=0;j<q->count;++j) {
            if(!q->unordered && j!=gw_quest_step[i])continue;
            if(q->unordered && gw_quest_is_done(q->first+j))continue;
            const gw_objective_def_t *o=&gw_objective_defs[q->first+j];
            if(strcmp(o->kind,"event")!=0 || strcmp(o->target,event_id)!=0)continue;
            if(gw_quest_mark(i,j)) {
                ++advances;
                if(!q->unordered)break; /* one ordered event per dispatch */
            }
            if(gw_quest_status[i]!=1u)break;
        }
    }
    if(advances)gw_quest_refresh();
    return advances;
}
uint8_t gameworlds_quest_event_number(uint16_t event_id)
{
    if(!active_world)return 0u;
    char token[320];
    snprintf(token,sizeof(token),"%s:%u",active_world->name,(unsigned)event_id);
    gw_quest_refresh();
    uint8_t count=0u;
    for(uint16_t i=0;i<GW_QUEST_COUNT;++i) {
        if(gw_quest_status[i]!=1u || gw_quest_step[i]>=gw_quest_defs[i].count)continue;
        const gw_quest_def_t *q=&gw_quest_defs[i];
        for(uint16_t j=0;j<q->count;++j) {
            if(!q->unordered && j!=gw_quest_step[i])continue;
            if(q->unordered && gw_quest_is_done(q->first+j))continue;
            const gw_objective_def_t *o=&gw_objective_defs[q->first+j];
            if(strcmp(o->kind,"adventure_event")!=0 || strcmp(o->target,token)!=0)continue;
            if(gw_quest_mark(i,j)) {
                ++count;
                if(!q->unordered)break; /* one ordered event per dispatch */
            }
            if(gw_quest_status[i]!=1u)break;
        }
    }
    if(count)gw_quest_refresh();
    return count;
}
/* Auto-generated dialogue-choice IDs are independent of numeric callbacks.
 * This lets a successful answer run an object action AND complete a quest. */
uint8_t gameworlds_quest_dialogue_choice(const char *stable_choice_id)
{
    if(!active_world || !stable_choice_id || !*stable_choice_id)return 0u;
    char token[320];
    const int length=snprintf(token,sizeof(token),"%s:%s",active_world->name,stable_choice_id);
    if(length<0 || (size_t)length>=sizeof(token))return 0u;
    gw_quest_refresh();
    uint8_t count=0u;
    for(uint16_t i=0;i<GW_QUEST_COUNT;++i) {
        if(gw_quest_status[i]!=1u || gw_quest_step[i]>=gw_quest_defs[i].count)continue;
        const gw_quest_def_t *q=&gw_quest_defs[i];
        for(uint16_t j=0;j<q->count;++j) {
            if(!q->unordered && j!=gw_quest_step[i])continue;
            if(q->unordered && gw_quest_is_done(q->first+j))continue;
            const gw_objective_def_t *o=&gw_objective_defs[q->first+j];
            if(strcmp(o->kind,"dialogue_choice")!=0 || strcmp(o->target,token)!=0)continue;
            if(gw_quest_mark(i,j)) {
                ++count;
                if(!q->unordered)break; /* one ordered event per dispatch */
            }
            if(gw_quest_status[i]!=1u)break;
        }
    }
    if(count)gw_quest_refresh();
    return count;
}
/* IDs and their ordered steps make up the save schema; title/hint edits
 * do not invalidate existing save progress. */
static uint32_t gw_quest_schema(void)
{
    uint32_t h=2166136261u;
    for(uint16_t i=0;i<GW_QUEST_COUNT;++i) {
        const char *p=gw_quest_defs[i].id;
        while(*p){h^=(uint8_t)*p++;h*=16777619u;}
        h^=gw_quest_defs[i].count;h*=16777619u;
        if(gw_quest_defs[i].unordered){h^=0xa5u;h*=16777619u;}
    }
    for(uint16_t i=0;i<GW_OBJECTIVE_COUNT;++i) {
        const char *p=gw_objective_defs[i].id;
        while(*p){h^=(uint8_t)*p++;h*=16777619u;}
    }
    return h;
}
void gameworlds_seed_inventory(const char *name, uint16_t initial)
{ inventory_put(name, initial, 0); }
void gameworlds_player_hooks(gameworlds_player_hook_t save,
                             gameworlds_player_hook_t restore, void *user)
{
    save_player = save;
    restore_player = restore;
    player_context = user;
}
gameworlds_player_state_t *gameworlds_state(void) { return &persistent; }
uint16_t gameworlds_count(void) { return (uint16_t)WORLD_COUNT; }
const char *gameworlds_name(uint16_t i) { return i < WORLD_COUNT ? worlds[i].name : 0; }
const char *gameworlds_active(void) { return active_world ? active_world->name : 0; }
uint8_t gameworlds_physics_profile(void)
{ return active_world ? active_world->physics_profile : worlds[0].physics_profile; }
void *gameworlds_map(void) { return active_world ? active_world->map : 0; }
uint8_t gameworlds_player_start(gameworlds_spawn_t *out) {
    if (!active_world || !out) return 0;
    out->x = active_world->start_x;
    out->y = active_world->start_y;
    out->facing = active_world->start_facing;
    for (uint16_t i = 0; i < active_world->named_spawn_count; ++i) {
        const gameworlds_named_spawn_t *named = &active_world->named_spawns[i];
        if (strcmp(named->id, active_spawn_id) == 0) {
            out->x = named->x; out->y = named->y; out->facing = named->facing;
            break;
        }
    }
    if (saved_position_valid && strcmp(active_world->name,saved_world_id)==0)
        *out=saved_position;
    return 1;
}

static void unload_active(void)
{
    spotlight_ring_release();
    if (!active_world) return;
    day_night_save_active();
    music_stop(); /* Never free sample buffers while DMA/audio still use them. */
    if (active_world->inventory_store)
        active_world->inventory_store(inventory_put, 0);
    /* Capture mutable objects and story flags BEFORE unbinding old assets. */
    if (active_world->world_state_save) active_world->world_state_save();
    if (active_world->story_save) active_world->story_save();
@IDE_IF{HAS_ADVENTURE_RUNTIME}
    /* Discard NPC/skin pointers to old world's assets. */
    game_adventure_start(0, 0, 0, 0, 0, 0, 0, 0, 0, 8, 0, 2, 0, 0);
@IDE_END
    if (active_world->unload_atlas) active_world->unload_atlas();
    if (active_world->unload_map) active_world->unload_map();
    active_world->assets_shutdown();
    active_world = 0;
    spotlight_enabled = 0;
}
static uint8_t activate(const gameworlds_record_t *world)
{
    if (!world || !world->assets_init()) return 0;
    if (world->load_map && !world->load_map(world->map_path)) goto failed;
    if (world->load_atlas && !world->load_atlas()) goto failed;
    /* Only call setup after sprite/PPB resources and tilemaps exist. */
    if (world->adventure_setup) world->adventure_setup();
@IDE_IF{HAS_PLAYER_VISIBILITY}
    game_adventure_set_inventory_filter(gameplayer_inventory_visible);
@IDE_END
    if (world->inventory_load) world->inventory_load(inventory_get, 0);
    if (world->story_restore) world->story_restore();
    if (!world->objects_init()) goto failed;
    /* Reapply this world's saved mutable state after its default objects are built. */
    if (world->world_state_restore) world->world_state_restore();
    if (world->object_apply_remote) world->object_apply_remote();
    active_world = world;
    const size_t spot_index = (size_t)(world - worlds);
    weather_enter(world);
    day_night_restore_world(world);
    gw_time_phase=255u;
    gw_time_refresh();
    spotlight_enabled = spot_index < WORLD_COUNT && spotlight_override_valid[spot_index]
        ? spotlight_override_value[spot_index] : world->spotlight_enabled;
    spotlight_radius = world->spotlight_radius;
    spotlight_feather = world->spotlight_feather;
    spotlight_center = world->spotlight_center;
    spotlight_offset_x = world->spotlight_offset_x;
    spotlight_offset_y = world->spotlight_offset_y;
    spotlight_mask_index = world->spotlight_mask_index ? world->spotlight_mask_index : 255u;
    spotlight_mask_colour = 0xff000000u | (world->spotlight_mask_colour & 0xffffffu);
    spotlight_flip_x = world->spotlight_flip_x;
    spotlight_flip_y = world->spotlight_flip_y;
    spotlight_opacity = (world->spotlight_opacity_code >= 1u && world->spotlight_opacity_code <= 101u)
        ? (uint8_t)(world->spotlight_opacity_code - 1u) : 100u;
    /* Old generated C records have zero-initialised trailing animation fields.
     * No animation stays static; new Stage5.111 exports stable dither=1. */
    spotlight_stable_dither = world->spotlight_stable_dither;
    spotlight_anim_mode = world->spotlight_anim_mode <= 2u ? world->spotlight_anim_mode : 0u;
    spotlight_anim_min = world->spotlight_anim_min > 96u ? 96u : world->spotlight_anim_min;
    spotlight_anim_max = world->spotlight_anim_max > 96u ? 96u : world->spotlight_anim_max;
    if (spotlight_anim_max < spotlight_anim_min) spotlight_anim_max = spotlight_anim_min;
    spotlight_random_min_frames = world->spotlight_random_min_frames ? world->spotlight_random_min_frames : 3u;
    spotlight_random_max_frames = world->spotlight_random_max_frames >= spotlight_random_min_frames
        ? world->spotlight_random_max_frames : spotlight_random_min_frames;
    spotlight_pulse_delay = world->spotlight_pulse_delay ? world->spotlight_pulse_delay : 3u;
    spotlight_anim_ticks = 0u;
    spotlight_anim_frame = 0u;
    spotlight_anim_backward = 0u;
    spotlight_feather_current = (uint8_t)spotlight_feather;
    spotlight_ring_build();
    /* All saved objects, remote actions, weather and spotlight defaults now exist.
     * Initialise derived logic states before displaying this world. */
    if (world->logic_sync) world->logic_sync();
    /* Immediately replace any title-screen CLUT before the first spotlight
     * frame, without modifying original palette arrays. */
    if (spotlight_enabled) transition_restore_palette();
    weather_palette_frame(); /* Night/fog is ready before the first visible frame. */
    return 1;
failed:
    music_stop();
    if (world->unload_atlas) world->unload_atlas();
    if (world->unload_map) world->unload_map();
    world->assets_shutdown();
    return 0;
}
/* Stage 5.166.109 TFCard save runtime. Uses two independent files per slot: an
 * interrupted write cannot damage the other copy. Neither contains pointers.
 * Save files use the application's TFCard working directory, beside the game
 * when the SIDBOX launcher sets that directory to the app's folder.
 * The old /CGSAVES directory remains readable for existing save slots.
 * Files use a FAT 8.3 project-key/slot/bank basename; max 256 KiB each. */
#define GW_SAVE_VERSION 4u
#define GW_SAVE_LIMIT 262144u
#define GW_SAVE_PROJECT_KEY @IDE{SAVE_KEY}u
#define GW_SAVE_IDENTITY @IDE{SAVE_IDENTITY}ULL
#define GW_SAVE_SLOT_COUNT 10u
#define GW_SAVE_MAX_NAME 64u

typedef struct {
    uint32_t magic, version, key, sequence;
    uint32_t length, checksum, world_layout;
    uint64_t identity; /* Stage 5.166.109: published object/story/quest identity. */
} gw_save_header_t;
typedef struct {
    uint8_t *bytes;
    uint32_t capacity, offset;
    uint8_t failed;
} gw_save_stream_t;
typedef struct {
    char name[GW_SAVE_MAX_NAME];
    uint16_t quantity;
} gw_save_item_t;
typedef struct {
    char name[GW_SAVE_MAX_NAME];
    int32_t value;
} gw_save_stat_t;
static char gw_save_inventory_names[GAMEWORLDS_MAX_INVENTORY][GW_SAVE_MAX_NAME];
typedef struct {
    uint32_t marker, schema;
    uint16_t count;
    uint8_t tracked, reserved;
    uint8_t status[64];
    uint16_t step[64];
    uint8_t done[32]; /* v4 objective bitset, absent from v3 saves */
} gw_save_quests_t;


static void gw_save_emit(const void *src, uint32_t amount, void *context)
{
    gw_save_stream_t *stream=(gw_save_stream_t *)context;
    if (stream->failed || amount > GW_SAVE_LIMIT - stream->offset) {
        stream->failed=1; return;
    }
    if (stream->bytes) {
        if (amount > stream->capacity - stream->offset) {
            stream->failed=1; return;
        }
        memcpy(stream->bytes+stream->offset,src,amount);
    }
    stream->offset+=amount;
}
static uint8_t gw_save_take(void *dst, uint32_t amount, void *context)
{
    gw_save_stream_t *stream=(gw_save_stream_t *)context;
    if (stream->failed || amount > stream->capacity-stream->offset) {
        stream->failed=1; return 0;
    }
    if (dst) memcpy(dst,stream->bytes+stream->offset,amount);
    stream->offset+=amount;
    return 1;
}
static uint32_t gw_save_checksum(const uint8_t *data, uint32_t length)
{
    /* FNV-1a. Detects truncated, altered and partially-written payloads. */
    uint32_t hash=2166136261u;
    for (uint32_t i=0;i<length;++i) { hash^=data[i]; hash*=16777619u; }
    return hash;
}
static uint32_t gw_save_world_layout(void)
{
    uint32_t hash=2166136261u;
    for (size_t i=0;i<WORLD_COUNT;++i) {
        const unsigned char *p=(const unsigned char *)worlds[i].name;
        while (*p) { hash^=*p++; hash*=16777619u; }
        gw_save_stream_t measure={0};
        worlds[i].object_disk_export(gw_save_emit,&measure);
        hash^=measure.offset; hash*=16777619u;
        measure.offset=0;
        worlds[i].story_disk_export(gw_save_emit,&measure);
        hash^=measure.offset; hash*=16777619u;
    }
    return hash;
}
static void gw_save_filename(char path[40], uint8_t slot, char bank)
{
    /* Relative to the TFCard working directory. FAT-compatible 8.3 name. */
    snprintf(path,40,"%06lX%1u%c.SAV",
        (unsigned long)(GW_SAVE_PROJECT_KEY&0xffffffu), (unsigned)slot, bank);
}
static void gw_save_legacy_filename(char path[40], uint8_t slot, char bank)
{
    /* Read-only compatibility with Stage 5.164 through 5.164.4. */
    snprintf(path,40,"/CGSAVES/%06lX%1u%c.SAV",
        (unsigned long)(GW_SAVE_PROJECT_KEY&0xffffffu), (unsigned)slot, bank);
}
static uint8_t gw_save_read_bank(uint8_t slot, char bank, uint8_t legacy,
                                 uint8_t **out, gw_save_header_t *header)
{
    char path[40];
    if (legacy) gw_save_legacy_filename(path,slot,bank);
    else gw_save_filename(path,slot,bank);
    if (sfopen(0,path,SD_READ)!=FR_OK) return 0;
    uint32_t got=0;
    gw_save_header_t temp;
    uint8_t *buffer=0;
    if (sfread(0,&temp,(uint32_t)sizeof(temp),&got)!=FR_OK ||
        got!=sizeof(temp) || temp.magic!=0x56534743u ||
        // v1/v2 headers have no identity proof. They cannot safely be
        // imported into index-serialized arrays after the layout changes.
        (temp.version!=3u && temp.version!=GW_SAVE_VERSION) || temp.key!=GW_SAVE_PROJECT_KEY ||
        temp.length>GW_SAVE_LIMIT || temp.length<sizeof(gameworlds_player_state_t) ||
        temp.world_layout!=gw_save_world_layout() || temp.identity!=GW_SAVE_IDENTITY ||
        SYSFileSystem->sbfilelen(0)!=(uint32_t)sizeof(temp)+temp.length)
        goto failure;
    buffer=(uint8_t *)malloc(temp.length);
    if (!buffer) goto failure;
    if (sfread(0,buffer,temp.length,&got)!=FR_OK || got!=temp.length ||
        gw_save_checksum(buffer,temp.length)!=temp.checksum)
        goto failure;
    sfclose(0);
    *out=buffer; *header=temp;
    return 1;
failure:
    free(buffer);
    sfclose(0);
    return 0;
}
/* Validate the full payload structure before considering a bank usable.
 * A checksum alone can be valid for an incompatible/malformed payload. */
static uint8_t gw_save_decode(uint8_t *bytes,uint32_t length,uint8_t apply,
                              uint32_t *world_number, uint32_t version);
static uint8_t gw_save_best(uint8_t slot, uint8_t **bytes, gw_save_header_t *header)
{
    /* Prefer the new game-local save. Only consult legacy root files when
     * no valid local bank survives. Do not move or overwrite legacy files. */
    for (uint8_t legacy=0;legacy<2u;++legacy) {
        uint8_t *a=0,*b=0;
        gw_save_header_t ha={0},hb={0};
        uint8_t va=gw_save_read_bank(slot,'A',legacy,&a,&ha);
        uint8_t vb=gw_save_read_bank(slot,'B',legacy,&b,&hb);
        if (va && !gw_save_decode(a,ha.length,0,0,ha.version)) { free(a); a=0;va=0; }
        if (vb && !gw_save_decode(b,hb.length,0,0,hb.version)) { free(b); b=0;vb=0; }
        if (!va && !vb) continue;
        /* Signed subtraction keeps wraparound sequence ordering sensible. */
        if (vb && (!va || (int32_t)(hb.sequence-ha.sequence)>0)) {
            free(a); *bytes=b; *header=hb;
        } else { free(b); *bytes=a; *header=ha; }
        return 1;
    }
    return 0;
}
/* Decode once without modifying live state, THEN decode again to apply.
 * Matching world layout and bounds are checked before any arrays change. */
static uint8_t gw_save_decode(uint8_t *bytes,uint32_t length,uint8_t apply,
                              uint32_t *world_number, uint32_t version)
{
    gw_save_stream_t stream={bytes,length,0,0};
    gameworlds_player_state_t player={0};
    uint32_t world_index=0;
    gameworlds_spawn_t spawn={0};
    uint16_t num_items=0,num_stats=0;
#define GW_READ(v) if (!gw_save_take(&(v),(uint32_t)sizeof(v),&stream)) return 0
    GW_READ(player);
    GW_READ(world_index);
    if (world_index>=WORLD_COUNT) return 0;
    GW_READ(spawn);
    if (spawn.facing>1u) return 0;
    GW_READ(num_items);
    if (num_items>GAMEWORLDS_MAX_INVENTORY) return 0;
    gw_save_item_t item;
    for (uint16_t i=0;i<num_items;++i) {
        GW_READ(item);
        if (!memchr(item.name,0,sizeof(item.name)) || !item.name[0]) return 0;
        if (apply) {
            memcpy(gw_save_inventory_names[i],item.name,sizeof(item.name));
            inventory[i].name=gw_save_inventory_names[i];
            inventory[i].amount=item.quantity;
        }
    }
    GW_READ(num_stats);
@IDE_IF{HAS_SHARED_PLAYER}
    if (num_stats!=gameplayer_custom_stat_count()) return 0;
@IDE_ELSE
    if (num_stats) return 0;
@IDE_END
    for (uint16_t i=0;i<num_stats;++i) {
        gw_save_stat_t stat;
        GW_READ(stat);
        if (!memchr(stat.name,0,sizeof(stat.name))) return 0;
@IDE_IF{HAS_SHARED_PLAYER}
        const char *expected=gameplayer_custom_stat_name(i);
        if (!expected || strcmp(expected,stat.name)!=0) return 0;
        if (apply && !gameplayer_stat_set(stat.name,stat.value)) return 0;
@IDE_END
    }
    if (!gw_save_take(apply ? day_night_saved_tick : 0,
            (uint32_t)sizeof(day_night_saved_tick),&stream) ||
        !gw_save_take(apply ? day_night_saved_valid : 0,
            (uint32_t)sizeof(day_night_saved_valid),&stream) ||
        !gw_save_take(apply ? spotlight_override_valid : 0,
            (uint32_t)sizeof(spotlight_override_valid),&stream) ||
        !gw_save_take(apply ? spotlight_override_value : 0,
            (uint32_t)sizeof(spotlight_override_value),&stream)) return 0;
    for (size_t i=0;i<WORLD_COUNT;++i) {
        gw_save_stream_t size={0};
        worlds[i].object_disk_export(gw_save_emit,&size);
        uint32_t stored=0;
        GW_READ(stored);
        if (stored!=size.offset) return 0;
        if (apply) {
            const uint32_t before=stream.offset;
            if (!worlds[i].object_disk_import(gw_save_take,&stream) ||
                stream.offset-before!=stored) return 0;
        } else if (!gw_save_take(0,stored,&stream)) return 0;
        size.offset=0;
        worlds[i].story_disk_export(gw_save_emit,&size);
        GW_READ(stored);
        if (stored!=size.offset) return 0;
        if (apply) {
            const uint32_t before=stream.offset;
            if (!worlds[i].story_disk_import(gw_save_take,&stream) ||
                stream.offset-before!=stored) return 0;
        } else if (!gw_save_take(0,stored,&stream)) return 0;
    }
#undef GW_READ
    gw_save_quests_t questData={0};
    if (version>=2u) {
        if (!gw_save_take(&questData,(uint32_t)(version>=4u ? sizeof(questData) :
                sizeof(questData)-sizeof(questData.done)),&stream) ||
            questData.marker!=0x54534551u || questData.schema!=gw_quest_schema() ||
            questData.count!=GW_QUEST_COUNT ||
            (questData.tracked!=255u && questData.tracked>=GW_QUEST_COUNT))return 0;
        for(uint16_t i=0;i<GW_QUEST_COUNT;++i) {
            if(questData.status[i]>4u || questData.step[i]>gw_quest_defs[i].count ||
               (questData.status[i]==2u && questData.step[i]!=gw_quest_defs[i].count))return 0;
            if(gw_quest_defs[i].unordered && version>=4u) {
                uint16_t bits=0u;
                for(uint16_t j=0;j<gw_quest_defs[i].count;++j) {
                    const uint16_t k=gw_quest_defs[i].first+j;
                    bits+=(uint16_t)((questData.done[k>>3u]>>(k&7u))&1u);
                }
                if(bits!=questData.step[i])return 0;
            }
        }
    } else if (version!=1u) return 0;
    if (stream.failed || stream.offset!=length) return 0;
    if (apply) {
        gw_quest_reset();
        if (version>=2u) {
            memcpy(gw_quest_status,questData.status,sizeof(gw_quest_status));
            gw_quest_notice_ready=0u;gw_quest_notice_kind=0u;gw_quest_notice_revision=0u;
            memcpy(gw_quest_step,questData.step,sizeof(gw_quest_step));
            if(version>=4u)memcpy(gw_quest_done,questData.done,sizeof(gw_quest_done));
            /* v3 predates unordered progression; ordered quest steps still
             * load unchanged from their original save layout. */
            gw_quest_tracked=questData.tracked;
            gw_quest_ready=1u;
        }
        persistent=player;
        inventory_count=num_items;
        saved_player_is_valid=1;
        saved_position=spawn;
        saved_position_valid=1;
        strncpy(saved_world_id,worlds[world_index].name,sizeof(saved_world_id)-1u);
        saved_world_id[sizeof(saved_world_id)-1u]=0;
    }
    if (world_number) *world_number=world_index;
    return 1;
}
static void gw_save_encode(gw_save_stream_t *stream)
{
    uint32_t world_index=(uint32_t)(active_world-worlds);
    gameworlds_spawn_t spawn={0};
    /* Capture the live tile-player, including owner-maintained main.c that
     * predates the explicit gameworlds_bind_player_physics() API. A world
     * start is NOT a valid substitute for the current checkpoint position. */
    if (!gameworlds_player_start(&spawn)) stream->failed=1;
@IDE_IF{HAS_SHARED_PLAYER}
    const game_tile_player_t *live=bound_player_physics ? bound_player_physics : game_tile_player_current();
    if (live && live->map==gameworlds_map() && live->sprite) {
        spawn.x=live->x100/100;
        spawn.y=live->y100/100;
        spawn.facing=(live->sprite->flags & BLIT_FLAG_FLIP_X) ? 0u : 1u;
    } else {
        /* Reject the save instead of silently claiming the level start is
         * the checkpoint. Do not replace a previously verified TFCard bank. */
        stream->failed=1;
    }
@IDE_END
#define GW_WRITE(v) gw_save_emit(&(v),(uint32_t)sizeof(v),stream)
    GW_WRITE(persistent);
    GW_WRITE(world_index);
    GW_WRITE(spawn);
    GW_WRITE(inventory_count);
    for (uint16_t i=0;i<inventory_count;++i) {
        gw_save_item_t item={0};
        if (strlen(inventory[i].name)>=sizeof(item.name)) { stream->failed=1; return; }
        strcpy(item.name,inventory[i].name);
        item.quantity=inventory[i].amount;
        GW_WRITE(item);
    }
    uint16_t num_stats=0;
@IDE_IF{HAS_SHARED_PLAYER}
    num_stats=gameplayer_custom_stat_count();
@IDE_END
    GW_WRITE(num_stats);
@IDE_IF{HAS_SHARED_PLAYER}
    for (uint16_t i=0;i<num_stats;++i) {
        gw_save_stat_t stat={0};
        const char *name=gameplayer_custom_stat_name(i);
        if (!name || strlen(name)>=sizeof(stat.name) ||
            !gameplayer_stat_get(name,&stat.value)) { stream->failed=1;return; }
        strcpy(stat.name,name);
        GW_WRITE(stat);
    }
@IDE_END
    GW_WRITE(day_night_saved_tick);
    GW_WRITE(day_night_saved_valid);
    GW_WRITE(spotlight_override_valid);
    GW_WRITE(spotlight_override_value);
    for (size_t i=0;i<WORLD_COUNT;++i) {
        gw_save_stream_t measure={0};
        worlds[i].object_disk_export(gw_save_emit,&measure);
        GW_WRITE(measure.offset);
        worlds[i].object_disk_export(gw_save_emit,stream);
        measure.offset=0;
        worlds[i].story_disk_export(gw_save_emit,&measure);
        GW_WRITE(measure.offset);
        worlds[i].story_disk_export(gw_save_emit,stream);
    }
    gw_save_quests_t questData={0};
    questData.marker=0x54534551u;
    questData.schema=gw_quest_schema();
    questData.count=GW_QUEST_COUNT;
    questData.tracked=gw_quest_tracked;
    memcpy(questData.status,gw_quest_status,sizeof(gw_quest_status));
    memcpy(questData.step,gw_quest_step,sizeof(gw_quest_step));
    memcpy(questData.done,gw_quest_done,sizeof(gw_quest_done));
    GW_WRITE(questData);
#undef GW_WRITE
}
void gameworlds_fresh_start_enable(uint8_t enabled)
{ gw_fresh_start_enabled=enabled?1u:0u; }
static void gw_capture_fresh_start(void)
{
    if(!gw_fresh_start_enabled || gw_fresh_capture_tried || !active_world ||
       gw_session_can_reload)return;
    gw_fresh_capture_tried=1u;
    /* Capture only after main.c has bound the real player and game update
     * starts. Save encode rejects fabricated level-start player locations. */
    if(save_player){save_player(&persistent,player_context);saved_player_is_valid=1u;}
    if(active_world->inventory_store)active_world->inventory_store(inventory_put,0);
    if(active_world->world_state_save)active_world->world_state_save();
    if(active_world->story_save)active_world->story_save();
    day_night_save_active();gw_quest_refresh();
    gw_save_stream_t measuring={0};gw_save_encode(&measuring);
    if(measuring.failed || !measuring.offset || measuring.offset>GW_SAVE_LIMIT)return;
    uint8_t *bytes=(uint8_t*)malloc(measuring.offset);
    if(!bytes)return;
    gw_save_stream_t capture={0};capture.bytes=bytes;capture.capacity=measuring.offset;
    gw_save_encode(&capture);
    if(capture.failed || capture.offset!=capture.capacity){free(bytes);return;}
    gw_fresh_bytes=bytes;gw_fresh_length=capture.offset;
}
uint8_t gameworlds_slot_exists(uint8_t slot)
{
    if (slot>=GW_SAVE_SLOT_COUNT) return 0;
    uint8_t *bytes=0; gw_save_header_t header={0};
    if (!gw_save_best(slot,&bytes,&header)) return 0;
    const uint8_t valid=gw_save_decode(bytes,header.length,0,0,header.version);
    free(bytes);
    return valid;
}
uint8_t gameworlds_save_slot(uint8_t slot)
{
    if (slot>=GW_SAVE_SLOT_COUNT || !active_world || applying ||
        gameworlds_transition_busy()) return 0;
    /* Snapshot the active world before any asset/palette destruction. */
    if (save_player) { save_player(&persistent,player_context); saved_player_is_valid=1; }
    if (active_world->inventory_store) active_world->inventory_store(inventory_put,0);
    if (active_world->world_state_save) active_world->world_state_save();
    if (active_world->story_save) active_world->story_save();
    day_night_save_active();
    gw_quest_refresh();
    gw_save_stream_t sizing={0};
    gw_save_encode(&sizing);
    if (sizing.failed || !sizing.offset || sizing.offset>GW_SAVE_LIMIT) return 0;
    gw_save_stream_t stream={0};
    stream.bytes=(uint8_t *)malloc(sizing.offset);
    if (!stream.bytes) return 0;
    stream.capacity=sizing.offset;
    gw_save_encode(&stream);
    if (stream.failed || stream.offset!=stream.capacity) { free(stream.bytes);return 0; }
    gw_save_header_t header={0};
    header.magic=0x56534743u;
    header.version=GW_SAVE_VERSION;
    header.key=GW_SAVE_PROJECT_KEY;
    header.length=stream.offset;
    header.checksum=gw_save_checksum(stream.bytes,stream.offset);
    header.world_layout=gw_save_world_layout();
    header.identity=GW_SAVE_IDENTITY;
    /* Write the *older* bank; never erase the newest verified save.
     * Also reject internally malformed payloads with valid checksums. */
    gw_save_header_t a={0},b={0}; uint8_t *tmp=0;
    uint8_t va=gw_save_read_bank(slot,'A',0,&tmp,&a);
    if (va && !gw_save_decode(tmp,a.length,0,0,a.version)) va=0;
    free(tmp);tmp=0;
    uint8_t vb=gw_save_read_bank(slot,'B',0,&tmp,&b);
    if (vb && !gw_save_decode(tmp,b.length,0,0,b.version)) vb=0;
    free(tmp);
    header.sequence=va && vb ? ((int32_t)(a.sequence-b.sequence)>0 ? a.sequence+1u : b.sequence+1u)
                     : va ? a.sequence+1u : vb ? b.sequence+1u : 1u;
    const char bank=!va ? 'A' : !vb ? 'B' :
        ((int32_t)(a.sequence-b.sequence)>0 ? 'B' : 'A');
    char path[40]; gw_save_filename(path,slot,bank);
    uint8_t ok=0;
    if (sfopen(0,path,SD_WRITE|SD_CREATE_ALWAYS)==FR_OK) {
        uint32_t written=0;
        if (sfwrite(0,&header,(uint32_t)sizeof(header),&written)==FR_OK &&
            written==sizeof(header) &&
            sfwrite(0,stream.bytes,stream.offset,&written)==FR_OK &&
            written==stream.offset) ok=1;
        if (sfclose(0)!=FR_OK) ok=0;
    }
    free(stream.bytes);
    if(ok){
        gw_last_save_slot=slot;gw_session_can_reload=1u;
        free(gw_fresh_bytes);gw_fresh_bytes=0;gw_fresh_length=0u;
    }
    return ok;
}
uint8_t gameworlds_load_slot(uint8_t slot)
{
    if (slot>=GW_SAVE_SLOT_COUNT || active_world || applying) return 0;
    uint8_t *bytes=0; gw_save_header_t header={0};
    if (!gw_save_best(slot,&bytes,&header)) return 0;
    const uint8_t ok=gw_save_decode(bytes,header.length,0,0,header.version) &&
                     gw_save_decode(bytes,header.length,1,0,header.version);
    free(bytes);
    if(ok){gw_last_save_slot=slot;gw_session_can_reload=1u;
        free(gw_fresh_bytes);gw_fresh_bytes=0;gw_fresh_length=0u;}
    return ok;
}
uint8_t gameworlds_session_can_reload(void){return gw_session_can_reload;}
uint32_t gameworlds_reload_revision(void){return gw_reload_revision;}
uint8_t gameworlds_restart_request(void){
    if(!active_world || applying || gw_session_can_reload ||
       !gw_fresh_bytes || !gw_fresh_length)return 0u;
    pending_restart_new_game=1u;return 1u;
}
uint8_t gameworlds_title_request(void)
{
    if(!active_world || applying)return 0u;
@IDE_IF{HAS_TITLE}
    /* The title belongs to EVERY play session, including one loaded from
     * a saved slot. The fresh-start snapshot is only required for the
     * no-save case; saved sessions use an explicit New Game reset below. */
    pending_title_return=1u;
    return 1u;
@IDE_ELSE
    /* Without a title, preserve the existing unsaved restart fallback.
     * A loaded session cannot safely fake a fresh start from its save. */
    return gameworlds_restart_request();
@IDE_END
}
uint8_t gameworlds_last_saved_slot(void){return gw_last_save_slot;}
uint8_t gameworlds_reload_request(uint8_t slot)
{
    /* The Defeat UI enforces the run's save eligibility. Keep this general
     * public API available for authored events and explicit game loads. */
    if(!active_world || applying || slot>=GW_SAVE_SLOT_COUNT ||
       !gameworlds_slot_exists(slot))return 0u;
    pending_reload_slot=(uint8_t)(slot+1u);
    return 1u;
}
const char *gameworlds_saved_world(void)
{ return saved_position_valid ? saved_world_id : 0; }
uint8_t gameworlds_checkpoint_request(uint8_t slot)
{
    if (!active_world || slot>=GW_SAVE_SLOT_COUNT || applying) return 0;
    if (save_checkpoint_pending==slot+1u) return 1;
    save_checkpoint_pending=(uint8_t)(slot+1u);
    return 1;
}
uint8_t gameworlds_save_status(void)
{
    const uint8_t result=save_checkpoint_status;
    save_checkpoint_status=0;
    return result;
}

uint8_t gameworlds_start(const char *name)
{
    /* Accept the title's selected save even in hand-maintained main.c files
     * that call gameworlds_start(DEFAULT_WORLD) without request_at(). If a
     * newer main already decoded the slot, reuse that snapshot once. */
    if (pending_title_load_slot && !active_world && !applying) {
        const uint8_t slot=(uint8_t)(pending_title_load_slot-1u);
        pending_title_load_slot=0;
        if (!saved_position_valid && !gameworlds_load_slot(slot)) return 0;
        name=gameworlds_saved_world();
        if (!name) return 0;
    }
    const gameworlds_record_t *target = find_world(name);
    if (!target || applying) return 0;
    if (target == active_world) return 1;
    if (saved_position_valid && strcmp(target->name,saved_world_id)!=0)
        saved_position_valid=0;
    const uint8_t first_world = active_world == NULL;
    /* An OUT fade must stay black while the world is being exchanged.
     * Restoring the old CLUT here would expose its last visible frame. */
    if (transition_phase != GW_PHASE_OUT_DONE) transition_restore_palette();
    transition_phase = GW_PHASE_IDLE;
    applying = 1;
    pending_world = 0;
    strcpy(active_spawn_id, "default");
    if (active_world && save_player) {
        save_player(&persistent, player_context);
        saved_player_is_valid = 1;
    }
    unload_active();
    const uint8_t success = activate(target);
    /* First start: the game initialises its player normally. On subsequent
     * loads, only restore state that was actually captured from a player. */
    if (success && saved_player_is_valid && restore_player)
        restore_player(&persistent, player_context);
@IDE_IF{HAS_SHARED_PLAYER}
    /* On every successful world entry, including a later return, apply its
     * chosen physics to the already-initialised shared player. The first world
     * is applied when the game calls gameworlds_bind_player_physics(). */
    if (success && bound_player_physics)
        gameplayer_apply_physics(bound_player_physics, target->physics_profile);
        gameplayer_attack_set_facing(target->start_facing);
@IDE_END
    applying = 0;
    if (success && !gw_initial_world) gw_initial_world=target->name;
    if (success) gw_quest_refresh();
    if (success && first_world && transition_enabled) {
        uint8_t in, out, frames;
        uint8_t origin;
        int32_t x, y;
        transition_entry(target, "default", &in, &out, &frames, &origin, &x, &y);
        transition_begin(GW_PHASE_IN, in, frames, origin, x, y);
    }
    return success;
}
uint8_t gameworlds_request_at(const char *name, const char *start_id)
{
    /* The title screen's private marker lets existing user-owned main.c
     * continue calling request_at()+apply_pending() without any source edit.
     * Loading happens AFTER shared player initialisation, never in title. */
    if (name && !active_world && !applying &&
        strlen(name)==11u && strncmp(name,"__CGSAVE",8u)==0 &&
        name[8]>='0' && name[8]<='9' && strcmp(name+9,"__")==0) {
        pending_title_load_slot=(uint8_t)(name[8]-'0'+1);
        return 1;
    }
    const gameworlds_record_t *target = find_world(name);
    if (!name || !*name || !target || applying) return 0;
    if (!start_id || !*start_id) start_id = "default";
    if (strlen(start_id) >= sizeof(pending_spawn_id)) return 0;
    if (strcmp(start_id, "default") != 0) {
        uint8_t found = 0;
        for (uint16_t i = 0; i < target->named_spawn_count; ++i)
            if (strcmp(target->named_spawns[i].id, start_id) == 0) { found = 1; break; }
        if (!found) return 0;
    }
    strcpy(pending_spawn_id, start_id);
    pending_world = target;
    pending_has_exit = 0;
    return 1;
}
uint8_t gameworlds_request_at_from(const char *name, const char *start_id,
                                   int32_t exit_x, int32_t exit_y)
{
    if (!gameworlds_request_at(name, start_id)) return 0;
    pending_exit_x = exit_x;
    pending_exit_y = exit_y;
    pending_has_exit = 1;
    return 1;
}
uint8_t gameworlds_request(const char *name)
{ return gameworlds_request_at(name, "default"); }
/* A title selection is a NEW session, never a continuation of the world
 * that happened to be active before death. Do not restore the "fresh-start"
 * RAM snapshot: it is recorded after gameplay has begun and may represent a
 * different spawn/world than the title menu requests. A saved slot is decoded
 * separately AFTER this reset. */
static void gw_reset_title_session(void)
{
    pending_world=0;
    pending_title_load_slot=0u;
    pending_reload_slot=0u;
    pending_restart_new_game=0u;
    pending_title_return=0u;
    save_checkpoint_pending=0u;
    save_checkpoint_status=0u;
    pending_has_exit=0u;
    pending_exit_x=0;
    pending_exit_y=0;
    strcpy(pending_spawn_id,"default");
    strcpy(active_spawn_id,"default");
    transition_restore_palette();
    transition_phase=GW_PHASE_IDLE;
    transition_mode=GW_TRANSITION_NONE;
    transition_step=0u;
    transition_camera_valid=0u;
    for(size_t i=0;i<WORLD_COUNT;++i){
        if(worlds[i].object_remote_reset)worlds[i].object_remote_reset();
        if(worlds[i].npc_remote_reset)worlds[i].npc_remote_reset();
    }
    memset(day_night_saved_tick,0,sizeof(day_night_saved_tick));
    memset(day_night_saved_valid,0,sizeof(day_night_saved_valid));
    memset(spotlight_override_valid,0,sizeof(spotlight_override_valid));
    memset(spotlight_override_value,0,sizeof(spotlight_override_value));
    gw_quest_reset();
    inventory_count=0u;
    memset(inventory,0,sizeof(inventory));
    memset(&persistent,0,sizeof(persistent));
    saved_player_is_valid=0u;
    saved_position_valid=0u;
    memset(&saved_position,0,sizeof(saved_position));
    saved_world_id[0]=0;
    gw_session_can_reload=0u;
    gw_last_save_slot=255u;
    gw_last_health_hit_note=0;
    gw_initial_world=0;
    gw_restoring_checkpoint=0u;
    gw_fresh_capture_tried=0u;
    free(gw_fresh_bytes);gw_fresh_bytes=0;gw_fresh_length=0u;
@IDE_IF{HAS_PICKUPS}
    gameworlds_hud_reset();
@IDE_END
@IDE_IF{HAS_SHARED_PLAYER}
    persistent.health=gameplayer_defaults.health;
    persistent.lives=gameplayer_defaults.lives;
    persistent.score=gameplayer_defaults.score;
    gameplayer_reset_stats();
    {
        uint16_t count=0u;
        const gameplayer_inventory_entry_t *items=gameplayer_initial_inventory(&count);
        for(uint16_t i=0u;i<count;++i)
            gameworlds_seed_inventory(items[i].name,items[i].initial);
    }
@IDE_END
@IDE_IF{HAS_WORLD_PHYSICS}
    /* Preserve the adapter's pointers to game-owned physics; clear only
     * transient combat and spring state that belongs to the deceased run. */
    if(gw_bound_world_player){
        gw_bound_world_player->hurt_damage_this_frame=0u;
        gw_bound_world_player->hurt_stat_delta=0;
        gw_bound_world_player->hurt_stat_target=0u;
        gw_bound_world_player->hurt_stat_name=0;
        gw_bound_world_player->hurt_death_note=0;
        gw_bound_world_player->hurt_triggered=0u;
        gw_bound_world_player->hurt_anim_active=0u;
        gw_bound_world_player->hurt_flash_active=0u;
        gw_bound_world_player->hurt_flash_colour=0u;
        gw_bound_world_player->hurt_flash_frames=0u;
        gw_bound_world_player->hurt_ticks_remaining=0u;
        gw_bound_world_player->hurt_elapsed=0u;
        gw_bound_world_player->spring_x100=0;
        gw_bound_world_player->spring_remainder_x100=0;
        gw_bound_world_player->spring_sliding=0u;
        gw_bound_world_player->break_stomp_armed=0u;
    }
@IDE_END
}
uint8_t gameworlds_apply_pending(void)
{
    /* Always run the title at a safe frame boundary. The menu returns the
     * authoritative New Game WORLD + NAMED SPAWN or a Load Game slot. */
    if(pending_title_return){
        pending_title_return=0u;
@IDE_IF{HAS_TITLE}
        pending_world=0;pending_has_exit=0;pending_reload_slot=0u;
        pending_restart_new_game=0u;save_checkpoint_pending=0u;
        pending_title_load_slot=0u;
        transition_restore_palette();transition_phase=GW_PHASE_IDLE;
        if(active_world)unload_active();
        gameworlds_ui_full_brightness();
        /* gametitle_run() sets its configured Start Game destination itself.
         * Never substitute last visited world, first registry entry or a
         * previously captured snapshot. */
        const char *title_world=worlds[0].name;
        const char *title_start="default";
        if(!gametitle_run(&title_world,&title_start))return 0u;
        const int8_t selected_slot=gametitle_load_slot();
        gw_reset_title_session();
        if(selected_slot>=0){
            if(!gameworlds_load_slot((uint8_t)selected_slot))return 0u;
            const char *saved=gameworlds_saved_world();
            if(!saved || !gameworlds_start(saved))return 0u;
        }else{
            if(!gameworlds_request_at(title_world,title_start) ||
               !gameworlds_apply_pending())return 0u;
        }
@IDE_IF{HAS_SHARED_PLAYER}
        /* main.c may be user-owned and only notice a change of world NAME.
         * Force the correct restored/spawn position and rearm death physics. */
        game_tile_player_t *live=bound_player_physics ? bound_player_physics :
            (game_tile_player_t*)game_tile_player_current();
        if(live && live->sprite && gameworlds_map()){
            gameworlds_spawn_t arrival={0};
            if(gameworlds_player_start(&arrival)){
                live->map=(const game_tilemap_t*)gameworlds_map();
                live->sprite->drawx=(int16_t)arrival.x;
                live->sprite->drawy=(int16_t)arrival.y;
                live->sprite->flags=(uint8_t)((live->sprite->flags & (uint8_t)~BLIT_FLAG_FLIP_X) |
                    (arrival.facing ? 0u : BLIT_FLAG_FLIP_X));
                game_tile_player_reset(live,(int16_t)arrival.x,(int16_t)arrival.y);
            }
        }
@IDE_END
@IDE_IF{HAS_ADVENTURE_RUNTIME}
        {
            gameworlds_spawn_t arrival={0};
            if(gameworlds_player_start(&arrival))
                game_adventure_set_player_facing(arrival.facing);
        }
@IDE_END
        if(active_world && active_world->assets_show_background)
            gameworlds_show_background();
        ++gw_reload_revision;
        return 1u;
@IDE_ELSE
        return gameworlds_restart_request();
@IDE_END
    }
    /* Recover at the safe world boundary. Never load a save from an
     * Adventure input/draw callback or while world assets are still in use.
     * The slot was validated when the player chose it. */
    if(pending_reload_slot || pending_restart_new_game){
        const uint8_t restart=pending_restart_new_game;
        const uint8_t slot=pending_reload_slot?(uint8_t)(pending_reload_slot-1u):0u;
        pending_reload_slot=0u;pending_restart_new_game=0u;pending_world=0;
        /* Unload captures the *dying* world's story state. Decode the
         * checkpoint AFTER unloading so the old state cannot overwrite it. */
        if(active_world)unload_active();
        saved_position_valid=0u;
        if(restart){
            if(!gw_fresh_bytes || !gw_fresh_length ||
               !gw_save_decode(gw_fresh_bytes,gw_fresh_length,0,0,GW_SAVE_VERSION) ||
               !gw_save_decode(gw_fresh_bytes,gw_fresh_length,1,0,GW_SAVE_VERSION))return 0u;
        } else if(!gameworlds_load_slot(slot))return 0u;
        const char *saved=gameworlds_saved_world();
        if(!saved)return 0u;
        gw_restoring_checkpoint=1u;
        const uint8_t ok=gameworlds_start(saved);
        gw_restoring_checkpoint=0u;
        if(!ok)return 0u;
@IDE_IF{HAS_WORLD_PHYSICS}
        /* A Defeat-screen FIRE1 save reload is a new life too. Do not
         * carry an old damage grace period, Hurt animation or flash into
         * the restored player (even when the saved world has the same name). */
        if(gw_bound_world_player){
            gw_bound_world_player->hurt_damage_this_frame=0u;
            gw_bound_world_player->hurt_stat_delta=0;
            gw_bound_world_player->hurt_stat_target=0u;
            gw_bound_world_player->hurt_stat_name=0;
            gw_bound_world_player->hurt_death_note=0;
            gw_bound_world_player->hurt_triggered=0u;
            gw_bound_world_player->hurt_anim_active=0u;
            gw_bound_world_player->hurt_flash_active=0u;
            gw_bound_world_player->hurt_flash_colour=0u;
            gw_bound_world_player->hurt_flash_frames=0u;
            gw_bound_world_player->hurt_ticks_remaining=0u;
            gw_bound_world_player->hurt_elapsed=0u;
            gw_bound_world_player->spring_x100=0;
            gw_bound_world_player->spring_remainder_x100=0;
            gw_bound_world_player->spring_sliding=0u;
            gw_bound_world_player->break_stomp_armed=0u;
        }
@IDE_END
@IDE_IF{HAS_SHARED_PLAYER}
        /* Owner-maintained main.c may only rebind physics when the world NAME
         * changes. Same-world death reloads still need their saved position.
         * Rebind the live sprite/map here at the safe frame boundary. */
        game_tile_player_t *live=bound_player_physics ? bound_player_physics :
            (game_tile_player_t*)game_tile_player_current();
        if(live && live->sprite && gameworlds_map()){
            live->map=(const game_tilemap_t*)gameworlds_map();
            live->sprite->drawx=(int16_t)saved_position.x;
            live->sprite->drawy=(int16_t)saved_position.y;
            live->sprite->flags=(uint8_t)((live->sprite->flags & (uint8_t)~BLIT_FLAG_FLIP_X) |
                       (saved_position.facing?0u:BLIT_FLAG_FLIP_X));
            game_tile_player_reset(live,(int16_t)saved_position.x,(int16_t)saved_position.y);
        }
@IDE_END
@IDE_IF{HAS_ADVENTURE_RUNTIME}
        game_adventure_set_player_facing(saved_position.facing);
@IDE_END
        ++gw_reload_revision;
        return 1u;
    }
    if (pending_title_load_slot) {
        const uint8_t slot=(uint8_t)(pending_title_load_slot-1u);
        pending_title_load_slot=0u;
        if (!gameworlds_load_slot(slot)) return 0;
        return gameworlds_start(gameworlds_saved_world());
    }
    if (save_checkpoint_pending) {
        const uint8_t slot=(uint8_t)(save_checkpoint_pending-1u);
        save_checkpoint_pending=0;
        save_checkpoint_status=gameworlds_save_slot(slot) ? 1u : 2u;
        if(save_checkpoint_status==1u && active_world && active_world->checkpoint_saved)
            active_world->checkpoint_saved();
    }
    if (!pending_world) return 1;
    if (transition_enabled &&
        (transition_phase == GW_PHASE_OUT || transition_phase == GW_PHASE_IN))
        return 1; /* Keep drawing until current effect completes. */
    /* OUT and IN belong to the DESTINATION start selected by this door,
     * not the start through which the player previously entered this world. */
    const gameworlds_record_t *target = pending_world;
    uint8_t in, out, frames, circle_origin;
    int32_t arrival_x, arrival_y;
    transition_entry(target, pending_spawn_id, &in, &out, &frames,
                     &circle_origin, &arrival_x, &arrival_y);
    if (transition_enabled && transition_phase != GW_PHASE_OUT_DONE && active_world) {
        if (out != GW_TRANSITION_NONE) {
            int32_t exit_x = pending_exit_x, exit_y = pending_exit_y;
            if (!pending_has_exit) {
                /* Programmatic world requests still have a useful origin. */
                exit_x = active_world->start_x;
                exit_y = active_world->start_y;
                for (uint16_t i = 0; i < active_world->named_spawn_count; ++i) {
                    const gameworlds_named_spawn_t *start = &active_world->named_spawns[i];
                    if (strcmp(start->id, active_spawn_id) == 0) {
                        exit_x = start->x;
                        exit_y = start->y;
                        break;
                    }
                }
            }
            transition_begin(GW_PHASE_OUT, out, frames, circle_origin, exit_x, exit_y);
            return 1;
        }
    }
    pending_world = 0;
    char requested[sizeof(pending_spawn_id)];
    strcpy(requested, pending_spawn_id);
    strcpy(pending_spawn_id, "default");
    pending_has_exit = 0;
    const uint8_t ok = gameworlds_start(target->name);
    if (ok) {
        strcpy(active_spawn_id, requested);
        if (transition_enabled)
            transition_begin(GW_PHASE_IN, in, frames, circle_origin, arrival_x, arrival_y);
    }
    return ok;
}
void gameworlds_shutdown(void)
{
@IDE_IF{HAS_PICKUPS}
    gameworlds_hud_reset();
@IDE_END
    if (active_world && save_player) {
        save_player(&persistent, player_context);
        saved_player_is_valid = 1;
    }
    transition_restore_palette();
    transition_phase = GW_PHASE_IDLE;
    transition_enabled = 0;
    unload_active();
    for (size_t i=0; i<WORLD_COUNT; ++i) {
        if (worlds[i].object_remote_reset) worlds[i].object_remote_reset();
        if (worlds[i].npc_remote_reset) worlds[i].npc_remote_reset();
    }
    memset(spotlight_override_valid,0,sizeof(spotlight_override_valid));
    memset(spotlight_override_value,0,sizeof(spotlight_override_value));
    memset(day_night_saved_tick,0,sizeof(day_night_saved_tick));
    memset(day_night_saved_valid,0,sizeof(day_night_saved_valid));
    pending_world = 0;
    pending_has_exit = 0;
    gw_quest_reset();
    saved_position_valid=0;
    save_checkpoint_pending=0;
    pending_title_load_slot=0;
    pending_reload_slot=0;
    pending_restart_new_game=0u;pending_title_return=0u;gw_last_health_hit_note=0;gw_session_can_reload=0u;
    gw_initial_world=0;
    gw_last_save_slot=255u;
    free(gw_fresh_bytes);gw_fresh_bytes=0;gw_fresh_length=0u;
    gw_fresh_capture_tried=0u;gw_fresh_start_enabled=0u;gw_reload_revision=0u;
    strcpy(active_spawn_id, "default");
    strcpy(pending_spawn_id, "default");
@IDE_IF{HAS_SHARED_PLAYER}
    bound_player_physics = 0;
@IDE_END
@IDE_IF{HAS_WORLD_PHYSICS}
    gw_bound_world_player=0;
@IDE_END
}
/* Three independent clocks for paused conversations. Old generated worlds
 * have NULL split-update pointers; gameplay falls back to their legacy update
 * while the particles-only call becomes a no-op until they are regenerated. */
void gameworlds_update_gameplay(uint16_t frames)
{
    if (!active_world) return;
    gw_capture_fresh_start();
    if (active_world->objects_update_gameplay)
        active_world->objects_update_gameplay(frames);
    else if (active_world->objects_update)
        active_world->objects_update(frames);
    gw_quest_refresh();
}
void gameworlds_update_particles(uint16_t frames)
{
    if (active_world && active_world->objects_update_particles)
        active_world->objects_update_particles(frames);
}
void gameworlds_update_weather(uint16_t frames)
{
    if (active_world) weather_update(frames);
}
/* Short names for authored main.c, matching game_update_weather(1) etc. */
void game_update_gameplay(uint16_t frames) { gameworlds_update_gameplay(frames); }
void game_update_particles(uint16_t frames) { gameworlds_update_particles(frames); }
void game_update_weather(uint16_t frames) { gameworlds_update_weather(frames); }
/* Backwards compatibility: exactly one update each for gameplay, ambient
 * particles and weather when older code calls gameworlds_update(1). */
void gameworlds_update(uint16_t frames)
{
    if (!active_world) return;
    gw_capture_fresh_start();
    if (active_world->objects_update) active_world->objects_update(frames);
    gw_quest_refresh();
    weather_update(frames);
}
void gameworlds_draw(int32_t x, int32_t y)
{ if (active_world) active_world->objects_draw(x,y); }
void gameworlds_draw_behind(int32_t x, int32_t y)
{ if (active_world && active_world->objects_draw_behind) active_world->objects_draw_behind(x,y); }
void gameworlds_draw_overlay(int32_t x, int32_t y)
{ if (active_world && active_world->objects_draw_overlay) active_world->objects_draw_overlay(x,y); }
@IDE_IF{HAS_WORLD_PHYSICS}
void gameworlds_before(game_world_player_t *p)
{
    if(p)gw_bound_world_player=p;
    /* A nonfatal hit has no right to decorate a later, unrelated death. */
    if(persistent.health>0u)gw_last_health_hit_note=0;
    if (active_world && active_world->before) active_world->before(p);
}
void gameworlds_after(game_world_player_t *p)
{
    if(p)gw_bound_world_player=p;
@IDE_IF{HAS_SHARED_PLAYER}
    /* Player melee precedes normal object event dispatch, so ON DEFEAT,
     * loot and quest links fire in the SAME frame without extra integration
     * in user-owned main.c. Call only while the gameplay loop runs. */
    if(p && p->x100 && p->y100 && p->width && p->height &&
       bound_player_physics && active_world &&
       gameplayer_attack_step(getjoyport())) {
        const int32_t x = *p->x100/100 + p->offset_x;
        const int32_t y = *p->y100/100 + p->offset_y;
        const int32_t reach = gameplayer_attack_reach();
        const int32_t attack_x = gameplayer_attack_facing_right()
            ? x + p->width : x - reach;
        uint8_t hits = 0u;
        if(active_world->player_attack)
            hits = active_world->player_attack(attack_x, y,
                (uint16_t)reach, p->height, gameplayer_attack_damage());
        gameplayer_attack_register_hits(hits);
    }
@IDE_END
    if (active_world && active_world->after) active_world->after(p);
    if(p && p->hurt_triggered && p->hurt_stat_target==0u &&
       p->hurt_stat_delta<0)gw_last_health_hit_note=p->hurt_death_note;
}
@IDE_END
@IDE_IF{HAS_PICKUPS}
/* HUD-only pickups retain their lifetime "number collected" counter.
 * Inventory-linked HUD pickups display the CURRENT backpack quantity, which
 * changes on USE, DROP, DESTROY, NPC hand-in, and game-specific removals.
 * Pickup Value stays separate (score, gold, reward value, etc.). */
static uint32_t gameworlds_hud_totals[256];
@IDE_IF{HAS_ADVENTURE_RUNTIME}
static uint8_t gameworlds_hud_inventory_kinds[256];
/* Strong implementation of the Adventure runtime's optional HUD hook.
 * No per-frame refresh is required: inventory kinds are registered at
 * Adventure start and when items are awarded by dialogue or scripts. */
void game_adventure_inventory_kind_changed(uint16_t pickup_kind)
{
    if (pickup_kind > 0u && pickup_kind < 256u)
        gameworlds_hud_inventory_kinds[pickup_kind] = 1u;
}
@IDE_END
uint32_t gameworlds_hud_total(uint16_t kind)
{
    if (kind >= 256u) return 0u;
@IDE_IF{HAS_ADVENTURE_RUNTIME}
    if (gameworlds_hud_inventory_kinds[kind]) {
        uint32_t owned = 0u;
        if (game_adventure_pickup_quantity(kind, &owned)) return owned;
    }
@IDE_END
    return gameworlds_hud_totals[kind];
}
void gameworlds_adjust_pickup(uint16_t kind, int32_t delta)
{
    if(kind>=256u || !delta)return;
@IDE_IF{HAS_ADVENTURE_RUNTIME}
    if(game_adventure_adjust_pickup(kind,delta)) {
        gameworlds_hud_inventory_kinds[kind]=1u;
        return;
    }
@IDE_END
    const int64_t next=(int64_t)gameworlds_hud_totals[kind]+delta;
    gameworlds_hud_totals[kind]=next<=0 ? 0u :
        next>=UINT32_MAX ? UINT32_MAX : (uint32_t)next;
}
void gameworlds_hud_reset(void)
{
    memset(gameworlds_hud_totals,0,sizeof(gameworlds_hud_totals));
@IDE_IF{HAS_ADVENTURE_RUNTIME}
    memset(gameworlds_hud_inventory_kinds,0,sizeof(gameworlds_hud_inventory_kinds));
@IDE_END
}
typedef struct { game_pickup_callback_t cb; void *user; } gameworlds_pickup_context_t;
static void gameworlds_pickup_bridge(game_collectable_t *item, void *context)
{
    gameworlds_pickup_context_t *ctx = (gameworlds_pickup_context_t *)context;
    if (!item) return;
    if (item->tracking_configured && item->show_in_hud && item->kind < 256u) {
        uint32_t *count = &gameworlds_hud_totals[item->kind];
        *count = (*count == UINT32_MAX ? UINT32_MAX : *count + 1u);
    }
@IDE_IF{HAS_ADVENTURE_RUNTIME}
    if (item->tracking_configured) {
        if (item->show_in_inventory) {
            /* Link HUD to inventory only if this world has a matching item.
             * HUD-only pickups continue to use the independent count. */
            if (game_adventure_collect_amount(item->kind, 1u) &&
                item->show_in_hud && item->kind < 256u)
                gameworlds_hud_inventory_kinds[item->kind] = 1u;
        }
        game_adventure_managed_pickup_begin(item->kind);
    }
@IDE_END
    if (item->stat_target && !item->show_in_inventory) {
        uint32_t *target = 0;
        if (item->stat_target == 1u) target = &persistent.health;
        else if (item->stat_target == 2u) target = &persistent.lives;
        else if (item->stat_target == 3u) target = &persistent.score;
        if (target) {
            const uint64_t total = (uint64_t)*target + item->value;
            *target = total > UINT32_MAX ? UINT32_MAX : (uint32_t)total;
        }
@IDE_IF{HAS_SHARED_PLAYER}
        else if (item->stat_target == 4u && item->stat_name) {
            int32_t current = 0;
            if (gameplayer_stat_get(item->stat_name, &current)) {
                int64_t total = (int64_t)current + item->value;
                if (total > INT32_MAX) total = INT32_MAX;
                gameplayer_stat_set(item->stat_name, (int32_t)total);
            }
        }
@IDE_END
    }
    if (ctx && ctx->cb) ctx->cb(item, ctx->user);
@IDE_IF{HAS_ADVENTURE_RUNTIME}
    if (item->tracking_configured) game_adventure_managed_pickup_end();
@IDE_END
}
uint16_t gameworlds_check(int32_t x, int32_t y, uint16_t w, uint16_t h,
                          game_pickup_callback_t cb, void *user)
{
    if (!active_world || !active_world->check) return 0;
    gameworlds_pickup_context_t context = {cb,user};
    return active_world->check(x,y,w,h,gameworlds_pickup_bridge,&context);
}
@IDE_END
void gameworlds_draw_foreground(void)
{ if (active_world) active_world->assets_foreground(); }
void gameworlds_draw_background(void)
{ if (active_world) active_world->assets_background(); }
void gameworlds_show_background(void)
{
    if (!active_world) return;
    active_world->assets_show_background();
    /* Some display back-buffer bindings can select their own palette.
     * Put the current destination WORLD's tint back before the first frame. */
    weather_palette_frame();
}
