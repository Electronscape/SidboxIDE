/* GamerGirl Stage 5.2 -- one world controller, even for a single-world game.
 * All worlds are linked, but only the active world's large assets are loaded.
 * Never call start/apply_pending from a world-object callback or during draw.
 */
#include "gameworlds.h"
#include <stddef.h>
#include <stdlib.h>
#include <string.h>
#include <stdio.h>
#include "apis.h"
@IDE_IF{HAS_MAP}
#include "gametilemap.h"
@IDE_END
@IDE_IF{HAS_TITLE}
#include "gametitle.h"
@IDE_END
@IDE_IF{HAS_WORLD_PHYSICS}
#include "gameworldobjects.h"
@IDE_END
@IDE_IF{HAS_PICKUPS}
#include "gamecollectables.h"
@IDE_END
@IDE_IF{HAS_ADVENTURE_RUNTIME}
#include "gameadventureruntime.h"
@IDE_END
@IDE_IF{HAS_PLAYER_VISIBILITY}
#include "gameplayer.h"
@IDE_END
@IDE_IF{HAS_SHARED_PLAYER}
#include "gameplayer.h"
@IDE_END
typedef struct {
    const char *id;
    int32_t x, y;
    uint8_t facing;
    uint8_t transition_in;
    uint8_t transition_out;
    uint8_t transition_frames;
    uint8_t circle_origin; /* 0 screen centre; 1 transition location */
} gameworlds_named_spawn_t;

typedef struct { uint16_t slot; uint8_t npc, action; } gw_time_action_t;
@IDE{WORLD_DECLARATIONS}

typedef struct {
    const char *name;
    int (*assets_init)(void);
    void (*assets_shutdown)(void);
    uint8_t (*objects_init)(void);
    void (*objects_update)(uint16_t); /* Legacy: gameplay + particles. */
    void (*objects_update_gameplay)(uint16_t);
    void (*objects_update_particles)(uint16_t);
    void (*objects_draw)(int32_t, int32_t);
    void (*objects_draw_behind)(int32_t, int32_t);
    void (*objects_draw_overlay)(int32_t, int32_t);
    void (*assets_foreground)(void);
    void (*assets_background)(void);
    void (*assets_show_background)(void);
    void (*adventure_setup)(void);
    void (*inventory_store)(gameworlds_inventory_put_t, void *);
    void (*inventory_load)(gameworlds_inventory_get_t, void *);
    void *map;
    uint8_t (*load_map)(const char *);
    void (*unload_map)(void);
    uint8_t (*load_atlas)(void);
    void (*unload_atlas)(void);
    const char *map_path;
@IDE_IF{HAS_WORLD_PHYSICS}
    void (*before)(game_world_player_t *);
    void (*after)(game_world_player_t *);
@IDE_END
@IDE_IF{HAS_PICKUPS}
    uint16_t (*check)(int32_t, int32_t, uint16_t, uint16_t, game_pickup_callback_t, void *);
@IDE_END
    int32_t start_x, start_y;
    uint8_t start_facing;
    uint8_t physics_profile;
    const gameworlds_named_spawn_t *named_spawns;
    uint16_t named_spawn_count;
    uint8_t transition_in, transition_out, transition_frames, circle_origin;
    uint8_t spotlight_enabled;
    uint16_t spotlight_radius, spotlight_feather;
    uint8_t spotlight_center;
    int16_t spotlight_offset_x, spotlight_offset_y;
    uint8_t spotlight_mask_index;
    uint32_t spotlight_mask_colour;
    uint8_t spotlight_flip_x, spotlight_flip_y, spotlight_opacity_code;
    uint8_t spotlight_stable_dither, spotlight_anim_mode;
    uint8_t spotlight_anim_min, spotlight_anim_max;
    uint16_t spotlight_random_min_frames, spotlight_random_max_frames, spotlight_pulse_delay;
    const uint32_t *(*front_palette)(void);
    const uint32_t *(*back_palette)(void);
    void (*world_state_save)(void);
    void (*world_state_restore)(void);
    void (*story_save)(void);
    void (*story_restore)(void);
    void (*object_set_active)(uint16_t, uint8_t);
    void (*object_remote_action)(uint16_t, uint8_t);
    void (*object_remote_reset)(void);
    void (*object_apply_remote)(void);
    void (*npc_set_active)(uint16_t, uint8_t);
    void (*npc_remote_action)(uint16_t, uint8_t);
    void (*npc_remote_reset)(void);
    uint8_t weather_mode, weather_density;
    int8_t weather_wind;
    uint8_t weather_colour_index;
    uint16_t weather_lightning_interval;
    uint8_t weather_lightning_strength;
    uint8_t weather_palette_flash_strength; /* 0=disabled, 100=full scene palette brightening. */
    uint8_t weather_suspend_spotlight; /* Opt in: lightning temporarily reveals the scene. */
    uint8_t weather_lightning_overlay; /* 1 = patterned scene flash; palette can be independent. */
    uint8_t day_night_mode; /* 0=off, 1=fixed tint, 2=cycle. */
    uint32_t day_night_colour; /* 0xRRGGBB, never changes the .pal asset. */
    uint8_t day_night_strength;
    uint16_t day_night_day_frames, day_night_night_frames, day_night_fade_frames;
    uint8_t day_night_start_at_night;
    uint8_t weather_curve_code; /* 0=default 25%; 1..101 encodes 0..100% lightning duration. */
    void (*object_disk_export)(void (*)(const void *, uint32_t, void *), void *);
    uint8_t (*object_disk_import)(uint8_t (*)(void *, uint32_t, void *), void *);
    void (*story_disk_export)(void (*)(const void *, uint32_t, void *), void *);
    uint8_t (*story_disk_import)(uint8_t (*)(void *, uint32_t, void *), void *);
    const gw_time_action_t *day_actions, *night_actions;
    uint16_t day_action_count, night_action_count;
    void (*logic_sync)(void); /* After object restore and lighting setup, before frame one. */
    uint8_t weather_particle_size; /* 2..32; appended to preserve existing world row order. */
    uint16_t weather_particle_tile; /* Legacy 1-based map atlas ID; 0=filled circle. */
    const uint8_t *weather_particle_pixels; /* One chosen resource tile in FLASH, no PPB allocation. */
    uint8_t weather_particle_source_size;
    void (*checkpoint_saved)(void); /* Called only after a successful disk save. */
    void (*quest_completed)(const char *quest_id); /* Current-world ON COMPLETED event. */
    uint8_t (*player_attack)(int32_t, int32_t, uint16_t, uint16_t, uint8_t);
} gameworlds_record_t;

static const gameworlds_record_t worlds[] = {
@IDE{WORLD_RECORDS}
};
#define WORLD_COUNT (sizeof(worlds) / sizeof(worlds[0]))
#define GAMEWORLDS_MAX_INVENTORY 64u
