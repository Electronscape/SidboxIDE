static uint8_t save_checkpoint_pending; /* slot+1, processed at frame boundary */
static uint8_t pending_reload_slot; /* Slot+1 for deferred in-game defeat recovery. */
static uint8_t pending_restart_new_game;
static uint8_t pending_title_return;
