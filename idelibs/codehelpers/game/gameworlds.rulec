/* GamerGirl Stage 5.2 -- one world controller, even for a single-world game.
 * All worlds are linked, but only the active world's large assets are loaded.
 * Never call start/apply_pending from a world-object callback or during draw.
 */
#include "gameworlds.h"
#include <stddef.h>
#include <string.h>
#include "apis.h"
@IDE_IF{HAS_WORLD_PHYSICS}
#include "gameworldobjects.h"
@IDE_END
@IDE_IF{HAS_PICKUPS}
#include "gamecollectables.h"
@IDE_END
@IDE_IF{HAS_ADVENTURE_RUNTIME}
#include "gameadventureruntime.h"
@IDE_END
@IDE_IF{HAS_PLAYER_VISIBILITY}
#include "gameplayer.h"
@IDE_END
@IDE_IF{HAS_SHARED_PLAYER}
#include "gameplayer.h"
@IDE_END
typedef struct {
    const char *id;
    int32_t x, y;
    uint8_t facing;
    uint8_t transition_in;
    uint8_t transition_out;
    uint8_t transition_frames;
    uint8_t circle_origin; /* 0 screen centre; 1 transition location */
} gameworlds_named_spawn_t;

@IDE{WORLD_DECLARATIONS}

typedef struct {
    const char *name;
    int (*assets_init)(void);
    void (*assets_shutdown)(void);
    uint8_t (*objects_init)(void);
    void (*objects_update)(uint16_t);
    void (*objects_draw)(int32_t, int32_t);
    void (*objects_draw_behind)(int32_t, int32_t);
    void (*assets_foreground)(void);
    void (*assets_background)(void);
    void (*assets_show_background)(void);
    void (*adventure_setup)(void);
    void (*inventory_store)(gameworlds_inventory_put_t, void *);
    void (*inventory_load)(gameworlds_inventory_get_t, void *);
    void *map;
    uint8_t (*load_map)(const char *);
    void (*unload_map)(void);
    uint8_t (*load_atlas)(void);
    void (*unload_atlas)(void);
    const char *map_path;
@IDE_IF{HAS_WORLD_PHYSICS}
    void (*before)(game_world_player_t *);
    void (*after)(game_world_player_t *);
@IDE_END
@IDE_IF{HAS_PICKUPS}
    uint16_t (*check)(int32_t, int32_t, uint16_t, uint16_t, game_pickup_callback_t, void *);
@IDE_END
    int32_t start_x, start_y;
    uint8_t start_facing;
    uint8_t physics_profile;
    const gameworlds_named_spawn_t *named_spawns;
    uint16_t named_spawn_count;
    uint8_t transition_in, transition_out, transition_frames, circle_origin;
    const uint32_t *(*front_palette)(void);
    const uint32_t *(*back_palette)(void);
    void (*world_state_save)(void);
    void (*world_state_restore)(void);
    void (*story_save)(void);
    void (*story_restore)(void);
} gameworlds_record_t;

static const gameworlds_record_t worlds[] = {
@IDE{WORLD_RECORDS}
};
#define WORLD_COUNT (sizeof(worlds) / sizeof(worlds[0]))
#define GAMEWORLDS_MAX_INVENTORY 64u
/* Identity is the item NAME, not its per-world index. Different worlds can
 * arrange their Adventure item lists differently and still share inventory.
 * Hash collisions (FNV-1a) are handled by a second string check using the
 * original game's static item-name pointer; world code is never unloaded. */
typedef struct { const char *name; uint16_t amount; } inventory_entry_t;
static inventory_entry_t inventory[GAMEWORLDS_MAX_INVENTORY];
static uint16_t inventory_count;
static gameworlds_player_state_t persistent;
static gameworlds_player_hook_t save_player, restore_player;
static void *player_context;
static const gameworlds_record_t *active_world;
static const gameworlds_record_t *pending_world;
static uint8_t applying;
static char pending_spawn_id[64] = "default";
static char active_spawn_id[64] = "default";
static int32_t pending_exit_x, pending_exit_y;
static uint8_t pending_has_exit;
static uint8_t saved_player_is_valid; /* Never restore zeroed state on first start. */
/* Three-phase, frame-synchronised transitions. All buffers remain owned by
 * the existing graphics system. Only 2 x 256 temporary CLUT words are used. */
#define GW_TRANSITION_NONE   0u
#define GW_TRANSITION_FADE   1u
#define GW_TRANSITION_LEFT   2u
#define GW_TRANSITION_RIGHT  3u
#define GW_TRANSITION_UP     4u
#define GW_TRANSITION_DOWN   5u
#define GW_TRANSITION_CIRCLE 6u
#define GW_PHASE_IDLE       0u
#define GW_PHASE_OUT        1u
#define GW_PHASE_OUT_DONE   2u
#define GW_PHASE_IN         3u
static uint8_t transition_phase;
static uint8_t transition_enabled;
static uint8_t transition_mode, transition_frames, transition_step;
static uint8_t transition_circle_origin, transition_camera_valid;
static int32_t transition_world_x, transition_world_y;
static int32_t transition_camera_x, transition_camera_y;
static uint32_t transition_front[256] __attribute__((aligned(32)));
static uint32_t transition_back[256] __attribute__((aligned(32)));

/* Both effects on a Goto World doorway are configured on its selected
 * DESTINATION Player Start: OUT on the departing scene, IN on arrival.
 * This must not use active_spawn_id, which remembers an earlier arrival. */
static void transition_entry(const gameworlds_record_t *world, const char *id,
                             uint8_t *in, uint8_t *out, uint8_t *frames,
                             uint8_t *circle_origin, int32_t *x, int32_t *y)
{
    *in = world->transition_in;
    *out = world->transition_out;
    *frames = world->transition_frames ? world->transition_frames : 30u;
    *circle_origin = world->circle_origin;
    *x = world->start_x;
    *y = world->start_y;
    if (id && strcmp(id, "default") != 0) {
        for (uint16_t i = 0; i < world->named_spawn_count; ++i) {
            const gameworlds_named_spawn_t *start = &world->named_spawns[i];
            if (strcmp(start->id, id) != 0) continue;
            *in = start->transition_in;
            *out = start->transition_out;
            *frames = start->transition_frames ? start->transition_frames : 30u;
            *circle_origin = start->circle_origin;
            *x = start->x;
            *y = start->y;
            break;
        }
    }
    if (*in > GW_TRANSITION_CIRCLE) *in = GW_TRANSITION_NONE;
    if (*out > GW_TRANSITION_CIRCLE) *out = GW_TRANSITION_NONE;
    *circle_origin = (*circle_origin != 0u) ? 1u : 0u;
}
static void transition_begin(uint8_t phase, uint8_t mode, uint8_t frames,
                             uint8_t circle_origin, int32_t origin_x, int32_t origin_y)
{
    transition_phase = mode == GW_TRANSITION_NONE ? GW_PHASE_IDLE : phase;
    transition_mode = mode;
    transition_frames = frames ? frames : 30u;
    transition_step = 0;
    transition_circle_origin = circle_origin;
    transition_world_x = origin_x;
    transition_world_y = origin_y;
    transition_camera_valid = 0;
}
static void transition_restore_palette(void)
{
    if (!active_world) return;
    const uint32_t *front = active_world->front_palette ? active_world->front_palette() : NULL;
    const uint32_t *back = active_world->back_palette ? active_world->back_palette() : NULL;
    (void)front; (void)back; /* Minimal host-test API may omit gfx macros. */
#ifdef gfx_usefpalette
    if (front) gfx_usefpalette((uint32_t *)front);
#endif
#ifdef gfx_usebpalette
    if (back) gfx_usebpalette((uint32_t *)back);
#endif
}
static uint32_t transition_dim(uint32_t source, uint16_t brightness)
{
    /* CLUT layout AARRGGBB; keep alpha intact (index 0 stays transparent). */
    uint32_t r = ((source >> 16) & 255u) * brightness / 255u;
    uint32_t g = ((source >> 8) & 255u) * brightness / 255u;
    uint32_t b = (source & 255u) * brightness / 255u;
    return (source & 0xff000000u) | (r << 16) | (g << 8) | b;
}
#if defined(gfx_rectf) && defined(gfx_setcolour)
static uint32_t transition_isqrt(uint32_t number)
{
    /* Integer square root: circle wipe needs no floating point/libm. */
    uint32_t root = 0, bit = 1u << 30;
    while (bit > number) bit >>= 2;
    while (bit) {
        if (number >= root + bit) {
            number -= root + bit;
            root = (root >> 1) + bit;
        } else root >>= 1;
        bit >>= 2;
    }
    return root;
}
#endif
void gameworlds_transitions_enable(uint8_t enabled)
{
    if (!enabled) {
        transition_restore_palette();
        transition_phase = GW_PHASE_IDLE;
        transition_enabled = 0;
        return;
    }
    if (transition_enabled) return;
    transition_enabled = 1;
    /* The first gameworlds_start() runs before the front buffers exist.
     * Start its entrance effect only once main.c has finished setup. */
    if (active_world) {
        uint8_t in, out, frames, origin;
        int32_t x, y;
        transition_entry(active_world, active_spawn_id, &in, &out, &frames, &origin, &x, &y);
        transition_begin(GW_PHASE_IN, in, frames, origin, x, y);
    }
}
uint8_t gameworlds_transition_busy(void)
{ return transition_enabled && transition_phase != GW_PHASE_IDLE; }

void gameworlds_transition_camera(int32_t camera_x, int32_t camera_y)
{
    transition_camera_x = camera_x;
    transition_camera_y = camera_y;
    transition_camera_valid = 1;
}

void gameworlds_transition_frame(uint16_t width, uint16_t height)
{
    if (!transition_enabled || !active_world || transition_phase == GW_PHASE_IDLE ||
        transition_phase == GW_PHASE_OUT_DONE || !width || !height) return;
    const uint32_t *front = active_world->front_palette ? active_world->front_palette() : NULL;
    const uint32_t *back = active_world->back_palette ? active_world->back_palette() : NULL;
    const uint32_t progress = ((uint32_t)(transition_step + 1u) * 255u) / transition_frames;
    const uint32_t coverage = transition_phase == GW_PHASE_OUT ? progress : 255u - progress;
    if (transition_mode == GW_TRANSITION_FADE) {
        const uint16_t light = (uint16_t)(255u - coverage);
        if (front) {
            for (uint16_t i = 0; i < 256; ++i)
                transition_front[i] = transition_dim(front[i], light);
#ifdef gfx_usefpalette
            gfx_usefpalette(transition_front);
#endif
        }
        if (back) {
            for (uint16_t i = 0; i < 256; ++i)
                transition_back[i] = transition_dim(back[i], light);
#ifdef gfx_usebpalette
            gfx_usebpalette(transition_back);
#endif
        }
    } else {
        /* Index 255 is a TEMPORARY blackout drawing colour; the original
         * palette is restored when the effect finishes. Background pixels
         * are not changed. This index may briefly look black in scenery. */
        if (front) {
            memcpy(transition_front, front, sizeof(transition_front));
            transition_front[255] = 0xff000000u;
#ifdef gfx_usefpalette
            gfx_usefpalette(transition_front);
#endif
        }
#if defined(gfx_rectf) && defined(gfx_setcolour)
        if (transition_mode == GW_TRANSITION_CIRCLE) {
            /* Black outside a shrinking (OUT) or expanding (IN) disk. */
            int32_t cx = (int32_t)width / 2, cy = (int32_t)height / 2;
            if (transition_circle_origin && transition_camera_valid) {
                cx = transition_world_x - transition_camera_x;
                cy = transition_world_y - transition_camera_y;
                /* Offscreen doorway/start: pin the centre to the nearest
                 * screen edge, rather than overflowing radius arithmetic. */
                if (cx < 0) cx = 0;
                if (cy < 0) cy = 0;
                if (cx > width) cx = width;
                if (cy > height) cy = height;
            }
            const int32_t far_x = cx > (int32_t)width - cx ? cx : (int32_t)width - cx;
            const int32_t far_y = cy > (int32_t)height - cy ? cy : (int32_t)height - cy;
            const uint32_t maxr = transition_isqrt((uint32_t)(far_x * far_x + far_y * far_y)) + 2u;
            const int32_t radius = (int32_t)((maxr * (255u - coverage)) / 255u);
            const int32_t rr = radius * radius;
            gfx_setcolour(255);
            for (int32_t y = 0; y < height; ++y) {
                const int32_t dy = y - cy;
                if (dy * dy >= rr) {
                    gfx_rectf(0, y, width, 1);
                } else {
                    const int32_t half = (int32_t)transition_isqrt((uint32_t)(rr - dy * dy));
                    int32_t left = cx - half;
                    int32_t right = cx + half + 1;
                    if (left > 0) gfx_rectf(0, y, left, 1);
                    if (right < width) gfx_rectf(right, y, width - right, 1);
                }
            }
        } else {
            const int32_t w = (int32_t)((width * coverage + 254u) / 255u);
            const int32_t h = (int32_t)((height * coverage + 254u) / 255u);
            gfx_setcolour(255);
            switch (transition_mode) {
            case GW_TRANSITION_LEFT:  if (w) gfx_rectf(width - w, 0, w, height); break;
            case GW_TRANSITION_RIGHT: if (w) gfx_rectf(0, 0, w, height); break;
            case GW_TRANSITION_UP:    if (h) gfx_rectf(0, height - h, width, h); break;
            case GW_TRANSITION_DOWN:  if (h) gfx_rectf(0, 0, width, h); break;
            }
        }
#endif /* gfx_rectf and gfx_setcolour */
    }
    ++transition_step;
    if (transition_step >= transition_frames) {
        if (transition_phase == GW_PHASE_OUT) {
            transition_phase = GW_PHASE_OUT_DONE;
        } else {
            transition_phase = GW_PHASE_IDLE;
            transition_restore_palette();
        }
    }
}
@IDE_IF{HAS_SHARED_PLAYER}
static game_tile_player_t *bound_player_physics;
uint8_t gameworlds_bind_player_physics(game_tile_player_t *player)
{
    if (!player || !active_world ||
        !gameplayer_apply_physics(player, active_world->physics_profile)) return 0;
    bound_player_physics = player;
    return 1;
}
@IDE_END

static const gameworlds_record_t *find_world(const char *name)
{
    if (!name || !*name) return &worlds[0];
    for (size_t i = 0; i < WORLD_COUNT; ++i)
        if (strcmp(worlds[i].name, name) == 0) return &worlds[i];
    return 0;
}
static void inventory_put(const char *name, uint16_t amount, void *user)
{
    (void)user;
    if (!name || !*name) return;
    for (uint16_t i = 0; i < inventory_count; ++i)
        if (strcmp(inventory[i].name, name) == 0) { inventory[i].amount = amount; return; }
    if (inventory_count < GAMEWORLDS_MAX_INVENTORY) {
        inventory[inventory_count].name = name;
        inventory[inventory_count].amount = amount;
        ++inventory_count;
    }
}
static uint32_t inventory_get(const char *name, void *user)
{
    (void)user;
    if (!name) return UINT32_MAX;
    for (uint16_t i = 0; i < inventory_count; ++i)
        if (strcmp(inventory[i].name, name) == 0) return inventory[i].amount;
    return UINT32_MAX; /* Not yet in backpack: retain world-defined initial. */
}
void gameworlds_seed_inventory(const char *name, uint16_t initial)
{ inventory_put(name, initial, 0); }
void gameworlds_player_hooks(gameworlds_player_hook_t save,
                             gameworlds_player_hook_t restore, void *user)
{
    save_player = save;
    restore_player = restore;
    player_context = user;
}
gameworlds_player_state_t *gameworlds_state(void) { return &persistent; }
uint16_t gameworlds_count(void) { return (uint16_t)WORLD_COUNT; }
const char *gameworlds_name(uint16_t i) { return i < WORLD_COUNT ? worlds[i].name : 0; }
const char *gameworlds_active(void) { return active_world ? active_world->name : 0; }
uint8_t gameworlds_physics_profile(void)
{ return active_world ? active_world->physics_profile : worlds[0].physics_profile; }
void *gameworlds_map(void) { return active_world ? active_world->map : 0; }
uint8_t gameworlds_player_start(gameworlds_spawn_t *out) {
    if (!active_world || !out) return 0;
    out->x = active_world->start_x;
    out->y = active_world->start_y;
    out->facing = active_world->start_facing;
    for (uint16_t i = 0; i < active_world->named_spawn_count; ++i) {
        const gameworlds_named_spawn_t *named = &active_world->named_spawns[i];
        if (strcmp(named->id, active_spawn_id) == 0) {
            out->x = named->x; out->y = named->y; out->facing = named->facing;
            break;
        }
    }
    return 1;
}

static void unload_active(void)
{
    if (!active_world) return;
    music_stop(); /* Never free sample buffers while DMA/audio still use them. */
    if (active_world->inventory_store)
        active_world->inventory_store(inventory_put, 0);
    /* Capture mutable objects and story flags BEFORE unbinding old assets. */
    if (active_world->world_state_save) active_world->world_state_save();
    if (active_world->story_save) active_world->story_save();
@IDE_IF{HAS_ADVENTURE_RUNTIME}
    /* Discard NPC/skin pointers to old world's assets. */
    game_adventure_start(0, 0, 0, 0, 0, 0, 0, 0, 0, 8, 0, 2, 0, 0);
@IDE_END
    if (active_world->unload_atlas) active_world->unload_atlas();
    if (active_world->unload_map) active_world->unload_map();
    active_world->assets_shutdown();
    active_world = 0;
}
static uint8_t activate(const gameworlds_record_t *world)
{
    if (!world || !world->assets_init()) return 0;
    if (world->load_map && !world->load_map(world->map_path)) goto failed;
    if (world->load_atlas && !world->load_atlas()) goto failed;
    /* Only call setup after sprite/PPB resources and tilemaps exist. */
    if (world->adventure_setup) world->adventure_setup();
@IDE_IF{HAS_PLAYER_VISIBILITY}
    game_adventure_set_inventory_filter(gameplayer_inventory_visible);
@IDE_END
    if (world->inventory_load) world->inventory_load(inventory_get, 0);
    if (world->story_restore) world->story_restore();
    if (!world->objects_init()) goto failed;
    /* Reapply this world's saved mutable state after its default objects are built. */
    if (world->world_state_restore) world->world_state_restore();
    active_world = world;
    return 1;
failed:
    music_stop();
    if (world->unload_atlas) world->unload_atlas();
    if (world->unload_map) world->unload_map();
    world->assets_shutdown();
    return 0;
}
uint8_t gameworlds_start(const char *name)
{
    const gameworlds_record_t *target = find_world(name);
    if (!target || applying) return 0;
    if (target == active_world) return 1;
    const uint8_t first_world = active_world == NULL;
    /* An OUT fade must stay black while the world is being exchanged.
     * Restoring the old CLUT here would expose its last visible frame. */
    if (transition_phase != GW_PHASE_OUT_DONE) transition_restore_palette();
    transition_phase = GW_PHASE_IDLE;
    applying = 1;
    pending_world = 0;
    strcpy(active_spawn_id, "default");
    if (active_world && save_player) {
        save_player(&persistent, player_context);
        saved_player_is_valid = 1;
    }
    unload_active();
    const uint8_t success = activate(target);
    /* First start: the game initialises its player normally. On subsequent
     * loads, only restore state that was actually captured from a player. */
    if (success && saved_player_is_valid && restore_player)
        restore_player(&persistent, player_context);
@IDE_IF{HAS_SHARED_PLAYER}
    /* On every successful world entry, including a later return, apply its
     * chosen physics to the already-initialised shared player. The first world
     * is applied when the game calls gameworlds_bind_player_physics(). */
    if (success && bound_player_physics)
        gameplayer_apply_physics(bound_player_physics, target->physics_profile);
@IDE_END
    applying = 0;
    if (success && first_world && transition_enabled) {
        uint8_t in, out, frames;
        uint8_t origin;
        int32_t x, y;
        transition_entry(target, "default", &in, &out, &frames, &origin, &x, &y);
        transition_begin(GW_PHASE_IN, in, frames, origin, x, y);
    }
    return success;
}
uint8_t gameworlds_request_at(const char *name, const char *start_id)
{
    const gameworlds_record_t *target = find_world(name);
    if (!name || !*name || !target || applying) return 0;
    if (!start_id || !*start_id) start_id = "default";
    if (strlen(start_id) >= sizeof(pending_spawn_id)) return 0;
    if (strcmp(start_id, "default") != 0) {
        uint8_t found = 0;
        for (uint16_t i = 0; i < target->named_spawn_count; ++i)
            if (strcmp(target->named_spawns[i].id, start_id) == 0) { found = 1; break; }
        if (!found) return 0;
    }
    strcpy(pending_spawn_id, start_id);
    pending_world = target;
    pending_has_exit = 0;
    return 1;
}
uint8_t gameworlds_request_at_from(const char *name, const char *start_id,
                                   int32_t exit_x, int32_t exit_y)
{
    if (!gameworlds_request_at(name, start_id)) return 0;
    pending_exit_x = exit_x;
    pending_exit_y = exit_y;
    pending_has_exit = 1;
    return 1;
}
uint8_t gameworlds_request(const char *name)
{ return gameworlds_request_at(name, "default"); }
uint8_t gameworlds_apply_pending(void)
{
    if (!pending_world) return 1;
    if (transition_enabled &&
        (transition_phase == GW_PHASE_OUT || transition_phase == GW_PHASE_IN))
        return 1; /* Keep drawing until current effect completes. */
    /* OUT and IN belong to the DESTINATION start selected by this door,
     * not the start through which the player previously entered this world. */
    const gameworlds_record_t *target = pending_world;
    uint8_t in, out, frames, circle_origin;
    int32_t arrival_x, arrival_y;
    transition_entry(target, pending_spawn_id, &in, &out, &frames,
                     &circle_origin, &arrival_x, &arrival_y);
    if (transition_enabled && transition_phase != GW_PHASE_OUT_DONE && active_world) {
        if (out != GW_TRANSITION_NONE) {
            int32_t exit_x = pending_exit_x, exit_y = pending_exit_y;
            if (!pending_has_exit) {
                /* Programmatic world requests still have a useful origin. */
                exit_x = active_world->start_x;
                exit_y = active_world->start_y;
                for (uint16_t i = 0; i < active_world->named_spawn_count; ++i) {
                    const gameworlds_named_spawn_t *start = &active_world->named_spawns[i];
                    if (strcmp(start->id, active_spawn_id) == 0) {
                        exit_x = start->x;
                        exit_y = start->y;
                        break;
                    }
                }
            }
            transition_begin(GW_PHASE_OUT, out, frames, circle_origin, exit_x, exit_y);
            return 1;
        }
    }
    pending_world = 0;
    char requested[sizeof(pending_spawn_id)];
    strcpy(requested, pending_spawn_id);
    strcpy(pending_spawn_id, "default");
    pending_has_exit = 0;
    const uint8_t ok = gameworlds_start(target->name);
    if (ok) {
        strcpy(active_spawn_id, requested);
        if (transition_enabled)
            transition_begin(GW_PHASE_IN, in, frames, circle_origin, arrival_x, arrival_y);
    }
    return ok;
}
void gameworlds_shutdown(void)
{
@IDE_IF{HAS_PICKUPS}
    gameworlds_hud_reset();
@IDE_END
    if (active_world && save_player) {
        save_player(&persistent, player_context);
        saved_player_is_valid = 1;
    }
    transition_restore_palette();
    transition_phase = GW_PHASE_IDLE;
    transition_enabled = 0;
    unload_active();
    pending_world = 0;
    pending_has_exit = 0;
    strcpy(active_spawn_id, "default");
    strcpy(pending_spawn_id, "default");
@IDE_IF{HAS_SHARED_PLAYER}
    bound_player_physics = 0;
@IDE_END
}
void gameworlds_update(uint16_t frames)
{ if (active_world) active_world->objects_update(frames); }
void gameworlds_draw(int32_t x, int32_t y)
{ if (active_world) active_world->objects_draw(x,y); }
void gameworlds_draw_behind(int32_t x, int32_t y)
{ if (active_world && active_world->objects_draw_behind) active_world->objects_draw_behind(x,y); }
@IDE_IF{HAS_WORLD_PHYSICS}
void gameworlds_before(game_world_player_t *p)
{ if (active_world && active_world->before) active_world->before(p); }
void gameworlds_after(game_world_player_t *p)
{ if (active_world && active_world->after) active_world->after(p); }
@IDE_END
@IDE_IF{HAS_PICKUPS}
/* HUD-only pickups retain their lifetime "number collected" counter.
 * Inventory-linked HUD pickups display the CURRENT backpack quantity, which
 * changes on USE, DROP, DESTROY, NPC hand-in, and game-specific removals.
 * Pickup Value stays separate (score, gold, reward value, etc.). */
static uint32_t gameworlds_hud_totals[256];
@IDE_IF{HAS_ADVENTURE_RUNTIME}
static uint8_t gameworlds_hud_inventory_kinds[256];
@IDE_END
uint32_t gameworlds_hud_total(uint16_t kind)
{
    if (kind >= 256u) return 0u;
@IDE_IF{HAS_ADVENTURE_RUNTIME}
    if (gameworlds_hud_inventory_kinds[kind]) {
        uint32_t owned = 0u;
        if (game_adventure_pickup_quantity(kind, &owned)) return owned;
    }
@IDE_END
    return gameworlds_hud_totals[kind];
}
void gameworlds_hud_reset(void)
{
    memset(gameworlds_hud_totals,0,sizeof(gameworlds_hud_totals));
@IDE_IF{HAS_ADVENTURE_RUNTIME}
    memset(gameworlds_hud_inventory_kinds,0,sizeof(gameworlds_hud_inventory_kinds));
@IDE_END
}
typedef struct { game_pickup_callback_t cb; void *user; } gameworlds_pickup_context_t;
static void gameworlds_pickup_bridge(game_collectable_t *item, void *context)
{
    gameworlds_pickup_context_t *ctx = (gameworlds_pickup_context_t *)context;
    if (!item) return;
    if (item->tracking_configured && item->show_in_hud && item->kind < 256u) {
        uint32_t *count = &gameworlds_hud_totals[item->kind];
        *count = (*count == UINT32_MAX ? UINT32_MAX : *count + 1u);
    }
@IDE_IF{HAS_ADVENTURE_RUNTIME}
    if (item->tracking_configured) {
        if (item->show_in_inventory) {
            /* Link HUD to inventory only if this world has a matching item.
             * HUD-only pickups continue to use the independent count. */
            if (game_adventure_collect_amount(item->kind, 1u) &&
                item->show_in_hud && item->kind < 256u)
                gameworlds_hud_inventory_kinds[item->kind] = 1u;
        }
        game_adventure_managed_pickup_begin(item->kind);
    }
@IDE_END
    if (ctx && ctx->cb) ctx->cb(item, ctx->user);
@IDE_IF{HAS_ADVENTURE_RUNTIME}
    if (item->tracking_configured) game_adventure_managed_pickup_end();
@IDE_END
}
uint16_t gameworlds_check(int32_t x, int32_t y, uint16_t w, uint16_t h,
                          game_pickup_callback_t cb, void *user)
{
    if (!active_world || !active_world->check) return 0;
    gameworlds_pickup_context_t context = {cb,user};
    return active_world->check(x,y,w,h,gameworlds_pickup_bridge,&context);
}
@IDE_END
void gameworlds_draw_foreground(void)
{ if (active_world) active_world->assets_foreground(); }
void gameworlds_draw_background(void)
{ if (active_world) active_world->assets_background(); }
void gameworlds_show_background(void)
{ if (active_world) active_world->assets_show_background(); }
