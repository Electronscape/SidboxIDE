#include "@IDE{WORLD_HEADER_FILENAME}"
/* Optional sprite PPB sharing. Standalone tilemaps still work. */
#if defined(__has_include)
# if __has_include("../gameassets/gameassets.h")
#  include "../gameassets/gameassets.h"
# endif
#endif

@IDE_IF{EMBEDDED}
@IDE_IF{RLE_COMPRESSED}
/* RLE-packed embedded data. This rule owns the runtime, not gametilemap.cpp. */
#include <stdlib.h>
const uint16_t *@IDE{WORLD_SYMBOL}_graphics = 0;
const uint8_t *@IDE{WORLD_SYMBOL}_collisions = 0;
const uint8_t *@IDE{WORLD_SYMBOL}_flips = 0;
static const uint8_t @IDE{WORLD_SYMBOL}_graphics_rle[] = {
@IDE{RLE_GRAPHICS_ROWS}};
static const uint8_t @IDE{WORLD_SYMBOL}_collisions_rle[] = {
@IDE{RLE_COLLISIONS_ROWS}};
static const uint8_t @IDE{WORLD_SYMBOL}_flips_rle[] = {
@IDE{RLE_FLIPS_ROWS}};
@IDE_IF{HAS_LEGACY_SLOPES}
const uint8_t *@IDE{WORLD_SYMBOL}_slopes = 0;
static const uint8_t @IDE{WORLD_SYMBOL}_slopes_rle[] = {
@IDE{RLE_SLOPES_ROWS}};
@IDE_END
@IDE_IF{HAS_POINT_SHAPES}
const uint16_t *@IDE{WORLD_SYMBOL}_shape_refs = 0;
static const uint8_t @IDE{WORLD_SYMBOL}_shape_refs_rle[] = {
@IDE{RLE_SHAPE_REFS_ROWS}};
@IDE_END
@IDE_ELSE
/* Embedded graphics and collision arrays: no TFCard map file needed. */
const uint16_t @IDE{WORLD_SYMBOL}_graphics[] __attribute__((aligned(32))) = {
@IDE{GRAPHIC_ROWS}};

const uint8_t @IDE{WORLD_SYMBOL}_collisions[] __attribute__((aligned(32))) = {
@IDE{COLLISION_ROWS}};

const uint8_t @IDE{WORLD_SYMBOL}_flips[] __attribute__((aligned(32))) = {
@IDE{FLIP_ROWS}};

@IDE_IF{HAS_LEGACY_SLOPES}
const uint8_t @IDE{WORLD_SYMBOL}_slopes[] __attribute__((aligned(32))) = {
@IDE{SLOPE_ROWS}};

@IDE_END
@IDE_IF{HAS_POINT_SHAPES}
const uint16_t @IDE{WORLD_SYMBOL}_shape_refs[] = {
@IDE{SHAPE_REF_ROWS}};
@IDE_END
@IDE_END

@IDE_IF{HAS_POINT_SHAPES}
extern const game_tile_shape_t game_global_collision_stamps[];
extern const game_tile_shape_point_t game_global_collision_points[];

const game_tile_shape_instance_t @IDE{WORLD_SYMBOL}_shape_instances[] = {
@IDE{SHAPE_INSTANCE_ROWS}};

@IDE_END
const game_tile_animation_t @IDE{WORLD_SYMBOL}_animations[] = {
@IDE{ANIMATION_ROWS}};

@IDE_END
@IDE_IF{HAS_LOOPS}
/* Only world centres and global stamp IDs live in each level. */
extern const game_tile_loop_stamp_t game_global_loop_stamps[];
static const game_tile_loop_placement_t @IDE{WORLD_SYMBOL}_loop_placements[] = {
@IDE{LOOP_ROWS}};

@IDE_END
game_tilemap_t @IDE{WORLD_SYMBOL} = {
@IDE_IF{EXTERNAL}
    0, 0, 0,
@IDE_ELSE
@IDE_IF{RLE_COMPRESSED}
    0, 0, 0,
@IDE_ELSE
    @IDE{WORLD_SYMBOL}_graphics, @IDE{WORLD_SYMBOL}_collisions, 0,
@IDE_END
@IDE_END
    @IDE{MAP_WIDTH}, @IDE{MAP_HEIGHT}, @IDE{TILE_SIZE}, @IDE{TILE_COUNT},
    @IDE{ANIM_POINTER}, @IDE{ANIM_COUNT},
    0, 0, 0, /* atlas width, height, borrowed flag */
    0, @IDE{FLIP_POINTER}, @IDE{SLOPE_POINTER},
    @IDE{SHAPE_REF_POINTER}, @IDE{SHAPE_INSTANCE_POINTER},
    @IDE{SHAPE_DEF_POINTER}, @IDE{SHAPE_POINTS_POINTER},
    @IDE{SHAPE_INSTANCE_COUNT}, @IDE{SHAPE_DEF_COUNT},
    0, @IDE{LOOP_COUNT},
    @IDE{LOOP_POINTER}, @IDE{LOOP_STAMP_POINTER}, @IDE{LOOP_STAMP_COUNT}
};

@IDE_IF{EXTERNAL}
/* TFCard map v2/v3/v4: file includes graphics, collisions, flips, optional slopes and animations. */
uint8_t @IDE{WORLD_SYMBOL}_load_map(const char *filename)
{ return game_tilemap_load_map(&@IDE{WORLD_SYMBOL}, filename); }
void @IDE{WORLD_SYMBOL}_unload_map(void)
{ game_tilemap_unload_map(&@IDE{WORLD_SYMBOL}); }
@IDE_ELSE
@IDE_IF{RLE_COMPRESSED}
/* Each packet contains 1..128 units. Bit 7 selects run vs literal;
 * graphics/shape references use 2-byte little-endian units. */
static uint8_t @IDE{WORLD_SYMBOL}_unpack_rle(const uint8_t *src, uint32_t src_len,
    uint8_t *dst, uint32_t dst_len, uint32_t unit)
{
    uint32_t in = 0, out = 0;
    if (!src || !dst || (unit != 1u && unit != 2u) || (dst_len % unit)) return 0;
    while (in < src_len) {
        const uint8_t control = src[in++];
        const uint32_t count = (uint32_t)(control & 127u) + 1u;
        if (count > (dst_len - out) / unit) return 0;
        if (control & 128u) {
            if (src_len - in < unit) return 0;
            for (uint32_t i = 0; i < count; ++i)
                for (uint32_t b = 0; b < unit; ++b)
                    dst[out + i * unit + b] = src[in + b];
            in += unit;
        } else {
            const uint32_t bytes = count * unit;
            if (src_len - in < bytes) return 0;
            for (uint32_t b = 0; b < bytes; ++b)
                dst[out + b] = src[in + b];
            in += bytes;
        }
        out += count * unit;
    }
    return (uint8_t)(out == dst_len);
}

uint8_t @IDE{WORLD_SYMBOL}_load_map(const char *filename)
{
    (void)filename;
    if (@IDE{WORLD_SYMBOL}.map_storage) return 1;
    uint8_t *memory = (uint8_t *)malloc(@IDE{RLE_TOTAL_BYTES}u);
    if (!memory) return 0;
    if (!@IDE{WORLD_SYMBOL}_unpack_rle(@IDE{WORLD_SYMBOL}_graphics_rle,
            sizeof(@IDE{WORLD_SYMBOL}_graphics_rle),
            memory + @IDE{RLE_GRAPHICS_OFFSET}u, @IDE{RLE_GRAPHICS_SIZE}u, 2u) ||
        !@IDE{WORLD_SYMBOL}_unpack_rle(@IDE{WORLD_SYMBOL}_collisions_rle,
            sizeof(@IDE{WORLD_SYMBOL}_collisions_rle),
            memory + @IDE{RLE_COLLISIONS_OFFSET}u, @IDE{RLE_COLLISIONS_SIZE}u, 1u) ||
        !@IDE{WORLD_SYMBOL}_unpack_rle(@IDE{WORLD_SYMBOL}_flips_rle,
            sizeof(@IDE{WORLD_SYMBOL}_flips_rle),
            memory + @IDE{RLE_FLIPS_OFFSET}u, @IDE{RLE_FLIPS_SIZE}u, 1u)
@IDE_IF{HAS_LEGACY_SLOPES}
        || !@IDE{WORLD_SYMBOL}_unpack_rle(@IDE{WORLD_SYMBOL}_slopes_rle,
            sizeof(@IDE{WORLD_SYMBOL}_slopes_rle),
            memory + @IDE{RLE_SLOPES_OFFSET}u, @IDE{RLE_SLOPES_SIZE}u, 1u)
@IDE_END
@IDE_IF{HAS_POINT_SHAPES}
        || !@IDE{WORLD_SYMBOL}_unpack_rle(@IDE{WORLD_SYMBOL}_shape_refs_rle,
            sizeof(@IDE{WORLD_SYMBOL}_shape_refs_rle),
            memory + @IDE{RLE_SHAPE_REFS_OFFSET}u, @IDE{RLE_SHAPE_REFS_SIZE}u, 2u)
@IDE_END
       ) {
        free(memory);
        return 0;
    }
    @IDE{WORLD_SYMBOL}_graphics = (const uint16_t *)(const void *)(memory + @IDE{RLE_GRAPHICS_OFFSET}u);
    @IDE{WORLD_SYMBOL}_collisions = memory + @IDE{RLE_COLLISIONS_OFFSET}u;
    @IDE{WORLD_SYMBOL}_flips = memory + @IDE{RLE_FLIPS_OFFSET}u;
    @IDE{WORLD_SYMBOL}.graphics = @IDE{WORLD_SYMBOL}_graphics;
    @IDE{WORLD_SYMBOL}.collision = @IDE{WORLD_SYMBOL}_collisions;
    @IDE{WORLD_SYMBOL}.flips = @IDE{WORLD_SYMBOL}_flips;
@IDE_IF{HAS_LEGACY_SLOPES}
    @IDE{WORLD_SYMBOL}_slopes = memory + @IDE{RLE_SLOPES_OFFSET}u;
    @IDE{WORLD_SYMBOL}.slopes = @IDE{WORLD_SYMBOL}_slopes;
@IDE_END
@IDE_IF{HAS_POINT_SHAPES}
    @IDE{WORLD_SYMBOL}_shape_refs = (const uint16_t *)(const void *)(memory + @IDE{RLE_SHAPE_REFS_OFFSET}u);
    @IDE{WORLD_SYMBOL}.shape_refs = @IDE{WORLD_SYMBOL}_shape_refs;
@IDE_END
    @IDE{WORLD_SYMBOL}.map_storage = memory;
    return 1;
}
void @IDE{WORLD_SYMBOL}_unload_map(void)
{
    free(@IDE{WORLD_SYMBOL}.map_storage);
    @IDE{WORLD_SYMBOL}.map_storage = 0;
    @IDE{WORLD_SYMBOL}.graphics = 0;
    @IDE{WORLD_SYMBOL}.collision = 0;
    @IDE{WORLD_SYMBOL}.flips = 0;
    @IDE{WORLD_SYMBOL}_graphics = 0;
    @IDE{WORLD_SYMBOL}_collisions = 0;
    @IDE{WORLD_SYMBOL}_flips = 0;
@IDE_IF{HAS_LEGACY_SLOPES}
    @IDE{WORLD_SYMBOL}.slopes = 0;
    @IDE{WORLD_SYMBOL}_slopes = 0;
@IDE_END
@IDE_IF{HAS_POINT_SHAPES}
    @IDE{WORLD_SYMBOL}.shape_refs = 0;
    @IDE{WORLD_SYMBOL}_shape_refs = 0;
@IDE_END
}
@IDE_ELSE
/* Embedded C mode does not require reading a TFCard .map. */
uint8_t @IDE{WORLD_SYMBOL}_load_map(const char *filename)
{ (void)filename; return 1; }
void @IDE{WORLD_SYMBOL}_unload_map(void) {}
@IDE_END
@IDE_END

@IDE_IF{HAS_ATLAS}
/* Once at startup, AFTER initMalloc(). No per-frame TFCard reads. */
uint8_t @IDE{WORLD_SYMBOL}_load_atlas(void)
{
@IDE_IF{RLE_COMPRESSED}
    if (!@IDE{WORLD_SYMBOL}_load_map(0)) return 0;
@IDE_END
    if (@IDE{WORLD_SYMBOL}.atlas) return 1;
#ifdef GAMEASSETS_HAS_PPB_LOOKUP
    /* Share a path-matched PPB when its dimensions fit; art may be modded. */
    uint16_t shared_w = 0, shared_h = 0;
    const uint8_t *shared = gameassets_find_ppb(@IDE{ATLAS_PATH}, &shared_w, &shared_h);
    if (shared)
        return game_tilemap_attach_shared_ppb_atlas(&@IDE{WORLD_SYMBOL},
            shared, shared_w, shared_h, @IDE{ATLAS_HASH}u);
#endif
    /* No matching sprite atlas: allocate separately from TFCard. */
    return game_tilemap_load_ppb_atlas(&@IDE{WORLD_SYMBOL}, @IDE{ATLAS_PATH},
        @IDE{ATLAS_WIDTH}, @IDE{ATLAS_HEIGHT}, @IDE{ATLAS_HASH}u);
}
@IDE_ELSE
uint8_t @IDE{WORLD_SYMBOL}_load_atlas(void)
{
@IDE_IF{RLE_COMPRESSED}
    return @IDE{WORLD_SYMBOL}_load_map(0);
@IDE_ELSE
    return 1;
@IDE_END
}
@IDE_END

void @IDE{WORLD_SYMBOL}_unload_atlas(void)
{
    game_tilemap_unload_ppb_atlas(&@IDE{WORLD_SYMBOL});
}
