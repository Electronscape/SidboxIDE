/* GamerGirl Stage 5.2 -- generated project-wide multi-world runtime.
 * All .sbgm projects (including one-world games) use this same API.
 * This is an API, not a second copy of the old global gameassets loader.
 */
#ifndef CODERGIRL_GAMEWORLDS_H
#define CODERGIRL_GAMEWORLDS_H
#include <stdint.h>

@IDE_IF{HAS_WORLD_PHYSICS}
#include "gameworldobjects.h"
@IDE_END
@IDE_IF{HAS_PICKUPS}
#include "gamecollectables.h"
@IDE_END

typedef struct {
    uint32_t score;
    uint32_t health;
    uint32_t lives;
    uint32_t flags;           /* YOUR persistent story flags */
    int32_t player_x100;
    int32_t player_y100;
    int32_t player_vx100;
    int32_t player_vy100;
    uint8_t user[64];         /* optional game-owned persistent data */
} gameworlds_player_state_t;

typedef void (*gameworlds_player_hook_t)(gameworlds_player_state_t *state, void *user);
typedef void (*gameworlds_inventory_put_t)(const char *name, uint16_t count, void *user);
typedef uint32_t (*gameworlds_inventory_get_t)(const char *name, void *user);

/* Register hooks to save the LIVE player before leaving a world and restore
 * to the newly-created player after its assets and physics are ready.
 * The first start does NOT call restore: create your first player normally.
 * Subsequent transitions restore only after a successful world load.
 * Hooks must not free world resources or request an immediate load. */
void gameworlds_player_hooks(gameworlds_player_hook_t save,
                             gameworlds_player_hook_t restore, void *user);
gameworlds_player_state_t *gameworlds_state(void);
uint16_t gameworlds_count(void);
const char *gameworlds_name(uint16_t index);
const char *gameworlds_active(void);
/* Physics profile configured for the active world (default if unassigned). */
uint8_t gameworlds_physics_profile(void);
@IDE_IF{HAS_SHARED_PLAYER}
#include "gametilemap.h"
/* Bind the live player ONCE after game_tile_player_start(). Applies the first
 * world's profile now and future worlds' profiles on successful entry. */
uint8_t gameworlds_bind_player_physics(game_tile_player_t *player);
/* Sprite top-left in world pixels, independent of collision hitbox.
   This never modifies physics or the player position. */
uint8_t gameworlds_player_sprite_origin(int32_t *x, int32_t *y);
/* Read the ACTIVE collision hitbox, not the sprite origin. Adventure floor
 * pickups must use this rectangle on both sides of the player. Read-only:
 * it never moves the player or changes the map collision. */
uint8_t gameworlds_player_pickup_rect(int32_t *x, int32_t *y,
                                     uint16_t *w, uint16_t *h);
@IDE_END
/* NULL or empty starts the project's selected/default world. */
uint8_t gameworlds_start(const char *name);
/* Stage 5.164: TFCard saves. Slots 0..9, all worlds and Adventure state.
 * Never call save_slot() directly inside object/contact callbacks; use
 * checkpoint_request() and allow gameworlds_apply_pending() to write safely.
 * load_slot() runs BEFORE the first gameworlds_start(), after gameplayer_init(). */
uint8_t gameworlds_save_slot(uint8_t slot);
uint8_t gameworlds_load_slot(uint8_t slot);
uint8_t gameworlds_slot_exists(uint8_t slot);
/* In-game load: validate now, then restore at gameworlds_apply_pending(),
 * preserving the dual-bank save format and live world lifetime rules. */
uint8_t gameworlds_reload_request(uint8_t slot);
/* Session policy: Start Game may only recover saves written in this run;
 * Load Game explicitly enables existing saved slots. */
uint8_t gameworlds_session_can_reload(void);
/* Without a title screen, recover an unsaved run from its initial memory
 * snapshot at the next safe world boundary. With a title screen, New Game
 * ALWAYS starts a clean session at the title action's world/named spawn. */
uint8_t gameworlds_restart_request(void);
/* Return to the generated title menu at the NEXT safe world boundary,
 * whether playing fresh or from a selected save slot. Without a title the
 * old unsaved-only fresh restart fallback remains available. */
uint8_t gameworlds_title_request(void);
/* Latest accepted health hit, cleared while player remains alive. */
const char *gameworlds_fatal_hit_note(void);
/* Opt in only when a Defeat Screen is actually enabled, avoiding otherwise
 * unnecessary initial-run snapshot memory in existing games. */
void gameworlds_fresh_start_enable(uint8_t enabled);
/* Same-world reload still counts as a new world/player binding. */
uint32_t gameworlds_reload_revision(void);
/* True uniform screen fade for the Adventure defeat overlay. */
void gameworlds_ui_fade(uint8_t brightness);
uint8_t gameworlds_last_saved_slot(void); /* 255 if none in this session */
uint8_t gameworlds_checkpoint_request(uint8_t slot);
const char *gameworlds_saved_world(void);
/* 0 idle, 1 saved, 2 write failure (clear by querying). */
uint8_t gameworlds_save_status(void);
/* Stage 5.165 project-wide Quest Journal API. Index is 0..count-1;
 * status: 0 locked, 1 active, 2 completed, 3 excluded by branch.
 * No quest progress is tied to which quest is tracked for display.
 * Call gameworlds_quest_event("event_id") from authored events; safe inside
 * gameplay callbacks, unlike TFCard writes or world transitions. */
uint16_t gameworlds_quest_count(void);
const char *gameworlds_quest_id(uint16_t index);
const char *gameworlds_quest_title(uint16_t index);
const char *gameworlds_quest_description(uint16_t index);
uint8_t gameworlds_quest_status(uint16_t index);
uint16_t gameworlds_quest_current_step(uint16_t index);
const char *gameworlds_quest_objective(uint16_t index);
/* Enumerate every objective for the quest Journal. Stable objective indices
 * are local to each quest; both ordered and unordered progress are readable. */
uint16_t gameworlds_quest_objective_count(uint16_t quest);
const char *gameworlds_quest_objective_title_at(uint16_t quest,uint16_t objective);
uint8_t gameworlds_quest_objective_done_at(uint16_t quest,uint16_t objective);
uint8_t gameworlds_quest_is_unordered(uint16_t quest);
const char *gameworlds_quest_hint(uint16_t index);
int16_t gameworlds_quest_tracked(void); /* -1 = none */
uint8_t gameworlds_quest_track(const char *quest_id);
uint8_t gameworlds_quest_event(const char *event_id);
uint8_t gameworlds_quest_event_number(uint16_t event_id); /* Active world + numeric Adventure event */
uint8_t gameworlds_quest_visible(uint16_t i); /* Hide undiscovered quest lines */
uint8_t gameworlds_quest_enable(const char *quest_id); /* Offer initially hidden quest at dialogue node */
uint8_t gameworlds_quest_dialogue_choice(const char *stable_choice_id); /* Auto IDs, active world */
/* Latest QUEST UPDATED event. Revision changes only on an actual authored
 * quest activation/objective advance/completion, never merely opening the UI.
 * A read does not consume the event and never accesses the TFCard.
 * kind: 1 quest offered/unlocked, 2 objective advanced, 3 quest completed.
 * A revision of zero means there has been no gameplay quest update. */
uint8_t gameworlds_quest_notice(uint16_t *quest_index, uint32_t *revision);
/* Safe inside callbacks: only queues a change. Does NOT unload anything. */
uint8_t gameworlds_request(const char *name);
/* Request a specific named entrance in the destination world.
 * "default" preserves the original Player Start behaviour. */
uint8_t gameworlds_request_at(const char *name, const char *start_id);
/* Door-trigger requests carry their world-space exit centre, for an optional
 * Circle Close around the doorway. Older callers use request_at() safely. */
uint8_t gameworlds_request_at_from(const char *name, const char *start_id,
                                   int32_t exit_x, int32_t exit_y);
/* Call OUTSIDE the frame's collision, object and drawing passes.
 * 0 = failed; 1 = no change or successful transition. */
uint8_t gameworlds_apply_pending(void);
void gameworlds_shutdown(void);
/* Player Start transition modes: 0 None; 1 Fade; 2 Left; 3 Right;
 * 4 Up; 5 Down; 6 Circle.  Duration is measured in rendered frames.
 * The generated main loop calls frame() AFTER drawing HUD/dialogue and BEFORE
 * gfx_dispfbuffer(). During an effect, skip physics/input and object updates.
 * Neither PPB cell indices nor the source CLUTs are ever edited. */
/* Existing user-owned main.c keeps instant cuts until it opts in. Without
 * frame() calls a transition could otherwise never finish. */
void gameworlds_transitions_enable(uint8_t enabled);
uint8_t gameworlds_transition_busy(void);
/* Update current camera origin before transition_frame() when using the
 * optional Player Start/door centre. No camera update = screen-centred mask. */
void gameworlds_transition_camera(int32_t camera_x, int32_t camera_y);
void gameworlds_transition_frame(uint16_t view_width, uint16_t view_height);
void gameworlds_spotlight_camera(int32_t camera_x, int32_t camera_y);
void gameworlds_spotlight_player(int32_t world_x, int32_t world_y);
void gameworlds_spotlight_frame(uint16_t view_width, uint16_t view_height);
/* World weather: named bit flags, not magic return values.
 * Query BEFORE drawing the spotlight, after gameworlds_update(), to inspect
 * this frame's weather. LIGHTNING_FLASH is set only on BRIGHT pulse frames,
 * not in the dark gap of a thunder double-flash. */
#define GAME_WEATHER_STATUS_NONE          0u
#define GAME_WEATHER_STATUS_PRECIPITATION (1u << 0)
#define GAME_WEATHER_STATUS_LIGHTNING_FLASH (1u << 1)
uint8_t gameworlds_weather_status(void);
/* Temporary UI visibility: bind original, untinted palettes without
 * modifying source CLUTs or stopping day/night/weather progression. */
void gameworlds_ui_full_brightness(void);
/* Render AFTER spotlight and FRONT tiles, BEFORE HUD/dialogue. Existing calls
 * may ignore the returned status without changing main.c. */
uint8_t gameworlds_weather_frame(uint16_t view_width, uint16_t view_height);
/* 0 = off, 1 = on, 2 = toggle. Applies to currently loaded world. */
void gameworlds_spotlight_action(uint8_t action);
/* PLAYER graph commands: weather 0 clear, 1 rain, 2 snow, 3 storm;
 * daylight 0 day, 1 night, 2 cycle. Operate on active world only. */
void gameworlds_weather_action(uint8_t mode);
/* Weather target controls: action 0 disable, 1 enable, 2 toggle.
 * Disable only clears the selected weather if it is the active mode.
 * Weather 0 (Clear) always clears. */
void gameworlds_weather_target_action(uint8_t mode, uint8_t action);
void gameworlds_daylight_action(uint8_t mode);
/* Trigger action targeting a live or unloaded world by compiled object slot.
   Unloaded targets are staged and applied at their next entry. */
uint8_t gameworlds_object_action(const char *world_name, uint16_t object_slot, uint8_t action);
/* NPC visibility actions: 0 hide, 1 show, 2 toggle; remote worlds stay unloaded. */
uint8_t gameworlds_npc_action(const char *world_name, uint16_t npc_slot, uint8_t action);
/* Seed project-wide starting items BEFORE gameworlds_start(); never resets on travel. */
void gameworlds_seed_inventory(const char *name, uint16_t initial);
/* The current map may be NULL for a scenery-only world. */
void *gameworlds_map(void);
/* Spawn belongs to the active WORLD; player graphics/stats belong to GAME. */
typedef struct { int32_t x, y; uint8_t facing; } gameworlds_spawn_t;
uint8_t gameworlds_player_start(gameworlds_spawn_t *out);
/* Original combined update advances gameplay, particles and weather. */
void gameworlds_update(uint16_t frames);
/* Split updates: use these INSTEAD of gameworlds_update() for dialogue pauses.
 * Gameplay includes object animation, enemies, splines, pickups and asset fades.
 * Particles and weather are purely visual, so can run every rendered frame. */
void gameworlds_update_gameplay(uint16_t frames);
void gameworlds_update_particles(uint16_t frames);
void gameworlds_update_weather(uint16_t frames);
/* Optional short aliases for hand-authored main.c. */
void game_update_gameplay(uint16_t frames);
void game_update_particles(uint16_t frames);
void game_update_weather(uint16_t frames);
void gameworlds_draw(int32_t camera_x, int32_t camera_y);
void gameworlds_draw_behind(int32_t camera_x, int32_t camera_y);
void gameworlds_draw_overlay(int32_t camera_x, int32_t camera_y);
@IDE_IF{HAS_WORLD_PHYSICS}
void gameworlds_before(game_world_player_t *player);
void gameworlds_after(game_world_player_t *player);
@IDE_END
@IDE_IF{HAS_PICKUPS}
/* HUD: current bag quantity for inventory-linked pickups; lifetime objects for HUD-only pickups.
 * Pickup Value (score/gold reward) does not affect these counts. */
uint32_t gameworlds_hud_total(uint16_t pickup_kind);
/* Signed pickup count change on accepted damage events (e.g. coins). */
void gameworlds_adjust_pickup(uint16_t pickup_kind, int32_t delta);
void gameworlds_hud_reset(void);
uint16_t gameworlds_check(int32_t x, int32_t y, uint16_t width, uint16_t height,
                          game_pickup_callback_t callback, void *user);
@IDE_END
void gameworlds_draw_foreground(void);
void gameworlds_draw_background(void);
void gameworlds_show_background(void);
/* Each world manages its own objects; these wrappers dispatch to active world. */
#endif
