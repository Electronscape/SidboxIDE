/* GamerGirl Stage 5.2 -- generated project-wide multi-world runtime.
 * All .sbgm projects (including one-world games) use this same API.
 * This is an API, not a second copy of the old global gameassets loader.
 */
#ifndef CODERGIRL_GAMEWORLDS_H
#define CODERGIRL_GAMEWORLDS_H
#include <stdint.h>

@IDE_IF{HAS_WORLD_PHYSICS}
#include "gameworldobjects.h"
@IDE_END
@IDE_IF{HAS_PICKUPS}
#include "gamecollectables.h"
@IDE_END

typedef struct {
    uint32_t score;
    uint32_t health;
    uint32_t lives;
    uint32_t flags;           /* YOUR persistent story flags */
    int32_t player_x100;
    int32_t player_y100;
    int32_t player_vx100;
    int32_t player_vy100;
    uint8_t user[64];         /* optional game-owned persistent data */
} gameworlds_player_state_t;

typedef void (*gameworlds_player_hook_t)(gameworlds_player_state_t *state, void *user);
typedef void (*gameworlds_inventory_put_t)(const char *name, uint16_t count, void *user);
typedef uint32_t (*gameworlds_inventory_get_t)(const char *name, void *user);

/* Register hooks to save the LIVE player before leaving a world and restore
 * to the newly-created player after its assets and physics are ready.
 * The first start does NOT call restore: create your first player normally.
 * Subsequent transitions restore only after a successful world load.
 * Hooks must not free world resources or request an immediate load. */
void gameworlds_player_hooks(gameworlds_player_hook_t save,
                             gameworlds_player_hook_t restore, void *user);
gameworlds_player_state_t *gameworlds_state(void);
uint16_t gameworlds_count(void);
const char *gameworlds_name(uint16_t index);
const char *gameworlds_active(void);
/* Physics profile configured for the active world (default if unassigned). */
uint8_t gameworlds_physics_profile(void);
@IDE_IF{HAS_SHARED_PLAYER}
#include "gametilemap.h"
/* Bind the live player ONCE after game_tile_player_start(). Applies the first
 * world's profile now and future worlds' profiles on successful entry. */
uint8_t gameworlds_bind_player_physics(game_tile_player_t *player);
@IDE_END
/* NULL or empty starts the project's selected/default world. */
uint8_t gameworlds_start(const char *name);
/* Safe inside callbacks: only queues a change. Does NOT unload anything. */
uint8_t gameworlds_request(const char *name);
/* Request a specific named entrance in the destination world.
 * "default" preserves the original Player Start behaviour. */
uint8_t gameworlds_request_at(const char *name, const char *start_id);
/* Door-trigger requests carry their world-space exit centre, for an optional
 * Circle Close around the doorway. Older callers use request_at() safely. */
uint8_t gameworlds_request_at_from(const char *name, const char *start_id,
                                   int32_t exit_x, int32_t exit_y);
/* Call OUTSIDE the frame's collision, object and drawing passes.
 * 0 = failed; 1 = no change or successful transition. */
uint8_t gameworlds_apply_pending(void);
void gameworlds_shutdown(void);
/* Player Start transition modes: 0 None; 1 Fade; 2 Left; 3 Right;
 * 4 Up; 5 Down; 6 Circle.  Duration is measured in rendered frames.
 * The generated main loop calls frame() AFTER drawing HUD/dialogue and BEFORE
 * gfx_dispfbuffer(). During an effect, skip physics/input and object updates.
 * Neither PPB cell indices nor the source CLUTs are ever edited. */
/* Existing user-owned main.c keeps instant cuts until it opts in. Without
 * frame() calls a transition could otherwise never finish. */
void gameworlds_transitions_enable(uint8_t enabled);
uint8_t gameworlds_transition_busy(void);
/* Update current camera origin before transition_frame() when using the
 * optional Player Start/door centre. No camera update = screen-centred mask. */
void gameworlds_transition_camera(int32_t camera_x, int32_t camera_y);
void gameworlds_transition_frame(uint16_t view_width, uint16_t view_height);
void gameworlds_spotlight_camera(int32_t camera_x, int32_t camera_y);
void gameworlds_spotlight_player(int32_t world_x, int32_t world_y);
void gameworlds_spotlight_frame(uint16_t view_width, uint16_t view_height);
/* 0 = off, 1 = on, 2 = toggle. Applies to currently loaded world. */
void gameworlds_spotlight_action(uint8_t action);
/* Trigger action targeting a live or unloaded world by compiled object slot.
   Unloaded targets are staged and applied at their next entry. */
uint8_t gameworlds_object_action(const char *world_name, uint16_t object_slot, uint8_t action);
/* NPC visibility actions: 0 hide, 1 show, 2 toggle; remote worlds stay unloaded. */
uint8_t gameworlds_npc_action(const char *world_name, uint16_t npc_slot, uint8_t action);
/* Seed project-wide starting items BEFORE gameworlds_start(); never resets on travel. */
void gameworlds_seed_inventory(const char *name, uint16_t initial);
/* The current map may be NULL for a scenery-only world. */
void *gameworlds_map(void);
/* Spawn belongs to the active WORLD; player graphics/stats belong to GAME. */
typedef struct { int32_t x, y; uint8_t facing; } gameworlds_spawn_t;
uint8_t gameworlds_player_start(gameworlds_spawn_t *out);
void gameworlds_update(uint16_t frames);
void gameworlds_draw(int32_t camera_x, int32_t camera_y);
void gameworlds_draw_behind(int32_t camera_x, int32_t camera_y);
@IDE_IF{HAS_WORLD_PHYSICS}
void gameworlds_before(game_world_player_t *player);
void gameworlds_after(game_world_player_t *player);
@IDE_END
@IDE_IF{HAS_PICKUPS}
/* HUD: current bag quantity for inventory-linked pickups; lifetime objects for HUD-only pickups.
 * Pickup Value (score/gold reward) does not affect these counts. */
uint32_t gameworlds_hud_total(uint16_t pickup_kind);
/* Signed pickup count change on accepted damage events (e.g. coins). */
void gameworlds_adjust_pickup(uint16_t pickup_kind, int32_t delta);
void gameworlds_hud_reset(void);
uint16_t gameworlds_check(int32_t x, int32_t y, uint16_t width, uint16_t height,
                          game_pickup_callback_t callback, void *user);
@IDE_END
void gameworlds_draw_foreground(void);
void gameworlds_draw_background(void);
void gameworlds_show_background(void);
/* Each world manages its own objects; these wrappers dispatch to active world. */
#endif
