/* GamerGirl V1 Advanced Platformer - Inventory, NPC Conversations, Choices.
   Runtime is self-contained. All dialogue/items/NPCs are generated as static
   tables by the IDE. No firmware changes or dynamic allocations. */
#ifndef GAMERGIRL_ADVENTURERUNTIME_H
#define GAMERGIRL_ADVENTURERUNTIME_H
#include <stdint.h>
#include "apis.h"
/* Rendered by GamerGirl from adventureruntime.ruleh.  The runtime's
   64-slot storage capacity remains
   independent of how many inventory types this design currently uses. */
#define GAME_ADVENTURE_MAX_ITEMS @IDE{MAX_ITEMCOUNT}u
#define GAME_ADVENTURE_CONFIGURED_ITEMS @IDE{ITEM_COUNT}u
/* The game generator passes these project values via the runtime API;
   keep definitions in the rule header rather than hardcoding C++ literals. */
#define GAME_ADVENTURE_DEFAULT_TILE_SIZE @IDE{TILE_SIZE}u
#define GAME_ADVENTURE_DEFAULT_FRAMES_PER_CHAR @IDE{FRAMES_PER_CHAR}u

typedef struct {
    const char *name;
    uint8_t pickup_kind; /* 0 = manual; 1..4 classic; 5..255 custom named pickup kinds */
    uint16_t icon;       /* Tile atlas cell; 65535 = no icon; >255 supported */
    uint16_t capacity, initial;
} game_adventure_item_t;

/* Optional per-item style table supplied by generated world data. Kept
   separate so existing game_adventure_item_t initializers remain valid. */
typedef struct {
    uint16_t icon_cells[4]; /* TL, TR, BL, BR */
    uint8_t icon_2x2;
    uint8_t discardable; /* 0 is protected: safe default */
    uint8_t droppable; /* floor drop may be allowed even for quest items */
} game_adventure_item_style_t;
void game_adventure_item_styles(const game_adventure_item_style_t *styles, uint16_t count);
void game_adventure_inventory_max_slots(uint8_t slots); /* 0 = unlimited */
void game_adventure_inventory_restore_begin(void);
void game_adventure_inventory_restore_end(void);
uint8_t game_adventure_can_collect_kind(uint16_t kind);
/* Override one item's icon source independently of the dialogue skin. */
void game_adventure_item_atlas(uint16_t item, const uint8_t *pixels,
                               uint16_t width,uint16_t height,uint8_t tile_size);
/* A persistent item can carry its ORIGINAL PPB filename across worlds even
   when that atlas is not a resource on the current map. Only carried or floor-dropped items load artwork into RAM; multiple
   item icons can share the same single PPB allocation. */
void game_adventure_item_atlas_file(uint16_t item,const char *path,
                                    uint16_t width,uint16_t height,uint8_t tile_size);
void game_adventure_prepare_owned_icons(void);
/* Optional USE effect per item: a named shared-player stat and signed delta.
 * No effect if stat is empty or callback fails. Consume one copy only on success.
 * This is deliberately separate from the stable item/style ABI. */
typedef struct { const char *stat; int32_t delta; uint8_t consume; } game_adventure_item_use_t;
typedef uint8_t (*game_adventure_use_stat_t)(const char *stat, int32_t delta, void *user);
void game_adventure_use_effects(const game_adventure_item_use_t *effects, uint16_t count,
                                game_adventure_use_stat_t handler, void *user);

/* Optional quest signal after an answer successfully commits (including GIVE).
 * Separate from Custom C events; invalid/wrong-item answers do not signal. */
/* Stage 5.166: Optional project-wide Quest Journal touchscreen bridge.
 * Set once per world, AFTER game_adventure_start(). The callbacks point to
 * the existing persistent world manager; no new game-loop/main.c API is needed.
 * This bridge is intentionally independent of gameworlds.h, so standalone
 * Adventure projects and older test programs can still link the renderer. */
typedef struct {
    uint16_t (*count)(void);
    const char *(*id)(uint16_t);
    const char *(*title)(uint16_t);
    const char *(*description)(uint16_t);
    const char *(*objective)(uint16_t);
    uint8_t (*status)(uint16_t);
    int16_t (*tracked)(void);
    uint8_t (*track)(const char *);
    uint8_t (*visible)(uint16_t); /* Optional: skip unrevealed quests */
} game_adventure_quest_ui_t;
void game_adventure_set_quest_journal(const game_adventure_quest_ui_t *source);
/* Separate optional extension preserves the legacy quest UI struct ABI. */
void game_adventure_quest_notices(uint8_t (*notice)(uint16_t *,uint32_t *));
/* Project-wide visual layout; colours are 8-bit SIDBOX palette indices. */
typedef struct {
    uint8_t margin,split_percent,background_colour,border_colour;
    uint8_t text_colour,selection_colour;
    uint8_t list_left,title_x,title_y,title_font_x,title_font_y;
    uint8_t outline_enabled,outline_colour;
} game_adventure_quest_style_t;
void game_adventure_quest_style(const game_adventure_quest_style_t *style);
/* Each icon may be a native single tile, or a 2x2 mosaic of four 8px tiles.
 * cells[5] remains for backward compatibility with saved appearance v1. */
void game_adventure_quest_icons(const uint16_t cells[5],const uint8_t flips[5]);
void game_adventure_quest_icon_composites(const uint8_t two_by_two[5],
                                         const uint16_t cells[5][4]);
/* Journal artwork is independent of dialogue nine-slice skin.
 * Invalid/missing atlas falls back to a solid palette-colour journal. */
void game_adventure_quest_skin_file(const uint8_t *asset_pixels,const char *path,
                                    uint16_t asset_width,uint16_t asset_height,
                                    uint16_t width,uint16_t height,
                                    uint8_t tile,const uint16_t cells[9],
                                    const uint8_t flips[9]);
void game_adventure_quest_viewport(uint16_t top,uint16_t height);
/* Reset scene CLUT tint before UI only; the next world frame restores weather. */
void game_adventure_set_modal_fullbright(void (*callback)(void));
/* In-game save checkpoint slot picker. Uses the existing deferred TFCard save
 * request API, never writes from the contact callback. Ten slots, 0..9. */
void game_adventure_save_slot_callbacks(uint8_t (*request)(uint8_t slot),
                                        uint8_t (*exists)(uint8_t slot));
uint8_t game_adventure_choose_save_slot(uint8_t preferred_slot);
/* Optional death overlay. Enabled only by the project-wide Defeat Designer.
 * Game-world callbacks are registered during each world setup. */
void game_adventure_defeat_setup(const uint32_t *health,
                                 uint8_t (*reload)(uint8_t),
                                 uint8_t (*exists)(uint8_t),
                                 uint8_t (*last_saved)(void),
                                 uint8_t enabled,const char *heading,const char *subtitle,
                                 uint8_t background,uint8_t border,uint8_t text,
                                 uint8_t accent,uint16_t title_x,uint16_t title_y);
typedef struct {int16_t x,y;const char *name;} game_adventure_map_point_t;
/* All map coordinates are project-wide canvas positions in pixels. */
void game_adventure_world_map(const game_adventure_map_point_t *points,
                              uint16_t count,uint16_t width,uint16_t height,
                              const char *(*current_world)(void));


typedef void (*game_adventure_choice_signal_t)(uint16_t node, uint8_t answer);
void game_adventure_set_choice_signal(game_adventure_choice_signal_t callback);
/* Fires exactly on reaching a visible dialogue node, including the first one. */
typedef void (*game_adventure_node_signal_t)(uint16_t node);
void game_adventure_set_node_signal(game_adventure_node_signal_t callback);
typedef struct {
    const char *label;
    const char *reply; /* Player's response above their head */
    int16_t next;      /* Next dialogue node, -1 = close */
    int16_t missing_next; /* Alternate node if the required item is missing, -1 = keep old no-op behaviour */
    int16_t requires;  /* Required inventory item index, -1 = no requirement */
    int16_t give;      /* Item index to grant on selection, -1 = none */
    int16_t take;      /* Item index to consume on selection, -1 = none */
    int16_t action;    /* User action ID, -1 = none */
} game_adventure_choice_t;

/* Optional per-answer inventory exchange. The four item indices are local
 * to this world's Adventure items. ALL requires all listed items; ANY only
 * one. Incremental ALL stores delivered items between conversations/worlds.
 * Wrong/partial events run without marking the NPC helped. */
#define GAME_ADVENTURE_EXCHANGE_SLOTS 768u /* 256 nodes x three choices */
#define GAME_ADVENTURE_EXCHANGE_ITEMS 4u
typedef struct {
    int16_t items[4]; /* -1 = unused */
    int16_t wrong_next, partial_next;
    int16_t wrong_action, partial_action;
    uint8_t count, any, incremental, consume;
} game_adventure_exchange_t;
void game_adventure_exchange_rules(const game_adventure_exchange_t *rules,
                                   uint16_t count);
void game_adventure_save_exchanges(uint8_t out[GAME_ADVENTURE_EXCHANGE_SLOTS]);
void game_adventure_restore_exchanges(const uint8_t saved[GAME_ADVENTURE_EXCHANGE_SLOTS]);
/* Optional repeated wrong-item response for a single item on a GIVE answer.
 * The four reply nodes cover first, second, third and fourth-or-later offers.
 * A -1 node falls back to the normal wrong-item reply. reveal_action triggers
 * ONCE on the third offer; the wrong item is never consumed. */
typedef struct {
    uint16_t exchange_index; /* dialogue_node * 3 + dialogue_choice */
    int16_t item;
    int16_t replies[4];
    /* Generated Game Object event IDs are 33000..33767, above INT16_MAX.
     * An unsigned event ID is essential: -1 (no action) maps to UINT16_MAX.
     * Otherwise the signed conversion turns valid IDs negative and the third
     * response plays without ever executing its linked action. */
    uint16_t reveal_action;
} game_adventure_wrong_repeat_t;
void game_adventure_wrong_repeat_rules(const game_adventure_wrong_repeat_t *rules,
                                       uint16_t count);
void game_adventure_save_wrong_repeats(uint8_t out[GAME_ADVENTURE_EXCHANGE_SLOTS]);
void game_adventure_restore_wrong_repeats(const uint8_t saved[GAME_ADVENTURE_EXCHANGE_SLOTS]);

typedef struct {
    const char *speaker;
    const char *text;
    game_adventure_choice_t choices[3];
} game_adventure_node_t;

typedef struct {
    int32_t x, y;      /* Sprite position in WORLD coordinates */
    uint16_t width, height, radius;
    uint16_t first_node;
} game_adventure_npc_t;

typedef struct {
    uint8_t index;
    uint8_t delay; /* Frames before moving to next animation cell */
} game_adventure_npc_frame_t;

typedef struct {
    gfxbob_t *sprite;         /* Existing placed Sprite BOB (not owned here). */
    uint8_t idle_first, idle_count, idle_speed;
    uint8_t talk_first, talk_count, talk_speed;
    const game_adventure_npc_frame_t *idle_frames;
    const game_adventure_npc_frame_t *talk_frames;
    uint8_t flip_flags; /* BLIT_FLAG_FLIP_X | BLIT_FLAG_FLIP_Y */
} game_adventure_npc_animation_t;

/* Optional dialogue-choice NPC appearance actions. Applied only after the
 * selected choice succeeds, not on a rejected GIVE exchange. Each configured
 * choice has up to two independent targets. No per-frame lookups. */
#define GAME_ADVENTURE_NPC_HIDE 0u
#define GAME_ADVENTURE_NPC_SHOW 1u
#define GAME_ADVENTURE_NPC_TOGGLE 2u
typedef struct {
    uint16_t choice_id; /* node*3+answer, or node_count*3+node for no-answer close */
    uint16_t npc_a, npc_b; /* UINT16_MAX = no target */
    uint8_t action_a, action_b;
} game_adventure_npc_choice_action_t;
void game_adventure_npc_choice_actions(const game_adventure_npc_choice_action_t *rules,
                                       uint16_t count);
/* Sparse remote NPC rules used by choices and terminal dialogue-close events. */
typedef struct {
    uint16_t event_id, npc_slot;
    const char *world;
    uint8_t action;
} game_adventure_remote_npc_rule_t;
void game_adventure_remote_npc_actions(const game_adventure_remote_npc_rule_t *rules,
                                     uint16_t count,
                                     uint8_t (*apply)(const char *,uint16_t,uint8_t));
/* Optional dialogue choice / terminal-close lighting actions (0 off,1 on,2 toggle). */
typedef struct { uint16_t event_id; uint8_t action; } game_adventure_spotlight_rule_t;
void game_adventure_spotlight_actions(const game_adventure_spotlight_rule_t *rules,
                                     uint16_t count, void (*apply)(uint8_t));
/* Optional ONE-TIME reward on closing a dialogue node with no answers.
 * Kept separate from game_adventure_choice_t to preserve its ABI. */
#define GAME_ADVENTURE_CLOSE_GIFT_BYTES 32u /* up to 256 dialogue nodes */
typedef struct { uint16_t node_id, item_id; } game_adventure_close_gift_t;
void game_adventure_close_gifts(const game_adventure_close_gift_t *rules,uint16_t count);
void game_adventure_save_close_gifts(uint8_t out[GAME_ADVENTURE_CLOSE_GIFT_BYTES]);
void game_adventure_restore_close_gifts(const uint8_t saved[GAME_ADVENTURE_CLOSE_GIFT_BYTES]);
/* Apply project defaults once, immediately AFTER game_adventure_start().
 * Separate from game_adventure_npc_t to preserve existing source/ABI layout. */
void game_adventure_npc_initial_visibility(const uint8_t *defaults, uint16_t count);
void game_adventure_set_npc_visible(uint16_t npc, uint8_t visible);
uint8_t game_adventure_npc_visible(uint16_t npc);
void game_adventure_npc_action(uint16_t npc, uint8_t action);


typedef void (*game_adventure_action_t)(uint16_t action, void *user);

/* Call after gameassets_init(). skin_pixels is optional; cells are a 3x3
   arrangement at the given atlas indices. Nine 8x8 cells are typical.
   Atlas memory belongs to gameassets and must remain alive. */
void game_adventure_start(const game_adventure_item_t *items, uint16_t item_count,
                          const game_adventure_node_t *nodes, uint16_t node_count,
                          const game_adventure_npc_t *npcs, uint16_t npc_count,
                          const uint8_t *skin_pixels, uint16_t atlas_width,
                          uint16_t atlas_height, uint8_t tile_size,
                          const uint16_t skin_indices[9], uint8_t frames_per_char,
                          game_adventure_action_t action, void *user);
/* FIRE2 talks to an NPC in range; otherwise opens inventory, except when
   a nearby FIRE2 trigger (door/switch) has priority. FIRE2 closes inventory.
   BTN_UP/DOWN navigate choices or inventory. FIRE2 uses edge detection.
   Return 1 while gameplay must be paused. */
/* Read-only priority query for a world-specific FIRE2 door/switch.  A positive
   return means normal game input should handle FIRE2 rather than inventory.
   The world registers its query during its Adventure setup. */
typedef uint8_t (*game_adventure_fire2_action_t)(int32_t x, int32_t y,
                                                  uint16_t w, uint16_t h);
void game_adventure_set_fire2_action(game_adventure_fire2_action_t action);
/* Stage 5.91: proximity USE, using existing inventory and FIRE2 input.
 * probe selects a live target; use receives the selected inventory item name.
 * Return 0 on mismatch, 1 on success, 2 on success consuming one item. */
typedef uint8_t (*game_adventure_interaction_use_t)(const char *item_name);
void game_adventure_set_interaction(game_adventure_fire2_action_t probe,
                                     game_adventure_interaction_use_t use);
/* Optional callback fired when FIRE2 cancels a targeted USE selection.
   Callback argument 2 = cancel. No callback is invoked if NULL. */
typedef void (*game_adventure_interaction_sound_t)(uint8_t event);
void game_adventure_set_interaction_sound(game_adventure_interaction_sound_t sound);
uint8_t game_adventure_input(uint8_t buttons, int32_t player_x, int32_t player_y,
                             uint16_t player_w, uint16_t player_h, uint16_t frames);
/* Mask FIRE1 while Adventure owns input and until a consumed press is
   released. Physics helpers use this automatically when linked. Custom
   physics can call it directly before reading jump input. */
uint8_t game_adventure_gameplay_buttons(uint8_t buttons);
/* Appearance settings (foreground CLUT indices). Defaults: text 15, no outline. */
void game_adventure_skin_flips(const uint8_t flips[9]);
void game_adventure_text_style(uint8_t text_index, uint8_t outline_enabled,
                               uint8_t outline_index);
/* Optional independent player thought text CLUT colour. */
void game_adventure_thought_text_colour(uint8_t colour_index);
/* Optional initial facing (0=left, 1=right). Gameplay LEFT/RIGHT updates it. */
void game_adventure_set_player_facing(uint8_t facing_right);
/* Optional floor query for dropped 16x16 items. It receives world-space X,
   previous item-top Y and candidate item-top Y; return the first safe landing
   top Y, or INT32_MAX if there is no landing surface. The generated game
   registers the active tilemap automatically. No allocation is involved. */
typedef int32_t (*game_adventure_drop_floor_t)(int32_t x, int32_t old_y,
                                              int32_t next_y);
void game_adventure_set_drop_floor(game_adventure_drop_floor_t query);
/* Sweep the entire 16x16 item horizontally from the player's foot towards
   the desired drop X. Return the last unblocked item-left X, or INT32_MIN
   if even the foot-side starting position is obstructed. */
typedef int32_t (*game_adventure_drop_sweep_t)(int32_t start_x,
                                                int32_t target_x, int32_t item_y);
void game_adventure_set_drop_sweep(game_adventure_drop_sweep_t query);
/* Callback when a dropped 16x16 inventory item touches a Trigger sensor.
   Return 0 = no successful activation, 1 = activated/leave on ground,
   2 = activated/consume the physical item. Invoked once per dropped item
   after a successful activation, even if the item remains on the ground. */
typedef uint8_t (*game_adventure_drop_contact_t)(const char *item_name,
                                                  int32_t x, int32_t y);
void game_adventure_set_drop_contact(game_adventure_drop_contact_t contact);
/* Optional true Player Animation foot anchor (sprite-local coordinates).
   The callback reads live sprite TOP-LEFT without changing player hitbox.
   Foot X also centres NPC talk-range checks; NPC vertical range is unchanged.
   The fall and pickup collision continue using the original item rules. */
typedef uint8_t (*game_adventure_sprite_origin_t)(int32_t *x, int32_t *y);
void game_adventure_set_drop_anchor(game_adventure_sprite_origin_t source,
                                    int16_t foot_x, int16_t foot_y,
                                    uint16_t hitbox_w, uint16_t hitbox_h);
/* Read-only callback providing the player's ACTUAL collision rectangle for
 * recollecting drops. If unavailable, use the legacy input coordinates.
 * This does not change how NPCs, doors or map collision interpret input. */
typedef uint8_t (*game_adventure_pickup_rect_t)(int32_t *x, int32_t *y,
                                                uint16_t *w, uint16_t *h);
void game_adventure_set_pickup_rect(game_adventure_pickup_rect_t source);
/* Optional per-game dialogue box position/width and MINIMUM height on the
   480x320 LCD. A dialogue grows to fit its text and two visible choices.
   If it would run off the bottom, its Y is raised to keep the frame visible.
   Existing designs retain their saved minimum and position. */
void game_adventure_dialogue_box(int16_t x, int16_t y, uint16_t width, uint16_t height);
/* Optional thought bubbles: per-choice bit 0 means show with NEXT dialogue;
 * bit 1 means show on THIS dialogue with the highlighted answer, or on
 * an answerless node (first flagged non-empty Player speech, no Answer).
 * Index is node*3+answer; legacy flag values (0/1) still work unchanged.
 * Uses the same loaded PPB atlas, with its own nine-slice cell layout. */
void game_adventure_thought_choices(const uint8_t *flags, uint16_t count);
void game_adventure_thought_box(int16_t x, int16_t y, uint16_t width,
    uint16_t height, const uint16_t indices[9], const uint8_t flips[9]);
/* Extra clear space INSIDE the skin's border for NPC dialogue and
   player reply bubbles: 0 or 8 pixels. Without a skin, measured from
   the plain box edge. Inventory always gets 8px beyond its skin border. */
void game_adventure_text_padding(uint8_t pixels);
/* Native 8x8 glyph pixels, scaled independently on X and Y. Each scale is
   1, 2, 4 or 8. Defaults 1x2 preserve older dialogues' 8x16 footprint.
   thought_on_top: 1 = thought drawn last, 0 = main dialogue drawn last. */
void game_adventure_dialogue_typography(uint8_t dialog_x, uint8_t dialog_y,
    uint8_t thought_x, uint8_t thought_y, uint8_t thought_on_top);
/* Optional per-node flags: 1 = once-only, 2 = mark talking NPC completed.
   These separate tables preserve compatibility with older dialogue structs. */
void game_adventure_story_flags(const uint8_t *choice_flags,
                                const uint16_t *completed_nodes);
/* Save only world-local dialogue progress; inventory is shared separately. */
#define GAME_ADVENTURE_USED_CHOICE_BYTES 96u
#define GAME_ADVENTURE_COMPLETED_NPC_BYTES 256u
void game_adventure_save_progress(uint8_t used_choices[96], uint8_t completed_npcs[256]);
void game_adventure_restore_progress(const uint8_t used_choices[96], const uint8_t completed_npcs[256]);
/* Saved per world in generated gameadventure.c. Not yet TFCard save-game data. */
#define GAME_ADVENTURE_NPC_VISIBILITY_BYTES 256u
void game_adventure_save_npc_visibility(uint8_t out[GAME_ADVENTURE_NPC_VISIBILITY_BYTES]);
void game_adventure_restore_npc_visibility(const uint8_t saved[GAME_ADVENTURE_NPC_VISIBILITY_BYTES]);
/* Optional NPC idle/talking atlas sequences. Called AFTER game_adventure_start.
   Animated Sprite BOBs are still drawn by the game's regular sprite draw calls. */
void game_adventure_npc_animations(const game_adventure_npc_animation_t *animations,
                                   uint16_t count);
typedef uint8_t (*game_adventure_item_visible_t)(const char *name);
/* Source-compatibility hook for existing world controllers. Backpack rows now
 * display ONLY owned items (quantity > 0), even when tagged secret. The tag
 * never changes NPC requirements, quantities or pickup behaviour. */
void game_adventure_set_inventory_filter(game_adventure_item_visible_t filter);
uint8_t game_adventure_open(void);
/* Triggers can open the same configured dialogue nodes as NPCs. Their
 * choices, dialogue artwork, quest actions and modal input are reused. */
uint8_t game_adventure_trigger_dialogue(uint16_t node);
/* Show only the chosen node's speaker/text. No choices, gifts, NPC or quest
 * actions are run: Trigger outcomes have already committed on successful USE. */
uint8_t game_adventure_trigger_message(uint16_t node);
/* Navigate multiple existing dialogue nodes via their choice labels and Next
 * links (e.g. Continue... / Thank god!). No inventory or dialogue effects run. */
uint8_t game_adventure_trigger_sequence(uint16_t node);
/* Reward by inventory NAME, never by world-local index. Preflight includes
 * capacity AND a key slot freed by successful consumption. */
uint8_t game_adventure_can_reward_name(const char *name,uint16_t quantity,
                                       const char *consumed_item);
uint8_t game_adventure_reward_name(const char *name,uint16_t quantity);
uint8_t game_adventure_take_name(const char *name,uint16_t quantity);
/* Draw all configured NPC sprite BOBs at their CURRENT generated world positions.
   Call once after world tiles and before the player; no manual Guardian coordinates. */
void game_adventure_draw_npcs(int32_t camera_x, int32_t camera_y);
void game_adventure_draw(int32_t camera_x, int32_t camera_y,
                          int32_t player_x, int32_t player_y);
/* Inventory API: indexes are zero-based in the Adventure Editor Items list. */
uint16_t game_adventure_quantity(uint16_t index);
/* Sum the CURRENT inventory balance for one collectible type.
 * Returns 1 if an inventory definition exists (even when the balance is zero);
 * returns 0 if this pickup type is not represented in this world's bag.
 * The output counts owned ITEMS, never Pickup Value/score. */
uint8_t game_adventure_pickup_quantity(uint16_t kind, uint32_t *total);
uint16_t game_adventure_add(uint16_t index, uint16_t amount);
uint8_t game_adventure_remove(uint16_t index, uint16_t amount);
/* World-local dropped collectibles (no allocations; at most 16 objects).
   Dropped items can be recovered by leaving their position then touching
   them again; progress hooks preserve drops when changing worlds. */
#define GAME_ADVENTURE_MAX_DROPS 16u
typedef struct {
    int32_t x, y;
    uint16_t item_id;
    uint8_t active, armed; /* armed bit0 = can recollect; bit1 = drop-trigger already fired. */
} game_adventure_drop_t;
void game_adventure_save_drops(game_adventure_drop_t out[GAME_ADVENTURE_MAX_DROPS]);
void game_adventure_restore_drops(const game_adventure_drop_t saved[GAME_ADVENTURE_MAX_DROPS]);
/* Bridge existing Collectable callback: matching pickup_kind gains ONE item.
   Returns number of inventory definitions matched, 0 if none. */
uint16_t game_adventure_collect(uint16_t pickup_kind);
/* The managed pickup bridge adds the actual value before the user's callback.
   These helpers prevent legacy callbacks adding another +1 to the same item. */
uint16_t game_adventure_collect_amount(uint16_t pickup_kind, uint16_t amount);
/* Change the quantity of a pickup type once, respecting capacity/zero. */
uint8_t game_adventure_adjust_pickup(uint16_t pickup_kind, int32_t delta);
