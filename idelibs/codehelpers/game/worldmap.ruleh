#ifndef @IDE{WORLD_HEADER_GUARD}
#define @IDE{WORLD_HEADER_GUARD}
#include <stdint.h>
#include "../gamehelpers/gametilemap.h"

/* Generated from Tilemap Editor > Name Zone (project-specific).
 * Edit names in GamerGirl and export the tilemap again.
 * Zones 1..8 are unchanged by solid/pass-through selection. */
@IDE{ZONE_ROWS}
@IDE_IF{EMBEDDED}
extern const uint16_t @IDE{WORLD_SYMBOL}_graphics[];
extern const uint8_t @IDE{WORLD_SYMBOL}_collisions[];
extern const uint8_t @IDE{WORLD_SYMBOL}_flips[];
extern const uint8_t @IDE{WORLD_SYMBOL}_slopes[];
extern const uint16_t @IDE{WORLD_SYMBOL}_shape_refs[];
extern const game_tile_shape_t @IDE{WORLD_SYMBOL}_shape_defs[];
extern const game_tile_shape_point_t @IDE{WORLD_SYMBOL}_shape_points[];
extern const game_tile_shape_instance_t @IDE{WORLD_SYMBOL}_shape_instances[];
extern const game_tile_animation_t @IDE{WORLD_SYMBOL}_animations[];
@IDE_END
uint8_t @IDE{WORLD_SYMBOL}_load_map(const char *filename);
void @IDE{WORLD_SYMBOL}_unload_map(void);
uint8_t @IDE{WORLD_SYMBOL}_load_atlas(void);
void @IDE{WORLD_SYMBOL}_unload_atlas(void);
extern game_tilemap_t @IDE{WORLD_SYMBOL};
#endif

@IDE_SECTION{ZONE_ID}
#define GAME_ZONE_ID_CUSTOM_@IDE{ZONE} @IDE{ZONE}u
@IDE_SECTION_END
@IDE_SECTION{ZONE_ALIAS}
#define @IDE{ALIAS} GAME_ZONE_ID_CUSTOM_@IDE{ZONE}
@IDE_SECTION_END
