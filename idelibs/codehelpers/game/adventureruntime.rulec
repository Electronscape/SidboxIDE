#include "adventureruntime.h"
#include "apis.h"
#include <string.h>


/* Bounded static memory: 64 inventory types, up to 3 choices per node. */
#define GA_MAX_ITEMS GAME_ADVENTURE_MAX_ITEMS
#define GA_COLS @IDE{GA_COLS} /* 8-pixel-wide glyphs, not 16-pixel glyphs. */
#define GA_LINES @IDE{GA_LINES}

/* Lets do a lot of sex! */
/* Design-time values. These are filled from Adventure Editor when this
   .rulec is rendered into gameadventureruntime.c by Update Game Project.
   Runtime counters/pointers below are internal state, not project settings. */


#define GA_DIALOG_DEFAULT_X @IDE{DIALOG_X}
#define GA_DIALOG_DEFAULT_Y @IDE{DIALOG_Y}
#define GA_DIALOG_DEFAULT_W @IDE{DIALOG_WIDTH}u
#define GA_DIALOG_DEFAULT_H @IDE{DIALOG_HEIGHT}u
#define GA_TEXT_DEFAULT_COLOUR @IDE{TEXT_COLOUR_INDEX}u
#define GA_TEXT_DEFAULT_OUTLINE @IDE{TEXT_OUTLINE_ENABLED}u
#define GA_TEXT_DEFAULT_OUTLINE_COLOUR @IDE{OUTLINE_COLOUR_INDEX}u
static const game_adventure_item_t *ga_items;
static const game_adventure_node_t *ga_nodes;
static const game_adventure_npc_t *ga_npcs;
static uint16_t ga_item_count, ga_node_count, ga_npc_count;
static uint16_t ga_counts[GA_MAX_ITEMS];
static game_adventure_item_visible_t ga_inventory_filter;
void game_adventure_set_inventory_filter(game_adventure_item_visible_t filter)
{ ga_inventory_filter = filter; }
/* Backpack rows represent what the player HAS, not everything the game
 * knows about. Zero-quantity entries stay off-screen. A secret item's saved
 * hidden marker is a discovery hint, not a permanent block: once its live
 * count is nonzero, show the item by name. Dialogue/pickup quantities use
 * ga_counts independently of this display rule.
 *
 * Keep the older filter setter for source compatibility with generated
 * world managers; its static hidden flag cannot conceal an owned item.
 */
static uint8_t ga_item_visible(uint16_t i)
{
    return i < ga_item_count && ga_counts[i] != 0u;
}
static uint16_t ga_visible_count(void)
{
    uint16_t total = 0;
    for (uint16_t i = 0; i < ga_item_count; ++i) if (ga_item_visible(i)) ++total;
    return total;
}
static uint16_t ga_visible_item_id(uint16_t display_index)
{
    for (uint16_t i = 0; i < ga_item_count; ++i)
        if (ga_item_visible(i) && display_index-- == 0) return i;
    return ga_item_count;
}
/* 256 nodes x 3 choices: 96 bytes for once-only flags. One bit per choice. */
static uint8_t ga_used_choices[(256u * 3u + 7u) / 8u];
static uint8_t ga_completed_npcs[256];
void game_adventure_save_progress(uint8_t used_choices[96], uint8_t completed_npcs[256])
{
    if (!used_choices || !completed_npcs) return;
    memcpy(used_choices, ga_used_choices, sizeof(ga_used_choices));
    memcpy(completed_npcs, ga_completed_npcs, sizeof(ga_completed_npcs));
}
void game_adventure_restore_progress(const uint8_t used_choices[96], const uint8_t completed_npcs[256])
{
    if (!used_choices || !completed_npcs) return;
    memcpy(ga_used_choices, used_choices, sizeof(ga_used_choices));
    memcpy(ga_completed_npcs, completed_npcs, sizeof(ga_completed_npcs));
}
static const uint8_t *ga_choice_flags; /* node * 3 + answer */
static const uint16_t *ga_completed_nodes; /* NPC index; UINT16_MAX => no alternate */
void game_adventure_story_flags(const uint8_t *choice_flags,
                                const uint16_t *completed_nodes)
{
    ga_choice_flags = choice_flags;
    ga_completed_nodes = completed_nodes;
}

static uint8_t ga_state; /* 0 idle, 1 dialogue, 2 inventory, 3 reply */
static uint8_t ga_prev_buttons, ga_choice, ga_inventory_offset;
static void ga_inventory_clamp_offset(void)
{
    const uint16_t visible = ga_visible_count();
    const uint16_t max_offset = visible > GA_LINES ? (uint16_t)(visible - GA_LINES) : 0u;
    if (ga_inventory_offset > max_offset) ga_inventory_offset = (uint8_t)max_offset;
}
static uint16_t ga_node, ga_typed, ga_ticks, ga_reply_typed, ga_reply_ticks;
static int16_t ga_after_reply;
static const char *ga_reply;
static int32_t ga_player_x, ga_player_y;
static const uint8_t *ga_skin_pixels;
static uint16_t ga_skin_w, ga_skin_h;
static uint8_t ga_tile, ga_frames_per_char;
static uint16_t ga_skin_indices[9];
static uint8_t ga_skin_flips[9];
static uint8_t ga_text_colour=GA_TEXT_DEFAULT_COLOUR;
static uint8_t ga_outline_enabled=GA_TEXT_DEFAULT_OUTLINE;
static uint8_t ga_outline_colour=GA_TEXT_DEFAULT_OUTLINE_COLOUR;
/* Dialogue height is a MINIMUM: expanded at draw time for the current node. */
static int16_t ga_dialog_x=GA_DIALOG_DEFAULT_X, ga_dialog_y=GA_DIALOG_DEFAULT_Y;
static uint16_t ga_dialog_w=GA_DIALOG_DEFAULT_W, ga_dialog_h=GA_DIALOG_DEFAULT_H;

void game_adventure_dialogue_box(int16_t x, int16_t y, uint16_t width, uint16_t height)
{
    /* Never let a text window extend outside the 480x320 LCD. */
    if (width < 128u) width = 128u;
    if (height < 96u) height = 96u;
    if (width > 480u) width = 480u;
    if (height > 320u) height = 320u;
    if (x < 0) x = 0;
    if (y < 0) y = 0;
    if (x > 480 - (int)width) x = (int16_t)(480 - width);
    if (y > 320 - (int)height) y = (int16_t)(320 - height);
    ga_dialog_x = x; ga_dialog_y = y;
    ga_dialog_w = width; ga_dialog_h = height;
}
static const game_adventure_npc_animation_t *ga_animations;
static uint16_t ga_animation_count, ga_active_npc;
static uint16_t ga_animation_ticks[256];
static uint8_t ga_animation_frames[256], ga_animation_mode[256];
static uint8_t ga_animation_original_index[256];
static game_adventure_action_t ga_action;
static void *ga_user;

void game_adventure_skin_flips(const uint8_t flips[9])
{
    for (uint8_t i=0;i<9;++i) ga_skin_flips[i] = flips ? flips[i] : 0;
}

void game_adventure_text_style(uint8_t text_index, uint8_t outline_enabled,
                               uint8_t outline_index)
{
    ga_text_colour = text_index;
    ga_outline_enabled = outline_enabled ? 1u : 0u;
    ga_outline_colour = outline_index;
}

void game_adventure_npc_animations(const game_adventure_npc_animation_t *animations,
                                   uint16_t count)
{
    ga_animations = animations;
    ga_animation_count = animations && count <= 256u ? count : (animations ? 256u : 0u);
    memset(ga_animation_ticks, 0, sizeof(ga_animation_ticks));
    memset(ga_animation_frames, 0, sizeof(ga_animation_frames));
    memset(ga_animation_mode, 0xFF, sizeof(ga_animation_mode));
    for (uint16_t i=0; i<ga_animation_count; ++i)
        ga_animation_original_index[i] = animations[i].sprite ? animations[i].sprite->index : 0;
}

/* The animation follows the active conversation, but ticking happens during
   game_adventure_input(), so custom main.c needs no new frame-loop hook. */
static void ga_tick_animations(uint16_t frames)
{
    for (uint16_t i = 0; i < ga_animation_count; ++i) {
        const game_adventure_npc_animation_t *a = &ga_animations[i];
        if (!a->sprite || !a->sprite->imgdat) continue;
        const uint8_t speaking = (ga_state == 1u && ga_active_npc == i) ? 1u : 0u;
        const uint16_t first = speaking && a->talk_count ? a->talk_first : a->idle_first;
        const uint16_t count = speaking && a->talk_count ? a->talk_count : a->idle_count;
        const uint16_t rate = speaking && a->talk_count ? a->talk_speed : a->idle_speed;
        const game_adventure_npc_frame_t *sequence = speaking && a->talk_count
            ? a->talk_frames : a->idle_frames;
        if (!count) {
            if (ga_animation_mode[i] != 0xFFu) {
                a->sprite->index = ga_animation_original_index[i];
                ga_animation_mode[i] = 0xFFu;
            }
            continue;
        }
        const uint16_t max_cells = (a->sprite->width && a->sprite->height)
            ? (uint16_t)((a->sprite->atlas_stride / a->sprite->width) *
                         (a->sprite->atlas_height / a->sprite->height)) : 0;
        if (!sequence && (first + count > max_cells || first + count > 256u)) continue;
        if (ga_animation_mode[i] != speaking) {
            ga_animation_mode[i] = speaking;
            ga_animation_ticks[i] = 0;
            ga_animation_frames[i] = 0;
        } else {
            uint32_t remaining = (uint32_t)ga_animation_ticks[i] + frames;
            /* Each frame has its own delay (the older contiguous format uses
               a constant speed). Bound each update to avoid heavy work after
               a pause, even if the game reports an unusually large delta. */
            const uint32_t bounded = remaining > 65535u ? 65535u : remaining;
            remaining = bounded;
            uint16_t steps = 0;
            while (steps < 256u) {
                uint16_t current = ga_animation_frames[i];
                uint16_t delay = sequence ? sequence[current].delay : rate;
                if (!delay) delay = 1;
                if (remaining < delay) break;
                remaining -= delay;
                ga_animation_frames[i] = (uint8_t)((current + 1u) % count);
                ++steps;
            }
            ga_animation_ticks[i] = (uint16_t)remaining;
        }
        const uint16_t chosen = sequence ? sequence[ga_animation_frames[i]].index
                                         : first + ga_animation_frames[i];
        if (chosen < max_cells && chosen < 256u)
            a->sprite->index = (uint8_t)chosen;
    }
}

uint8_t game_adventure_open(void) { return ga_state != 0; }
uint16_t game_adventure_quantity(uint16_t i) { return i < ga_item_count ? ga_counts[i] : 0; }
uint16_t game_adventure_add(uint16_t i, uint16_t n)
{
    if (i >= ga_item_count) return 0;
    const uint16_t old = ga_counts[i], max = ga_items[i].capacity;
    const uint32_t wanted = (uint32_t)old + n;
    ga_counts[i] = (uint16_t)(wanted > max ? max : wanted);
    return ga_counts[i] - old;
}
uint8_t game_adventure_remove(uint16_t i, uint16_t n)
{
    if (i >= ga_item_count || ga_counts[i] < n) return 0;
    ga_counts[i] -= n;
    return 1;
}
uint16_t game_adventure_collect(uint16_t kind)
{
    uint16_t matched = 0;
    for (uint16_t i = 0; i < ga_item_count; ++i)
        if (kind && ga_items[i].pickup_kind == kind) {
            game_adventure_add(i, 1); ++matched;
        }
    return matched;
}

void game_adventure_start(const game_adventure_item_t *items, uint16_t item_count,
                          const game_adventure_node_t *nodes, uint16_t node_count,
                          const game_adventure_npc_t *npcs, uint16_t npc_count,
                          const uint8_t *skin_pixels, uint16_t atlas_width,
                          uint16_t atlas_height, uint8_t tile_size,
                          const uint16_t skin_indices[9], uint8_t frames_per_char,
                          game_adventure_action_t action, void *user)
{
    ga_items = items; ga_item_count = item_count > GA_MAX_ITEMS ? GA_MAX_ITEMS : item_count;
    ga_nodes = nodes; ga_node_count = node_count;
    ga_npcs = npcs; ga_npc_count = npc_count;
    memset(ga_counts, 0, sizeof(ga_counts));
    memset(ga_used_choices, 0, sizeof(ga_used_choices));
    memset(ga_completed_npcs, 0, sizeof(ga_completed_npcs));
    ga_choice_flags = 0;
    ga_completed_nodes = 0;
    for (uint16_t i = 0; i < ga_item_count; ++i)
        ga_counts[i] = ga_items[i].initial > ga_items[i].capacity
            ? ga_items[i].capacity : ga_items[i].initial;
    ga_state = ga_prev_buttons = ga_choice = ga_inventory_offset = 0;
    ga_active_npc = 0xFFFFu;
    game_adventure_npc_animations(0,0);
    game_adventure_text_style(GA_TEXT_DEFAULT_COLOUR,
                              GA_TEXT_DEFAULT_OUTLINE,
                              GA_TEXT_DEFAULT_OUTLINE_COLOUR);
    ga_node = ga_typed = ga_ticks = ga_reply_typed = ga_reply_ticks = 0;
    ga_after_reply = -1; ga_reply = 0;
    ga_skin_pixels = skin_pixels; ga_skin_w = atlas_width; ga_skin_h = atlas_height;
    ga_tile = tile_size >= 4 && tile_size <= 32 ? tile_size
                                                    : GAME_ADVENTURE_DEFAULT_TILE_SIZE;
    for (uint8_t i = 0; i < 9; ++i) ga_skin_indices[i] = skin_indices ? skin_indices[i] : i;
    game_adventure_skin_flips(0);
    ga_frames_per_char = frames_per_char ? frames_per_char
                                           : GAME_ADVENTURE_DEFAULT_FRAMES_PER_CHAR;
    ga_action = action; ga_user = user;
    game_adventure_dialogue_box(GA_DIALOG_DEFAULT_X, GA_DIALOG_DEFAULT_Y,
                                GA_DIALOG_DEFAULT_W, GA_DIALOG_DEFAULT_H);
}
static uint8_t ga_choice_visible(uint16_t node, uint8_t choice)
{
    if (node >= ga_node_count || choice >= 3u) return 0;
    const game_adventure_choice_t *c = &ga_nodes[node].choices[choice];
    if (!c->label || !c->label[0]) return 0;
    const uint16_t bit = (uint16_t)(node * 3u + choice);
    if (!ga_choice_flags || !(ga_choice_flags[bit] & 1u)) return 1;
    return !(ga_used_choices[bit / 8u] & (uint8_t)(1u << (bit % 8u)));
}
static void ga_mark_choice_used(uint16_t node, uint8_t choice)
{
    if (node >= 256u || choice >= 3u) return;
    const uint16_t bit = (uint16_t)(node * 3u + choice);
    ga_used_choices[bit / 8u] |= (uint8_t)(1u << (bit % 8u));
}
static uint8_t ga_has_choices(void)
{
    if (ga_node >= ga_node_count) return 0;
    uint8_t n = 0;
    for (uint8_t i = 0; i < 3; ++i)
        if (ga_choice_visible(ga_node,i)) ++n;
    return n;
}
static uint8_t ga_allowed(const game_adventure_choice_t *c)
{
    return c->requires < 0 || ((uint16_t)c->requires < ga_item_count && ga_counts[c->requires]);
}
/* Called by the reply helper below, before its full definition. */
static void ga_next_node(int16_t node);
static void ga_reply_then_next(const game_adventure_choice_t *c, int16_t next_node)
{
    ga_reply = c->reply && c->reply[0] ? c->reply : c->label;
    ga_reply_typed = 0;
    if (ga_reply && ga_reply[0]) {
        ga_after_reply = next_node;
        ga_reply_ticks = 0;
        ga_state = 3;
    } else {
        ga_next_node(next_node);
    }
}
static void ga_next_node(int16_t node)
{
    if (node < 0 || node >= ga_node_count) { ga_state = 0; return; }
    ga_node = (uint16_t)node; ga_state = 1;
    ga_choice = 0; ga_typed = 0; ga_ticks = 0;
    for (uint8_t i=0;i<3;++i)
        if (ga_choice_visible(ga_node,i)) { ga_choice=i; break; }
}
uint8_t game_adventure_input(uint8_t buttons, int32_t player_x, int32_t player_y,
                             uint16_t player_w, uint16_t player_h, uint16_t frames)
{
    const uint8_t press = (buttons & BTN_FIRE2) && !(ga_prev_buttons & BTN_FIRE2);
    const uint8_t up = (buttons & BTN_UP) && !(ga_prev_buttons & BTN_UP);
    const uint8_t down = (buttons & BTN_DOWN) && !(ga_prev_buttons & BTN_DOWN);
    ga_prev_buttons = buttons;
    ga_tick_animations(frames);
    ga_player_x = player_x; ga_player_y = player_y;
    if (ga_state == 0) {
        if (!press) return 0;
        const int32_t pcx = player_x + player_w / 2, pcy = player_y + player_h / 2;
        for (uint16_t i = 0; i < ga_npc_count; ++i) {
            const game_adventure_npc_t *npc = &ga_npcs[i];
            const int32_t nx = npc->x + npc->width / 2;
            const int32_t ny = npc->y + npc->height / 2;
            const int32_t dx = nx - pcx, dy = ny - pcy;
            if (dx >= -(int32_t)npc->radius && dx <= npc->radius &&
                dy >= -(int32_t)npc->radius && dy <= npc->radius && npc->first_node < ga_node_count) {
                ga_active_npc = i;
                const uint16_t after = ga_completed_nodes ? ga_completed_nodes[i] : UINT16_MAX;
                const uint16_t start = ga_completed_npcs[i] && after < ga_node_count
                    ? after : npc->first_node;
                ga_next_node((int16_t)start);
                return 1;
            }
        }
        if (buttons & BTN_UP) { ga_state = 2; ga_inventory_offset = 0; return 1; }
        return 0;
    }
    if (ga_state == 2) {
        ga_inventory_clamp_offset();
        if (press) { ga_state = 0; return 0; }
        if (down && ga_inventory_offset + GA_LINES < ga_visible_count()) ++ga_inventory_offset;
        if (up && ga_inventory_offset) --ga_inventory_offset;
        return 1;
    }
    if (ga_state == 3) {
        if (ga_reply && ga_reply_typed < strlen(ga_reply)) {
            const uint32_t elapsed = (uint32_t)ga_reply_ticks + frames;
            ga_reply_typed += elapsed / ga_frames_per_char;
            ga_reply_ticks = (uint16_t)(elapsed % ga_frames_per_char);
            if (ga_reply_typed > strlen(ga_reply)) ga_reply_typed = (uint16_t)strlen(ga_reply);
        }
        if (press) ga_next_node(ga_after_reply);
        return 1;
    }
    if (ga_node >= ga_node_count) { ga_state = 0; return 0; }
    const game_adventure_node_t *n = &ga_nodes[ga_node];
    const uint16_t text_len = (uint16_t)strlen(n->text ? n->text : "");
    if (ga_typed < text_len) {
        const uint32_t elapsed = (uint32_t)ga_ticks + frames;
        ga_typed += elapsed / ga_frames_per_char;
        ga_ticks = (uint16_t)(elapsed % ga_frames_per_char);
        if (ga_typed > text_len) ga_typed = text_len;
    }
    const uint8_t count = ga_has_choices();
    if (count && up) {
        do { ga_choice = (uint8_t)((ga_choice + 2) % 3); }
        while (!ga_choice_visible(ga_node,ga_choice));
    }
    if (count && down) {
        do { ga_choice = (uint8_t)((ga_choice + 1) % 3); }
        while (!ga_choice_visible(ga_node,ga_choice));
    }
    if (press) {
        if (ga_typed < text_len) { ga_typed = text_len; return 1; }
        if (!count) { ga_state = 0; return 0; }
        if (!ga_choice_visible(ga_node,ga_choice)) { ga_next_node((int16_t)ga_node); return 1; }
        const game_adventure_choice_t *c = &n->choices[ga_choice];
        if (!ga_allowed(c)) {
            /* No item: branch directly to the alternate NPC dialogue.
               Never display the successful answer's player-speech bubble,
               and never execute its item, event or completion actions. */
            if (c->missing_next >= 0 && c->missing_next < ga_node_count)
                ga_next_node(c->missing_next);
            return 1;
        }
        if (c->take >= 0 && !game_adventure_remove((uint16_t)c->take, 1)) return 1;
        if (c->give >= 0) game_adventure_add((uint16_t)c->give, 1);
        if (c->action >= 0 && ga_action) ga_action((uint16_t)c->action, ga_user);
        /* Only mark successful actions. Missing requirements / items never consume the flag. */
        const uint16_t flag_index = (uint16_t)(ga_node * 3u + ga_choice);
        const uint8_t flags = ga_choice_flags ? ga_choice_flags[flag_index] : 0u;
        if (flags & 1u) ga_mark_choice_used(ga_node,ga_choice);
        if ((flags & 2u) && ga_active_npc < ga_npc_count && ga_active_npc < 256u)
            ga_completed_npcs[ga_active_npc] = 1u;
        ga_reply_then_next(c, c->next);
    }
    return 1;
}

/* Draw the nine atlas cells as a stretched tiled frame. The LCD canvas is
   assumed to be 480x320; the frame is drawn last, after all world sprites. */
static void ga_frame(int16_t x, int16_t y, uint16_t width, uint16_t height)
{
    gfx_setcolour(2); gfx_rectf(x, y, width, height);
    if (!ga_skin_pixels || ga_skin_w < ga_tile * 3 || ga_skin_h < ga_tile * 3) return;
    const uint16_t columns = ga_skin_w / ga_tile;
    const uint16_t rows = ga_skin_h / ga_tile;
    const uint32_t cells = (uint32_t)columns * rows;
    for (uint16_t iy = 0; iy < height; iy += ga_tile) {
        for (uint16_t ix = 0; ix < width; ix += ga_tile) {
            const uint8_t pos = (uint8_t)((iy == 0 ? 0 : iy + ga_tile >= height ? 2 : 1) * 3 +
                                          (ix == 0 ? 0 : ix + ga_tile >= width ? 2 : 1));
            const uint16_t index = ga_skin_indices[pos];
            if (index >= cells) continue;
            gfxbob_t tile;
            memset(&tile, 0, sizeof(tile));
            /* gfxbob_t.index is uint8_t. Rebase the pixel pointer to the
               selected cell so tile IDs beyond 255 render correctly too. */
            const uint32_t pixel_offset = ((uint32_t)(index / columns) * ga_tile * ga_skin_w)
                                        + (uint32_t)(index % columns) * ga_tile;
            tile.imgdat = ga_skin_pixels + pixel_offset;
            tile.atlas_stride = ga_skin_w;
            tile.atlas_height = ga_tile; tile.width = ga_tile; tile.height = ga_tile;
            tile.drawx = x + ix; tile.drawy = y + iy;
            tile.scale = 100; tile.index = 0;
            tile.flags = ga_skin_flips[pos];
            gfx_drawbob(&tile);
        }
    }
}
static void ga_text(int x, int y, const char *text)
{
    if (!text || !text[0]) return;
    if (ga_outline_enabled) {
        gfx_setcolour(ga_outline_colour);
        gfx_drawtext(x-1,y,text);
        gfx_drawtext(x+1,y,text);
        gfx_drawtext(x,y-1,text);
        gfx_drawtext(x,y+1,text);
    }
    gfx_setcolour(ga_text_colour);
    gfx_drawtext(x,y,text);
}
/* The font is 8x16. This routine is shared by NPC text and answer choices.
   It returns the number of displayed lines and never prints outside the
   caller's vertical budget. Word boundaries are retained where possible. */
static uint8_t ga_wrapped(const char *text, uint16_t visible, int x, int y,
                          uint8_t max_columns, uint8_t max_lines)
{
    if (!text || !max_lines || !max_columns) return 0;
    char line[GA_COLS + 1]; uint16_t pos = 0; uint8_t lines = 0;
    const int row_height = ga_outline_enabled ? 20 : 16;
    if (max_columns > GA_COLS) max_columns = GA_COLS;
    while (text[pos] && pos < visible && lines < max_lines) {
        uint8_t n = 0;
        while (text[pos] && pos < visible && text[pos] != '\n' &&
               n < max_columns) line[n++] = text[pos++];
        if (n == max_columns && text[pos] && pos < visible &&
            text[pos] != ' ' && text[pos] != '\n') {
            uint8_t last_space = n;
            while (last_space && line[last_space-1] != ' ') --last_space;
            if (last_space > 0) {
                pos -= n - last_space + 1;
                n = last_space - 1;
            }
        }
        while (n && line[n-1] == ' ') --n;
        line[n] = 0;
        if (text[pos] == '\n' && pos < visible) ++pos;
        while (text[pos] == ' ' && pos < visible) ++pos;
        ga_text(x, y + lines * row_height, line);
        ++lines;
    }
    return lines;
}

/* Count rows for a full answer, up to max_rows. Text may contain explicit
   newlines and long words. The estimate is used for scrolling the answers. */
static uint8_t ga_answer_rows(const char *text, uint8_t columns, uint8_t max_rows)
{
    if (!text || !text[0]) return 0;
    if (!columns) return 1;
    uint16_t at=0; uint8_t rows=0;
    while (text[at] && rows < max_rows) {
        uint8_t taken=0;
        while (text[at] && text[at]!='\n' && taken<columns) { ++at; ++taken; }
        if (taken==columns && text[at] && text[at]!='\n' && text[at]!=' ') {
            /* Match the renderer's wrap-at-space behaviour. */
            uint8_t rewind=taken;
            while (rewind && text[at-(taken-rewind)-1]!=' ') --rewind;
            if (rewind) at -= taken-rewind+1;
        }
        if (text[at]=='\n') ++at;
        while (text[at]==' ') ++at;
        ++rows;
    }
    return rows;
}

/* Count the largest adjacent pair of choices, not all three. A dialogue only
   shows two choices at once. Using the largest pair keeps the box height
   steady while the player navigates between them. */
static int ga_two_choice_height(const game_adventure_node_t *node,
                                uint8_t answer_columns, int row)
{
    uint8_t rows[3]={0,0,0}, count=0;
    for (uint8_t i=0;i<3;++i) {
        if (ga_choice_visible(ga_node,i))
            rows[count++]=ga_answer_rows(node->choices[i].label,answer_columns,32);
    }
    if (!count) return 0;
    int largest=(int)rows[0]*row;
    if (count>1) {
        largest=0;
        for (uint8_t i=0;i+1<count;++i) {
            const int pair=((int)rows[i]+rows[i+1])*row+4;
            if (pair>largest) largest=pair;
        }
    }
    return largest;
}
static int ga_dialogue_required_height(const game_adventure_node_t *node,
                                       uint8_t body_columns, uint8_t answer_columns,
                                       int row)
{
    const uint8_t body_rows=ga_answer_rows(node->text,body_columns,64);
    const int choice_height=ga_two_choice_height(node,answer_columns,row);
    /* Name at y+9, body at y+32, answers after body+9, bottom 12px. */
    return 32 + (int)body_rows*row + (choice_height?9+choice_height:0) + 12;
}

void game_adventure_draw_npcs(int32_t camera_x, int32_t camera_y)
{
    /* NPCs use the SAME BOB used by the animation system. World locations
       come from regenerated adventure data, not a hand-edited main.c. */
    for (uint16_t i = 0; i < ga_npc_count && i < ga_animation_count; ++i) {
        gfxbob_t *sprite = ga_animations[i].sprite;
        if (!sprite || !sprite->imgdat) continue;
        const int32_t x = ga_npcs[i].x - camera_x;
        const int32_t y = ga_npcs[i].y - camera_y;
        if (x <= -((int32_t)sprite->width) || y <= -((int32_t)sprite->height)
            || x >= 480 || y >= 320) continue;
        sprite->drawx = (int16_t)x;
        sprite->drawy = (int16_t)y;
        sprite->flags = (uint8_t)((sprite->flags & (uint8_t)~(BLIT_FLAG_FLIP_X | BLIT_FLAG_FLIP_Y))
            | (ga_animations[i].flip_flags & (BLIT_FLAG_FLIP_X | BLIT_FLAG_FLIP_Y)));
        gfx_drawbob(sprite);
    }
}

void game_adventure_draw(int32_t camera_x, int32_t camera_y,
                          int32_t player_x, int32_t player_y)
{
    if (!ga_state) return;
    if (ga_state == 2) {
        ga_inventory_clamp_offset();
        ga_frame(40, 34, 400, 172);
        ga_text(56, 48, "INVENTORY");
        for (uint8_t i = 0; i < GA_LINES; ++i) {
            uint16_t id = ga_visible_item_id((uint16_t)(ga_inventory_offset + i));
            if (id >= ga_item_count) break;
            char line[60];
            /* bounded display: no heap allocation and no variable precision libc */
            const char *name = ga_items[id].name ? ga_items[id].name : "Item";
            uint8_t n = 0; while (name[n] && n < 34) { line[n] = name[n]; ++n; }
            line[n++] = ' '; line[n++] = 'x';
            uint16_t qty = ga_counts[id]; char tmp[6]; uint8_t digits = 0;
            do { tmp[digits++] = (char)('0' + qty % 10); qty /= 10; } while (qty && digits < 6);
            while (digits) line[n++] = tmp[--digits];
            line[n] = 0;
            if (ga_skin_pixels && ga_items[id].icon < (ga_skin_w/ga_tile)*(ga_skin_h/ga_tile)) {
                gfxbob_t icon; memset(&icon,0,sizeof(icon));
                const uint16_t columns=ga_skin_w/ga_tile;
                const uint16_t cell=ga_items[id].icon;
                icon.imgdat=ga_skin_pixels + (uint32_t)(cell/columns)*ga_tile*ga_skin_w
                            + (uint32_t)(cell%columns)*ga_tile;
                icon.atlas_stride=ga_skin_w;
                icon.atlas_height=ga_tile; icon.width=ga_tile;
                icon.height=ga_tile; icon.scale=100; icon.index=0;
                icon.drawx=56; icon.drawy=68+i*22;
                gfx_drawbob(&icon);
            }
            ga_text(76, 68 + i * 22, line);
        }
        return;
    }
    if (ga_state == 3) {
        /* Player's selected reply types out above their own head. */
        const int screen_x = player_x - camera_x, screen_y = player_y - camera_y;
        const uint16_t letters=ga_reply ? (uint16_t)strlen(ga_reply) : 0;
        const int bubble_w=letters > 23u ? 280 : 205;
        const uint8_t columns=(uint8_t)((bubble_w-20)/8);
        const uint8_t rows=ga_answer_rows(ga_reply,columns,5);
        const int line_h=ga_outline_enabled ? 20 : 16;
        const int bubble_h=18+(rows ? rows : 1)*line_h;
        const int bubble_x=screen_x-10<4 ? 4 : screen_x-10>480-bubble_w-4
            ? 480-bubble_w-4 : screen_x-10;
        const int tentative_y=screen_y-bubble_h-8;
        const int bubble_y=tentative_y >= 4 ? tentative_y
            : (screen_y+28+bubble_h < 316 ? screen_y+28 : 4);
        ga_frame((int16_t)bubble_x,(int16_t)bubble_y,(uint16_t)bubble_w,(uint16_t)bubble_h);
        ga_wrapped(ga_reply,ga_reply_typed,bubble_x+10,bubble_y+9,columns,5);
        return;
    }
    if (ga_node >= ga_node_count) return;
    const game_adventure_node_t *node = &ga_nodes[ga_node];
    /* Height is the MINIMUM from the designer. On each conversation node
       automatically grow to fit the speaker, all dialogue lines and TWO
       choices. If growth reaches the LCD bottom, move the frame up rather
       than cutting off the choices. No heap allocations or text clipping. */
    const int bx=ga_dialog_x, bw=ga_dialog_w;
    const int row=ga_outline_enabled ? 20 : 16;
    const int pad=12;
    const int inner_width=bw-2*pad;
    const uint8_t body_columns=(uint8_t)((inner_width/8)>50?50:inner_width/8);
    /* Right gutter is reserved for MORE arrows only; item ownership stays hidden. */
    const uint8_t answer_columns=(uint8_t)(((inner_width-34)/8)>GA_COLS?GA_COLS:(inner_width-34)/8);
    const int needed=ga_dialogue_required_height(node,body_columns,answer_columns,row);
    const int bh=needed>(int)ga_dialog_h? (needed>320?320:needed) : ga_dialog_h;
    const int by=ga_dialog_y+bh>320?320-bh:ga_dialog_y;
    const int bottom=by+bh-pad;
    const int text_y=by+32;
    const int choice_height=ga_two_choice_height(node,answer_columns,row);
    const uint8_t desired_body=ga_answer_rows(node->text,body_columns,64);
    int body_budget=bottom-text_y-(choice_height?9+choice_height:0);
    int body_rows=body_budget>0?body_budget/row:0;
    if (body_rows>desired_body) body_rows=desired_body;
    if (body_rows<0) body_rows=0;

    ga_frame((int16_t)bx,(int16_t)by,(uint16_t)bw,(uint16_t)bh);
    ga_text(bx+pad,by+9,node->speaker ? node->speaker : "");
    ga_wrapped(node->text,ga_typed,bx+pad,text_y,body_columns,(uint8_t)body_rows);
    if (!choice_height) return;
    const int answers_y=text_y+body_rows*row+9;

    uint8_t indexes[3], count=0;
    for (uint8_t i=0;i<3;++i)
        if (ga_choice_visible(ga_node,i)) indexes[count++]=i;
    if (!count) return;
    uint8_t selected=0;
    for (uint8_t i=0;i<count;++i) if (indexes[i]==ga_choice) selected=i;
    const uint8_t first=(count>2 && selected>1) ? (uint8_t)(selected-1) : 0u;
    const uint8_t shown=(uint8_t)((count-first)>2?2:(count-first));
    int cy=answers_y;
    for (uint8_t i=0;i<shown;++i) {
        const uint8_t choice_index=indexes[first+i];
        const game_adventure_choice_t *c=&node->choices[choice_index];
        const int rows=ga_answer_rows(c->label,answer_columns,32);
        const int room=(bottom-cy)/row;
        if (room<1) break;
        const uint8_t draw_rows=(uint8_t)(rows<room?rows:room);
        ga_text(bx+pad,cy,choice_index==ga_choice?">":" ");
        ga_wrapped(c->label,(uint16_t)strlen(c->label),bx+pad+14,cy,
                   answer_columns,draw_rows);
        /* The arrow gutter stays outside the wrapped answer's text area. */
        if (i==0 && first>0) ga_text(bx+bw-pad-8,cy,"^");
        if (i+1==shown && first+shown<count)
            ga_text(bx+bw-pad-8,cy+(draw_rows-1)*row,"v");
        cy+=(int)draw_rows*row+4;
    }

}
