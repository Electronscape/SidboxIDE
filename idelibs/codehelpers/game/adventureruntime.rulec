#include "adventureruntime.h"
#include "apis.h"
#include <string.h>
#include <stdlib.h>
/* Firmware defines BTN_FIRE; older host test mocks may not. */
#ifndef BTN_FIRE
#define BTN_FIRE 0x01u
#endif
/* Older host mocks may omit the directional button constants. */
#ifndef BTN_LEFT
#define BTN_LEFT 0x10u
#endif
#ifndef BTN_RIGHT
#define BTN_RIGHT 0x20u
#endif

/* Bounded static memory: 64 inventory types, up to 3 choices per node. */
#define GA_MAX_ITEMS GAME_ADVENTURE_MAX_ITEMS
#define GA_COLS @IDE{GA_COLS} /* 8-pixel-wide glyphs, not 16-pixel glyphs. */
#define GA_LINES @IDE{GA_LINES}

/* Design-time values. These are filled from Adventure Editor when this
   .rulec is rendered into gameadventureruntime.c by Update Game Project.
   Runtime counters/pointers below are internal state, not project settings. */


#define GA_DIALOG_DEFAULT_X @IDE{DIALOG_X}
#define GA_DIALOG_DEFAULT_Y @IDE{DIALOG_Y}
#define GA_DIALOG_DEFAULT_W @IDE{DIALOG_WIDTH}u
#define GA_DIALOG_DEFAULT_H @IDE{DIALOG_HEIGHT}u
#define GA_TEXT_DEFAULT_COLOUR @IDE{TEXT_COLOUR_INDEX}u
#define GA_TEXT_DEFAULT_OUTLINE @IDE{TEXT_OUTLINE_ENABLED}u
#define GA_TEXT_DEFAULT_OUTLINE_COLOUR @IDE{OUTLINE_COLOUR_INDEX}u
static const game_adventure_item_t *ga_items;
static const game_adventure_node_t *ga_nodes;
static const game_adventure_npc_t *ga_npcs;
static uint16_t ga_item_count, ga_node_count, ga_npc_count;
static const game_adventure_item_style_t *ga_item_styles;
static uint16_t ga_item_style_count;
static const uint8_t *ga_icon_atlas[GA_MAX_ITEMS];
/* Distinguish "no custom atlas" from "custom atlas missing at runtime". */
static uint8_t ga_icon_registered[GA_MAX_ITEMS];
static uint16_t ga_icon_width[GA_MAX_ITEMS],ga_icon_height[GA_MAX_ITEMS];
static uint8_t ga_icon_tile[GA_MAX_ITEMS];
static const char *ga_icon_file[GA_MAX_ITEMS];
/* Share one allocation between all carried icons using the same PPB file.
   These buffers never belong to gameassets and are released on world travel. */
typedef struct {
    const char *path;
    uint8_t *pixels;
    uint16_t width, height;
} ga_owned_ppb_t;
static ga_owned_ppb_t ga_loaded_ppbs[GA_MAX_ITEMS];
static uint16_t ga_loaded_ppb_count;
static void ga_release_owned_ppbs(void)
{
    for(uint16_t i=0;i<ga_loaded_ppb_count;++i) free(ga_loaded_ppbs[i].pixels);
    memset(ga_loaded_ppbs,0,sizeof(ga_loaded_ppbs));
    ga_loaded_ppb_count=0;
}
/* Validate exact PPB dimensions and payload length. The legacy LoadPPB()
   returns void and cannot report a short read, so it is unsafe here. */
static const uint8_t *ga_load_ppb(const char *path,uint16_t width,uint16_t height)
{
    if(!path || !*path || !width || !height) return 0;
    for(uint16_t i=0;i<ga_loaded_ppb_count;++i)
        if(strcmp(path,ga_loaded_ppbs[i].path)==0) {
            return ga_loaded_ppbs[i].width==width && ga_loaded_ppbs[i].height==height
                ? ga_loaded_ppbs[i].pixels : 0;
        }
    if(ga_loaded_ppb_count>=GA_MAX_ITEMS) return 0;
    ga_owned_ppb_t *entry=&ga_loaded_ppbs[ga_loaded_ppb_count++];
    entry->path=path; entry->width=width; entry->height=height;
    const uint32_t size=(uint32_t)width*height;
    if(size>4u*1024u*1024u || sfopen(0,(char *)path,SD_READ)!=FR_OK) return 0;
    do {
        uint8_t hdr[16]; uint32_t got=0;
        if(sfread(0,hdr,16u,&got)!=FR_OK || got!=16u) break;
        const uint32_t w=((uint32_t)hdr[1]<<8)|hdr[2];
        const uint32_t h=((uint32_t)hdr[3]<<8)|hdr[4];
        const uint32_t len=((uint32_t)hdr[5]<<24)|((uint32_t)hdr[6]<<16)|
                           ((uint32_t)hdr[7]<<8)|hdr[8];
        if(w!=width || h!=height || len!=size) break;
        entry->pixels=(uint8_t *)malloc(size);
        if(!entry->pixels || sflseek(0,1040u)!=FR_OK) break;
        got=0;
        if(sfread(0,entry->pixels,size,&got)!=FR_OK || got!=size) break;
        uint8_t trailing=0; got=0;
        if(sfread(0,&trailing,1u,&got)!=FR_OK || got!=0u) break;
        sfclose(0);
        return entry->pixels;
    } while(0);
    sfclose(0);
    free(entry->pixels); entry->pixels=0;
    return 0;
}
void game_adventure_item_atlas_file(uint16_t item,const char *path,
                                    uint16_t width,uint16_t height,uint8_t tile_size)
{
    if(item>=GA_MAX_ITEMS || !path || !*path) return;
    ga_icon_registered[item]=1u;
    ga_icon_file[item]=path;
    ga_icon_atlas[item]=0;
    ga_icon_width[item]=width;
    ga_icon_height[item]=height;
    ga_icon_tile[item]=tile_size;
}
void game_adventure_item_atlas(uint16_t item,const uint8_t *pixels,
                               uint16_t width,uint16_t height,uint8_t tile_size)
{
    if(item>=GA_MAX_ITEMS)return;
    ga_icon_registered[item]=1u;
    ga_icon_file[item]=0;
    ga_icon_atlas[item]=pixels;
    ga_icon_width[item]=width;
    ga_icon_height[item]=height;
    ga_icon_tile[item]=tile_size;
}
void game_adventure_item_styles(const game_adventure_item_style_t *styles, uint16_t count)
{ ga_item_styles = styles; ga_item_style_count = styles ? count : 0u; }
static uint8_t ga_discardable(uint16_t id)
{ return ga_item_styles && id < ga_item_style_count && ga_item_styles[id].discardable; }
static uint8_t ga_droppable(uint16_t id)
{ return ga_item_styles && id < ga_item_style_count && ga_item_styles[id].droppable; }
static uint8_t ga_inventory_slot_limit; /* 0 = unrestricted */
static uint8_t ga_restoring_inventory;
void game_adventure_inventory_max_slots(uint8_t slots)
{ ga_inventory_slot_limit=slots>GA_MAX_ITEMS?GA_MAX_ITEMS:slots; }
void game_adventure_inventory_restore_begin(void) { ga_restoring_inventory=1u; }
void game_adventure_inventory_restore_end(void) { ga_restoring_inventory=0u; }
/* Item names are stable between world-local lists. Keep order for the game's
 * lifetime even when game_adventure_start() unloads/rebuilds a world. */
typedef struct { char name[37]; uint32_t rank; } ga_recent_item_t;
static ga_recent_item_t ga_recent[GA_MAX_ITEMS];
static uint16_t ga_recent_count;
static uint32_t ga_recent_clock;
static uint32_t ga_item_rank(uint16_t id)
{
    if(id>=ga_item_count || !ga_items || !ga_items[id].name) return 0u;
    for(uint16_t i=0;i<ga_recent_count;++i)
        if(strcmp(ga_recent[i].name,ga_items[id].name)==0) return ga_recent[i].rank;
    return 0u;
}
static void ga_touch_item(uint16_t id,uint8_t new_acquisition)
{
    if(id>=ga_item_count || !ga_items || !ga_items[id].name) return;
    const char *name=ga_items[id].name;
    for(uint16_t i=0;i<ga_recent_count;++i)
        if(strcmp(ga_recent[i].name,name)==0) {
            if(new_acquisition) ga_recent[i].rank=++ga_recent_clock;
            return;
        }
    if(ga_recent_count>=GA_MAX_ITEMS)return;
    ga_recent_item_t *slot=&ga_recent[ga_recent_count++];
    strncpy(slot->name,name,sizeof(slot->name)-1u);
    slot->name[sizeof(slot->name)-1u]=0;
    slot->rank=++ga_recent_clock;
}

static uint16_t ga_counts[GA_MAX_ITEMS];
static uint8_t ga_display_dirty=1u;
static void ga_load_item_icon(uint16_t item)
{
    if(item>=ga_item_count || !ga_icon_file[item] || ga_icon_atlas[item]) return;
    ga_icon_atlas[item]=ga_load_ppb(ga_icon_file[item],ga_icon_width[item],ga_icon_height[item]);
}
void game_adventure_prepare_owned_icons(void)
{
    for(uint16_t i=0;i<ga_item_count;++i)
        if(ga_counts[i]) ga_load_item_icon(i);
}
static const game_adventure_item_use_t *ga_use_effects;
static uint16_t ga_use_count;
static game_adventure_use_stat_t ga_use_handler;
static void *ga_use_user;
void game_adventure_use_effects(const game_adventure_item_use_t *effects, uint16_t count,
                               game_adventure_use_stat_t handler, void *user)
{
    ga_use_effects = effects; ga_use_count = effects ? count : 0u;
    ga_use_handler = handler; ga_use_user = user;
}
static uint8_t ga_can_use(uint16_t id)
{
    return ga_use_effects && id < ga_use_count && ga_use_handler &&
           ga_use_effects[id].stat && ga_use_effects[id].stat[0] &&
           ga_use_effects[id].delta != 0;
}
static uint8_t ga_use_item(uint16_t id)
{
    if (!ga_can_use(id) || id >= ga_item_count || !ga_counts[id]) return 0;
    const game_adventure_item_use_t *effect=&ga_use_effects[id];
    if (!ga_use_handler(effect->stat,effect->delta,ga_use_user)) return 0;
    if (effect->consume) { --ga_counts[id]; ga_display_dirty=1u; }
    return 1;
}

static game_adventure_item_visible_t ga_inventory_filter;
void game_adventure_set_inventory_filter(game_adventure_item_visible_t filter)
{ ga_inventory_filter = filter; }
/* Backpack rows represent what the player HAS, not everything the game
 * knows about. Zero-quantity entries stay off-screen. A secret item's saved
 * hidden marker is a discovery hint, not a permanent block: once its live
 * count is nonzero, show the item by name. Dialogue/pickup quantities use
 * ga_counts independently of this display rule.
 *
 * Keep the older filter setter for source compatibility with generated
 * world managers; its static hidden flag cannot conceal an owned item.
 */
static uint8_t ga_item_visible(uint16_t i)
{
    return i < ga_item_count && ga_counts[i] != 0u;
}
/* Cache display order. Rebuilding at 50 Hz is unnecessary when unchanged. */
static uint8_t ga_display_ids[GA_MAX_ITEMS];
static uint16_t ga_display_count;
static void ga_refresh_display(void)
{
    if(!ga_display_dirty)return;
    ga_display_count=0u;
    for(uint16_t i=0;i<ga_item_count;++i) {
        if(!ga_item_visible(i))continue;
        const uint32_t rank=ga_item_rank(i);
        uint16_t place=ga_display_count;
        while(place && ga_item_rank(ga_display_ids[place-1u])<rank) {
            ga_display_ids[place]=ga_display_ids[place-1u];
            --place;
        }
        ga_display_ids[place]=(uint8_t)i;
        ++ga_display_count;
    }
    ga_display_dirty=0u;
}
static uint16_t ga_visible_count(void)
{
    ga_refresh_display();
    return ga_display_count;
}
static uint16_t ga_visible_item_id(uint16_t display_index)
{
    ga_refresh_display();
    return display_index<ga_display_count?ga_display_ids[display_index]:ga_item_count;
}
/* 256 nodes x 3 choices: 96 bytes for once-only flags. One bit per choice. */
static uint8_t ga_used_choices[(256u * 3u + 7u) / 8u];
static uint8_t ga_completed_npcs[256];
static uint8_t ga_npc_visibility[256];
static const game_adventure_npc_choice_action_t *ga_npc_choice_actions;
static const game_adventure_spotlight_rule_t *ga_spotlight_rules;
static uint16_t ga_spotlight_rule_count;
static void (*ga_spotlight_apply)(uint8_t);
static uint16_t ga_npc_choice_action_count;
static const game_adventure_remote_npc_rule_t *ga_remote_npc_rules;
static uint16_t ga_remote_npc_rule_count;
static uint8_t (*ga_remote_npc_apply)(const char *,uint16_t,uint8_t);
static const game_adventure_close_gift_t *ga_close_gifts;
static uint16_t ga_close_gift_count;
static uint8_t ga_close_gift_claimed[GAME_ADVENTURE_CLOSE_GIFT_BYTES];
void game_adventure_close_gifts(const game_adventure_close_gift_t *rules,uint16_t count)
{ ga_close_gifts=rules;ga_close_gift_count=rules?count:0u; }
void game_adventure_save_close_gifts(uint8_t out[GAME_ADVENTURE_CLOSE_GIFT_BYTES])
{ if(out) memcpy(out,ga_close_gift_claimed,sizeof(ga_close_gift_claimed)); }
void game_adventure_restore_close_gifts(const uint8_t saved[GAME_ADVENTURE_CLOSE_GIFT_BYTES])
{ if(saved) memcpy(ga_close_gift_claimed,saved,sizeof(ga_close_gift_claimed)); }

void game_adventure_npc_initial_visibility(const uint8_t *defaults, uint16_t count)
{
    if (!defaults) return;
    for (uint16_t i = 0; i < ga_npc_count && i < count && i < 256u; ++i)
        ga_npc_visibility[i] = defaults[i] ? 1u : 0u;
}
uint8_t game_adventure_npc_visible(uint16_t npc)
{
    return npc < ga_npc_count && npc < 256u ? ga_npc_visibility[npc] : 0u;
}
void game_adventure_set_npc_visible(uint16_t npc, uint8_t visible)
{
    if (npc < ga_npc_count && npc < 256u) ga_npc_visibility[npc] = visible ? 1u : 0u;
}
void game_adventure_npc_action(uint16_t npc, uint8_t action)
{
    if (npc >= ga_npc_count || npc >= 256u) return;
    if (action == GAME_ADVENTURE_NPC_HIDE) ga_npc_visibility[npc] = 0u;
    else if (action == GAME_ADVENTURE_NPC_SHOW) ga_npc_visibility[npc] = 1u;
    else if (action == GAME_ADVENTURE_NPC_TOGGLE) ga_npc_visibility[npc] ^= 1u;
}
void game_adventure_spotlight_actions(const game_adventure_spotlight_rule_t *rules,
                                     uint16_t count, void (*apply)(uint8_t))
{
    ga_spotlight_rules = rules;
    ga_spotlight_rule_count = rules ? count : 0u;
    ga_spotlight_apply = apply;
}
void game_adventure_npc_choice_actions(const game_adventure_npc_choice_action_t *rules,
                                       uint16_t count)
{
    ga_npc_choice_actions = rules;
    ga_npc_choice_action_count = rules ? count : 0u;
}
void game_adventure_remote_npc_actions(const game_adventure_remote_npc_rule_t *rules,
                                     uint16_t count,
                                     uint8_t (*apply)(const char *,uint16_t,uint8_t))
{
    ga_remote_npc_rules = rules;
    ga_remote_npc_rule_count = rules && apply ? count : 0u;
    ga_remote_npc_apply = apply;
}
void game_adventure_save_npc_visibility(uint8_t out[GAME_ADVENTURE_NPC_VISIBILITY_BYTES])
{
    if (out) memcpy(out, ga_npc_visibility, sizeof(ga_npc_visibility));
}
void game_adventure_restore_npc_visibility(const uint8_t saved[GAME_ADVENTURE_NPC_VISIBILITY_BYTES])
{
    if (!saved) return;
    for (uint16_t i = 0; i < ga_npc_count; ++i)
        ga_npc_visibility[i] = saved[i] ? 1u : 0u;
}
void game_adventure_save_progress(uint8_t used_choices[96], uint8_t completed_npcs[256])
{
    if (!used_choices || !completed_npcs) return;
    memcpy(used_choices, ga_used_choices, sizeof(ga_used_choices));
    memcpy(completed_npcs, ga_completed_npcs, sizeof(ga_completed_npcs));
}
void game_adventure_restore_progress(const uint8_t used_choices[96], const uint8_t completed_npcs[256])
{
    if (!used_choices || !completed_npcs) return;
    memcpy(ga_used_choices, used_choices, sizeof(ga_used_choices));
    memcpy(ga_completed_npcs, completed_npcs, sizeof(ga_completed_npcs));
}
static const uint8_t *ga_choice_flags; /* node * 3 + answer */
static const uint16_t *ga_completed_nodes; /* NPC index; UINT16_MAX => no alternate */
void game_adventure_story_flags(const uint8_t *choice_flags,
                                const uint16_t *completed_nodes)
{
    ga_choice_flags = choice_flags;
    ga_completed_nodes = completed_nodes;
}

static uint8_t ga_state; /* 0 idle, 1 dialogue, 2 inventory, 3 reply, 4 destroy, 5 GIVE */
static uint8_t ga_trigger_message_mode; /* 0 normal, 1 single, 2 navigation-only sequence. */
static const game_adventure_exchange_t *ga_exchanges;
static uint16_t ga_exchange_count;
static uint8_t ga_exchange_progress[GAME_ADVENTURE_EXCHANGE_SLOTS];
/* Each dialogue-answer has at most one tracked wrong item. Four replies;
 * repeat after the third offer saturates at state 4. No heap allocations. */
static const game_adventure_wrong_repeat_t *ga_wrong_repeats;
static uint16_t ga_wrong_repeat_count;
static uint8_t ga_wrong_repeat_counts[GAME_ADVENTURE_EXCHANGE_SLOTS];
void game_adventure_wrong_repeat_rules(const game_adventure_wrong_repeat_t *rules,
                                       uint16_t count)
{ ga_wrong_repeats=rules; ga_wrong_repeat_count=rules ? count : 0u; }
void game_adventure_save_wrong_repeats(uint8_t out[GAME_ADVENTURE_EXCHANGE_SLOTS])
{ if (out) memcpy(out,ga_wrong_repeat_counts,sizeof(ga_wrong_repeat_counts)); }
void game_adventure_restore_wrong_repeats(const uint8_t saved[GAME_ADVENTURE_EXCHANGE_SLOTS])
{ if (saved) memcpy(ga_wrong_repeat_counts,saved,sizeof(ga_wrong_repeat_counts)); }
static const game_adventure_wrong_repeat_t *ga_find_wrong_repeat(uint16_t key, uint16_t item)
{
    for (uint16_t i=0; i<ga_wrong_repeat_count; ++i) {
        const game_adventure_wrong_repeat_t *r=&ga_wrong_repeats[i];
        if (r->exchange_index==key && r->item>=0 && (uint16_t)r->item==item) return r;
    }
    return 0;
}
static uint16_t ga_exchange_node;
static uint8_t ga_exchange_choice;
void game_adventure_exchange_rules(const game_adventure_exchange_t *rules, uint16_t count)
{ ga_exchanges=rules; ga_exchange_count=rules ? (count > GAME_ADVENTURE_EXCHANGE_SLOTS ? GAME_ADVENTURE_EXCHANGE_SLOTS : count) : 0u; }
void game_adventure_save_exchanges(uint8_t out[GAME_ADVENTURE_EXCHANGE_SLOTS])
{ if (out) memcpy(out,ga_exchange_progress,sizeof(ga_exchange_progress)); }
void game_adventure_restore_exchanges(const uint8_t saved[GAME_ADVENTURE_EXCHANGE_SLOTS])
{ if (saved) memcpy(ga_exchange_progress,saved,sizeof(ga_exchange_progress)); }
static const game_adventure_exchange_t *ga_exchange_rule(uint16_t node,uint8_t choice)
{
    const uint16_t index=(uint16_t)(node*3u+choice);
    if (index>=ga_exchange_count || !ga_exchanges || !ga_exchanges[index].count) return 0;
    return &ga_exchanges[index];
}
/* Optional query owned by the current world; only tests whether FIRE2 has
 * an active trigger under the player, without activating that trigger. */
static game_adventure_fire2_action_t ga_fire2_action;
static game_adventure_fire2_action_t ga_interaction_probe;
static game_adventure_interaction_use_t ga_interaction_use;
static game_adventure_interaction_sound_t ga_interaction_sound;
static uint8_t ga_interaction_failed;
void game_adventure_set_interaction(game_adventure_fire2_action_t probe,
                                    game_adventure_interaction_use_t use)
{ ga_interaction_probe=probe; ga_interaction_use=use; ga_interaction_failed=0; }
void game_adventure_set_interaction_sound(game_adventure_interaction_sound_t sound)
{ ga_interaction_sound=sound; }
void game_adventure_set_fire2_action(game_adventure_fire2_action_t action)
{ ga_fire2_action = action; }
static uint8_t ga_prev_buttons, ga_choice, ga_inventory_offset;
/* Keep FIRE1 away from gameplay whenever an Adventure modal consumes it.
   The latch is held until release, so closing a box with FIRE1 cannot
   cause a jump on that same frame or on a following held frame. */
static uint8_t ga_fire1_blocked;
uint8_t game_adventure_gameplay_buttons(uint8_t buttons)
{
    return (uint8_t)(buttons & (uint8_t)~((ga_state || ga_fire1_blocked) ? BTN_FIRE : 0u));
}

static uint8_t ga_inventory_selection; /* Index into owned/visible items. */
static uint8_t ga_inventory_action; /* Among available USE, DROP, DESTROY (LEFT/RIGHT). */
static game_adventure_drop_t ga_drops[GAME_ADVENTURE_MAX_DROPS];
static uint8_t ga_confirm_yes;  /* Confirmation defaults to NO. */
/* Blink only the [ ] selection brackets, not the action labels.  At 50 fps,
   each half-period is ten frames (200 ms), and drawing does not change time. */
static uint8_t ga_bracket_frames;
static void ga_bracket_restart(void) { ga_bracket_frames=0u; }
static uint8_t ga_brackets_visible(void) { return ga_bracket_frames < 10u; }
/* Four rows plus header/footer fit in the compact backpack. */
#define GA_INVENTORY_ROWS 4u
static void ga_inventory_clamp_offset(void)
{
    const uint16_t visible = ga_visible_count();
    const uint16_t max_offset = visible > GA_INVENTORY_ROWS
        ? (uint16_t)(visible - GA_INVENTORY_ROWS) : 0u;
    if (ga_inventory_offset > max_offset) ga_inventory_offset = (uint8_t)max_offset;
}
void game_adventure_save_drops(game_adventure_drop_t out[GAME_ADVENTURE_MAX_DROPS])
{ if (out) memcpy(out, ga_drops, sizeof(ga_drops)); }
void game_adventure_restore_drops(const game_adventure_drop_t saved[GAME_ADVENTURE_MAX_DROPS])
{
    if (!saved) return;
    memcpy(ga_drops, saved, sizeof(ga_drops));
    /* A floor drop can be the player's LAST item of this kind. Inventory
     * quantity is then zero, but the item still needs its PPB to draw.
     * Restore artwork now (on world entry), never during frame rendering. */
    for (uint8_t i=0; i<GAME_ADVENTURE_MAX_DROPS; ++i)
        if (ga_drops[i].active && ga_drops[i].item_id < ga_item_count)
            ga_load_item_icon(ga_drops[i].item_id);
}
static uint16_t ga_node, ga_typed, ga_ticks, ga_reply_typed, ga_reply_ticks;
static int16_t ga_after_reply;
static const char *ga_reply;
static int32_t ga_player_x, ga_player_y;
static const uint8_t *ga_skin_pixels;
static uint16_t ga_skin_w, ga_skin_h;
static uint8_t ga_tile, ga_frames_per_char;
static uint16_t ga_skin_indices[9];
static uint8_t ga_skin_flips[9];
static const uint8_t *ga_thought_flags;
static uint16_t ga_thought_flag_count;
static const char *ga_thought_text;
/* The inherited NEXT-node thought remains available when changing answers.
 * This-node thoughts are selected live without changing dialogue state. */
static const char *ga_inherited_thought;
static uint16_t ga_thought_typed, ga_thought_ticks;
static uint16_t ga_thought_indices[9];
static uint8_t ga_thought_flips[9];
static int16_t ga_thought_x=20,ga_thought_y=12;
static uint16_t ga_thought_w=240,ga_thought_h=64;
void game_adventure_thought_choices(const uint8_t *flags,uint16_t count)
{ ga_thought_flags=flags;ga_thought_flag_count=flags?count:0u; }
void game_adventure_thought_box(int16_t x,int16_t y,uint16_t w,uint16_t h,
    const uint16_t indices[9],const uint8_t flips[9])
{
    if(w<96u)w=96u;
    if(w>480u)w=480u;
    if(h<40u)h=40u;
    if(h>320u)h=320u;
    if(x<0)x=0;
    if(y<0)y=0;
    if(x>480-(int)w)x=(int16_t)(480-w);
    if(y>320-(int)h)y=(int16_t)(320-h);
    ga_thought_x=x;ga_thought_y=y;ga_thought_w=w;ga_thought_h=h;
    for(uint8_t i=0;i<9u;++i){
        ga_thought_indices[i]=indices?indices[i]:ga_skin_indices[i];
        ga_thought_flips[i]=flips?flips[i]:ga_skin_flips[i];
    }
}
static uint8_t ga_text_colour=GA_TEXT_DEFAULT_COLOUR;
static uint8_t ga_outline_enabled=GA_TEXT_DEFAULT_OUTLINE;
static uint8_t ga_outline_colour=GA_TEXT_DEFAULT_OUTLINE_COLOUR;
/* Dialogue height is a MINIMUM: expanded at draw time for the current node. */
static int16_t ga_dialog_x=GA_DIALOG_DEFAULT_X, ga_dialog_y=GA_DIALOG_DEFAULT_Y;
static uint16_t ga_dialog_w=GA_DIALOG_DEFAULT_W, ga_dialog_h=GA_DIALOG_DEFAULT_H;
static uint8_t ga_dialog_padding = 8u;
static uint8_t ga_dialog_scale_x=1u,ga_dialog_scale_y=2u;
static uint8_t ga_thought_scale_x=1u,ga_thought_scale_y=2u;
static uint8_t ga_thought_on_top=1u;
static uint8_t ga_valid_font_scale(uint8_t n)
{ return n==1u || n==2u || n==4u || n==8u ? n : 1u; }
void game_adventure_dialogue_typography(uint8_t dx,uint8_t dy,uint8_t tx,uint8_t ty,
                                         uint8_t thought_on_top)
{
    ga_dialog_scale_x=ga_valid_font_scale(dx);
    ga_dialog_scale_y=ga_valid_font_scale(dy);
    ga_thought_scale_x=ga_valid_font_scale(tx);
    ga_thought_scale_y=ga_valid_font_scale(ty);
    ga_thought_on_top=thought_on_top?1u:0u;
}
void game_adventure_text_padding(uint8_t pixels)
{ ga_dialog_padding = pixels == 8u ? 8u : 0u; }

void game_adventure_dialogue_box(int16_t x, int16_t y, uint16_t width, uint16_t height)
{
    /* Never let a text window extend outside the 480x320 LCD. */
    if (width < 128u) width = 128u;
    if (height < 96u) height = 96u;
    if (width > 480u) width = 480u;
    if (height > 320u) height = 320u;
    if (x < 0) x = 0;
    if (y < 0) y = 0;
    if (x > 480 - (int)width) x = (int16_t)(480 - width);
    if (y > 320 - (int)height) y = (int16_t)(320 - height);
    ga_dialog_x = x; ga_dialog_y = y;
    ga_dialog_w = width; ga_dialog_h = height;
}
static const game_adventure_npc_animation_t *ga_animations;
static uint16_t ga_animation_count, ga_active_npc;
static uint16_t ga_animation_ticks[256];
static uint8_t ga_animation_frames[256], ga_animation_mode[256];
static uint8_t ga_animation_original_index[256];
static game_adventure_action_t ga_action;
static void *ga_user;

void game_adventure_skin_flips(const uint8_t flips[9])
{
    for (uint8_t i=0;i<9;++i) ga_skin_flips[i] = flips ? flips[i] : 0;
}

void game_adventure_text_style(uint8_t text_index, uint8_t outline_enabled,
                               uint8_t outline_index)
{
    ga_text_colour = text_index;
    ga_outline_enabled = outline_enabled ? 1u : 0u;
    ga_outline_colour = outline_index;
}

void game_adventure_npc_animations(const game_adventure_npc_animation_t *animations,
                                   uint16_t count)
{
    ga_animations = animations;
    ga_animation_count = animations && count <= 256u ? count : (animations ? 256u : 0u);
    memset(ga_animation_ticks, 0, sizeof(ga_animation_ticks));
    memset(ga_animation_frames, 0, sizeof(ga_animation_frames));
    memset(ga_animation_mode, 0xFF, sizeof(ga_animation_mode));
    for (uint16_t i=0; i<ga_animation_count; ++i)
        ga_animation_original_index[i] = animations[i].sprite ? animations[i].sprite->index : 0;
}

/* The animation follows the active conversation, but ticking happens during
   game_adventure_input(), so custom main.c needs no new frame-loop hook. */
static void ga_tick_animations(uint16_t frames)
{
    for (uint16_t i = 0; i < ga_animation_count; ++i) {
        if (!game_adventure_npc_visible(i)) continue;
        const game_adventure_npc_animation_t *a = &ga_animations[i];
        if (!a->sprite || !a->sprite->imgdat) continue;
        const uint8_t speaking = (ga_state == 1u && ga_active_npc == i) ? 1u : 0u;
        const uint16_t first = speaking && a->talk_count ? a->talk_first : a->idle_first;
        const uint16_t count = speaking && a->talk_count ? a->talk_count : a->idle_count;
        const uint16_t rate = speaking && a->talk_count ? a->talk_speed : a->idle_speed;
        const game_adventure_npc_frame_t *sequence = speaking && a->talk_count
            ? a->talk_frames : a->idle_frames;
        if (!count) {
            if (ga_animation_mode[i] != 0xFFu) {
                a->sprite->index = ga_animation_original_index[i];
                ga_animation_mode[i] = 0xFFu;
            }
            continue;
        }
        const uint16_t max_cells = (a->sprite->width && a->sprite->height)
            ? (uint16_t)((a->sprite->atlas_stride / a->sprite->width) *
                         (a->sprite->atlas_height / a->sprite->height)) : 0;
        if (!sequence && (first + count > max_cells || first + count > 256u)) continue;
        if (ga_animation_mode[i] != speaking) {
            ga_animation_mode[i] = speaking;
            ga_animation_ticks[i] = 0;
            ga_animation_frames[i] = 0;
        } else {
            uint32_t remaining = (uint32_t)ga_animation_ticks[i] + frames;
            /* Each frame has its own delay (the older contiguous format uses
               a constant speed). Bound each update to avoid heavy work after
               a pause, even if the game reports an unusually large delta. */
            const uint32_t bounded = remaining > 65535u ? 65535u : remaining;
            remaining = bounded;
            uint16_t steps = 0;
            while (steps < 256u) {
                uint16_t current = ga_animation_frames[i];
                uint16_t delay = sequence ? sequence[current].delay : rate;
                if (!delay) delay = 1;
                if (remaining < delay) break;
                remaining -= delay;
                ga_animation_frames[i] = (uint8_t)((current + 1u) % count);
                ++steps;
            }
            ga_animation_ticks[i] = (uint16_t)remaining;
        }
        const uint16_t chosen = sequence ? sequence[ga_animation_frames[i]].index
                                         : first + ga_animation_frames[i];
        if (chosen < max_cells && chosen < 256u)
            a->sprite->index = (uint8_t)chosen;
    }
}

uint8_t game_adventure_open(void) { return ga_state != 0; }
/* Optional world-manager hook: register an Adventure pickup kind before
 * the HUD first queries it. A standalone Adventure build needs no world
 * manager, so this default implementation deliberately does nothing. */
__attribute__((weak)) void game_adventure_inventory_kind_changed(uint16_t pickup_kind)
{
    (void)pickup_kind;
}
uint16_t game_adventure_quantity(uint16_t i) { return i < ga_item_count ? ga_counts[i] : 0; }
uint8_t game_adventure_pickup_quantity(uint16_t kind, uint32_t *total)
{
    uint32_t owned = 0;
    uint8_t found = 0;
    if (kind && ga_items) {
        for (uint16_t i = 0; i < ga_item_count; ++i) {
            if (ga_items[i].pickup_kind == kind) {
                owned += ga_counts[i];
                found = 1;
            }
        }
    }
    if (total) *total = owned;
    return found;
}
uint16_t game_adventure_add(uint16_t i, uint16_t n)
{
    if (i >= ga_item_count) return 0;
    const uint16_t old = ga_counts[i], max = ga_items[i].capacity;
    if(n && !old && !ga_restoring_inventory && ga_inventory_slot_limit &&
       ga_visible_count() >= ga_inventory_slot_limit) return 0;
    const uint32_t wanted = (uint32_t)old + n;
    ga_counts[i] = (uint16_t)(wanted > max ? max : wanted);
    if(ga_counts[i]!=old) ga_display_dirty=1u;
    if (ga_counts[i] > old) {
        if (!ga_restoring_inventory) ga_touch_item(i,1u);
        else ga_touch_item(i,0u);
        /* Gifts, hand-ins and scripted awards can precede floor pickups. */
        game_adventure_inventory_kind_changed(ga_items[i].pickup_kind);
        ga_load_item_icon(i);
    }
    return ga_counts[i] - old;
}
uint8_t game_adventure_remove(uint16_t i, uint16_t n)
{
    if (i >= ga_item_count || ga_counts[i] < n) return 0;
    ga_counts[i] -= n;
    ga_display_dirty=1u;
    return 1;
}
static uint8_t ga_managed_pickup_scope;
static uint16_t ga_managed_pickup_kind;
void game_adventure_managed_pickup_begin(uint16_t kind)
{ ga_managed_pickup_kind = kind; ga_managed_pickup_scope = 1; }
void game_adventure_managed_pickup_end(void) { ga_managed_pickup_scope = 0; }
uint8_t game_adventure_can_collect_kind(uint16_t kind)
{
    if(!kind || !ga_items)return 1u;
    uint16_t needed=0,existing=ga_visible_count();
    for(uint16_t i=0;i<ga_item_count;++i) {
        if(ga_items[i].pickup_kind!=kind)continue;
        if(ga_counts[i]>=ga_items[i].capacity) return 0u;
        if(!ga_counts[i])++needed;
    }
    return !ga_inventory_slot_limit || existing+needed<=ga_inventory_slot_limit;
}
uint16_t game_adventure_collect_amount(uint16_t kind, uint16_t amount)
{
    uint16_t matched = 0;
    if(amount && !game_adventure_can_collect_kind(kind))return 0;
    for (uint16_t i = 0; i < ga_item_count; ++i)
        if (kind && ga_items[i].pickup_kind == kind) {
            game_adventure_add(i, amount); ++matched;
        }
    return matched;
}
uint8_t game_adventure_adjust_pickup(uint16_t kind, int32_t delta)
{
    /* Change the total of this pickup KIND, not every matching item by the
       requested amount. Some adventures contain several items of one kind. */
    uint8_t found=0;
    int64_t remaining=delta < 0 ? -(int64_t)delta : delta;
    if(remaining>65535) remaining=65535;
    for (uint16_t i=0;i<ga_item_count;++i) if(kind && ga_items[i].pickup_kind==kind) {
        found=1;
        if(!remaining)continue;
        if(delta>0) {
            uint16_t available=ga_items[i].capacity>ga_counts[i] ?
                (uint16_t)(ga_items[i].capacity-ga_counts[i]) : (uint16_t)0;
            uint16_t amount=(uint16_t)(remaining<available?remaining:available);
            remaining-=game_adventure_add(i,amount);
        } else if(delta<0) {
            uint16_t amount=(uint16_t)(remaining<ga_counts[i]?remaining:ga_counts[i]);
            if(amount && game_adventure_remove(i,amount))remaining-=amount;
        }
    }
    return found;
}
uint16_t game_adventure_collect(uint16_t kind)
{
    /* Legacy main.c often calls collect(kind) in on_pickup(). For a new
       managed pickup, the world manager has already accounted for the value.
       Ignore this call only during that individual pickup callback. */
    if (ga_managed_pickup_scope && kind == ga_managed_pickup_kind) return 0;
    return game_adventure_collect_amount(kind, 1u);
}
void game_adventure_start(const game_adventure_item_t *items, uint16_t item_count,
                          const game_adventure_node_t *nodes, uint16_t node_count,
                          const game_adventure_npc_t *npcs, uint16_t npc_count,
                          const uint8_t *skin_pixels, uint16_t atlas_width,
                          uint16_t atlas_height, uint8_t tile_size,
                          const uint16_t skin_indices[9], uint8_t frames_per_char,
                          game_adventure_action_t action, void *user)
{
    ga_release_owned_ppbs(); /* BEFORE old world assets are destroyed. */
    ga_items = items; ga_item_count = item_count > GA_MAX_ITEMS ? GA_MAX_ITEMS : item_count;
    game_adventure_item_styles(0,0);
    memset(ga_icon_atlas,0,sizeof(ga_icon_atlas));
    memset(ga_icon_registered,0,sizeof(ga_icon_registered));
    memset(ga_icon_width,0,sizeof(ga_icon_width));
    memset(ga_icon_height,0,sizeof(ga_icon_height));
    memset(ga_icon_tile,0,sizeof(ga_icon_tile));
    memset(ga_icon_file,0,sizeof(ga_icon_file));
    game_adventure_use_effects(0,0,0,0);
    ga_nodes = nodes; ga_node_count = node_count;
    ga_npcs = npcs; ga_npc_count = npc_count;
    memset(ga_counts, 0, sizeof(ga_counts));
    ga_display_dirty=1u;
    memset(ga_used_choices, 0, sizeof(ga_used_choices));
    memset(ga_completed_npcs, 0, sizeof(ga_completed_npcs));
    memset(ga_npc_visibility, 0, sizeof(ga_npc_visibility));
    for (uint16_t i = 0; i < ga_npc_count && i < 256u; ++i)
        ga_npc_visibility[i] = 1u;
    game_adventure_npc_choice_actions(0, 0);
    game_adventure_remote_npc_actions(0, 0, 0);
    game_adventure_spotlight_actions(0, 0, 0);
    game_adventure_close_gifts(0,0);
    memset(ga_close_gift_claimed,0,sizeof(ga_close_gift_claimed));
    ga_choice_flags = 0;
    ga_completed_nodes = 0;
    game_adventure_exchange_rules(0,0);
    memset(ga_exchange_progress,0,sizeof(ga_exchange_progress));
    game_adventure_wrong_repeat_rules(0,0);
    memset(ga_wrong_repeat_counts,0,sizeof(ga_wrong_repeat_counts));
    for (uint16_t i = 0; i < ga_item_count; ++i) {
        ga_counts[i] = ga_items[i].initial > ga_items[i].capacity
            ? ga_items[i].capacity : ga_items[i].initial;
        /* Register the kind even when the initial balance is zero. The HUD
         * must not wait for a floor pickup to discover inventory linkage. */
        game_adventure_inventory_kind_changed(ga_items[i].pickup_kind);
    }
    ga_inventory_slot_limit=0u;
    ga_restoring_inventory=0u;
    for (uint16_t i=0;i<ga_item_count;++i)
        if(ga_counts[i]) ga_touch_item(i,0u);
    ga_state = ga_choice = ga_inventory_offset = 0;
    ga_trigger_message_mode=0u;
    ga_inventory_selection = ga_inventory_action = ga_confirm_yes = 0;
    ga_bracket_restart();
    memset(ga_drops, 0, sizeof(ga_drops));
    ga_dialog_padding = 8u;
    game_adventure_dialogue_typography(1u,2u,1u,2u,1u);
    /* Keep ga_prev_buttons across world travel: if FIRE2 opened a door and
       is still held during arrival, that hold must NOT reopen inventory. */
    ga_fire2_action = 0; /* Every newly loaded world registers its own query. */
    ga_interaction_probe=0; ga_interaction_use=0; ga_interaction_sound=0; ga_interaction_failed=0;
    ga_active_npc = 0xFFFFu;
    game_adventure_npc_animations(0,0);
    game_adventure_text_style(GA_TEXT_DEFAULT_COLOUR,
                              GA_TEXT_DEFAULT_OUTLINE,
                              GA_TEXT_DEFAULT_OUTLINE_COLOUR);
    ga_node = ga_typed = ga_ticks = ga_reply_typed = ga_reply_ticks = 0;
    ga_after_reply = -1; ga_reply = 0;
    ga_thought_text=ga_inherited_thought=0;
    ga_thought_typed=ga_thought_ticks=0;
    game_adventure_thought_choices(0,0u);
    ga_skin_pixels = skin_pixels; ga_skin_w = atlas_width; ga_skin_h = atlas_height;
    ga_tile = tile_size >= 4 && tile_size <= 32 ? tile_size
                                                    : GAME_ADVENTURE_DEFAULT_TILE_SIZE;
    for (uint8_t i = 0; i < 9; ++i) ga_skin_indices[i] = skin_indices ? skin_indices[i] : i;
    game_adventure_skin_flips(0);
    game_adventure_thought_box(20,12,240u,64u,0,0);
    ga_frames_per_char = frames_per_char ? frames_per_char
                                           : GAME_ADVENTURE_DEFAULT_FRAMES_PER_CHAR;
    ga_action = action; ga_user = user;
    game_adventure_dialogue_box(GA_DIALOG_DEFAULT_X, GA_DIALOG_DEFAULT_Y,
                                GA_DIALOG_DEFAULT_W, GA_DIALOG_DEFAULT_H);
}
static uint8_t ga_choice_visible(uint16_t node, uint8_t choice)
{
    if (ga_trigger_message_mode==1u) return 0u;
    if (node >= ga_node_count || choice >= 3u) return 0;
    const game_adventure_choice_t *c = &ga_nodes[node].choices[choice];
    if (!c->label || !c->label[0]) return 0;
    /* Navigation-only prompts ignore once-only/requirement flags entirely. */
    if (ga_trigger_message_mode==2u) return 1u;
    const uint16_t bit = (uint16_t)(node * 3u + choice);
    if (!ga_choice_flags || !(ga_choice_flags[bit] & 1u)) return 1;
    return !(ga_used_choices[bit / 8u] & (uint8_t)(1u << (bit % 8u)));
}
static void ga_mark_choice_used(uint16_t node, uint8_t choice)
{
    if (node >= 256u || choice >= 3u) return;
    const uint16_t bit = (uint16_t)(node * 3u + choice);
    ga_used_choices[bit / 8u] |= (uint8_t)(1u << (bit % 8u));
}
static uint8_t ga_has_choices(void)
{
    if (ga_node >= ga_node_count) return 0;
    uint8_t n = 0;
    for (uint8_t i = 0; i < 3; ++i)
        if (ga_choice_visible(ga_node,i)) ++n;
    return n;
}
static uint8_t ga_can_receive(uint16_t item)
{
    return item<ga_item_count && ga_items && ga_counts[item]<ga_items[item].capacity &&
        (!ga_inventory_slot_limit || ga_counts[item] ||
          ga_visible_count()<ga_inventory_slot_limit);
}
/* A valid hand-in can free the very slot needed for its reward. */
static uint8_t ga_can_receive_after_take(uint16_t gift,int16_t taken)
{
    if(ga_can_receive(gift))return 1u;
    if(gift>=ga_item_count || !ga_items || !ga_items[gift].capacity)return 0u;
    if(taken<0 || (uint16_t)taken>=ga_item_count || !ga_counts[taken])return 0u;
    if(taken==(int16_t)gift)
        return 1u; /* Consuming one from a full stack makes room for one. */
    return ga_inventory_slot_limit && !ga_counts[gift] && ga_counts[taken]==1u &&
        ga_visible_count()>=ga_inventory_slot_limit;
}
static int16_t ga_find_named_item(const char *name)
{
    if (!name || !*name || !ga_items) return -1;
    for(uint16_t i=0;i<ga_item_count;++i)
        if (ga_items[i].name && strcmp(ga_items[i].name,name)==0) return (int16_t)i;
    return -1;
}
uint8_t game_adventure_can_reward_name(const char *name,uint16_t quantity,
                                       const char *consumed_item)
{
    const int16_t gift=ga_find_named_item(name);
    if (gift<0 || !quantity) return 0u;
    const int16_t taken=ga_find_named_item(consumed_item);
    const uint16_t own=ga_counts[(uint16_t)gift];
    const uint16_t consumes=(uint16_t)(taken==gift && own!=0);
    if ((uint32_t)own-consumes+quantity>ga_items[(uint16_t)gift].capacity) return 0u;
    if (!ga_inventory_slot_limit || own || ga_visible_count()<ga_inventory_slot_limit)
        return 1u;
    return taken>=0 && taken!=gift && ga_counts[(uint16_t)taken]==1u;
}
uint8_t game_adventure_reward_name(const char *name,uint16_t quantity)
{
    const int16_t item=ga_find_named_item(name);
    return item>=0 && quantity && game_adventure_add((uint16_t)item,quantity)==quantity;
}
uint8_t game_adventure_take_name(const char *name,uint16_t quantity)
{
    const int16_t item=ga_find_named_item(name);
    return item>=0 && game_adventure_remove((uint16_t)item,quantity);
}
static uint8_t ga_allowed(const game_adventure_choice_t *c)
{
    return c->requires < 0 || ((uint16_t)c->requires < ga_item_count && ga_counts[c->requires]);
}
/* Called by the reply helper below, before its full definition. */
static void ga_next_node(int16_t node);
/* Explain why a choice/gift was deferred; do not consume or complete it. */
static void ga_inventory_full_reply(int16_t return_node)
{
    ga_reply="Inventory full! Drop something.";
    ga_reply_typed=0u;
    ga_reply_ticks=0u;
    ga_after_reply=return_node;
    ga_state=3u;
}
static uint8_t ga_is_thought(uint16_t node,uint8_t choice)
{
    const uint16_t index=(uint16_t)(node*3u+choice);
    return ga_thought_flags && index<ga_thought_flag_count && (ga_thought_flags[index]&1u);
}
static uint8_t ga_is_thought_this(uint16_t node,uint8_t choice)
{
    const uint16_t index=(uint16_t)(node*3u+choice);
    return ga_thought_flags && index<ga_thought_flag_count && (ga_thought_flags[index]&2u);
}
/* Show THIS-dialogue thoughts beside the NPC's speech. If this node has
 * no Answer labels at all, a thought in any blank choice row becomes a
 * node-local thought, visible until Fire2 closes the speech. It is NOT a
 * selectable choice and cannot fire its associated answer actions.
 * Important: only use this fallback on genuinely answerless nodes, never
 * on nodes with hidden/used answers or in text-only Trigger Message mode
 * when there are real Answer labels. */
static void ga_refresh_thought_for_choice(void)
{
    const char *selected=0;
    if(ga_state==1u && ga_node<ga_node_count) {
        const game_adventure_node_t *node=&ga_nodes[ga_node];
        if(ga_choice<3u && ga_choice_visible(ga_node,ga_choice)) {
            const uint16_t index=(uint16_t)(ga_node*3u+ga_choice);
            if(ga_thought_flags && index<ga_thought_flag_count &&
               (ga_thought_flags[index]&2u)) {
                const char *reply=node->choices[ga_choice].reply;
                if(reply && reply[0]) selected=reply;
            }
        } else {
            uint8_t has_answer=0u;
            for(uint8_t i=0u;i<3u;++i)
                if(node->choices[i].label && node->choices[i].label[0])
                    { has_answer=1u; break; }
            if(!has_answer) for(uint8_t i=0u;i<3u;++i) {
                const uint16_t index=(uint16_t)(ga_node*3u+i);
                const char *reply=node->choices[i].reply;
                if(ga_thought_flags && index<ga_thought_flag_count &&
                   (ga_thought_flags[index]&2u) && reply && reply[0]) {
                    selected=reply;break;
                }
            }
        }
    }
    const char *wanted=selected ? selected : ga_inherited_thought;
    if(wanted!=ga_thought_text) {
        ga_thought_text=wanted;
        ga_thought_typed=ga_thought_ticks=0u;
    }
}
static void ga_set_thought(const char *text)
{
    ga_inherited_thought=text && text[0]?text:0;
    ga_refresh_thought_for_choice();
}
static void ga_reply_then_next(const game_adventure_choice_t *c, int16_t next_node)
{
    ga_reply = c->reply && c->reply[0] ? c->reply : c->label;
    ga_reply_typed = 0;
    if (ga_reply && ga_reply[0]) {
        ga_after_reply = next_node;
        ga_reply_ticks = 0;
        ga_state = 3;
    } else {
        ga_next_node(next_node);
    }
}
static void ga_next_node(int16_t node)
{
    ga_thought_text=ga_inherited_thought=0;
    ga_thought_typed=ga_thought_ticks=0;
    if (node < 0 || node >= ga_node_count) { ga_state = 0; return; }
    ga_trigger_message_mode=0u; /* Normal NPC/full conversation may branch. */
    ga_node = (uint16_t)node; ga_state = 1;
    ga_choice = 0; ga_typed = 0; ga_ticks = 0;
    for (uint8_t i=0;i<3;++i)
        if (ga_choice_visible(ga_node,i)) { ga_choice=i; break; }
    ga_refresh_thought_for_choice();
}
uint8_t game_adventure_trigger_dialogue(uint16_t node)
{
    if (node>=ga_node_count || !ga_nodes) return 0u;
    ga_active_npc=UINT16_MAX; /* No NPC completion assigned to this trigger. */
    ga_next_node((int16_t)node);
    ga_bracket_restart();
    return 1u;
}
uint8_t game_adventure_trigger_message(uint16_t node)
{
    if (node>=ga_node_count || !ga_nodes) return 0u;
    ga_active_npc=UINT16_MAX;
    ga_next_node((int16_t)node);
    ga_trigger_message_mode=1u;
    ga_refresh_thought_for_choice();
    ga_bracket_restart();
    return 1u;
}
uint8_t game_adventure_trigger_sequence(uint16_t node)
{
    if (node>=ga_node_count || !ga_nodes) return 0u;
    ga_active_npc=UINT16_MAX;
    ga_next_node((int16_t)node);
    ga_trigger_message_mode=2u;
    /* Pick the first navigation label, ignoring saved once-only flags. */
    for (uint8_t i=0;i<3u;++i)
        if (ga_choice_visible(ga_node,i)) {ga_choice=i;break;}
    ga_refresh_thought_for_choice();
    ga_bracket_restart();
    return 1u;
}
/* Both selected-answer and answerless-dialogue-close effects use the same
 * sparse table. On-close IDs start at 3 * number_of_nodes. No frame polling. */
static void ga_apply_npc_appearance(uint16_t event_id)
{
    if (ga_spotlight_rules && ga_spotlight_apply)
        for (uint16_t i = 0; i < ga_spotlight_rule_count; ++i)
            if (ga_spotlight_rules[i].event_id == event_id)
                ga_spotlight_apply(ga_spotlight_rules[i].action);
    for (uint16_t i = 0; i < ga_npc_choice_action_count; ++i) {
        const game_adventure_npc_choice_action_t *rule = &ga_npc_choice_actions[i];
        if (rule->choice_id != event_id) continue;
        if (rule->npc_a != UINT16_MAX) game_adventure_npc_action(rule->npc_a, rule->action_a);
        if (rule->npc_b != UINT16_MAX) game_adventure_npc_action(rule->npc_b, rule->action_b);
        break;
    }
    if (ga_remote_npc_rules && ga_remote_npc_apply)
        for (uint16_t i=0; i<ga_remote_npc_rule_count; ++i)
            if (ga_remote_npc_rules[i].event_id == event_id)
                ga_remote_npc_apply(ga_remote_npc_rules[i].world,
                                   ga_remote_npc_rules[i].npc_slot,
                                   ga_remote_npc_rules[i].action);
}
/* Award terminal-node gifts once. On full inventory, retry next time rather
 * than marking the gift claimed and silently losing it. */
static uint8_t ga_award_close_gift(uint16_t node)
{
    if (node>=256u) return 1u;
    const uint8_t mask=(uint8_t)(1u<<(node & 7u));
    uint8_t *used=&ga_close_gift_claimed[node>>3u];
    if (*used & mask) return 1u;
    for(uint16_t i=0;i<ga_close_gift_count;++i) {
        if (ga_close_gifts[i].node_id!=node) continue;
        if(!game_adventure_add(ga_close_gifts[i].item_id,1u)) return 0u;
        *used|=mask;
        return 1u;
    }
    return 1u;
}
static void ga_success_choice(const game_adventure_choice_t *c, uint16_t node, uint8_t choice)
{
    if (c->give >= 0) game_adventure_add((uint16_t)c->give,1u);
    if (c->action >= 0 && ga_action) ga_action((uint16_t)c->action,ga_user);
    const uint16_t flag_index=(uint16_t)(node*3u+choice);
    ga_apply_npc_appearance(flag_index);
    const uint8_t flags=ga_choice_flags ? ga_choice_flags[flag_index] : 0u;
    if (flags & 1u) ga_mark_choice_used(node,choice);
    if ((flags & 2u) && ga_active_npc < ga_npc_count && ga_active_npc < 256u)
        ga_completed_npcs[ga_active_npc]=1u;
    if(ga_is_thought(node,choice)){
        const char *thought=c->reply;
        ga_next_node(c->next);
        if(ga_state==1u)ga_set_thought(thought);
    } else if(ga_is_thought_this(node,choice)) {
        /* Already shown with THIS node: do not repeat it as spoken reply. */
        ga_next_node(c->next);
    } else ga_reply_then_next(c,c->next);
}
/* GIVE is a separate inventory mode. A wrong offer is never taken. Incremental
 * deliveries consume one copy only when allowed, and remember their slot by
 * dialogue choice. ALL-at-once commits all requirements atomically. */
static void ga_offer_item(uint16_t offered)
{
    const game_adventure_exchange_t *r=ga_exchange_rule(ga_exchange_node,ga_exchange_choice);
    if (!r || ga_exchange_node >= ga_node_count || offered >= ga_item_count) { ga_state=1u; return; }
    const uint16_t key=(uint16_t)(ga_exchange_node*3u+ga_exchange_choice);
    const game_adventure_choice_t *choice=&ga_nodes[ga_exchange_node].choices[ga_exchange_choice];
    int slot=-1;
    for (uint8_t i=0;i<r->count && i<4u;++i)
        if (r->items[i]>=0 && (uint16_t)r->items[i]==offered) {slot=i;break;}
    /* Re-offering an already delivered part is not another valid delivery. */
    if (slot<0 || (r->incremental && (ga_exchange_progress[key] & (1u<<slot)))) {
        /* A configured wrong item can have escalating replies. No successful
         * hand-in, completion flag or inventory consumption occurs here. */
        const game_adventure_wrong_repeat_t *repeat=ga_find_wrong_repeat(key,offered);
        if (repeat) {
            uint8_t *count=&ga_wrong_repeat_counts[key];
            if (*count>4u) *count=4u; /* clamp invalid restored values */
            if (*count<4u) ++*count; /* saturate, never wrap */
            const uint8_t step=(uint8_t)(*count-1u);
            /* UINT16_MAX is the no-action sentinel; generated Game Object
             * events (33000+) must NOT be treated as signed int16_t. */
            if (*count==3u && repeat->reveal_action!=UINT16_MAX && ga_action)
                ga_action(repeat->reveal_action,ga_user);
            const int16_t next=repeat->replies[step];
            if (next>=0 && (uint16_t)next<ga_node_count) { ga_next_node(next);return; }
        }
        if (r->wrong_action>=0 && ga_action) ga_action((uint16_t)r->wrong_action,ga_user);
        if (r->wrong_next>=0) ga_next_node(r->wrong_next);
        else ga_next_node((int16_t)ga_exchange_node);
        return;
    }
    if(choice->give>=0 &&
       !ga_can_receive_after_take((uint16_t)choice->give,
            r->consume ? (int16_t)offered : -1)) {
        ga_inventory_full_reply((int16_t)ga_exchange_node);
        return;
    }
    if (r->any) {
        if (r->consume && !game_adventure_remove(offered,1u)) {ga_state=1u;return;}
        ga_success_choice(choice,ga_exchange_node,ga_exchange_choice);
        return;
    }
    if (r->incremental) {
        if (r->consume && !game_adventure_remove(offered,1u)) {ga_state=1u;return;}
        ga_exchange_progress[key] |= (uint8_t)(1u<<slot);
        const uint8_t mask=(uint8_t)((1u<<r->count)-1u);
        if ((ga_exchange_progress[key] & mask)==mask) {
            ga_success_choice(choice,ga_exchange_node,ga_exchange_choice);
        } else {
            /* Partial delivery is remembered silently. Do not reveal which
               additional puzzle items are required through a hint dialogue. */
            ga_next_node((int16_t)ga_exchange_node);
        }
        return;
    }
    /* All-at-once: every requested item must be present before anything is taken. */
    for (uint8_t i=0;i<r->count;++i)
        if (r->items[i]<0 || (uint16_t)r->items[i]>=ga_item_count ||
            !ga_counts[r->items[i]]) {
            /* Partial delivery is remembered silently. Do not reveal which
               additional puzzle items are required through a hint dialogue. */
            ga_next_node((int16_t)ga_exchange_node);
            return;
        }
    if (r->consume) for (uint8_t i=0;i<r->count;++i)
        game_adventure_remove((uint16_t)r->items[i],1u);
    ga_success_choice(choice,ga_exchange_node,ga_exchange_choice);
}
/* The dropped item is a physical collectible, not a silent delete.
   It starts unarmed while the player is touching it, so it cannot instantly
   jump back into the backpack on the next frame. */
static uint8_t ga_drop_item(uint16_t item_id, int32_t player_x, int32_t player_y,
                            uint16_t player_w, uint16_t player_h)
{
    if (item_id >= ga_item_count || !ga_counts[item_id] || !ga_droppable(item_id)) return 0;
    for (uint8_t i=0; i<GAME_ADVENTURE_MAX_DROPS; ++i) {
        if (ga_drops[i].active) continue;
        ga_drops[i].x = player_x + (int32_t)player_w/2 - 8;
        ga_drops[i].y = player_y + (int32_t)player_h - 16;
        ga_drops[i].item_id = item_id;
        ga_drops[i].active = 1u;
        ga_drops[i].armed = 0u;
        game_adventure_remove(item_id, 1u);
        return 1;
    }
    return 0; /* World drop slots full: leave the inventory unchanged. */
}
static void ga_collect_drops(int32_t x, int32_t y, uint16_t w, uint16_t h)
{
    if (!w || !h) return;
    for (uint8_t i=0; i<GAME_ADVENTURE_MAX_DROPS; ++i) {
        game_adventure_drop_t *drop=&ga_drops[i];
        if (!drop->active || drop->item_id >= ga_item_count) continue;
        const uint8_t touching = (uint8_t)((int64_t)x < (int64_t)drop->x+16 &&
            (int64_t)x+w > drop->x && (int64_t)y < (int64_t)drop->y+16 &&
            (int64_t)y+h > drop->y);
        if (!touching) { drop->armed=1u; continue; }
        if (drop->armed && game_adventure_add(drop->item_id,1u)) drop->active=0u;
    }
}
static void ga_draw_item_icon(uint16_t id, int x, int y)
{
    if (id >= ga_item_count) return;
    /* A configured custom icon source must NEVER silently draw skin tiles.
       Missing custom PPBs show a fallback rectangle until fixed. */
    const uint8_t *pixels=ga_icon_registered[id] ? ga_icon_atlas[id] : ga_skin_pixels;
    const uint16_t atlas_w=ga_icon_registered[id] ? ga_icon_width[id] : ga_skin_w;
    const uint16_t atlas_h=ga_icon_registered[id] ? ga_icon_height[id] : ga_skin_h;
    const uint16_t tile=ga_icon_registered[id] ? ga_icon_tile[id] : ga_tile;
    if (!pixels || !tile || atlas_w < tile || atlas_h < tile) {
        /* Without an atlas, a dropped item must remain visible/recoverable. */
        gfx_setcolour(ga_text_colour); gfx_rectf(x,y,16,16);
        return;
    }
    const uint16_t columns=atlas_w/tile;
    const uint32_t total=(uint32_t)columns*(atlas_h/tile);
    const uint8_t composite=(uint8_t)(ga_item_styles && id < ga_item_style_count &&
        ga_item_styles[id].icon_2x2);
    const uint8_t cells=composite?4u:1u;
    uint8_t drawn=0u;
    /* Fit every icon in a 16px viewport, even when atlas cells are 16/32px. */
    const uint16_t cell_size = composite ? 8u : 16u;
    const uint16_t scale=(uint16_t)((100u*cell_size)/tile);
    for (uint8_t part=0; part<cells; ++part) {
        const uint16_t cell=composite ? ga_item_styles[id].icon_cells[part] : ga_items[id].icon;
        if (cell==65535u || cell>=total) continue;
        gfxbob_t icon; memset(&icon,0,sizeof(icon));
        icon.imgdat=pixels + (uint32_t)(cell/columns)*tile*atlas_w
                    + (uint32_t)(cell%columns)*tile;
        icon.atlas_stride=atlas_w;
        icon.atlas_height=tile; icon.width=tile;
        icon.height=tile; icon.scale=scale; icon.index=0;
        icon.drawx=(int16_t)(x+(composite?(part&1u)*cell_size:0));
        icon.drawy=(int16_t)(y+(composite?(part>>1)*cell_size:0));
        gfx_drawbob(&icon);
        drawn=1u;
    }
    if (!drawn) {
        gfx_setcolour(ga_text_colour); gfx_rectf(x,y,16,16);
    }
}
uint8_t game_adventure_input(uint8_t buttons, int32_t player_x, int32_t player_y,
                             uint16_t player_w, uint16_t player_h, uint16_t frames)
{
    const uint8_t press = (buttons & BTN_FIRE2) && !(ga_prev_buttons & BTN_FIRE2);
    const uint8_t fire = (buttons & BTN_FIRE) && !(ga_prev_buttons & BTN_FIRE);
    const uint8_t up = (buttons & BTN_UP) && !(ga_prev_buttons & BTN_UP);
    const uint8_t down = (buttons & BTN_DOWN) && !(ga_prev_buttons & BTN_DOWN);
    const uint8_t left = (buttons & BTN_LEFT) && !(ga_prev_buttons & BTN_LEFT);
    const uint8_t right = (buttons & BTN_RIGHT) && !(ga_prev_buttons & BTN_RIGHT);
    /* Record modal FIRE1 before an item action changes ga_state to idle. */
    if (!(buttons & BTN_FIRE)) ga_fire1_blocked=0u;
    else if (ga_state != 0u) ga_fire1_blocked=1u;
    ga_prev_buttons = buttons;
    ga_tick_animations(frames);
    ga_bracket_frames=(uint8_t)(((uint32_t)ga_bracket_frames + frames) % 20u);
    ga_player_x = player_x; ga_player_y = player_y;
    if (ga_state == 5u) {
        const uint16_t visible=ga_visible_count();
        if (ga_inventory_selection>=visible)
            ga_inventory_selection=visible ? (uint8_t)(visible-1u) : 0u;
        if (press) { ga_state=1u; ga_bracket_restart(); return 1; }
        if (down && (uint16_t)ga_inventory_selection+1u<visible) ++ga_inventory_selection;
        if (up && ga_inventory_selection) --ga_inventory_selection;
        if (up || down) {
            ga_bracket_restart();
            if (ga_inventory_selection < ga_inventory_offset) ga_inventory_offset=ga_inventory_selection;
            if ((uint16_t)ga_inventory_selection >= (uint16_t)ga_inventory_offset+GA_INVENTORY_ROWS)
                ga_inventory_offset=(uint8_t)(ga_inventory_selection-GA_INVENTORY_ROWS+1u);
            ga_inventory_clamp_offset();
        }
        if (fire && visible) ga_offer_item(ga_visible_item_id(ga_inventory_selection));
        return 1;
    }
    if (ga_state == 0) {
        ga_collect_drops(player_x, player_y, player_w, player_h);
        if (!press) return 0;
        const int32_t pcx = player_x + player_w / 2, pcy = player_y + player_h / 2;
        for (uint16_t i = 0; i < ga_npc_count; ++i) {
            if (!game_adventure_npc_visible(i)) continue;
            const game_adventure_npc_t *npc = &ga_npcs[i];
            const int32_t nx = npc->x + npc->width / 2;
            const int32_t ny = npc->y + npc->height / 2;
            const int32_t dx = nx - pcx, dy = ny - pcy;
            if (dx >= -(int32_t)npc->radius && dx <= npc->radius &&
                dy >= -(int32_t)npc->radius && dy <= npc->radius && npc->first_node < ga_node_count) {
                ga_active_npc = i;
                const uint16_t after = ga_completed_nodes ? ga_completed_nodes[i] : UINT16_MAX;
                const uint16_t start = ga_completed_npcs[i] && after < ga_node_count
                    ? after : npc->first_node;
                ga_next_node((int16_t)start);
                return 1;
            }
        }
        /* Item-targeted interaction uses the same inventory picker, without
         * allowing the normal free-standing USE/DROP actions to run. */
        if (ga_interaction_probe && ga_interaction_use &&
            ga_interaction_probe(player_x,player_y,player_w,player_h)) {
            ga_state=6u; ga_interaction_failed=0u;
            ga_inventory_offset=ga_inventory_selection=ga_inventory_action=0u;
            ga_bracket_restart();
            return 1;
        }
        /* A nearby FIRE2 door/switch has priority over opening the bag.
         * The query is read-only; normal gameworlds_after() still fires it. */
        if (ga_fire2_action && ga_fire2_action(player_x, player_y, player_w, player_h))
            return 0;
        ga_state = 2; ga_inventory_offset = ga_inventory_selection = ga_inventory_action = 0;
        ga_bracket_restart();
        return 1;
    }
    if (ga_state == 4) {
        /* DESTROY confirmation: FIRE2 always cancels/closes a modal;
           FIRE1 confirms, and NO is the default. */
        if (left || right || up || down) {
            ga_confirm_yes ^= 1u;
            ga_bracket_restart();
        }
        if (press) { ga_state = 2u; ga_confirm_yes = 0u; ga_bracket_restart(); return 1; }
        if (fire) {
            const uint16_t id = ga_visible_item_id(ga_inventory_selection);
            /* Only confirmed destruction closes the backpack.  NO (or a
               rejected action) returns to the inventory without losing it. */
            const uint8_t removed=(uint8_t)(ga_confirm_yes && id < ga_item_count &&
                ga_discardable(id) && game_adventure_remove(id, 1u));
            ga_confirm_yes = 0u;
            ga_state = removed ? 0u : 2u;
            ga_inventory_clamp_offset();
            ga_bracket_restart();
        }
        return 1;
    }
    if (ga_state == 2 || ga_state == 6) {
        const uint16_t visible = ga_visible_count();
        if (ga_inventory_selection >= visible)
            ga_inventory_selection = visible ? (uint8_t)(visible-1u) : 0u;
        if (press) {
            if (ga_state==6u && ga_interaction_sound) ga_interaction_sound(2u);
            ga_state = 0; ga_interaction_failed=0; return 1;
        }
        if (down && (uint16_t)ga_inventory_selection+1u < visible) {
            ++ga_inventory_selection; ga_inventory_action=0u;
            ga_bracket_restart();
        }
        if (up && ga_inventory_selection) {
            --ga_inventory_selection; ga_inventory_action=0u;
            ga_bracket_restart();
        }
        /* Each permission is independent: a quest item may be dropped
         * for later retrieval but never permanently destroyed. */
        const uint16_t action_id=ga_visible_item_id(ga_inventory_selection);
        const uint8_t can_use=ga_can_use(action_id);
        const uint8_t can_discard=ga_discardable(action_id);
        const uint8_t can_drop=ga_droppable(action_id);
        const uint8_t count=(uint8_t)(can_use + can_drop + can_discard);
        if (ga_state==6u && (up || down)) ga_interaction_failed=0u;
        if (count && ga_inventory_action >= count) ga_inventory_action=(uint8_t)(count-1u);
        if (left && ga_inventory_action) { --ga_inventory_action; ga_bracket_restart(); }
        if (right && count && ga_inventory_action + 1u < count) {
            ++ga_inventory_action; ga_bracket_restart();
        }
        if (up || down) {
            if (ga_inventory_selection < ga_inventory_offset)
                ga_inventory_offset = ga_inventory_selection;
            if ((uint16_t)ga_inventory_selection >=
                (uint16_t)ga_inventory_offset+GA_INVENTORY_ROWS)
                ga_inventory_offset=(uint8_t)(ga_inventory_selection-GA_INVENTORY_ROWS+1u);
            ga_inventory_clamp_offset();
        }
        if (fire && visible) {
            const uint16_t id = ga_visible_item_id(ga_inventory_selection);
            if (ga_state==6u) {
                uint8_t outcome=0;
                if (id<ga_item_count && ga_counts[id] && ga_interaction_use) {
                    /* Release the inventory modal BEFORE the callback.
                     * A successful Trigger may open an Adventure dialogue. */
                    ga_state=0u;
                    outcome=ga_interaction_use(ga_items[id].name);
                }
                if (outcome==1u || outcome==2u) {
                    if (outcome==2u) game_adventure_remove(id,1u);
                    ga_interaction_failed=0u;
                } else if (ga_state==1u) {
                    /* Wrong-item callback opened a dialogue. Do not clobber
                     * it by restoring the inventory USE picker. No item taken. */
                    ga_interaction_failed=0u;
                } else {
                    ga_state=6u;
                    ga_interaction_failed=(outcome==3u) ? 2u : 1u;
                }
                ga_bracket_restart();
                return 1;
            }
            if (id < ga_item_count) {
                const uint8_t has_use=ga_can_use(id);
                const uint8_t has_discard=ga_discardable(id);
                const uint8_t has_drop=ga_droppable(id);
                if (has_use && ga_inventory_action==0u) {
                    if (ga_use_item(id)) ga_state=0u;
                } else {
                    const uint8_t next=(uint8_t)(ga_inventory_action-(has_use?1u:0u));
                    if(has_drop && next==0u) {
                        if(ga_drop_item(id,player_x,player_y,player_w,player_h)) ga_state=0u;
                    } else if(has_discard && next==(has_drop?1u:0u)) {
                        ga_confirm_yes=0u;ga_state=4u;
                        ga_bracket_restart();
                    }
                }
                if (ga_inventory_selection >= ga_visible_count() && ga_inventory_selection)
                    --ga_inventory_selection;
                ga_inventory_clamp_offset();
            }
        }
        return 1;
    }
    if (ga_state == 3) {
        if (ga_reply && ga_reply_typed < strlen(ga_reply)) {
            const uint32_t elapsed = (uint32_t)ga_reply_ticks + frames;
            ga_reply_typed += elapsed / ga_frames_per_char;
            ga_reply_ticks = (uint16_t)(elapsed % ga_frames_per_char);
            if (ga_reply_typed > strlen(ga_reply)) ga_reply_typed = (uint16_t)strlen(ga_reply);
        }
        if (press) ga_next_node(ga_after_reply);
        return 1;
    }
    if (ga_node >= ga_node_count) { ga_state = 0; return 0; }
    const game_adventure_node_t *n = &ga_nodes[ga_node];
    const uint16_t text_len = (uint16_t)strlen(n->text ? n->text : "");
    if (ga_typed < text_len) {
        const uint32_t elapsed = (uint32_t)ga_ticks + frames;
        ga_typed += elapsed / ga_frames_per_char;
        ga_ticks = (uint16_t)(elapsed % ga_frames_per_char);
        if (ga_typed > text_len) ga_typed = text_len;
    }
    const uint8_t count = ga_has_choices();
    if (count && up) {
        do { ga_choice = (uint8_t)((ga_choice + 2) % 3); }
        while (!ga_choice_visible(ga_node,ga_choice));
    }
    if (count && down) {
        do { ga_choice = (uint8_t)((ga_choice + 1) % 3); }
        while (!ga_choice_visible(ga_node,ga_choice));
    }
    ga_refresh_thought_for_choice();
    /* Thought and dialogue type simultaneously, without any second modal.
     * Update the selection BEFORE typing so arrow presses switch immediately. */
    if(ga_thought_text && ga_thought_typed<strlen(ga_thought_text)){
        const uint32_t elapsed=(uint32_t)ga_thought_ticks+frames;
        ga_thought_typed+=(uint16_t)(elapsed/ga_frames_per_char);
        ga_thought_ticks=(uint16_t)(elapsed%ga_frames_per_char);
        if(ga_thought_typed>strlen(ga_thought_text))
            ga_thought_typed=(uint16_t)strlen(ga_thought_text);
    }
    if (press) {
        if (ga_typed < text_len) { ga_typed = text_len; return 1; }
        if (!count) {
            if (ga_trigger_message_mode) {
                /* No choice/navigation prompt: end text-only conversation.
                 * Never grant close gifts or run NPC appearance effects. */
                ga_trigger_message_mode=0u;
                ga_state=0u;
                return 0u;
            }
            /* Closing a terminal speech node is not a dialogue-choice event.
             * Trigger its separately configured NPC actions now. */
            /* Grant before hiding the NPC. No fake selectable answer needed. */
            if(!ga_award_close_gift(ga_node)) {
                ga_inventory_full_reply((int16_t)ga_node);
                return 1; /* Retain gift to retry. */
            }
            ga_apply_npc_appearance((uint16_t)(ga_node_count*3u+ga_node));
            ga_state = 0;
            return 0;
        }
        if (!ga_choice_visible(ga_node,ga_choice)) { ga_next_node((int16_t)ga_node); return 1; }
        const game_adventure_choice_t *c = &n->choices[ga_choice];
        if (ga_trigger_message_mode==2u) {
            /* Follow only the selected Next link. Ignore item checks, gifts,
             * TAKE, action, reply, NPC progress and once-only flags. */
            const int16_t next=c->next;
            if (next>=0 && next<ga_node_count) {
                ga_next_node(next);
                if(ga_is_thought((uint16_t)(n-ga_nodes), (uint8_t)(c-n->choices)))
                    ga_set_thought(c->reply);
                ga_trigger_message_mode=2u;
                for (uint8_t i=0;i<3u;++i)
                    if (ga_choice_visible(ga_node,i)) {ga_choice=i;break;}
                ga_refresh_thought_for_choice();
                ga_bracket_restart();
                return 1u;
            }
            ga_trigger_message_mode=0u;
            ga_state=0u;
            return 0u;
        }
        if (ga_exchange_rule(ga_node,ga_choice)) {
            ga_exchange_node=ga_node;
            ga_exchange_choice=ga_choice;
            ga_inventory_offset=ga_inventory_selection=ga_inventory_action=0u;
            ga_bracket_restart();
            ga_state=5u;
            return 1;
        }
        if (!ga_allowed(c)) {
            /* No item: branch directly to the alternate NPC dialogue.
               Never display the successful answer's player-speech bubble,
               and never execute its item, event or completion actions. */
            if (c->missing_next >= 0 && c->missing_next < ga_node_count)
                ga_next_node(c->missing_next);
            return 1;
        }
        /* Do not consume a quest requirement or complete a puzzle if its
         * reward has nowhere to go. The player can free a slot and retry. */
        if (c->give >= 0 &&
            !ga_can_receive_after_take((uint16_t)c->give,c->take)) {
            ga_inventory_full_reply((int16_t)ga_node);
            return 1;
        }
        if (c->take >= 0 && !game_adventure_remove((uint16_t)c->take, 1)) return 1;
        ga_success_choice(c,ga_node,ga_choice);
    }
    return 1;
}

/* A 9-slice frame has a full outer tile around its usable interior.
   Padding is measured from the INSIDE edge of that decorative border,
   not from the sprite frame's outside corner. No skin => no tile border. */
static uint8_t ga_frame_border(void)
{
    return (ga_skin_pixels && ga_tile && ga_skin_w >= 3u*ga_tile &&
            ga_skin_h >= 3u*ga_tile) ? ga_tile : 0u;
}
static int ga_dialog_inset(void)
{ return (int)ga_frame_border() + (int)ga_dialog_padding; }
static int ga_dialog_bottom_inset(void)
{ const int pad=ga_dialog_inset(); return pad>=8 ? pad-8 : 0; }

/* Draw the nine atlas cells as a stretched tiled frame. The LCD canvas is
   assumed to be 480x320; the frame is drawn last, after all world sprites. */
static void ga_frame_skin(int16_t x,int16_t y,uint16_t width,uint16_t height,
                          const uint16_t skin_indices[9],const uint8_t skin_flips[9])
{
    gfx_setcolour(2); gfx_rectf(x, y, width, height);
    if (!ga_skin_pixels || ga_skin_w < ga_tile * 3 || ga_skin_h < ga_tile * 3) return;
    const uint16_t columns = ga_skin_w / ga_tile;
    const uint16_t rows = ga_skin_h / ga_tile;
    const uint32_t cells = (uint32_t)columns * rows;
    for (uint16_t iy = 0; iy < height; iy += ga_tile) {
        for (uint16_t ix = 0; ix < width; ix += ga_tile) {
            const uint8_t pos = (uint8_t)((iy == 0 ? 0 : iy + ga_tile >= height ? 2 : 1) * 3 +
                                          (ix == 0 ? 0 : ix + ga_tile >= width ? 2 : 1));
            const uint16_t index = skin_indices[pos];
            if (index >= cells) continue;
            gfxbob_t tile;
            memset(&tile, 0, sizeof(tile));
            /* gfxbob_t.index is uint8_t. Rebase the pixel pointer to the
               selected cell so tile IDs beyond 255 render correctly too. */
            const uint32_t pixel_offset = ((uint32_t)(index / columns) * ga_tile * ga_skin_w)
                                        + (uint32_t)(index % columns) * ga_tile;
            tile.imgdat = ga_skin_pixels + pixel_offset;
            tile.atlas_stride = ga_skin_w;
            tile.atlas_height = ga_tile; tile.width = ga_tile; tile.height = ga_tile;
            tile.drawx = x + ix; tile.drawy = y + iy;
            tile.scale = 100; tile.index = 0;
            tile.flags = skin_flips[pos];
            gfx_drawbob(&tile);
        }
    }
}
static void ga_frame(int16_t x,int16_t y,uint16_t w,uint16_t h)
{ ga_frame_skin(x,y,w,h,ga_skin_indices,ga_skin_flips); }
static void ga_text(int x, int y, const char *text)
{
    if (!text || !text[0]) return;
    if (ga_outline_enabled) {
        gfx_setcolour(ga_outline_colour);
        gfx_drawtext(x-1,y,text);
        gfx_drawtext(x+1,y,text);
        gfx_drawtext(x,y-1,text);
        gfx_drawtext(x,y+1,text);
    }
    gfx_setcolour(ga_text_colour);
    gfx_drawtext(x,y,text);
}
/* Glyphs in the SIDBOX font are native 8x8. gfx_drawtextf scales them
   independently; only dialogue and simultaneous thoughts use these settings.
   Inventory menus deliberately keep their existing unscaled typography. */
static void ga_dialog_text(int x,int y,const char *text,uint8_t sx,uint8_t sy)
{
    if(!text || !text[0])return;
    /* Preserve the exact legacy font path at the default 8x16 setting. */
    if(sx==1u && sy==2u){ ga_text(x,y,text); return; }
    if(ga_outline_enabled){
        gfx_setcolour(ga_outline_colour);
        gfx_drawtextf(x-1,y,text,sx,sy);
        gfx_drawtextf(x+1,y,text,sx,sy);
        gfx_drawtextf(x,y-1,text,sx,sy);
        gfx_drawtextf(x,y+1,text,sx,sy);
    }
    gfx_setcolour(ga_text_colour);
    gfx_drawtextf(x,y,text,sx,sy);
}
/* Brackets are drawn around a fixed-label origin. Selecting an action must
   never move the words themselves (same for the confirmation dialogue). */
static void ga_fixed_action(int x, int y, const char *word, uint8_t selected)
{
    ga_text(x,y,word);
    if (selected && ga_brackets_visible()) {
        ga_text(x-8,y,"[");
        ga_text(x+(int)strlen(word)*8,y,"]");
    }
}
/* The font is 8x16. This routine is shared by NPC text and answer choices.
   It returns the number of displayed lines and never prints outside the
   caller's vertical budget. Word boundaries are retained where possible. */
static uint8_t ga_wrapped_scaled(const char *text, uint16_t visible, int x, int y,
                                 uint8_t max_columns, uint8_t max_lines,
                                 uint8_t sx,uint8_t sy)
{
    if (!text || !max_lines || !max_columns) return 0;
    char line[GA_COLS + 1]; uint16_t pos = 0; uint8_t lines = 0;
    const int row_height = 8*(int)sy+(ga_outline_enabled?4:0);
    if (max_columns > GA_COLS) max_columns = GA_COLS;
    while (text[pos] && pos < visible && lines < max_lines) {
        uint8_t n = 0;
        while (text[pos] && pos < visible && text[pos] != '\n' &&
               n < max_columns) line[n++] = text[pos++];
        if (n == max_columns && text[pos] && pos < visible &&
            text[pos] != ' ' && text[pos] != '\n') {
            uint8_t last_space = n;
            while (last_space && line[last_space-1] != ' ') --last_space;
            if (last_space > 0) {
                pos -= n - last_space + 1;
                n = last_space - 1;
            }
        }
        while (n && line[n-1] == ' ') --n;
        line[n] = 0;
        if (text[pos] == '\n' && pos < visible) ++pos;
        while (text[pos] == ' ' && pos < visible) ++pos;
        ga_dialog_text(x, y + lines * row_height, line,sx,sy);
        ++lines;
    }
    return lines;
}

/* Count rows for a full answer, up to max_rows. Text may contain explicit
   newlines and long words. The estimate is used for scrolling the answers. */
static uint8_t ga_answer_rows(const char *text, uint8_t columns, uint8_t max_rows)
{
    if (!text || !text[0]) return 0;
    if (!columns) return 1;
    uint16_t at=0; uint8_t rows=0;
    while (text[at] && rows < max_rows) {
        uint8_t taken=0;
        while (text[at] && text[at]!='\n' && taken<columns) { ++at; ++taken; }
        if (taken==columns && text[at] && text[at]!='\n' && text[at]!=' ') {
            /* Match the renderer's wrap-at-space behaviour. */
            uint8_t rewind=taken;
            while (rewind && text[at-(taken-rewind)-1]!=' ') --rewind;
            if (rewind) at -= taken-rewind+1;
        }
        if (text[at]=='\n') ++at;
        while (text[at]==' ') ++at;
        ++rows;
    }
    return rows;
}

/* Count the largest adjacent pair of choices, not all three. A dialogue only
   shows two choices at once. Using the largest pair keeps the box height
   steady while the player navigates between them. */
static int ga_two_choice_height(const game_adventure_node_t *node,
                                uint8_t answer_columns, int row)
{
    uint8_t rows[3]={0,0,0}, count=0;
    for (uint8_t i=0;i<3;++i) {
        if (ga_choice_visible(ga_node,i))
            rows[count++]=ga_answer_rows(node->choices[i].label,answer_columns,32);
    }
    if (!count) return 0;
    int largest=(int)rows[0]*row;
    if (count>1) {
        largest=0;
        for (uint8_t i=0;i+1<count;++i) {
            const int pair=((int)rows[i]+rows[i+1])*row+4;
            if (pair>largest) largest=pair;
        }
    }
    return largest;
}
static int ga_dialogue_required_height(const game_adventure_node_t *node,
                                       uint8_t body_columns, uint8_t answer_columns,
                                       int row)
{
    const uint8_t body_rows=ga_answer_rows(node->text,body_columns,64);
    const int choice_height=ga_two_choice_height(node,answer_columns,row);
    /* Name at y+9, body at y+32, answers after body+9, bottom 12px. */
    /* The earlier extra eight pixels sat between the text and the choices
       (or between the name and body when no choices existed).  Reclaim that
       space instead of removing the protective border/text inset. */
    return (choice_height ? row+8 : row) + ga_dialog_inset() +
        ga_dialog_bottom_inset() + (int)body_rows*row +
        (choice_height ? 1+choice_height : 0);
}

/* Draw the optional simultaneous player thought. No new modal state and
 * no dependence on an NPC being present. It draws whichever active thought
 * was selected from a NEXT link, the highlighted Answer, or an empty-Answer
 * THIS-dialogue thought. */
static void ga_draw_thought(void)
{
    if(!ga_thought_text || !ga_thought_text[0])return;
    const int inset=ga_dialog_inset();
    const int line_h=8*(int)ga_thought_scale_y+(ga_outline_enabled?4:0);
    int cols=((int)ga_thought_w-2*inset)/(8*(int)ga_thought_scale_x);
    if(cols<1)cols=1;
    if(cols>GA_COLS)cols=GA_COLS;
    const int text_rows=ga_answer_rows(ga_thought_text,(uint8_t)cols,16);
    const int needed=2*inset+text_rows*line_h;
    int h=(int)ga_thought_h;
    if(h<needed)h=needed;
    if(h>320)h=320;
    const int y=ga_thought_y+h>320?320-h:ga_thought_y;
    ga_frame_skin(ga_thought_x,(int16_t)y,ga_thought_w,(uint16_t)h,
                  ga_thought_indices,ga_thought_flips);
    int visible=(h-2*inset)/line_h;
    if(visible<0)visible=0;
    if(visible>16)visible=16;
    ga_wrapped_scaled(ga_thought_text,ga_thought_typed,ga_thought_x+inset,y+inset,
                      (uint8_t)cols,(uint8_t)visible,ga_thought_scale_x,ga_thought_scale_y);
}

void game_adventure_draw_npcs(int32_t camera_x, int32_t camera_y)
{
    /* World-local backpack drops are also drawn through this already-wired
       game draw call; user-owned main.c needs no changes. */
    for (uint8_t i=0; i<GAME_ADVENTURE_MAX_DROPS; ++i) {
        const game_adventure_drop_t *drop=&ga_drops[i];
        if (!drop->active || drop->item_id>=ga_item_count) continue;
        const int32_t sx=drop->x-camera_x, sy=drop->y-camera_y;
        if (sx < -16 || sy < -16 || sx >= 480 || sy >= 320) continue;
        ga_draw_item_icon(drop->item_id,(int)sx,(int)sy);
    }

    /* NPCs use the SAME BOB used by the animation system. World locations
       come from regenerated adventure data, not a hand-edited main.c. */
    for (uint16_t i = 0; i < ga_npc_count && i < ga_animation_count; ++i) {
        if (!game_adventure_npc_visible(i)) continue;
        gfxbob_t *sprite = ga_animations[i].sprite;
        if (!sprite || !sprite->imgdat) continue;
        const int32_t x = ga_npcs[i].x - camera_x;
        const int32_t y = ga_npcs[i].y - camera_y;
        if (x <= -((int32_t)sprite->width) || y <= -((int32_t)sprite->height)
            || x >= 480 || y >= 320) continue;
        sprite->drawx = (int16_t)x;
        sprite->drawy = (int16_t)y;
        sprite->flags = (uint8_t)((sprite->flags & (uint8_t)~(BLIT_FLAG_FLIP_X | BLIT_FLAG_FLIP_Y))
            | (ga_animations[i].flip_flags & (BLIT_FLAG_FLIP_X | BLIT_FLAG_FLIP_Y)));
        gfx_drawbob(sprite);
    }
}

void game_adventure_draw(int32_t camera_x, int32_t camera_y,
                          int32_t player_x, int32_t player_y)
{
    if (!ga_state) return;
    if (ga_state == 2 || ga_state == 4 || ga_state == 5 || ga_state == 6) {
        const uint16_t visible = ga_visible_count();
        if (ga_inventory_selection >= visible)
            ga_inventory_selection = visible ? (uint8_t)(visible - 1u) : 0u;
        ga_inventory_clamp_offset();
        const uint8_t shown=(uint8_t)(visible>GA_INVENTORY_ROWS ? GA_INVENTORY_ROWS : visible);
        /* ALWAYS eight clear pixels beyond the inner edge of the skin frame.
           Compress inter-row spacing for 32px skin tiles to keep 10 items
           and the close footer within the 480x320 display. */
        const int inset=(int)ga_frame_border()+8;
        const int row_step=inset>24 ? 20 : 22;
        const int box_w=464;
        /* Eight fewer pixels below the close/confirm footer. The title and
           item rows keep their positions relative to the frame's top. */
        const int box_h=2*inset+24+(int)shown*row_step;
        const int box_x=8, box_y=(320-box_h)/2;
        const int first_y=box_y+inset+20;
        const int selector_x=box_x+inset;
        const int icon_x=selector_x+16;
        const int label_x=selector_x+40;
        /* Stable word origins. Brackets extend outward, never shift labels. */
        const int destroy_x=box_x+box_w-inset-8-(int)(7u*8u);
        const int drop_x=destroy_x-72;
        const int use_x=drop_x-56;
        ga_frame((int16_t)box_x,(int16_t)box_y,(uint16_t)box_w,(uint16_t)box_h);
        ga_text(selector_x,box_y+inset,ga_state==5u ? "Give an item:" :
            ga_state==6u ? (ga_interaction_failed==2u ? "Inventory full! Drop something." :
                ga_interaction_failed ? "That item does not work!" : "Use item on object:") : "Inventory:");
        if (ga_inventory_selection < ga_inventory_offset)
            ga_inventory_offset=ga_inventory_selection;
        if ((uint16_t)ga_inventory_selection >= (uint16_t)ga_inventory_offset+GA_INVENTORY_ROWS)
            ga_inventory_offset=(uint8_t)(ga_inventory_selection-GA_INVENTORY_ROWS+1u);
        ga_inventory_clamp_offset();
        if(ga_inventory_offset) ga_text(box_x+box_w-inset-16,box_y+inset,"^");
        if(visible>(uint16_t)ga_inventory_offset+GA_INVENTORY_ROWS)
            ga_text(selector_x,box_y+box_h-inset-8,"v");
        for (uint8_t i=0; i<shown; ++i) {
            const uint16_t display=(uint16_t)(ga_inventory_offset+i);
            const uint16_t id=ga_visible_item_id(display);
            if (id>=ga_item_count) break;
            char line[36];
            const char *name=ga_items[id].name?ga_items[id].name:"Item";
            const int name_area_end=(ga_state==5u || ga_state==6u || ga_can_use(id)||ga_droppable(id)||ga_discardable(id))
                ? use_x-8 : box_x+box_w-inset;
            const int name_room=(name_area_end-label_x)/8-3; /* reserve x + quantity */
            const uint8_t limit=(uint8_t)(name_room<1?1:name_room>18?18:name_room);
            uint8_t n=0;
            while (name[n] && n<limit) { line[n]=name[n]; ++n; }
            line[n++]=' '; line[n++]='x';
            uint16_t qty=ga_counts[id]; char tmp[6]; uint8_t digits=0;
            do {tmp[digits++]=(char)('0'+qty%10); qty/=10;} while(qty && digits<6);
            while(digits) line[n++]=tmp[--digits];
            line[n]=0;
            const int y=first_y+(int)i*row_step;
            if (display==ga_inventory_selection) ga_text(selector_x,y,">");
            ga_draw_item_icon(id,icon_x,y);
            ga_text(label_x,y,line);
            const uint8_t current=(uint8_t)((ga_state==2u || ga_state==5u || ga_state==6u) && display==ga_inventory_selection);
            if (ga_state==6u) {
                ga_fixed_action(destroy_x,y,"USE",current);
            } else if (ga_state==5u) {
                ga_fixed_action(destroy_x,y,"GIVE",current);
            } else {
                const uint8_t use=ga_can_use(id);
                if (use) ga_fixed_action(use_x,y,"USE",current && ga_inventory_action==0u);
                const uint8_t drop=ga_droppable(id);
                if (drop) ga_fixed_action(drop_x,y,"DROP",current && ga_inventory_action==(use?1u:0u));
                if (ga_discardable(id)) ga_fixed_action(destroy_x,y,"DESTROY",current && ga_inventory_action==(uint8_t)(use+drop));
            }
        }
        /* Footer is aligned eight pixels in from the INNER skin edge. */
        const char *footer=(ga_state==5u || ga_state==6u) ? "FIRE1: USE  FIRE2: BACK" : "FIRE2: CLOSE";
        ga_text(box_x+box_w-inset-(int)strlen(footer)*8,box_y+box_h-inset-8,footer);
        if (ga_state == 4) {
            /* The confirmation box has the same eight pixels of CLEAR inner
               padding as the inventory, even with a 32px decorative border. */
            const int cx=72, cy=84, cw=336, ch=144;
            const int ci=(int)ga_frame_border()+8;
            ga_frame(cx,cy,cw,ch);
            ga_text(cx+ci,cy+ci,"Destroy ONE item?");
            ga_fixed_action(cx+ci+8,cy+ci+40,"NO",!ga_confirm_yes);
            ga_fixed_action(cx+ci+120,cy+ci+40,"YES",ga_confirm_yes);
            ga_text(cx+ci,cy+ch-ci-16,"FIRE: SELECT   FIRE2: BACK");
        }
        return;
    }
    if (ga_state == 3) {
        /* The player's spoken reply uses the SAME font scale as dialogue.
         * Thought bubbles keep their independent thought font settings;
         * the inventory still uses the legacy, unscaled text renderer. */
        const int screen_x = player_x - camera_x, screen_y = player_y - camera_y;
        const uint16_t letters=ga_reply ? (uint16_t)strlen(ga_reply) : 0;
        const int glyph_w=8*(int)ga_dialog_scale_x;
        const int line_h=8*(int)ga_dialog_scale_y+(ga_outline_enabled?4:0);
        const int inset=ga_dialog_inset();
        /* Wider scales need a wider bubble to avoid an unnecessary
         * one- or two-character column. Keep legacy dimensions at 1x2. */
        const int bubble_w=ga_dialog_scale_x>2u ? 464 : letters>23u ? 280 : 205;
        int columns=(bubble_w-2*inset)/glyph_w;
        if(columns<1)columns=1;
        if(columns>GA_COLS)columns=GA_COLS;
        /* Cap height to the LCD, including the decorated frame. A large
         * font may show fewer rows rather than drawing off-screen. */
        int max_lines=(320-2*inset)/line_h;
        if(max_lines>8)max_lines=8;
        if(ga_dialog_scale_x==1u && ga_dialog_scale_y==2u && max_lines>5)
            max_lines=5; /* Original 8x16 reply layout. */
        if(max_lines<1)max_lines=1;
        const uint8_t rows=ga_answer_rows(ga_reply,(uint8_t)columns,(uint8_t)max_lines);
        const int bubble_h=2*inset+(rows ? rows : 1)*line_h;
        const int bubble_x=screen_x-10<4 ? 4 : screen_x-10>480-bubble_w-4
            ? 480-bubble_w-4 : screen_x-10;
        const int tentative_y=screen_y-bubble_h-8;
        const int bubble_y=tentative_y >= 4 ? tentative_y
            : (screen_y+28+bubble_h < 316 ? screen_y+28 : 4);
        ga_frame((int16_t)bubble_x,(int16_t)bubble_y,(uint16_t)bubble_w,(uint16_t)bubble_h);
        ga_wrapped_scaled(ga_reply,ga_reply_typed,bubble_x+inset,bubble_y+inset,
                          (uint8_t)columns,(uint8_t)max_lines,
                          ga_dialog_scale_x,ga_dialog_scale_y);
        return;
    }
    if (ga_node >= ga_node_count) return;
    const game_adventure_node_t *node = &ga_nodes[ga_node];
    /* Height is the MINIMUM from the designer. On each conversation node
       automatically grow to fit the speaker, all dialogue lines and TWO
       choices. If growth reaches the LCD bottom, move the frame up rather
       than cutting off the choices. No heap allocations or text clipping. */
    const int bx=ga_dialog_x, bw=ga_dialog_w;
    const int row=8*(int)ga_dialog_scale_y+(ga_outline_enabled?4:0);
    const int pad=ga_dialog_inset();
    const int inner_width=bw-2*pad;
    const uint8_t body_columns=(uint8_t)((inner_width/(8*(int)ga_dialog_scale_x))>50?50:inner_width/(8*(int)ga_dialog_scale_x));
    /* Right gutter is reserved for MORE arrows only; item ownership stays hidden. */
    const int answer_width=inner_width-34*(int)ga_dialog_scale_x;
    const uint8_t answer_columns=(uint8_t)(answer_width>0
        ? ((answer_width/(8*(int)ga_dialog_scale_x))>GA_COLS
            ? GA_COLS:answer_width/(8*(int)ga_dialog_scale_x)):1);
    /* Narrow boxes at large X scale still reserve one glyph for text. */
    const uint8_t safe_body_columns=body_columns?body_columns:1u;
    const uint8_t safe_answer_columns=answer_columns?answer_columns:1u;
    const int needed=ga_dialogue_required_height(node,safe_body_columns,safe_answer_columns,row);
    /* The configured height was previously carrying an extra 8px of
       bottom slack.  Keep enough room for the actual text/choices. */
    const int preferred_h=(int)ga_dialog_h-16;
    const int bh=needed>preferred_h? (needed>320?320:needed) : preferred_h;
    const int by=ga_dialog_y+bh>320?320-bh:ga_dialog_y;
    const int bottom=by+bh-ga_dialog_bottom_inset();
    const int choice_height=ga_two_choice_height(node,safe_answer_columns,row);
    const int text_y=by+pad+(choice_height ? row+8 : row);
    const uint8_t desired_body=ga_answer_rows(node->text,safe_body_columns,64);
    int body_budget=bottom-text_y-(choice_height?1+choice_height:0);
    int body_rows=body_budget>0?body_budget/row:0;
    if (body_rows>desired_body) body_rows=desired_body;
    if (body_rows<0) body_rows=0;

    /* The active thought belongs either to this highlighted choice or
     * to the previous choice's NEXT-node message. Both use the same frame. */
    if(!ga_thought_on_top)ga_draw_thought();
    ga_frame((int16_t)bx,(int16_t)by,(uint16_t)bw,(uint16_t)bh);
    ga_dialog_text(bx+pad,by+pad,node->speaker ? node->speaker : "",ga_dialog_scale_x,ga_dialog_scale_y);
    ga_wrapped_scaled(node->text,ga_typed,bx+pad,text_y,safe_body_columns,(uint8_t)body_rows,ga_dialog_scale_x,ga_dialog_scale_y);
    if (!choice_height) {
        if(ga_thought_on_top)ga_draw_thought();
        return;
    }
    const int answers_y=text_y+body_rows*row+1;

    uint8_t indexes[3], count=0;
    for (uint8_t i=0;i<3;++i)
        if (ga_choice_visible(ga_node,i)) indexes[count++]=i;
    if (!count) { if(ga_thought_on_top)ga_draw_thought(); return; }
    uint8_t selected=0;
    for (uint8_t i=0;i<count;++i) if (indexes[i]==ga_choice) selected=i;
    const uint8_t first=(count>2 && selected>1) ? (uint8_t)(selected-1) : 0u;
    const uint8_t shown=(uint8_t)((count-first)>2?2:(count-first));
    int cy=answers_y;
    for (uint8_t i=0;i<shown;++i) {
        const uint8_t choice_index=indexes[first+i];
        const game_adventure_choice_t *c=&node->choices[choice_index];
        const int rows=ga_answer_rows(c->label,safe_answer_columns,32);
        const int room=(bottom-cy)/row;
        if (room<1) break;
        const uint8_t draw_rows=(uint8_t)(rows<room?rows:room);
        ga_dialog_text(bx+pad,cy,choice_index==ga_choice?">":" ",ga_dialog_scale_x,ga_dialog_scale_y);
        ga_wrapped_scaled(c->label,(uint16_t)strlen(c->label),bx+pad+14*(int)ga_dialog_scale_x,cy,
                          safe_answer_columns,draw_rows,ga_dialog_scale_x,ga_dialog_scale_y);
        /* The arrow gutter stays outside the wrapped answer's text area. */
        if (i==0 && first>0) ga_dialog_text(bx+bw-pad-8*(int)ga_dialog_scale_x,cy,"^",ga_dialog_scale_x,ga_dialog_scale_y);
        if (i+1==shown && first+shown<count)
            ga_dialog_text(bx+bw-pad-8*(int)ga_dialog_scale_x,cy+(draw_rows-1)*row,"v",ga_dialog_scale_x,ga_dialog_scale_y);
        cy+=(int)draw_rows*row+4;
    }

    if(ga_thought_on_top)ga_draw_thought();
}
