    @IDE{ARRAY_NAME}[@IDE{INDEX}].animation = &@IDE{ANIM_VAR};
@IDE_END
@IDE_SECTION_END

@IDE_SECTION{AMBIENT_INIT}
    if (platforms[@IDE{INDEX}].active) {
        cg_sound_@IDE{SOUND_SYMBOL}(platforms[@IDE{INDEX}].x, @IDE{AUDIO_RADIUS});
        sound_setvolume(@IDE{SOUND_CHANNEL}, 0);
        cg_loop_playing[@IDE{INDEX}] = 1;
        cg_loop_gain[@IDE{INDEX}] = 0;
        cg_loop_target[@IDE{INDEX}] = 255;
    }
@IDE_SECTION_END

@IDE_SECTION{RESPAWN_SOUND}
    if (pickups[@IDE{INDEX}].active && pickups[@IDE{INDEX}].respawn_frames && pickups[@IDE{INDEX}].respawn_left == 0 && frames && cg_pickup_was_inactive[@IDE{INDEX}]) {
        cg_sound_@IDE{SOUND_SYMBOL}(pickups[@IDE{INDEX}].x, @IDE{AUDIO_RADIUS});
    }
@IDE_SECTION_END

@IDE_SECTION{AMBIENT_UPDATE}
    if (platforms[@IDE{INDEX}].active && !cg_loop_playing[@IDE{INDEX}]) {
        cg_sound_@IDE{SOUND_SYMBOL}(platforms[@IDE{INDEX}].x, @IDE{AUDIO_RADIUS});
        sound_setvolume(@IDE{SOUND_CHANNEL}, 0);
        cg_loop_playing[@IDE{INDEX}] = 1;
        cg_loop_gain[@IDE{INDEX}] = 0;
    }
    cg_loop_target[@IDE{INDEX}] = platforms[@IDE{INDEX}].active ? 255 : 0;
@IDE_SECTION_END

@IDE_SECTION{LIFT_UPDATE}
    {
        int32_t dx = platforms[@IDE{INDEX}].x - platforms[@IDE{INDEX}].previous_x;
        int32_t dy = platforms[@IDE{INDEX}].y - platforms[@IDE{INDEX}].previous_y;
        uint8_t moving = dx != 0 || dy != 0;
        int8_t dir = (dx ? (dx > 0 ? 1 : -1) : (dy ? (dy > 0 ? 1 : -1) : 0));
@IDE_IF{HAS_SFX_START}
        if (moving && !cg_was_moving[@IDE{INDEX}]) cg_sound_@IDE{SFX_START}(platforms[@IDE{INDEX}].x, @IDE{AUDIO_RADIUS});
@IDE_END
@IDE_IF{HAS_SFX_REVERSE}
        if (moving && cg_previous_direction[@IDE{INDEX}] && dir != cg_previous_direction[@IDE{INDEX}]) cg_sound_@IDE{SFX_REVERSE}(platforms[@IDE{INDEX}].x, @IDE{AUDIO_RADIUS});
@IDE_END
@IDE_IF{HAS_SFX_STOP}
        if (!moving && cg_was_moving[@IDE{INDEX}]) cg_sound_@IDE{SFX_STOP}(platforms[@IDE{INDEX}].x, @IDE{AUDIO_RADIUS});
@IDE_END
@IDE_IF{HAS_SFX_MOVE}
        if (moving && !cg_was_moving[@IDE{INDEX}]) {
            cg_sound_@IDE{SFX_MOVE}(platforms[@IDE{INDEX}].x, @IDE{AUDIO_RADIUS});
            sound_setvolume(@IDE{MOVE_CHANNEL}, 0);
            cg_loop_playing[@IDE{INDEX}] = 1;
            cg_loop_gain[@IDE{INDEX}] = 0;
        }
        cg_loop_target[@IDE{INDEX}] = moving ? 255 : 0;
@IDE_END
        cg_was_moving[@IDE{INDEX}] = moving;
        if (moving) cg_previous_direction[@IDE{INDEX}] = dir;
    }
@IDE_SECTION_END

@IDE_SECTION{REWARD_SPAWN}
    if (platforms[@IDE{INDEX}].break_triggered) {
        pickups[@IDE{REWARD_INDEX}].active = 1;
        pickups[@IDE{REWARD_INDEX}].can_collect = 0;
        pickups[@IDE{REWARD_INDEX}].respawn_left = 0;
        game_collectable_set_position(&pickups[@IDE{REWARD_INDEX}], platforms[@IDE{INDEX}].x + (platforms[@IDE{INDEX}].width - pickups[@IDE{REWARD_INDEX}].width) / 2, platforms[@IDE{INDEX}].y);
        cg_reward_x100[@IDE{REWARD_INDEX}] = pickups[@IDE{REWARD_INDEX}].x * 100;
        cg_reward_y100[@IDE{REWARD_INDEX}] = pickups[@IDE{REWARD_INDEX}].y * 100;
        cg_reward_vx100[@IDE{REWARD_INDEX}] = @IDE{REWARD_VX};
        cg_reward_vy100[@IDE{REWARD_INDEX}] = @IDE{REWARD_VY};
        cg_reward_falling[@IDE{REWARD_INDEX}] = 1;
    }
@IDE_SECTION_END

@IDE_SECTION{TARGET_ACTION}
@IDE_IF{TARGET_ENABLE}
        @IDE{TARGET_EXPRESSION}.active = 1;
@IDE_END
@IDE_IF{TARGET_DISABLE}
        @IDE{TARGET_EXPRESSION}.active = 0;
@IDE_END
@IDE_IF{TARGET_TOGGLE}
        @IDE{TARGET_EXPRESSION}.active = (uint8_t)!@IDE{TARGET_EXPRESSION}.active;
@IDE_END
@IDE_SECTION_END

@IDE_SECTION{ENEMY_DEFEAT_ACTION}
    if (platforms[@IDE{INDEX}].break_triggered) {
@IDE{ACTION_BODY}    }
@IDE_SECTION_END

@IDE_SECTION{WORLD_EVENT_SOUND}
    if (platforms[@IDE{INDEX}].@IDE{EVENT_FIELD}) cg_sound_@IDE{SOUND_SYMBOL}(platforms[@IDE{INDEX}].x, @IDE{AUDIO_RADIUS});
@IDE_SECTION_END

@IDE_SECTION{PICKUP_TARGET_ACTION}
    if (was_active[@IDE{INDEX}] && !pickups[@IDE{INDEX}].active) {
@IDE{ACTION_BODY}    }
@IDE_SECTION_END

@IDE_SECTION{PICKUP_EVENT_SOUND}
    if (was_active[@IDE{INDEX}] && !pickups[@IDE{INDEX}].active) cg_sound_@IDE{SOUND_SYMBOL}(pickups[@IDE{INDEX}].x, @IDE{AUDIO_RADIUS});
@IDE_SECTION_END

@IDE_SECTION{TRIGGER_ACTION}
    if (platforms[@IDE{INDEX}].trigger_fired) {
@IDE{ACTION_BODY}
@IDE_IF{MUSIC_STOP}
        music_stop();
@IDE_END
@IDE_IF{MUSIC_PLAY}
        playmusic@IDE{MUSIC_SYMBOL}();
@IDE_END
    }
@IDE_SECTION_END

@IDE_SECTION{LOOP_FADE}
    if (cg_loop_playing[@IDE{INDEX}]) {
        if (cg_loop_gain[@IDE{INDEX}] < cg_loop_target[@IDE{INDEX}]) {
            uint16_t next = cg_loop_gain[@IDE{INDEX}] + @IDE{FADE_STEP};
            cg_loop_gain[@IDE{INDEX}] = next > 255 ? 255 : next;
        } else if (cg_loop_gain[@IDE{INDEX}] > cg_loop_target[@IDE{INDEX}]) {
            cg_loop_gain[@IDE{INDEX}] = cg_loop_gain[@IDE{INDEX}] > @IDE{FADE_STEP} ? cg_loop_gain[@IDE{INDEX}] - @IDE{FADE_STEP} : 0;
        }
        sound_setvolume(@IDE{SOUND_CHANNEL}, (uint16_t)(cg_audio_volume(@IDE{SOUND_VOLUME}, platforms[@IDE{INDEX}].x, @IDE{AUDIO_RADIUS}) * cg_loop_gain[@IDE{INDEX}] / 255));
        sound_setpanning(@IDE{SOUND_CHANNEL}, cg_audio_pan(@IDE{SOUND_PAN}, platforms[@IDE{INDEX}].x, @IDE{AUDIO_RADIUS}));
        if (cg_loop_gain[@IDE{INDEX}] == 0 && cg_loop_target[@IDE{INDEX}] == 0) {
            sound_stop(@IDE{SOUND_CHANNEL});
            cg_loop_playing[@IDE{INDEX}] = 0;
        }
    }
@IDE_SECTION_END
