    platforms[@IDE{INDEX}].active = @IDE{INIT_ACTIVE};
    platforms[@IDE{INDEX}].draw_behind_tiles = @IDE{DRAW_BEHIND};
@IDE_IF{IS_TRIGGER}
    platforms[@IDE{INDEX}].trigger_press = @IDE{TRIGGER_PRESS};
    platforms[@IDE{INDEX}].trigger_one_shot = @IDE{TRIGGER_ONESHOT};
@IDE_END
