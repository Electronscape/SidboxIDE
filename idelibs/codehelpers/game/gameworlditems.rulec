@IDE_IF{HAS_PARTICLE_EMITTERS}
/* Stage 5.143: decorative scenery particle pool. All values are WORLD-space
   hundredths of a pixel. No per-frame heap allocation or player collision. */
#define CG_PARTICLES_PER_EMITTER 32u

typedef struct {
    uint16_t object_index;
    uint16_t width, height;
    uint16_t lifetime;
    int16_t wind100, fall100;
    uint8_t max_count, interval, prepopulate, gravity100, flutter100;
    uint8_t player_layer_mix; /* 1 = randomly split particles around the player. */
    uint8_t fade_enabled, fade_in, fade_out, fade_speed;
    uint8_t swirl_mode, swirl_radius, swirl_speed; /* Firefly mode, 0 = existing drift. */
} cg_particle_source_t;

typedef struct {
    int32_t x100, y100;
    int32_t centre_x100, centre_y100;
    uint8_t swirl_phase, swirl_radius;
    int16_t vy100;
    uint16_t age;
    uint8_t active;
    uint8_t draw_after_player;
    uint8_t fade; /* Patterned transparency: 0 = solid, 100 = invisible. */
} cg_particle_t;

static const cg_particle_source_t cg_particle_sources[@IDE{PARTICLE_EMITTER_COUNT}] = {
@IDE{PARTICLE_EMITTER_ROWS}};
static cg_particle_t cg_particles[@IDE{PARTICLE_EMITTER_COUNT}][CG_PARTICLES_PER_EMITTER];
static uint8_t cg_particle_ticks[@IDE{PARTICLE_EMITTER_COUNT}];
static uint32_t cg_particle_rng[@IDE{PARTICLE_EMITTER_COUNT}];

static uint32_t cg_particle_random(uint16_t emitter)
{
    uint32_t v = cg_particle_rng[emitter];
    v ^= v << 13;
    v ^= v >> 17;
    v ^= v << 5;
    cg_particle_rng[emitter] = v;
    return v;
}

static void cg_particle_reset(void)
{
    memset(cg_particles, 0, sizeof(cg_particles));
    memset(cg_particle_ticks, 0, sizeof(cg_particle_ticks));
    for (uint16_t i = 0; i < @IDE{PARTICLE_EMITTER_COUNT}; ++i)
        cg_particle_rng[i] = 0xA8E5B173u ^ (uint32_t)(i + 1u) * 0x9E3779B9u ^
            (uint32_t)cg_gwi_platforms[cg_particle_sources[i].object_index].x;
}

/* 64-entry sine table: smooth firefly orbits without per-frame sin(), floats or allocation. */
static const int8_t cg_particle_sine[64] = {
       0,   12,   25,   37,   49,   60,   71,   81,
      90,   98,  106,  112,  117,  122,  125,  126,
     127,  126,  125,  122,  117,  112,  106,   98,
      90,   81,   71,   60,   49,   37,   25,   12,
       0,  -12,  -25,  -37,  -49,  -60,  -71,  -81,
     -90,  -98, -106, -112, -117, -122, -125, -126,
    -127, -126, -125, -122, -117, -112, -106,  -98,
     -90,  -81,  -71,  -60,  -49,  -37,  -25,  -12,
};

static void cg_particle_step(uint16_t e)
{
    const cg_particle_source_t *s = &cg_particle_sources[e];
    const game_world_object_t *o = &cg_gwi_platforms[s->object_index];
    if (!o->active) return; /* Also responds to Trigger enable/toggle. */
    if (++cg_particle_ticks[e] >= s->interval) {
        cg_particle_ticks[e] = 0u;
        for (uint8_t i = 0; i < s->max_count; ++i) {
            cg_particle_t *p = &cg_particles[e][i];
            if (p->active) continue;
            const uint32_t rx = cg_particle_random(e);
            const uint32_t ry = cg_particle_random(e);
            p->x100 = (o->x + (int32_t)(rx % s->width)) * 100;
            p->y100 = (o->y + (int32_t)(ry % s->height)) * 100;
            p->vy100 = s->fall100;
            p->centre_x100 = p->x100;
            p->centre_y100 = p->y100;
            /* Each firefly follows its own offset ellipse. Do not consume
               extra random values: existing leaf sequences stay unchanged. */
            p->swirl_phase = (uint8_t)((rx >> 8) ^ ry);
            p->swirl_radius = (uint8_t)(s->swirl_radius / 2u +
                (ry % (s->swirl_radius / 2u + 1u)));
            p->age = 0;
            p->draw_after_player = (uint8_t)((!o->draw_behind_tiles && s->player_layer_mix && ((rx ^ ry) & 1u)) ? 1u : 0u);
            p->fade = (s->fade_enabled && s->fade_in) ? 100u : 0u;
            p->active = 1;
            break;
        }
    }
    for (uint8_t i = 0; i < s->max_count; ++i) {
        cg_particle_t *particle = &cg_particles[e][i];
        if (!particle->active) continue;
        if (++particle->age >= s->lifetime) {
            particle->active = 0;
            continue;
        }
        if (s->fade_enabled) {
            /* Each percentage is a portion of the lifetime. Combine
               overlapping ramps by taking the MORE transparent ramp.
               No floating-point math or heap allocation. */
            uint32_t target = 0u;
            const uint32_t in_frames = (uint32_t)s->lifetime * s->fade_in / 100u;
            const uint32_t out_frames = (uint32_t)s->lifetime * s->fade_out / 100u;
            if (in_frames && particle->age < in_frames)
                target = 100u - (uint32_t)particle->age * 100u / in_frames;
            if (out_frames && particle->age > (uint32_t)s->lifetime - out_frames) {
                const uint32_t out = ((uint32_t)particle->age -
                    ((uint32_t)s->lifetime - out_frames)) * 100u / out_frames;
                if (out > target) target = out;
            }
            const uint32_t old_fade = particle->fade;
            if (target > old_fade)
                particle->fade = (uint8_t)(old_fade +
                    ((target - old_fade) > s->fade_speed ? s->fade_speed : (target - old_fade)));
            else if (target < old_fade)
                particle->fade = (uint8_t)(old_fade -
                    ((old_fade - target) > s->fade_speed ? s->fade_speed : (old_fade - target)));
        }
        /* Lightweight triangular gust. Unlike floating-point sine,
           this does not cost an FPU/libm call for every leaf. */
        if (s->swirl_mode) {
            /* Base centre drifts gently. The sprite orbits that moving centre.
               256 phase units/circle: speed 2 takes 128 ticks (~2.56 sec).
               Each birth receives a random phase and half-to-full radius. */
            particle->centre_x100 += s->wind100;
            int32_t speed = (int32_t)particle->vy100 + s->gravity100;
            if (speed > 1200) speed = 1200;
            particle->vy100 = (int16_t)speed;
            particle->centre_y100 += speed;
            particle->swirl_phase = (uint8_t)(particle->swirl_phase + s->swirl_speed);
            const uint8_t index = (uint8_t)(particle->swirl_phase >> 2);
            const int32_t radius100 = (int32_t)particle->swirl_radius * 100;
            particle->x100 = particle->centre_x100 + radius100 * cg_particle_sine[(index + 16u) & 63u] / 127;
            particle->y100 = particle->centre_y100 + radius100 * cg_particle_sine[index] / 127;
        } else {
            /* Existing leaves/clouds/dust physics remains byte-for-byte unchanged. */
            const int32_t phase = (particle->age + i * 9u) & 31;
            const int32_t triangle = phase < 16 ? phase - 8 : 24 - phase;
            const int32_t gust = triangle * (int32_t)s->flutter100 / 8;
            particle->x100 += (int32_t)s->wind100 + gust;
            int32_t speed = (int32_t)particle->vy100 + s->gravity100;
            if (speed > 1200) speed = 1200;
            particle->vy100 = (int16_t)speed;
            particle->y100 += speed;
        }
        /* Lifetime, not emitter bounds, controls recycling. A leaf
           can leave the spawn rectangle and continue travelling until
           its configured age expires. Drawing separately clips to the
           LCD viewport without destroying off-screen particles. */
    }
}

static void cg_particle_update(uint16_t frames)
{
    for (uint16_t tick = 0; tick < frames; ++tick)
        for (uint16_t e = 0; e < @IDE{PARTICLE_EMITTER_COUNT}; ++e)
            cg_particle_step(e);
}

/* Prewarm each initially active emitter separately at level entry. The number
   of simulated frames is the minimum of its lifetime and the time required to
   fill its own pool, preserving its rate, age, wind, flutter and fade. This
   performs no allocation and does not fast-forward player/world physics. */
static void cg_particle_prewarm(void)
{
    for (uint16_t e = 0; e < @IDE{PARTICLE_EMITTER_COUNT}; ++e) {
        const cg_particle_source_t *s = &cg_particle_sources[e];
        const game_world_object_t *o = &cg_gwi_platforms[s->object_index];
        if (!s->prepopulate || !o->active || !o->sprite) continue;
        uint32_t frames = (uint32_t)s->max_count * (uint32_t)s->interval;
        if (frames >= s->lifetime) frames = s->lifetime - 1u;
        for (uint32_t t = 0; t < frames; ++t) cg_particle_step(e);
    }
}

static void cg_particle_draw(int32_t camera_x, int32_t camera_y, uint8_t behind, uint8_t overlay_pass)
{
    for (uint16_t e = 0; e < @IDE{PARTICLE_EMITTER_COUNT}; ++e) {
        const cg_particle_source_t *s = &cg_particle_sources[e];
        const game_world_object_t *o = &cg_gwi_platforms[s->object_index];
        if (!o->active || !o->sprite || !!o->draw_behind_tiles != !!behind) continue;
        for (uint8_t i = 0; i < s->max_count; ++i) {
            const cg_particle_t *particle = &cg_particles[e][i];
            if (!particle->active || !!particle->draw_after_player != !!overlay_pass) continue;
            const int32_t dx = particle->x100 / 100 - camera_x;
            const int32_t dy = particle->y100 / 100 - camera_y;
            if (dx <= -(int32_t)o->sprite->width || dy <= -(int32_t)o->sprite->height ||
                dx >= 480 || dy >= 320) continue;
            gfxbob_t sprite = *o->sprite;
            sprite.drawx = (int16_t)dx;
            sprite.drawy = (int16_t)dy;
            if (s->fade_enabled) {
                if (particle->fade >= 100u) continue;
                sprite.flagval[BLIT_FLAG_TYPE_FADE_VALUE] = particle->fade;
                sprite.flags = (uint8_t)((sprite.flags & (uint8_t)~BLIT_FLAG_ALPHABLEND) |
                    (particle->fade ? BLIT_FLAG_ALPHABLEND : 0u));
            }
            gfx_drawbob(&sprite);
        }
    }
}
@IDE_END
@IDE_IF{HAS_STAMPS}
/* Stage 5.42: compact, read-only 8x8 cell lookup into existing PPB pixels. */
typedef struct {
    const uint32_t *cells; /* 0 = ordinary sprite; 0xFFFFFFFF = empty cell */
    uint8_t columns, rows;
} cg_stamp_t;
@IDE{STAMP_DECLARATIONS}
@IDE_END
@IDE_IF{HAS_LOOT}
/* Stage 5.166.105: repeatable enemy loot. This pool is independent from
 * the unique quest reward slot. Only original placed Collectable objects own
 * saved/persistent quest state; spawned loot uses cloned BOB descriptors and
 * the same inventory callback without touching the source Collectable. */
#define CG_LOOT_CAPACITY @IDE{LOOT_SLOT_COUNT}u
typedef struct {
    int32_t x100,y100,vx100,vy100;
    uint16_t template_index;
    uint8_t active, falling, can_collect;
} cg_loot_state_t;
typedef struct {
    uint16_t enemy_index;
    uint8_t min_count,max_count,candidate_count;
    uint16_t candidates[8];
} cg_loot_rule_t;
static const cg_loot_rule_t cg_loot_rules[@IDE{LOOT_RULE_COUNT}] = {
@IDE{LOOT_RULE_ROWS}};
static cg_loot_state_t cg_loot_slots[CG_LOOT_CAPACITY];
static cg_loot_state_t cg_loot_saved[CG_LOOT_CAPACITY];
static game_collectable_t cg_loot_pickups[CG_LOOT_CAPACITY];
static gfxbob_t cg_loot_bobs[CG_LOOT_CAPACITY];
static uint32_t cg_loot_rng = 0xC0FFEE17u;
static uint32_t cg_loot_saved_rng = 0xC0FFEE17u;
static uint32_t cg_loot_random(void)
{
    uint32_t x = cg_loot_rng;
    x ^= x << 13; x ^= x >> 17; x ^= x << 5;
    cg_loot_rng = x;
    return x;
}
/* Each slot gets its OWN gfxbob_t. Never reposition the template's sprite. */
static void cg_loot_rebuild(uint16_t slot)
{
    cg_loot_state_t *state = &cg_loot_slots[slot];
    game_collectable_t *item = &cg_loot_pickups[slot];
    memset(item,0,sizeof(*item));
    if (!state->active || state->template_index >= @IDE{PICKUP_COUNT}) return;
    const game_collectable_t *source = &cg_gwi_pickups[state->template_index];
    if (!source->sprite) {state->active=0;return;}
    cg_loot_bobs[slot] = *source->sprite;
    *item = *source;
    item->sprite = &cg_loot_bobs[slot];
    item->spline = 0;
    item->animation = 0; /* static frame, no shared mutable animation state */
    item->spline_start_delay = 0;
    item->persistent = 0; /* ordinary loot; never overwrite unique pickup bits */
    item->respawn_frames = 0;
    item->respawn_left = 0;
    item->active = 1;
    item->can_collect = state->can_collect;
    item->x = state->x100/100;
    item->y = state->y100/100;
    /* Position on the clone, not on the template sprite. */
    cg_loot_bobs[slot].drawx = (int16_t)item->x;
    cg_loot_bobs[slot].drawy = (int16_t)item->y;
}
static void cg_loot_spawn(void)
{
    for (uint16_t r=0;r<@IDE{LOOT_RULE_COUNT};++r) {
        const cg_loot_rule_t *rule=&cg_loot_rules[r];
        if (!cg_gwi_platforms[rule->enemy_index].break_triggered) continue;
        const uint32_t count_random=cg_loot_random();
        const uint8_t count=(uint8_t)(rule->min_count +
            count_random % (uint32_t)(rule->max_count-rule->min_count+1u));
        const game_world_object_t *enemy=&cg_gwi_platforms[rule->enemy_index];
        for(uint8_t n=0;n<count;++n) {
            uint16_t slot=CG_LOOT_CAPACITY;
            for(uint16_t i=0;i<CG_LOOT_CAPACITY;++i)
                if (!cg_loot_slots[i].active) {slot=i;break;}
            if (slot>=CG_LOOT_CAPACITY) break; /* fixed RAM budget */
            const uint32_t v=cg_loot_random();
            const uint16_t choice=rule->candidates[v % rule->candidate_count];
            const game_collectable_t *source=&cg_gwi_pickups[choice];
            cg_loot_state_t *state=&cg_loot_slots[slot];
            state->template_index=choice;
            state->x100=(enemy->x+(enemy->width-(int32_t)source->width)/2 +
                (int32_t)((v>>11)%19u)-9)*100;
            state->y100=enemy->y*100;
            state->vx100=(int32_t)((v>>19)%601u)-300;
            state->vy100=-300-(int32_t)((v>>3)%251u);
            state->active=1;
            state->can_collect=0;
            state->falling=1;
            cg_loot_rebuild(slot);
        }
    }
}
/* Per-frame, world-space gravity/solid tile collision; no heap or assets. */
static void cg_loot_update(uint16_t frames)
{
    for(uint16_t i=0;i<CG_LOOT_CAPACITY;++i) {
        cg_loot_state_t *state=&cg_loot_slots[i];
        game_collectable_t *item=&cg_loot_pickups[i];
        if (!state->active || !item->active || !state->falling) continue;
        for(uint16_t frame=0;frame<frames;++frame) {
            const int32_t proposed_x=state->x100+state->vx100;
            int32_t x=state->x100/100;
            const int32_t dest_x=proposed_x/100;
            int32_t dir=dest_x>x?1:-1;
            while(x!=dest_x) {
                if(game_tilemap_actor_blocked(&@IDE{WORLD_SYMBOL},x+dir,item->y,
                        item->width,item->height)) {state->vx100=0;break;}
                x+=dir;
            }
            state->x100=(state->vx100 ? proposed_x : x*100);
            item->x=state->x100/100;
            state->vx100=(state->vx100*97)/100;
            if (state->vx100>-5 && state->vx100<5) state->vx100=0;
            if (state->vy100<900) state->vy100+=65;
            const int32_t proposed_y=state->y100+state->vy100;
            int32_t y=state->y100/100;
            const int32_t dest_y=proposed_y/100;
            dir=dest_y>y?1:-1;
            uint8_t landed=0;
            while(y!=dest_y) {
                if(game_tilemap_actor_blocked(&@IDE{WORLD_SYMBOL},item->x,y+dir,
                        item->width,item->height)) {
                    if(dir>0) landed=1;
                    state->vy100=0;
                    break;
                }
                y+=dir;
            }
            state->y100=(state->vy100 ? proposed_y : y*100);
            item->y=state->y100/100;
            if(landed) {
                state->falling=0;
                state->can_collect=1;
                item->can_collect=1;
                break;
            }
        }
        cg_loot_bobs[i].drawx=(int16_t)item->x;
        cg_loot_bobs[i].drawy=(int16_t)item->y;
    }
}
@IDE_END
/* Stage 5.21: per-world RAM snapshot. Each generated world module keeps its
 * own copy, even while another world's graphics and collision data are loaded.
 * Store values ONLY, never gfxbob/animation/spline pointers. */
@IDE_IF{HAS_WORLDS}
typedef struct {
    int32_t x, y, previous_x, previous_y;
    uint16_t dying;
    uint8_t active, hits, roam_direction;
    uint8_t has_spline, has_animation;
    uint16_t spline_elapsed, spline_pause, spline_next;
    uint16_t spline_start_delay;
    int32_t spline_offset_x, spline_offset_y;
    uint8_t spline_active, spline_finish;
    uint16_t animation_current, animation_counter, animation_phase, sprite_index;
    uint8_t animation_playing, animation_finished;
} cg_world_object_state_t;
static cg_world_object_state_t cg_saved_objects[@IDE{WORLD_OBJECT_COUNT}];
/* Persistent initial-state reference and a tiny pending remote-action buffer.
   The latter is needed when another world changes an object before first entry. */
static const uint8_t cg_initial_active[@IDE{WORLD_OBJECT_COUNT}] = {@IDE{WORLD_OBJECT_INITIAL_ACTIVE}};
static uint8_t cg_remote_valid[@IDE{WORLD_OBJECT_COUNT}];
static uint8_t cg_remote_active[@IDE{WORLD_OBJECT_COUNT}];
@IDE_END
@IDE_IF{HAS_TRIGGERS}
/* Virtual Trigger switch. Not a sprite and not the Trigger's active flag.
 * One activation flips this latch. Each world owns its own persistent copy. */
typedef struct { uint8_t active; } cg_trigger_virtual_t;
static cg_trigger_virtual_t cg_trigger_state[@IDE{WORLD_OBJECT_COUNT}];
static cg_trigger_virtual_t cg_saved_trigger_state[@IDE{WORLD_OBJECT_COUNT}];
@IDE_END
@IDE_IF{HAS_PICKUPS}
typedef struct {
    int32_t x, y;
    uint16_t respawn_left, spline_start_delay, sprite_index;
    uint8_t active, can_collect, has_spline, has_animation;
    uint16_t spline_elapsed, spline_pause, spline_next;
    int32_t spline_offset_x, spline_offset_y;
    uint8_t spline_active, spline_finish;
    uint16_t animation_current, animation_counter, animation_phase;
    uint8_t animation_playing, animation_finished;
} cg_world_pickup_state_t;
static cg_world_pickup_state_t cg_saved_pickups[@IDE{PICKUP_COUNT}];
/* Per-world static progression: survives unloading/reloading the world. */
static uint8_t cg_pickup_permanently_collected[@IDE{PICKUP_COUNT}];
@IDE_END
@IDE_IF{HAS_REWARDS}
static uint8_t cg_saved_reward_falling[@IDE{PICKUP_COUNT}];
static int32_t cg_saved_reward_x100[@IDE{PICKUP_COUNT}];
static int32_t cg_saved_reward_y100[@IDE{PICKUP_COUNT}];
static int32_t cg_saved_reward_vx100[@IDE{PICKUP_COUNT}];
static int32_t cg_saved_reward_vy100[@IDE{PICKUP_COUNT}];
@IDE_END
static uint8_t cg_world_snapshot_valid;

void gameworlditems_save_state(void)
{
@IDE_IF{HAS_WORLDS}
    for (uint16_t i = 0; i < @IDE{WORLD_OBJECT_COUNT}; ++i) {
        const game_world_object_t *o = &cg_gwi_platforms[i];
        cg_world_object_state_t *d = &cg_saved_objects[i];
        d->active = o->active;
        d->hits = o->break_hits_done;
        d->dying = o->enemy_dying;
        d->roam_direction = (uint8_t)o->enemy_roam_direction;
        d->x = o->x; d->y = o->y;
        d->previous_x = o->previous_x; d->previous_y = o->previous_y;
        d->spline_start_delay = o->spline_start_delay;
        d->has_spline = o->spline != 0;
        if (o->spline) {
            d->spline_elapsed = o->spline->elapsed_frames;
            d->spline_pause = o->spline->pause_remaining;
            d->spline_next = o->spline->next_pause_index;
            d->spline_offset_x = o->spline->offset_x;
            d->spline_offset_y = o->spline->offset_y;
            d->spline_active = o->spline->active;
            d->spline_finish = o->spline->finish_after_pause;
        }
        d->has_animation = o->animation != 0;
        if (o->animation) {
            d->animation_current = o->animation->current_frame;
            d->animation_counter = o->animation->frame_counter;
            d->animation_phase = o->animation->pingpong_phase;
            d->animation_playing = o->animation->playing;
            d->animation_finished = o->animation->finished;
        }
        d->sprite_index = o->sprite ? o->sprite->index : 0;
    }
@IDE_END
@IDE_IF{HAS_PICKUPS}
    for (uint16_t i = 0; i < @IDE{PICKUP_COUNT}; ++i) {
        const game_collectable_t *o = &cg_gwi_pickups[i];
        cg_world_pickup_state_t *d = &cg_saved_pickups[i];
        d->active = o->active;
        d->can_collect = o->can_collect;
        d->respawn_left = o->respawn_left;
        d->x = o->x; d->y = o->y;
        d->spline_start_delay = o->spline_start_delay;
        d->has_spline = o->spline != 0;
        if (o->spline) {
            d->spline_elapsed = o->spline->elapsed_frames;
            d->spline_pause = o->spline->pause_remaining;
            d->spline_next = o->spline->next_pause_index;
            d->spline_offset_x = o->spline->offset_x;
            d->spline_offset_y = o->spline->offset_y;
            d->spline_active = o->spline->active;
            d->spline_finish = o->spline->finish_after_pause;
        }
        d->has_animation = o->animation != 0;
        if (o->animation) {
            d->animation_current = o->animation->current_frame;
            d->animation_counter = o->animation->frame_counter;
            d->animation_phase = o->animation->pingpong_phase;
            d->animation_playing = o->animation->playing;
            d->animation_finished = o->animation->finished;
        }
        d->sprite_index = o->sprite ? o->sprite->index : 0;
    }
@IDE_END
@IDE_IF{HAS_REWARDS}
    for (uint16_t i = 0; i < @IDE{PICKUP_COUNT}; ++i) {
        cg_saved_reward_falling[i] = cg_reward_falling[i];
        cg_saved_reward_x100[i] = cg_reward_x100[i];
        cg_saved_reward_y100[i] = cg_reward_y100[i];
        cg_saved_reward_vx100[i] = cg_reward_vx100[i];
        cg_saved_reward_vy100[i] = cg_reward_vy100[i];
    }
@IDE_END
@IDE_IF{HAS_LOOT}
    for(uint16_t i=0;i<CG_LOOT_CAPACITY;++i) {
        cg_loot_slots[i].active=cg_loot_pickups[i].active;
        cg_loot_slots[i].can_collect=cg_loot_pickups[i].can_collect;
    }
    memcpy(cg_loot_saved,cg_loot_slots,sizeof(cg_loot_saved));
    cg_loot_saved_rng=cg_loot_rng;
@IDE_END
@IDE_IF{HAS_TRIGGERS}
    memcpy(cg_saved_trigger_state,cg_trigger_state,sizeof(cg_trigger_state));
@IDE_END
    cg_world_snapshot_valid = 1;
}


/* Stage 5.164: deterministic TFCard snapshot. Functions work on the already
 * saved value copies, NEVER on live sprite, map, spline or audio pointers. */
void gameworlditems_disk_export(void (*emit)(const void *, uint32_t, void *), void *ctx)
{
    if (!emit) return;
#define CG_SAVE_BYTES(v) emit(&(v), (uint32_t)sizeof(v), ctx)
    CG_SAVE_BYTES(cg_world_snapshot_valid);
@IDE_IF{HAS_LOOT}
    CG_SAVE_BYTES(cg_loot_saved);
    CG_SAVE_BYTES(cg_loot_saved_rng);
@IDE_END
@IDE_IF{HAS_WORLDS}
    CG_SAVE_BYTES(cg_saved_objects);
    CG_SAVE_BYTES(cg_remote_valid);
    CG_SAVE_BYTES(cg_remote_active);
@IDE_END
@IDE_IF{HAS_TRIGGERS}
    CG_SAVE_BYTES(cg_saved_trigger_state);
@IDE_END
@IDE_IF{HAS_PICKUPS}
    CG_SAVE_BYTES(cg_saved_pickups);
    CG_SAVE_BYTES(cg_pickup_permanently_collected);
@IDE_END
@IDE_IF{HAS_REWARDS}
    CG_SAVE_BYTES(cg_saved_reward_falling);
    CG_SAVE_BYTES(cg_saved_reward_x100);
    CG_SAVE_BYTES(cg_saved_reward_y100);
    CG_SAVE_BYTES(cg_saved_reward_vx100);
    CG_SAVE_BYTES(cg_saved_reward_vy100);
@IDE_END
#undef CG_SAVE_BYTES
}
uint8_t gameworlditems_disk_import(uint8_t (*take)(void *, uint32_t, void *), void *ctx)
{
    if (!take) return 0;
#define CG_LOAD_BYTES(v) if (!take(&(v), (uint32_t)sizeof(v), ctx)) return 0
    CG_LOAD_BYTES(cg_world_snapshot_valid);
@IDE_IF{HAS_LOOT}
    CG_LOAD_BYTES(cg_loot_saved);
    CG_LOAD_BYTES(cg_loot_saved_rng);
@IDE_END
@IDE_IF{HAS_WORLDS}
    CG_LOAD_BYTES(cg_saved_objects);
    CG_LOAD_BYTES(cg_remote_valid);
    CG_LOAD_BYTES(cg_remote_active);
@IDE_END
@IDE_IF{HAS_TRIGGERS}
    CG_LOAD_BYTES(cg_saved_trigger_state);
@IDE_END
@IDE_IF{HAS_PICKUPS}
    CG_LOAD_BYTES(cg_saved_pickups);
    CG_LOAD_BYTES(cg_pickup_permanently_collected);
@IDE_END
@IDE_IF{HAS_REWARDS}
    CG_LOAD_BYTES(cg_saved_reward_falling);
    CG_LOAD_BYTES(cg_saved_reward_x100);
    CG_LOAD_BYTES(cg_saved_reward_y100);
    CG_LOAD_BYTES(cg_saved_reward_vx100);
    CG_LOAD_BYTES(cg_saved_reward_vy100);
@IDE_END
#undef CG_LOAD_BYTES
    return 1;
}

void gameworlditems_restore_state(void)
{
    if (!cg_world_snapshot_valid) return; /* First entry uses editor defaults. */
@IDE_IF{HAS_TRIGGERS}
    memcpy(cg_trigger_state,cg_saved_trigger_state,sizeof(cg_trigger_state));
@IDE_END
@IDE_IF{HAS_LOOT}
    memcpy(cg_loot_slots,cg_loot_saved,sizeof(cg_loot_slots));
    cg_loot_rng=cg_loot_saved_rng ? cg_loot_saved_rng : 0xC0FFEE17u;
    for(uint16_t i=0;i<CG_LOOT_CAPACITY;++i) cg_loot_rebuild(i);
@IDE_END
@IDE_IF{HAS_WORLDS}
    for (uint16_t i = 0; i < @IDE{WORLD_OBJECT_COUNT}; ++i) {
        game_world_object_t *o = &cg_gwi_platforms[i];
        const cg_world_object_state_t *d = &cg_saved_objects[i];
        o->active = d->active;
        o->break_hits_done = d->hits;
        o->enemy_dying = d->dying;
        /* Hit feedback is transient; loading a world resumes its real animation. */
        o->enemy_hit_ticks_remaining = 0u;
        o->enemy_hit_elapsed = 0u;
        o->enemy_roam_direction = (int8_t)d->roam_direction;
        o->x = d->x; o->y = d->y;
        o->previous_x = d->previous_x; o->previous_y = d->previous_y;
        o->spline_start_delay = d->spline_start_delay;
        if (o->spline && d->has_spline) {
            o->spline->elapsed_frames = d->spline_elapsed;
            o->spline->pause_remaining = d->spline_pause;
            o->spline->next_pause_index = d->spline_next;
            o->spline->offset_x = d->spline_offset_x;
            o->spline->offset_y = d->spline_offset_y;
            o->spline->active = d->spline_active;
            o->spline->finish_after_pause = d->spline_finish;
        }
        if (o->animation && d->has_animation) {
            o->animation->current_frame = d->animation_current;
            o->animation->frame_counter = d->animation_counter;
            o->animation->pingpong_phase = d->animation_phase;
            o->animation->playing = d->animation_playing;
            o->animation->finished = d->animation_finished;
        }
        if (o->sprite) {
            o->sprite->drawx = (int16_t)d->x;
            o->sprite->drawy = (int16_t)d->y;
            o->sprite->index = d->sprite_index;
        }
        /* Contact latches are transient, not game progression. */
        o->trigger_touching = 0; o->trigger_pressed = 0;
        o->spring_touching = 0; o->break_touching = 0;
    }
@IDE_END
@IDE_IF{HAS_PICKUPS}
    for (uint16_t i = 0; i < @IDE{PICKUP_COUNT}; ++i) {
        game_collectable_t *o = &cg_gwi_pickups[i];
        const cg_world_pickup_state_t *d = &cg_saved_pickups[i];
        o->active = (uint8_t)(d->active && !cg_pickup_permanently_collected[i]);
        o->can_collect = d->can_collect;
        o->respawn_left = d->respawn_left;
        o->x = d->x; o->y = d->y;
        o->spline_start_delay = d->spline_start_delay;
        if (o->spline && d->has_spline) {
            o->spline->elapsed_frames = d->spline_elapsed;
            o->spline->pause_remaining = d->spline_pause;
            o->spline->next_pause_index = d->spline_next;
            o->spline->offset_x = d->spline_offset_x;
            o->spline->offset_y = d->spline_offset_y;
            o->spline->active = d->spline_active;
            o->spline->finish_after_pause = d->spline_finish;
        }
        if (o->animation && d->has_animation) {
            o->animation->current_frame = d->animation_current;
            o->animation->frame_counter = d->animation_counter;
            o->animation->pingpong_phase = d->animation_phase;
            o->animation->playing = d->animation_playing;
            o->animation->finished = d->animation_finished;
        }
        if (o->sprite) {
            o->sprite->drawx = (int16_t)d->x;
            o->sprite->drawy = (int16_t)d->y;
            o->sprite->index = d->sprite_index;
        }
    }
@IDE_END
@IDE_IF{HAS_REWARDS}
    for (uint16_t i = 0; i < @IDE{PICKUP_COUNT}; ++i) {
        cg_reward_falling[i] = cg_saved_reward_falling[i];
        cg_reward_x100[i] = cg_saved_reward_x100[i];
        cg_reward_y100[i] = cg_saved_reward_y100[i];
        cg_reward_vx100[i] = cg_saved_reward_vx100[i];
        cg_reward_vy100[i] = cg_saved_reward_vy100[i];
    }
@IDE_END
}

uint8_t gameworlditems_init(void)
{
    cg_action_head=cg_action_tail=cg_action_size=0u;
    cg_action_draining=0u;
    cg_event_head=cg_event_tail=cg_event_size=0u;
    cg_event_dispatching=0u;
    cg_event_next_sequence=0u;
    cg_current_defeat_owner=UINT16_MAX;

@IDE_IF{HAS_LOOT}
    memset(cg_loot_slots,0,sizeof(cg_loot_slots));
    memset(cg_loot_pickups,0,sizeof(cg_loot_pickups));
    cg_loot_rng=0xC0FFEE17u;
@IDE_END
@IDE_IF{HAS_WORLDS}
    cg_fire2_player=0;
    cg_interaction_target=UINT16_MAX;
    cg_checkpoint_event_source=UINT16_MAX;
@IDE_END
@IDE_IF{HAS_TILEMAP_WORLDS}
    cg_hazard_zone_contact = 0;
@IDE_END
@IDE_IF{HAS_REWARDS}
    for (uint16_t i = 0; i < @IDE{PICKUP_COUNT}; ++i) { cg_reward_falling[i] = 0; cg_reward_x100[i] = 0; cg_reward_y100[i] = 0; cg_reward_vx100[i] = 0; cg_reward_vy100[i] = 0; }
@IDE_END
@IDE_IF{HAS_AUDIO_WORLDS}
    for (uint16_t i = 0; i < @IDE{WORLD_OBJECT_COUNT}; ++i) { cg_was_moving[i] = 0; cg_previous_direction[i] = 0; cg_loop_playing[i] = 0; cg_loop_gain[i] = 0; cg_loop_target[i] = 0; }
@IDE_END
@IDE{INIT_BODY}
@IDE_IF{HAS_PARTICLE_EMITTERS}
    cg_particle_reset();
    cg_particle_prewarm();
@IDE_END
@IDE_IF{HAS_WORLDS}
    /* Static state artwork applies independently of optional animation.
     * Inactive artwork is painted without restoring object collision. */
    for(uint16_t i=0;i<@IDE{WORLD_OBJECT_COUNT};++i)
        if(cg_active_state_frames[i]!=UINT16_MAX && cg_gwi_platforms[i].sprite)
            cg_gwi_platforms[i].sprite->index=(uint8_t)cg_active_state_frames[i];
@IDE_END
@IDE_IF{HAS_PICKUPS}
    for (uint16_t i=0;i<@IDE{PICKUP_COUNT};++i)
        if (cg_pickup_permanently_collected[i] && cg_gwi_pickups[i].persistent)
            cg_gwi_pickups[i].active=0;
@IDE_END
    return 1;
}

@IDE_IF{HAS_WORLDS}
void gameworlditems_set_active(uint16_t index, uint8_t state);
void gameworlditems_apply_remote(void)
{
    for (uint16_t i=0;i<GAMEWORLDITEMS_PLATFORM_COUNT;++i) {
        if (!cg_remote_valid[i]) continue;
        gameworlditems_set_active(i,cg_remote_active[i]);
        cg_remote_valid[i]=0u;
    }
}
void gameworlditems_set_active(uint16_t index, uint8_t state)
{
    if (index >= GAMEWORLDITEMS_PLATFORM_COUNT) return;
    cg_gwi_platforms[index].active = state == 2 ? (uint8_t)!cg_gwi_platforms[index].active : (uint8_t)(state != 0);
    if(cg_gwi_platforms[index].active && cg_active_state_frames[index]!=UINT16_MAX && cg_gwi_platforms[index].sprite)
        cg_gwi_platforms[index].sprite->index=(uint8_t)cg_active_state_frames[index];
}

/* Called by the shared world manager ONLY while this world is unloaded.
   Pending overrides deliberately do not touch unloaded sprite/PPB memory. */
void gameworlditems_remote_action(uint16_t index, uint8_t state)
{
    if (index >= GAMEWORLDITEMS_PLATFORM_COUNT || state > 2u) return;
    const uint8_t prior = cg_remote_valid[index] ? cg_remote_active[index] :
        (cg_world_snapshot_valid ? cg_saved_objects[index].active : cg_initial_active[index]);
    const uint8_t next = state == 2u ? (uint8_t)!prior : (uint8_t)(state != 0u);
    cg_remote_active[index] = next;
    cg_remote_valid[index] = 1u;
}
/* A NEW GAME must forget *all* world-local progression, including the
 * persistent-pickup bitset. Simply invalidating cg_world_snapshot_valid left
 * collected items hidden when this world was entered again from the title.
 * Load Game imports the saved arrays AFTER this reset, so saves still work. */
void gameworlditems_remote_reset(void)
{
    cg_action_head=cg_action_tail=cg_action_size=0u;
    cg_action_draining=0u;
    cg_action_overflow=0u;
    cg_event_head=cg_event_tail=cg_event_size=0u;
    cg_event_dispatching=0u;
    cg_event_overflow=0u;
    cg_event_next_sequence=0u;
    cg_current_defeat_owner=UINT16_MAX;

    memset(cg_remote_valid,0,sizeof(cg_remote_valid));
    memset(cg_remote_active,0,sizeof(cg_remote_active));
    memset(cg_saved_objects,0,sizeof(cg_saved_objects));
@IDE_IF{HAS_TRIGGERS}
    memset(cg_trigger_state,0,sizeof(cg_trigger_state));
    memset(cg_saved_trigger_state,0,sizeof(cg_saved_trigger_state));
@IDE_END
#if GAMEWORLDITEMS_PICKUP_COUNT > 0
    memset(cg_saved_pickups,0,sizeof(cg_saved_pickups));
    memset(cg_pickup_permanently_collected,0,sizeof(cg_pickup_permanently_collected));
#endif
@IDE_IF{HAS_REWARDS}
    memset(cg_saved_reward_falling,0,sizeof(cg_saved_reward_falling));
    memset(cg_saved_reward_x100,0,sizeof(cg_saved_reward_x100));
    memset(cg_saved_reward_y100,0,sizeof(cg_saved_reward_y100));
    memset(cg_saved_reward_vx100,0,sizeof(cg_saved_reward_vx100));
    memset(cg_saved_reward_vy100,0,sizeof(cg_saved_reward_vy100));
@IDE_END
@IDE_IF{HAS_LOOT}
    memset(cg_loot_saved,0,sizeof(cg_loot_saved));
    cg_loot_saved_rng=0xC0FFEE17u;
@IDE_END
    cg_world_snapshot_valid=0u;
}
@IDE_ELSE
void gameworlditems_set_active(uint16_t index,uint8_t state) { (void)index; (void)state; }
void gameworlditems_remote_action(uint16_t index,uint8_t state) { (void)index; (void)state; }
/* Worlds with pickups but no managed platforms need the same reset. */
void gameworlditems_remote_reset(void)
{
    cg_action_head=cg_action_tail=cg_action_size=0u;
    cg_action_draining=0u;
    cg_action_overflow=0u;
    cg_event_head=cg_event_tail=cg_event_size=0u;
    cg_event_dispatching=0u;
    cg_event_overflow=0u;
    cg_event_next_sequence=0u;
    cg_current_defeat_owner=UINT16_MAX;

#if GAMEWORLDITEMS_PICKUP_COUNT > 0
    memset(cg_saved_pickups,0,sizeof(cg_saved_pickups));
    memset(cg_pickup_permanently_collected,0,sizeof(cg_pickup_permanently_collected));
#endif
@IDE_IF{HAS_REWARDS}
    memset(cg_saved_reward_falling,0,sizeof(cg_saved_reward_falling));
    memset(cg_saved_reward_x100,0,sizeof(cg_saved_reward_x100));
    memset(cg_saved_reward_y100,0,sizeof(cg_saved_reward_y100));
    memset(cg_saved_reward_vx100,0,sizeof(cg_saved_reward_vx100));
    memset(cg_saved_reward_vy100,0,sizeof(cg_saved_reward_vy100));
@IDE_END
@IDE_IF{HAS_LOOT}
    memset(cg_loot_saved,0,sizeof(cg_loot_saved));
    cg_loot_saved_rng=0xC0FFEE17u;
@IDE_END
    cg_world_snapshot_valid=0u;
}
void gameworlditems_apply_remote(void) {}
@IDE_END
@IDE_IF{HAS_TILEMAP_WORLDS}
/* Same tile/slope query as the player. */
static uint8_t cg_enemy_tile_blocked(int32_t x, int32_t y, uint16_t w, uint16_t h, void *ctx)
{ return game_tilemap_actor_blocked((const game_tilemap_t *)ctx, x, y, w, h); }

@IDE_END
void gameworlditems_update_gameplay(uint16_t frames)
{
    gameassets_fade_update(frames);
@IDE_IF{HAS_WORLDS}
    game_world_objects_update(cg_gwi_platforms, @IDE{WORLD_OBJECT_COUNT}, frames);
@IDE_END
@IDE_IF{HAS_TILEMAP_WORLDS}
    game_world_objects_roam(cg_gwi_platforms, @IDE{WORLD_OBJECT_COUNT}, frames, cg_enemy_tile_blocked, &@IDE{WORLD_SYMBOL});
@IDE_END
@IDE_IF{HAS_AUDIO_PICKUPS}
    for (uint16_t i = 0; i < @IDE{PICKUP_COUNT}; ++i) cg_pickup_was_inactive[i] = (uint8_t)!cg_gwi_pickups[i].active;
@IDE_END
@IDE_IF{HAS_PICKUPS}
    game_collectables_update(cg_gwi_pickups, @IDE{PICKUP_COUNT}, frames);
@IDE_END
@IDE_IF{HAS_REWARDS}
    /* Prize launch: optional X/Y impulse, then gravity. Sweep each axis
       pixel-by-pixel so thin tile walls, ceilings and floors are respected.
       A reward cannot be collected until it lands on solid ground. */
    for (uint16_t i = 0; i < GAMEWORLDITEMS_PICKUP_COUNT; ++i) {
        if (!cg_reward_falling[i]) continue;
        for (uint16_t tick = 0; tick < frames; ++tick) {
            int32_t x = cg_gwi_pickups[i].x;
            int32_t y = cg_gwi_pickups[i].y;
            int32_t next_x100 = cg_reward_x100[i] + cg_reward_vx100[i];
            int32_t next_y100;
            int32_t vx = cg_reward_vx100[i];
            int32_t vy = cg_reward_vy100[i] + 65; /* gravity 0.65px/frame² */
            if (vy > 900) vy = 900;
            cg_reward_vy100[i] = vy;
            next_y100 = cg_reward_y100[i] + vy;
            /* Horizontal sweep. Walls stop horizontal speed, not gravity. */
            int32_t target_x = next_x100 / 100;
            while (x != target_x) {
                int32_t step = target_x > x ? 1 : -1;
                if (game_tilemap_actor_blocked(&@IDE{WORLD_SYMBOL}, x + step, y,
                        cg_gwi_pickups[i].width, cg_gwi_pickups[i].height)) {
                    vx = 0;
                    next_x100 = x * 100;
                    break;
                }
                x += step;
            }
            /* A gentle horizontal slowdown leaves the launch visible
               without letting prizes drift forever across the level. */
            cg_reward_vx100[i] = (vx * 97) / 100;
            if (cg_reward_vx100[i] > -5 && cg_reward_vx100[i] < 5)
                cg_reward_vx100[i] = 0;
            cg_reward_x100[i] = next_x100;
            int32_t target_y = next_y100 / 100;
            uint8_t landed = 0;
            while (y != target_y) {
                int32_t step = target_y > y ? 1 : -1;
                if (game_tilemap_actor_blocked(&@IDE{WORLD_SYMBOL}, x, y + step,
                        cg_gwi_pickups[i].width, cg_gwi_pickups[i].height)) {
                    if (step > 0) landed = 1;
                    cg_reward_vy100[i] = 0;
                    next_y100 = y * 100;
                    break;
                }
                y += step;
            }
            cg_reward_y100[i] = next_y100;
            game_collectable_set_position(&cg_gwi_pickups[i], x, y);
            if (landed || (cg_reward_vy100[i] >= 0 &&
                    game_tilemap_actor_blocked(&@IDE{WORLD_SYMBOL}, x, y + 1,
                        cg_gwi_pickups[i].width, cg_gwi_pickups[i].height))) {
                cg_reward_falling[i] = 0;
                cg_reward_vx100[i] = 0;
                cg_reward_vy100[i] = 0;
                cg_gwi_pickups[i].can_collect = 1;
                break;
            }
        }
    }
@IDE_END
@IDE_IF{HAS_LOOT}
    cg_loot_update(frames);
@IDE_END
@IDE{UPDATE_BODY}
}

/* Separate visual clock: gameplay/enemy/platform/spline state stays paused.
 * The original combined update remains for existing hand-authored main.c. */
void gameworlditems_update_particles(uint16_t frames)
{
@IDE_IF{HAS_PARTICLE_EMITTERS}
    cg_particle_update(frames);
@IDE_ELSE
    (void)frames;
@IDE_END
}
void gameworlditems_update(uint16_t frames)
{
    gameworlditems_update_gameplay(frames);
    gameworlditems_update_particles(frames);
}

@IDE_IF{HAS_TILEMAP_WORLDS}
/* Use the same walls/slopes as game_tile_player_run() when
   a moving platform carries the player. Generated automatically. */
static uint8_t cg_world_player_blocked(int32_t x, int32_t y,
    uint16_t width, uint16_t height, void *context)
{
    return game_tilemap_actor_blocked((const game_tilemap_t *)context,
                                     x, y, width, height);
}

@IDE_END
@IDE_IF{HAS_WORLDS}
uint8_t gameworlditems_fire2_action(int32_t player_x, int32_t player_y,
                                    uint16_t player_w, uint16_t player_h)
{
    if (cg_fire2_player && cg_fire2_player->x100 && cg_fire2_player->y100 &&
        cg_fire2_player->width && cg_fire2_player->height) {
        player_x=*cg_fire2_player->x100/100+cg_fire2_player->offset_x;
        player_y=*cg_fire2_player->y100/100+cg_fire2_player->offset_y;
        player_w=cg_fire2_player->width;
        player_h=cg_fire2_player->height;
    }
    return game_world_objects_fire2_action(cg_gwi_platforms, @IDE{WORLD_OBJECT_COUNT},
        player_x, player_y, player_w, player_h);
}

void gameworlditems_before(game_world_player_t *player)
{
@IDE_IF{HAS_WORLDS}
    cg_fire2_player=player;
@IDE_END
@IDE_IF{HAS_TILEMAP_WORLDS}
    if (game_death_is_dead()) return;
    if (player) {
        player->position_blocked = cg_world_player_blocked;
        player->collision_context = &@IDE{WORLD_SYMBOL};
    }
@IDE_END
    game_world_objects_before(cg_gwi_platforms, @IDE{WORLD_OBJECT_COUNT}, player);
}

/* The world manager calls this once on an accepted player melee swing.
 * Enemy hit flags feed existing ON HIT / ON DEFEAT / reward logic below. */
uint8_t gameworlditems_player_attack(int32_t x, int32_t y,
                                     uint16_t w, uint16_t h, uint8_t damage)
{
    return game_world_objects_attack(cg_gwi_platforms, @IDE{WORLD_OBJECT_COUNT},
                                     x, y, w, h, damage);
}
/* Every event-driven or state-driven graph shares the same dispatcher.
 * Declare it even when there are no enemy-owned graphs. */
static void cg_run_trigger_actions(void);
@IDE_IF{HAS_ENEMY_STATE_LOGIC}
static uint8_t cg_enemy_logic_event_handled = 0u;
@IDE_END
void gameworlditems_after(game_world_player_t *player)
{
@IDE_IF{HAS_TILEMAP_WORLDS}
    if (game_death_is_dead()) return;
@IDE_END
@IDE_IF{HAS_NAMED_EVENTS}
    memset(cg_named_event_sources,0,sizeof(cg_named_event_sources));
@IDE_END
    game_world_objects_after(cg_gwi_platforms, @IDE{WORLD_OBJECT_COUNT}, player);
@IDE_IF{HAS_ENEMY_STATE_LOGIC}
    cg_enemy_logic_event_handled=0u;
@IDE_END
    game_world_objects_hazards(cg_gwi_platforms, @IDE{WORLD_OBJECT_COUNT}, player);
@IDE{REWARD_SPAWN_ACTIONS}
@IDE_IF{HAS_LOOT}
    cg_loot_spawn();
@IDE_END
@IDE_IF{HAS_TILEMAP_WORLDS}
    /* Hazard Zone: ENTERED once, INSIDE each frame, EXITED on leaving. */
    uint8_t in_hazard_zone = (uint8_t)(player && player->x100 && player->y100 &&
        player->width && player->height &&
        game_world_objects_death_zone(cg_gwi_platforms, @IDE{WORLD_OBJECT_COUNT}, *player->x100 / 100 + player->offset_x, *player->y100 / 100 + player->offset_y, player->width, player->height));
    uint8_t was_in_hazard_zone = cg_hazard_zone_contact;
    cg_hazard_zone_contact = in_hazard_zone;
    if (player && player->x100 && player->y100) {
        if (in_hazard_zone && !was_in_hazard_zone)
            game_hazard_notify(GAME_HAZARD_ZONE_ENTERED, *player->x100 / 100 + player->offset_x, *player->y100 / 100 + player->offset_y);
        else if (in_hazard_zone)
            game_hazard_notify(GAME_HAZARD_ZONE_INSIDE, *player->x100 / 100 + player->offset_x, *player->y100 / 100 + player->offset_y);
        else if (was_in_hazard_zone)
            game_hazard_notify(GAME_HAZARD_ZONE_EXITED, *player->x100 / 100 + player->offset_x, *player->y100 / 100 + player->offset_y);
        /* Callback may explicitly kill or teleport the player. */
        if (game_death_is_dead()) {
@IDE_IF{HAS_ADVENTURE}
            if (in_hazard_zone && player->width && player->height) {
                const char *note = game_world_objects_death_zone_note(
                    cg_gwi_platforms, @IDE{WORLD_OBJECT_COUNT},
                    *player->x100 / 100 + player->offset_x,
                    *player->y100 / 100 + player->offset_y,
                    player->width, player->height);
                game_adventure_defeat_note(note);
            }
@IDE_END
            return;
        }
    }
@IDE_END
@IDE{WORLD_EVENT_ACTIONS}
    cg_action_drain();
@IDE_IF{HAS_ENEMY_STATE_LOGIC}
    // An enemy may die without ANY Trigger activation. The final stomp
    // already set break_triggered and active=0 in game_world_objects_after().
    // Evaluate AFTER its ordered ON DEFEAT actions, using the same DAG code.
    uint8_t cg_defeat_logic_event=0u;
    for(uint16_t cg_i=0;cg_i<@IDE{WORLD_OBJECT_COUNT};++cg_i)
        if(cg_gwi_platforms[cg_i].type==GAME_OBJECT_ENEMY &&
           cg_gwi_platforms[cg_i].break_triggered) {cg_defeat_logic_event=1u;break;}
    if(cg_defeat_logic_event) {
        cg_run_trigger_actions();
        // A Trigger can also fire later this frame. Don't dispatch the same
        // enemy defeat graph branches twice when it does.
        cg_enemy_logic_event_handled=1u;
    }
@IDE_END
@IDE_IF{HAS_NAMED_EVENT_LOGIC}
    uint8_t cg_named_logic_fired=0u;
    for(uint16_t cg_i=0;cg_i<@IDE{WORLD_OBJECT_COUNT};++cg_i)
        if(cg_named_event_sources[cg_i]) {cg_named_logic_fired=1u;break;}
    if(cg_named_logic_fired)cg_run_trigger_actions();
@IDE_END
@IDE_IF{HAS_NAMED_EVENTS}
    /* Don't replay a named event if a Trigger fires later this frame. */
    memset(cg_named_event_sources,0,sizeof(cg_named_event_sources));
@IDE_END
@IDE_IF{HAS_TRIGGERS}
    if (player && player->x100 && player->y100 && player->width && player->height)
        gameworlditems_trigger(*player->x100 / 100 + player->offset_x, *player->y100 / 100 + player->offset_y,
            player->width, player->height, (getjoyport() & BTN_FIRE2) != 0);
@IDE_END
@IDE_IF{HAS_STAT_COMPARE}
    /* Cheap revision check; evaluate graph only when a stat changed. */
    if(cg_logic_seen_stat_revision != gameplayer_stat_revision() ||
       cg_logic_seen_health != gameworlds_state()->health)cg_run_trigger_actions();
@IDE_END
@IDE_IF{HAS_QUEST_CONDITION}
    if(cg_logic_seen_quest_revision != gameworlds_quest_revision())cg_run_trigger_actions();
@IDE_END
}

@IDE_END
/* Pickup-only worlds have no platform Trigger dispatcher, but still need
 * the same one-frame state/event logic for their Collectable nodes. */

@IDE_IF{HAS_LOGIC_DISPATCH}
/* Pull the fired flags into a FIFO exactly once and immediately consume the
 * original bits. Multiple events in one update are not collapsed into a single
 * Boolean; each event has its own owner/type identity. */
static void cg_event_collect(void)
{
@IDE_IF{HAS_WORLDS}
    for(uint16_t i=0u;i<@IDE{WORLD_OBJECT_COUNT};++i) {
        if(cg_gwi_platforms[i].trigger_fired) {
            (void)cg_event_enqueue(i,1u,0u);
            cg_gwi_platforms[i].trigger_fired=0u;
        }
    }
@IDE_END
@IDE_IF{HAS_ENEMY_STATE_LOGIC}
    if(!cg_enemy_logic_event_handled) {
        for(uint16_t i=0u;i<@IDE{WORLD_OBJECT_COUNT};++i)
            if(cg_gwi_platforms[i].type==GAME_OBJECT_ENEMY &&
               cg_gwi_platforms[i].break_triggered) {
                (void)cg_event_enqueue(i,2u,0u);
                cg_enemy_logic_event_handled=1u;
            }
    }
@IDE_END
@IDE_IF{HAS_NAMED_EVENTS}
    for(uint16_t i=0u;i<@IDE{WORLD_OBJECT_COUNT};++i) {
        uint8_t bits=cg_named_event_sources[i];
        cg_named_event_sources[i]=0u;
        for(uint8_t bit=1u;bits && bit;bit=(uint8_t)(bit<<1u)) {
            if(bits&bit){(void)cg_event_enqueue(i,3u,bit);bits=(uint8_t)(bits&~bit);}
        }
    }
@IDE_END
@IDE_IF{HAS_NAMED_PICKUP_EVENTS}
    for(uint16_t i=0u;i<@IDE{PICKUP_COUNT};++i) {
        if(cg_named_pickup_sources[i]) {
            cg_named_pickup_sources[i]=0u;
            (void)cg_event_enqueue(i,4u,1u);
        }
    }
@IDE_END
}
/* Single reusable Boolean/AND/OR/NOT evaluator. The event selection is
 * temporary. The authored node DAG and its numbered input layout are kept. */
static void cg_logic_evaluate_once(void)
{
    cg_action_drain();
@IDE{GRAPH_SNAPSHOTS}
@IDE_IF{HAS_WORLDS}
@IDE{TRIGGER_ACTIONS}@IDE{EVENT_ENTER_ACTIONS}
@IDE_END
    cg_action_drain();
@IDE{GRAPH_EVALUATIONS}
@IDE_IF{HAS_STAT_COMPARE}
    cg_logic_seen_stat_revision=gameplayer_stat_revision();
    cg_logic_seen_health=gameworlds_state()->health;
@IDE_END
@IDE_IF{HAS_QUEST_CONDITION}
    cg_logic_seen_quest_revision=gameworlds_quest_revision();
@IDE_END
@IDE{GRAPH_DISPATCH}
    cg_action_drain();
}
static void cg_run_trigger_actions(void)
{
    cg_event_collect();
    if(cg_event_dispatching)return; /* Nested event enters same FIFO. */
    cg_event_dispatching=1u;
    if(!cg_event_size) {
        /* State-only gates must still react to external state changes. */
        cg_logic_evaluate_once();
        cg_event_dispatching=0u;
        return;
    }
    uint16_t budget=CG_EVENT_QUEUE_CAPACITY;
    while(cg_event_size && budget--) {
        const cg_event_record_t ev=cg_event_queue[cg_event_head];
        cg_event_head=(uint16_t)((cg_event_head+1u)%CG_EVENT_QUEUE_CAPACITY);
        --cg_event_size;
        switch(ev.kind) {
@IDE_IF{HAS_WORLDS}
        case 1u: cg_gwi_platforms[ev.source].trigger_fired=1u;break;
@IDE_END
        case 2u: cg_current_defeat_owner=ev.source;break;
@IDE_IF{HAS_NAMED_EVENTS}
        case 3u: cg_named_event_sources[ev.source]=ev.mask;break;
@IDE_END
@IDE_IF{HAS_NAMED_PICKUP_EVENTS}
        case 4u: cg_named_pickup_sources[ev.source]=1u;break;
@IDE_END
        default: break;
        }
        cg_logic_evaluate_once();
        switch(ev.kind) {
@IDE_IF{HAS_WORLDS}
        case 1u: cg_gwi_platforms[ev.source].trigger_fired=0u;break;
@IDE_END
        case 2u: cg_current_defeat_owner=UINT16_MAX;break;
@IDE_IF{HAS_NAMED_EVENTS}
        case 3u: cg_named_event_sources[ev.source]=0u;break;
@IDE_END
@IDE_IF{HAS_NAMED_PICKUP_EVENTS}
        case 4u: cg_named_pickup_sources[ev.source]=0u;break;
@IDE_END
        default: break;
        }
        /* An ON ENTER handler may enqueue its own named event. */
        cg_event_collect();
    }
    if(cg_event_size) {
        ++cg_event_overflow; /* Budget exhausted: observable, never recurse. */
        cg_event_head=cg_event_tail=cg_event_size=0u;
    }
    cg_event_dispatching=0u;
}
@IDE_END
@IDE_IF{HAS_PICKUPS}
uint16_t gameworlditems_check(int32_t x, int32_t y, uint16_t w, uint16_t h,
    game_pickup_callback_t callback, void *user)
{
@IDE_IF{HAS_TILEMAP_PICKUPS}
    if (game_death_is_dead()) return 0;
@IDE_END
@IDE_IF{SAVE_PICKUP_ACTIVE}
    uint8_t was_active[@IDE{PICKUP_COUNT}];
    for (uint16_t i = 0; i < @IDE{PICKUP_COUNT}; ++i) was_active[i] = cg_gwi_pickups[i].active;
@IDE_END
    uint8_t persistent_was_active[@IDE{PICKUP_COUNT}];
    for(uint16_t i=0;i<@IDE{PICKUP_COUNT};++i)
        persistent_was_active[i]=cg_gwi_pickups[i].active;
    uint16_t count = game_collectables_check(cg_gwi_pickups, @IDE{PICKUP_COUNT}, x, y, w, h, callback, user);
@IDE_IF{HAS_LOOT}
    count += game_collectables_check(cg_loot_pickups,CG_LOOT_CAPACITY,x,y,w,h,callback,user);
    for(uint16_t i=0;i<CG_LOOT_CAPACITY;++i)
        cg_loot_slots[i].active=cg_loot_pickups[i].active;
@IDE_END
    for(uint16_t i=0;i<@IDE{PICKUP_COUNT};++i){
        /* Ignore hidden rewards that have not actually been picked up. */
        if(persistent_was_active[i] && !cg_gwi_pickups[i].active && cg_gwi_pickups[i].persistent)
            cg_pickup_permanently_collected[i]=1;
    }
@IDE_IF{HAS_NAMED_PICKUP_EVENTS}
    memset(cg_named_pickup_sources,0,sizeof(cg_named_pickup_sources));
@IDE_END
@IDE{CHECK_ACTIONS}
    cg_action_drain();
@IDE_IF{HAS_NAMED_PICKUP_LOGIC}
    uint8_t cg_named_pickup_logic=0u;
    for(uint16_t cg_i=0;cg_i<@IDE{PICKUP_COUNT};++cg_i)
        if(cg_named_pickup_sources[cg_i]) {cg_named_pickup_logic=1u;break;}
    if(cg_named_pickup_logic)cg_run_trigger_actions();
@IDE_END
@IDE_IF{HAS_NAMED_PICKUP_EVENTS}
    /* The pickup pulse has been delivered.  gameworlditems_trigger() also
     * calls cg_run_trigger_actions() and may run later in this frame.  Never
     * let that second pass see an old ON PICKUP pulse or it can replay the
     * same dialogue and toggle actions. */
    memset(cg_named_pickup_sources,0,sizeof(cg_named_pickup_sources));
@IDE_END
    return count;
}

@IDE_END
@IDE_IF{HAS_WORLDS}
/* Deferred world changes are implemented by the shared world manager. */
uint8_t gameworlds_request(const char *name);
uint8_t gameworlds_request_at(const char *name, const char *start_id);
uint8_t gameworlds_request_at_from(const char *name, const char *start_id, int32_t exit_x, int32_t exit_y);
/* Startup/re-entry pass: only state bindings and idempotent actions.
 * Never replay a dialogue, toggle, or travel just because a save was loaded. */
void gameworlditems_sync_logic(void)
{
@IDE{GRAPH_INITIAL_SYNC}
@IDE_IF{HAS_STAT_COMPARE}
    cg_logic_seen_stat_revision=gameplayer_stat_revision();
    cg_logic_seen_health=gameworlds_state()->health;
@IDE_END
@IDE_IF{HAS_QUEST_CONDITION}
    cg_logic_seen_quest_revision=gameworlds_quest_revision();
@IDE_END
}
/* ON SAVE fires only for a successful confirmed TFCard write, never when
 * the checkpoint is merely touched or the picker is cancelled. */
void gameworlditems_checkpoint_saved(void)
{
@IDE{EVENT_SAVE_ACTIONS}
    cg_action_drain();
@IDE_IF{HAS_NAMED_EVENT_LOGIC}
    uint8_t cg_named_save_logic=0u;
    for(uint16_t cg_i=0;cg_i<@IDE{WORLD_OBJECT_COUNT};++cg_i)
        if(cg_named_event_sources[cg_i]) {cg_named_save_logic=1u;break;}
    if(cg_named_save_logic)cg_run_trigger_actions();
@IDE_END
@IDE_IF{HAS_NAMED_EVENTS}
    memset(cg_named_event_sources,0,sizeof(cg_named_event_sources));
@IDE_END
    cg_checkpoint_event_source=UINT16_MAX;
}
/* FIRE2 near an interactive Trigger opens the Adventure item's USE list.
 * The closest eligible object wins; detection uses distance to the hitbox
 * EDGES so solid doors can be interacted with without entering their body. */
uint8_t gameworlditems_interaction_probe(int32_t x, int32_t y, uint16_t w, uint16_t h)
{
    cg_interaction_target=UINT16_MAX;
    /* Match the LIVE physics hitbox used by normal door triggers. */
    if (cg_fire2_player && cg_fire2_player->x100 && cg_fire2_player->y100 &&
        cg_fire2_player->width && cg_fire2_player->height) {
        x=*cg_fire2_player->x100/100+cg_fire2_player->offset_x;
        y=*cg_fire2_player->y100/100+cg_fire2_player->offset_y;
        w=cg_fire2_player->width; h=cg_fire2_player->height;
    }
    if (!w || !h) return 0;
    int64_t best=INT64_MAX;
    for (uint16_t n=0; n<sizeof(cg_interaction_rules)/sizeof(cg_interaction_rules[0]); ++n) {
        const cg_interaction_rule_t *r=&cg_interaction_rules[n];
        if (r->object>=@IDE{WORLD_OBJECT_COUNT} || !r->item || !r->item[0]) continue;
        const game_world_object_t *o=&cg_gwi_platforms[r->object];
        if (!o->active || !o->width || !o->height) continue;
        int64_t dx=(int64_t)o->x-(x+(int64_t)w);
        if (dx<0) dx=(int64_t)x-(o->x+(int64_t)o->width);
        if (dx<0) dx=0;
        int64_t dy=(int64_t)o->y-(y+(int64_t)h);
        if (dy<0) dy=(int64_t)y-(o->y+(int64_t)o->height);
        if (dy<0) dy=0;
        const int64_t distance=dx*dx+dy*dy;
        if (distance>(int64_t)r->reach*r->reach || distance>=best) continue;
        best=distance;
        cg_interaction_target=n;
    }
    return cg_interaction_target!=UINT16_MAX;
}
void gameworlditems_interaction_sound(uint8_t event)
{
    if (cg_interaction_target>=sizeof(cg_interaction_rules)/sizeof(cg_interaction_rules[0])) return;
    const cg_interaction_rule_t *r=&cg_interaction_rules[cg_interaction_target];
    if (r->object>=@IDE{WORLD_OBJECT_COUNT}) return;
    (void)event;
@IDE{INTERACT_SOUND_ACTIONS}}
/* USE and falling-item contact deliberately share the SAME success path.
   A dropped item already left inventory, so 'consume' removes its physical
   sprite rather than deducting a second item from the player's backpack. */
static uint8_t cg_complete_item_interaction(uint16_t rule_index, uint8_t dropped)
{
    const cg_interaction_rule_t *r=&cg_interaction_rules[rule_index];
    if (r->object>=@IDE{WORLD_OBJECT_COUNT}) return 0u;
    game_world_object_t *o=&cg_gwi_platforms[r->object];
    if (!o->active || !r->item) return 0u;
    uint8_t consumed_here=0u;
@IDE{INTERACT_PREFLIGHT_ACTIONS}
    o->trigger_fired=1;
@IDE_IF{HAS_TRIGGERS}
    cg_trigger_state[r->object].active ^= 1u;
@IDE_END
    if (o->trigger_one_shot) o->active=0;
    cg_run_trigger_actions();
    o->trigger_fired=0;
    const uint16_t previous=cg_interaction_target;
    cg_interaction_target=rule_index;
    gameworlditems_interaction_sound(1u);
@IDE{INTERACT_DIALOGUE_ACTIONS}
    cg_action_drain();
    cg_interaction_target=dropped ? previous : UINT16_MAX;
    return dropped ? (r->consume ? 2u : 1u)
                   : (consumed_here ? 1u : (r->consume ? 2u : 1u));
}
uint8_t gameworlditems_interaction_use(const char *item_name)
{
    if (cg_interaction_target>=sizeof(cg_interaction_rules)/sizeof(cg_interaction_rules[0]) || !item_name) return 0u;
    const cg_interaction_rule_t *r=&cg_interaction_rules[cg_interaction_target];
    if (r->object>=@IDE{WORLD_OBJECT_COUNT}) return 0u;
    if (!cg_gwi_platforms[r->object].active || !r->item) return 0u;
    if (strcmp(item_name,r->item)!=0) {
        gameworlditems_interaction_sound(0u);
@IDE{INTERACT_WRONG_DIALOGUE_ACTIONS}        return 0u;
    }
    return cg_complete_item_interaction(cg_interaction_target,0u);
}
uint8_t gameworlditems_drop_contact(const char *name, int32_t x, int32_t y)
{
    if (!name || !*name) return 0u;
    for (uint16_t n=0u; n<sizeof(cg_interaction_rules)/sizeof(cg_interaction_rules[0]); ++n) {
        const cg_interaction_rule_t *r=&cg_interaction_rules[n];
        if (!r->drop || !r->item || strcmp(name,r->item)!=0 ||
            r->object>=@IDE{WORLD_OBJECT_COUNT}) continue;
        const game_world_object_t *o=&cg_gwi_platforms[r->object];
        if (!o->active || !o->width || !o->height) continue;
        if ((int64_t)x>=((int64_t)o->x+o->width) || ((int64_t)x+16)<=o->x ||
            (int64_t)y>=((int64_t)o->y+o->height) || ((int64_t)y+16)<=o->y) continue;
        const uint8_t result=cg_complete_item_interaction(n,1u);
        if (result==1u || result==2u) return result;
    }
    return 0u;
}
@IDE_END
@IDE_IF{HAS_TRIGGERS}
uint16_t gameworlditems_trigger(int32_t x, int32_t y, uint16_t w, uint16_t h, uint8_t pressed)
{
    uint16_t fired=game_world_objects_trigger(cg_gwi_platforms, @IDE{WORLD_OBJECT_COUNT}, x, y, w, h, pressed);
    for(uint16_t i=0;i<@IDE{WORLD_OBJECT_COUNT};++i)
        if(cg_gwi_platforms[i].type==GAME_OBJECT_TRIGGER && cg_gwi_platforms[i].trigger_fired)
            cg_trigger_state[i].active ^= 1u;
    cg_run_trigger_actions();
    return fired;
}

@IDE_END
@IDE_IF{HAS_STAMPS}
/* Address the source tile DIRECTLY: index is 16-bit in the design and can
   exceed gfxbob_t.index's 8-bit limit. The PPB pixels remain shared. */
static int16_t cg_stamp_clamp(int64_t n)
{ return (int16_t)(n < -32768 ? -32768 : n > 32767 ? 32767 : n); }

static void cg_draw_stamp(const gfxbob_t *source, const cg_stamp_t *stamp,
                          int32_t x, int32_t y, int32_t camera_x, int32_t camera_y)
{
    if (!source || !source->imgdat) return;
    if (!stamp->cells) {
        gfxbob_t bob = *source;
        bob.drawx = cg_stamp_clamp((int64_t)x-camera_x);
        bob.drawy = cg_stamp_clamp((int64_t)y-camera_y);
        gfx_drawbob(&bob);
        return;
    }
    const uint16_t columns = source->atlas_stride/8u;
    const uint16_t rows = source->atlas_height/8u;
    if (!columns || !rows) return;
    const uint8_t mirror_x = !!(source->flags & BLIT_FLAG_FLIP_X);
    const uint8_t mirror_y = !!(source->flags & BLIT_FLAG_FLIP_Y);
    const int32_t left = x-camera_x, top = y-camera_y;
    for (uint16_t cy=0; cy<stamp->rows; ++cy)
        for (uint16_t cx=0; cx<stamp->columns; ++cx) {
            const uint32_t code = stamp->cells[cy*stamp->columns+cx];
            if (code == 0xFFFFFFFFu) continue;
            const uint32_t index = code & 0xFFFFu;
            if (index >= (uint32_t)columns*rows) continue;
            const int32_t dx = left+(int32_t)(mirror_x ? stamp->columns-1u-cx : cx)*8;
            const int32_t dy = top +(int32_t)(mirror_y ? stamp->rows-1u-cy : cy)*8;
            if (dx <= -8 || dy <= -8 || dx >= 480 || dy >= 320) continue;
            gfxbob_t bob = *source;
            bob.imgdat = source->imgdat + (index/columns)*8u*source->atlas_stride
                                         + (index%columns)*8u;
            bob.width=8; bob.height=8; bob.atlas_height=8; bob.index=0;
            bob.drawx=cg_stamp_clamp(dx); bob.drawy=cg_stamp_clamp(dy);
            bob.flags = (uint8_t)((source->flags & ~(BLIT_FLAG_FLIP_X | BLIT_FLAG_FLIP_Y))
                | ((mirror_x ^ !!(code & 0x10000u)) ? BLIT_FLAG_FLIP_X : 0)
                | ((mirror_y ^ !!(code & 0x20000u)) ? BLIT_FLAG_FLIP_Y : 0));
            gfx_drawbob(&bob);
        }
}
/* Replaces only drawing, not the world-object/pickup physics helpers.
   Non-stamped objects still receive their original single BOB draw. */
static void cg_draw_world_layer(int32_t camera_x, int32_t camera_y, uint8_t behind)
{
@IDE_IF{HAS_WORLDS}
    for (uint16_t i=0; i<@IDE{WORLD_OBJECT_COUNT}; ++i) {
        const game_world_object_t *o=&cg_gwi_platforms[i];
        if (o->type == GAME_OBJECT_PARTICLE_EMITTER ||
            (!o->active && !o->enemy_dying) || !o->sprite ||
            !!o->draw_behind_tiles != !!behind) continue;
        gfxbob_t visible = *o->sprite;
        game_world_enemy_hit_visual(o, &visible);
        cg_draw_stamp(&visible,&cg_platform_stamps[i],o->x,o->y,camera_x,camera_y);
    }
@IDE_END
@IDE_IF{HAS_PICKUPS}
    for (uint16_t i=0; i<@IDE{PICKUP_COUNT}; ++i) {
        const game_collectable_t *o=&cg_gwi_pickups[i];
        if (!o->active || !o->sprite || !!o->draw_behind_tiles != !!behind) continue;
        cg_draw_stamp(o->sprite,&cg_pickup_stamps[i],o->x,o->y,camera_x,camera_y);
    }
@IDE_END
@IDE_IF{HAS_LOOT}
    for(uint16_t i=0;i<CG_LOOT_CAPACITY;++i) {
        const game_collectable_t *o=&cg_loot_pickups[i];
        if (!o->active || !o->sprite || !!o->draw_behind_tiles != !!behind) continue;
        cg_draw_stamp(o->sprite,&cg_pickup_stamps[cg_loot_slots[i].template_index],
                      o->x,o->y,camera_x,camera_y);
    }
@IDE_END
}
@IDE_END
@IDE_IF{HAS_INACTIVE_STATE_FRAMES}
static void cg_draw_inactive_state_frames(int32_t camera_x,int32_t camera_y,uint8_t behind)
{
    for(uint16_t i=0;i<@IDE{WORLD_OBJECT_COUNT};++i) {
        const game_world_object_t *o=&cg_gwi_platforms[i];
        if(o->type == GAME_OBJECT_PARTICLE_EMITTER || o->active || !o->sprite || !!o->draw_behind_tiles!=!!behind ||
           cg_inactive_state_frames[i]==UINT16_MAX) continue;
        const int32_t draw_x=o->x-camera_x, draw_y=o->y-camera_y;
        if (draw_x<=-(int32_t)o->sprite->width || draw_y<=-(int32_t)o->sprite->height ||
            draw_x>=480 || draw_y>=320) continue;
        gfxbob_t bob=*o->sprite; /* Never change sprite or physics state. */
        bob.index=(uint8_t)cg_inactive_state_frames[i];
        bob.drawx=(int16_t)draw_x;
        bob.drawy=(int16_t)draw_y;
        gfx_drawbob(&bob);
    }
}
@IDE_END
void gameworlditems_draw_behind(int32_t camera_x, int32_t camera_y)
{
@IDE_IF{HAS_INACTIVE_STATE_FRAMES}
    cg_draw_inactive_state_frames(camera_x,camera_y,1u);
@IDE_END
@IDE_IF{HAS_STAMPS}
    cg_draw_world_layer(camera_x, camera_y, 1);
@IDE_ELSE
@IDE_IF{HAS_WORLDS}
    game_world_objects_draw_layer(cg_gwi_platforms, @IDE{WORLD_OBJECT_COUNT}, camera_x, camera_y, 1);
@IDE_END
@IDE_IF{HAS_PICKUPS}
    game_collectables_draw_layer(cg_gwi_pickups, @IDE{PICKUP_COUNT}, camera_x, camera_y, 1);
@IDE_END
@IDE_IF{HAS_LOOT}
    game_collectables_draw_layer(cg_loot_pickups, CG_LOOT_CAPACITY, camera_x, camera_y, 1);
@IDE_END
@IDE_END
@IDE{DRAW_BEHIND_BODY}
@IDE_IF{HAS_PARTICLE_EMITTERS}
    cg_particle_draw(camera_x, camera_y, 1u, 0u);
@IDE_END
}

void gameworlditems_draw(int32_t camera_x, int32_t camera_y)
{
@IDE_IF{HAS_INACTIVE_STATE_FRAMES}
    cg_draw_inactive_state_frames(camera_x,camera_y,0u);
@IDE_END
@IDE_IF{HAS_STAMPS}
    cg_draw_world_layer(camera_x, camera_y, 0);
@IDE_ELSE
@IDE_IF{HAS_WORLDS}
    game_world_objects_draw_layer(cg_gwi_platforms, @IDE{WORLD_OBJECT_COUNT}, camera_x, camera_y, 0);
@IDE_END
@IDE_IF{HAS_PICKUPS}
    game_collectables_draw_layer(cg_gwi_pickups, @IDE{PICKUP_COUNT}, camera_x, camera_y, 0);
@IDE_END
@IDE_IF{HAS_LOOT}
    game_collectables_draw_layer(cg_loot_pickups, CG_LOOT_CAPACITY, camera_x, camera_y, 0);
@IDE_END
@IDE_END
@IDE_IF{HAS_AUDIO}
    cg_audio_camera_x = camera_x;
@IDE_END
@IDE{DRAW_BODY}
@IDE_IF{HAS_PARTICLE_EMITTERS}
    cg_particle_draw(camera_x, camera_y, 0u, 0u);
@IDE_END
}
void gameworlditems_draw_overlay(int32_t camera_x, int32_t camera_y)
{
@IDE_IF{HAS_PARTICLE_EMITTERS}
    cg_particle_draw(camera_x, camera_y, 0u, 1u);
@IDE_ELSE
    (void)camera_x; (void)camera_y;
@IDE_END
}

