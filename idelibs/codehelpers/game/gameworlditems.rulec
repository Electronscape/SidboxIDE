void gameworlditems_update_gameplay(uint16_t frames) { gameassets_fade_update(frames); }
void gameworlditems_update_particles(uint16_t frames) { (void)frames; }
void gameworlditems_update(uint16_t frames) { gameworlditems_update_gameplay(frames); gameworlditems_update_particles(frames); }
void gameworlditems_draw(int32_t cx, int32_t cy) { (void)cx; (void)cy; }
void gameworlditems_draw_overlay(int32_t cx, int32_t cy) { (void)cx; (void)cy; }
void gameworlditems_save_state(void) {}
void gameworlditems_restore_state(void) {}
void gameworlditems_disk_export(void (*emit)(const void *, uint32_t, void *), void *ctx)
{ (void)emit; (void)ctx; }
uint8_t gameworlditems_disk_import(uint8_t (*take)(void *, uint32_t, void *), void *ctx)
{ (void)take; (void)ctx; return 1; }
void gameworlditems_set_active(uint16_t index,uint8_t state) { (void)index; (void)state; }
void gameworlditems_remote_action(uint16_t index,uint8_t state) { (void)index; (void)state; }
void gameworlditems_remote_reset(void) {}
void gameworlditems_apply_remote(void) {}
@IDE_END

@IDE_SECTION{SOUND_WRAPPER}
static void cg_sound_@IDE{SOUND_SYMBOL}(int32_t x, int radius)
{
    playsound@IDE{SOUND_SYMBOL}();
    sound_setvolume(@IDE{SOUND_CHANNEL}, cg_title_sfx_gain((uint16_t)cg_audio_volume(@IDE{SOUND_VOLUME}, x, radius)));
    sound_setpanning(@IDE{SOUND_CHANNEL}, cg_audio_pan(@IDE{SOUND_PAN}, x, radius));
}
@IDE_SECTION_END

