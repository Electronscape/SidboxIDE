static void cg_sound_@IDE{SOUND_SYMBOL}(int32_t x, int radius)
{
    playsound@IDE{SOUND_SYMBOL}();
    sound_setvolume(@IDE{SOUND_CHANNEL}, cg_title_sfx_gain((uint16_t)cg_audio_volume(@IDE{SOUND_VOLUME}, x, radius)));
    sound_setpanning(@IDE{SOUND_CHANNEL}, cg_audio_pan(@IDE{SOUND_PAN}, x, radius));
}
@IDE_SECTION_END

