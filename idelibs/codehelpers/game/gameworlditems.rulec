    @IDE{SPRITE_SYMBOL}.flags = (uint8_t)((@IDE{SPRITE_SYMBOL}.flags & ~(BLIT_FLAG_FLIP_X | BLIT_FLAG_FLIP_Y)) | @IDE{FLIP_X} | @IDE{FLIP_Y});
@IDE_IF{HAS_ACTIVE_PATH}
    start_spline(&@IDE{PATH_VAR}, &@IDE{SPRITE_SYMBOL}, @IDE{PATH_SYMBOL}_path, @IDE{PATH_SYMBOL}_count, @IDE{PATH_SYMBOL}_frames, @IDE{PATH_SYMBOL}_loop);
