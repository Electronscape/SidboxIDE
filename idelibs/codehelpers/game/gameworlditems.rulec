/* Stage 119: deterministic, bounded action command ring. No heap/recursion.
 * The generator allocates one case per authored action (not one per frame).
 * Keep these transient bytes OUT of persistent world saves. */
#define CG_ACTION_QUEUE_CAPACITY 128u
static uint16_t cg_action_queue[CG_ACTION_QUEUE_CAPACITY];
static uint16_t cg_action_head, cg_action_tail, cg_action_size;
static uint8_t cg_action_draining;
static uint32_t cg_action_overflow;
static uint8_t cg_action_enqueue(uint16_t command)
{
    if(cg_action_size==CG_ACTION_QUEUE_CAPACITY) {
        ++cg_action_overflow;
        return 0u;
    }
    cg_action_queue[cg_action_tail]=command;
    cg_action_tail=(uint16_t)((cg_action_tail+1u)%CG_ACTION_QUEUE_CAPACITY);
    ++cg_action_size;
    return 1u;
}
uint32_t gameworlditems_action_overflow_count(void) {return cg_action_overflow;}
static void cg_action_drain(void)
{
    if(cg_action_draining)return; /* Nested callbacks append; caller drains. */
    cg_action_draining=1u;
    uint16_t budget=CG_ACTION_QUEUE_CAPACITY;
    /* Commands can append further commands. A bounded budget also protects
     * against accidental cyclic connections; overflow is observable. */
    while(cg_action_size && budget--) {
        const uint16_t command=cg_action_queue[cg_action_head];
        cg_action_head=(uint16_t)((cg_action_head+1u)%CG_ACTION_QUEUE_CAPACITY);
        --cg_action_size;
        switch(command) {
@IDE{ACTION_QUEUE_CASES}        default: break;
        }
    }
    if(cg_action_size) {
        ++cg_action_overflow; /* Cycle/budget guard, not a silent deferral. */
        cg_action_head=cg_action_tail=cg_action_size=0u;
    }
    cg_action_draining=0u;
}
/* One-shot quest completion dispatch from the world manager. The QUEUED
 * action IDs are generated from this world's quest-completed source links. */
void gameworlditems_quest_completed(const char *quest_id)
{
    if(!quest_id)return;
@IDE{QUEST_COMPLETE_ACTIONS}}
/* All event entries carry their source index, type and (for named events)
 * mask. We never model events as lasting Boolean state. */
#define CG_EVENT_QUEUE_CAPACITY 128u
typedef struct { uint32_t sequence; uint16_t source; uint8_t kind,mask; } cg_event_record_t;
static cg_event_record_t cg_event_queue[CG_EVENT_QUEUE_CAPACITY];
static uint16_t cg_event_head,cg_event_tail,cg_event_size;
static uint8_t cg_event_dispatching;
static uint32_t cg_event_overflow,cg_event_next_sequence;
static uint16_t cg_current_defeat_owner=UINT16_MAX;
static uint8_t cg_event_enqueue(uint16_t source,uint8_t kind,uint8_t mask)
{
    if(cg_event_size==CG_EVENT_QUEUE_CAPACITY) {
        ++cg_event_overflow;
        return 0u;
    }
    cg_event_record_t *entry=&cg_event_queue[cg_event_tail];
    entry->sequence=++cg_event_next_sequence;
    entry->source=source;entry->kind=kind;entry->mask=mask;
    cg_event_tail=(uint16_t)((cg_event_tail+1u)%CG_EVENT_QUEUE_CAPACITY);
    ++cg_event_size;
    return 1u;
}
uint32_t gameworlditems_event_overflow_count(void) { return cg_event_overflow; }
