static game_world_object_t cg_gwi_platforms[@IDE{WORLD_OBJECT_COUNT}];
/* The FIRE2 priority probe must use exactly the same live collision rectangle
   as gameworlditems_after() uses to activate the door, including offsets. */
static const game_world_player_t *cg_fire2_player;
/* A stable item name, not a world-local inventory slot number. */
typedef struct { uint16_t object; uint16_t reach; uint8_t consume; const char *item; } cg_interaction_rule_t;
static const cg_interaction_rule_t cg_interaction_rules[] = {
@IDE{INTERACT_ROWS}    {UINT16_MAX, 0u, 0u, 0}
};
