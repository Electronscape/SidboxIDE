@IDE_END
static uint8_t cg_world_snapshot_valid;

void gameworlditems_save_state(void)
{
@IDE_IF{HAS_WORLDS}
    for (uint16_t i = 0; i < @IDE{WORLD_OBJECT_COUNT}; ++i) {
        const game_world_object_t *o = &cg_gwi_platforms[i];
        cg_world_object_state_t *d = &cg_saved_objects[i];
        d->active = o->active;
        d->hits = o->break_hits_done;
        d->dying = o->enemy_dying;
        d->roam_direction = (uint8_t)o->enemy_roam_direction;
        d->x = o->x; d->y = o->y;
        d->previous_x = o->previous_x; d->previous_y = o->previous_y;
        d->spline_start_delay = o->spline_start_delay;
        d->has_spline = o->spline != 0;
        if (o->spline) {
            d->spline_elapsed = o->spline->elapsed_frames;
            d->spline_pause = o->spline->pause_remaining;
            d->spline_next = o->spline->next_pause_index;
            d->spline_offset_x = o->spline->offset_x;
            d->spline_offset_y = o->spline->offset_y;
            d->spline_active = o->spline->active;
            d->spline_finish = o->spline->finish_after_pause;
        }
        d->has_animation = o->animation != 0;
        if (o->animation) {
            d->animation_current = o->animation->current_frame;
            d->animation_counter = o->animation->frame_counter;
            d->animation_phase = o->animation->pingpong_phase;
            d->animation_playing = o->animation->playing;
            d->animation_finished = o->animation->finished;
        }
        d->sprite_index = o->sprite ? o->sprite->index : 0;
    }
@IDE_END
@IDE_IF{HAS_PICKUPS}
    for (uint16_t i = 0; i < @IDE{PICKUP_COUNT}; ++i) {
        const game_collectable_t *o = &cg_gwi_pickups[i];
        cg_world_pickup_state_t *d = &cg_saved_pickups[i];
        d->active = o->active;
        d->can_collect = o->can_collect;
        d->respawn_left = o->respawn_left;
        d->x = o->x; d->y = o->y;
        d->spline_start_delay = o->spline_start_delay;
        d->has_spline = o->spline != 0;
        if (o->spline) {
            d->spline_elapsed = o->spline->elapsed_frames;
            d->spline_pause = o->spline->pause_remaining;
            d->spline_next = o->spline->next_pause_index;
            d->spline_offset_x = o->spline->offset_x;
            d->spline_offset_y = o->spline->offset_y;
            d->spline_active = o->spline->active;
            d->spline_finish = o->spline->finish_after_pause;
        }
        d->has_animation = o->animation != 0;
        if (o->animation) {
            d->animation_current = o->animation->current_frame;
            d->animation_counter = o->animation->frame_counter;
            d->animation_phase = o->animation->pingpong_phase;
            d->animation_playing = o->animation->playing;
            d->animation_finished = o->animation->finished;
        }
        d->sprite_index = o->sprite ? o->sprite->index : 0;
    }
@IDE_END
@IDE_IF{HAS_REWARDS}
    for (uint16_t i = 0; i < @IDE{PICKUP_COUNT}; ++i) {
        cg_saved_reward_falling[i] = cg_reward_falling[i];
        cg_saved_reward_x100[i] = cg_reward_x100[i];
        cg_saved_reward_y100[i] = cg_reward_y100[i];
        cg_saved_reward_vx100[i] = cg_reward_vx100[i];
        cg_saved_reward_vy100[i] = cg_reward_vy100[i];
    }
@IDE_END
    cg_world_snapshot_valid = 1;
}

void gameworlditems_restore_state(void)
{
    if (!cg_world_snapshot_valid) return; /* First entry uses editor defaults. */
@IDE_IF{HAS_WORLDS}
    for (uint16_t i = 0; i < @IDE{WORLD_OBJECT_COUNT}; ++i) {
        game_world_object_t *o = &cg_gwi_platforms[i];
        const cg_world_object_state_t *d = &cg_saved_objects[i];
        o->active = d->active;
        o->break_hits_done = d->hits;
        o->enemy_dying = d->dying;
        o->enemy_roam_direction = (int8_t)d->roam_direction;
        o->x = d->x; o->y = d->y;
        o->previous_x = d->previous_x; o->previous_y = d->previous_y;
        o->spline_start_delay = d->spline_start_delay;
        if (o->spline && d->has_spline) {
            o->spline->elapsed_frames = d->spline_elapsed;
            o->spline->pause_remaining = d->spline_pause;
            o->spline->next_pause_index = d->spline_next;
            o->spline->offset_x = d->spline_offset_x;
            o->spline->offset_y = d->spline_offset_y;
            o->spline->active = d->spline_active;
            o->spline->finish_after_pause = d->spline_finish;
        }
        if (o->animation && d->has_animation) {
            o->animation->current_frame = d->animation_current;
            o->animation->frame_counter = d->animation_counter;
            o->animation->pingpong_phase = d->animation_phase;
            o->animation->playing = d->animation_playing;
            o->animation->finished = d->animation_finished;
        }
        if (o->sprite) {
            o->sprite->drawx = (int16_t)d->x;
            o->sprite->drawy = (int16_t)d->y;
            o->sprite->index = d->sprite_index;
        }
        /* Contact latches are transient, not game progression. */
        o->trigger_touching = 0; o->trigger_pressed = 0;
        o->spring_touching = 0; o->break_touching = 0;
    }
@IDE_END
@IDE_IF{HAS_PICKUPS}
    for (uint16_t i = 0; i < @IDE{PICKUP_COUNT}; ++i) {
        game_collectable_t *o = &cg_gwi_pickups[i];
        const cg_world_pickup_state_t *d = &cg_saved_pickups[i];
        o->active = (uint8_t)(d->active && !cg_pickup_permanently_collected[i]);
        o->can_collect = d->can_collect;
        o->respawn_left = d->respawn_left;
        o->x = d->x; o->y = d->y;
        o->spline_start_delay = d->spline_start_delay;
        if (o->spline && d->has_spline) {
            o->spline->elapsed_frames = d->spline_elapsed;
            o->spline->pause_remaining = d->spline_pause;
            o->spline->next_pause_index = d->spline_next;
            o->spline->offset_x = d->spline_offset_x;
            o->spline->offset_y = d->spline_offset_y;
            o->spline->active = d->spline_active;
            o->spline->finish_after_pause = d->spline_finish;
        }
        if (o->animation && d->has_animation) {
            o->animation->current_frame = d->animation_current;
            o->animation->frame_counter = d->animation_counter;
            o->animation->pingpong_phase = d->animation_phase;
            o->animation->playing = d->animation_playing;
            o->animation->finished = d->animation_finished;
        }
        if (o->sprite) {
            o->sprite->drawx = (int16_t)d->x;
            o->sprite->drawy = (int16_t)d->y;
            o->sprite->index = d->sprite_index;
        }
    }
@IDE_END
@IDE_IF{HAS_REWARDS}
    for (uint16_t i = 0; i < @IDE{PICKUP_COUNT}; ++i) {
        cg_reward_falling[i] = cg_saved_reward_falling[i];
        cg_reward_x100[i] = cg_saved_reward_x100[i];
        cg_reward_y100[i] = cg_saved_reward_y100[i];
        cg_reward_vx100[i] = cg_saved_reward_vx100[i];
        cg_reward_vy100[i] = cg_saved_reward_vy100[i];
    }
@IDE_END
}

uint8_t gameworlditems_init(void)
{
@IDE_IF{HAS_WORLDS}
    cg_fire2_player=0;
    cg_interaction_target=UINT16_MAX;
@IDE_END
@IDE_IF{HAS_TILEMAP_WORLDS}
    cg_hazard_zone_contact = 0;
@IDE_END
@IDE_IF{HAS_REWARDS}
    for (uint16_t i = 0; i < @IDE{PICKUP_COUNT}; ++i) { cg_reward_falling[i] = 0; cg_reward_x100[i] = 0; cg_reward_y100[i] = 0; cg_reward_vx100[i] = 0; cg_reward_vy100[i] = 0; }
@IDE_END
@IDE_IF{HAS_AUDIO_WORLDS}
    for (uint16_t i = 0; i < @IDE{WORLD_OBJECT_COUNT}; ++i) { cg_was_moving[i] = 0; cg_previous_direction[i] = 0; cg_loop_playing[i] = 0; cg_loop_gain[i] = 0; cg_loop_target[i] = 0; }
@IDE_END
@IDE{INIT_BODY}
@IDE_IF{HAS_WORLDS}
    /* Static state artwork applies independently of optional animation.
     * Inactive artwork is painted without restoring object collision. */
    for(uint16_t i=0;i<@IDE{WORLD_OBJECT_COUNT};++i)
        if(cg_active_state_frames[i]!=UINT16_MAX && cg_gwi_platforms[i].sprite)
            cg_gwi_platforms[i].sprite->index=(uint8_t)cg_active_state_frames[i];
@IDE_END
@IDE_IF{HAS_PICKUPS}
    for (uint16_t i=0;i<@IDE{PICKUP_COUNT};++i)
        if (cg_pickup_permanently_collected[i] && cg_gwi_pickups[i].persistent)
            cg_gwi_pickups[i].active=0;
@IDE_END
    return 1;
}

@IDE_IF{HAS_WORLDS}
void gameworlditems_set_active(uint16_t index, uint8_t state)
{
    if (index >= GAMEWORLDITEMS_PLATFORM_COUNT) return;
    cg_gwi_platforms[index].active = state == 2 ? (uint8_t)!cg_gwi_platforms[index].active : (uint8_t)(state != 0);
    if(cg_gwi_platforms[index].active && cg_active_state_frames[index]!=UINT16_MAX && cg_gwi_platforms[index].sprite)
        cg_gwi_platforms[index].sprite->index=(uint8_t)cg_active_state_frames[index];
}

@IDE_END
@IDE_IF{HAS_TILEMAP_WORLDS}
/* Same tile/slope query as the player. */
static uint8_t cg_enemy_tile_blocked(int32_t x, int32_t y, uint16_t w, uint16_t h, void *ctx)
{ return game_tilemap_actor_blocked((const game_tilemap_t *)ctx, x, y, w, h); }

@IDE_END
void gameworlditems_update(uint16_t frames)
{
    gameassets_fade_update(frames);
@IDE_IF{HAS_WORLDS}
    game_world_objects_update(cg_gwi_platforms, @IDE{WORLD_OBJECT_COUNT}, frames);
@IDE_END
@IDE_IF{HAS_TILEMAP_WORLDS}
    game_world_objects_roam(cg_gwi_platforms, @IDE{WORLD_OBJECT_COUNT}, frames, cg_enemy_tile_blocked, &@IDE{WORLD_SYMBOL});
@IDE_END
@IDE_IF{HAS_AUDIO_PICKUPS}
    for (uint16_t i = 0; i < @IDE{PICKUP_COUNT}; ++i) cg_pickup_was_inactive[i] = (uint8_t)!cg_gwi_pickups[i].active;
@IDE_END
@IDE_IF{HAS_PICKUPS}
    game_collectables_update(cg_gwi_pickups, @IDE{PICKUP_COUNT}, frames);
@IDE_END
@IDE_IF{HAS_REWARDS}
    /* Prize launch: optional X/Y impulse, then gravity. Sweep each axis
       pixel-by-pixel so thin tile walls, ceilings and floors are respected.
       A reward cannot be collected until it lands on solid ground. */
    for (uint16_t i = 0; i < GAMEWORLDITEMS_PICKUP_COUNT; ++i) {
        if (!cg_reward_falling[i]) continue;
        for (uint16_t tick = 0; tick < frames; ++tick) {
            int32_t x = cg_gwi_pickups[i].x;
            int32_t y = cg_gwi_pickups[i].y;
            int32_t next_x100 = cg_reward_x100[i] + cg_reward_vx100[i];
            int32_t next_y100;
            int32_t vx = cg_reward_vx100[i];
            int32_t vy = cg_reward_vy100[i] + 65; /* gravity 0.65px/frame² */
            if (vy > 900) vy = 900;
            cg_reward_vy100[i] = vy;
            next_y100 = cg_reward_y100[i] + vy;
            /* Horizontal sweep. Walls stop horizontal speed, not gravity. */
            int32_t target_x = next_x100 / 100;
            while (x != target_x) {
                int32_t step = target_x > x ? 1 : -1;
                if (game_tilemap_actor_blocked(&@IDE{WORLD_SYMBOL}, x + step, y,
                        cg_gwi_pickups[i].width, cg_gwi_pickups[i].height)) {
                    vx = 0;
                    next_x100 = x * 100;
                    break;
                }
                x += step;
            }
            /* A gentle horizontal slowdown leaves the launch visible
               without letting prizes drift forever across the level. */
            cg_reward_vx100[i] = (vx * 97) / 100;
            if (cg_reward_vx100[i] > -5 && cg_reward_vx100[i] < 5)
                cg_reward_vx100[i] = 0;
            cg_reward_x100[i] = next_x100;
            int32_t target_y = next_y100 / 100;
            uint8_t landed = 0;
            while (y != target_y) {
                int32_t step = target_y > y ? 1 : -1;
                if (game_tilemap_actor_blocked(&@IDE{WORLD_SYMBOL}, x, y + step,
                        cg_gwi_pickups[i].width, cg_gwi_pickups[i].height)) {
                    if (step > 0) landed = 1;
                    cg_reward_vy100[i] = 0;
                    next_y100 = y * 100;
                    break;
                }
                y += step;
            }
            cg_reward_y100[i] = next_y100;
            game_collectable_set_position(&cg_gwi_pickups[i], x, y);
            if (landed || (cg_reward_vy100[i] >= 0 &&
                    game_tilemap_actor_blocked(&@IDE{WORLD_SYMBOL}, x, y + 1,
                        cg_gwi_pickups[i].width, cg_gwi_pickups[i].height))) {
                cg_reward_falling[i] = 0;
                cg_reward_vx100[i] = 0;
                cg_reward_vy100[i] = 0;
                cg_gwi_pickups[i].can_collect = 1;
                break;
            }
        }
    }
@IDE_END
@IDE{UPDATE_BODY}}

@IDE_IF{HAS_TILEMAP_WORLDS}
/* Use the same walls/slopes as game_tile_player_run() when
   a moving platform carries the player. Generated automatically. */
static uint8_t cg_world_player_blocked(int32_t x, int32_t y,
    uint16_t width, uint16_t height, void *context)
{
    return game_tilemap_actor_blocked((const game_tilemap_t *)context,
                                     x, y, width, height);
}

@IDE_END
@IDE_IF{HAS_WORLDS}
uint8_t gameworlditems_fire2_action(int32_t player_x, int32_t player_y,
                                    uint16_t player_w, uint16_t player_h)
{
    if (cg_fire2_player && cg_fire2_player->x100 && cg_fire2_player->y100 &&
        cg_fire2_player->width && cg_fire2_player->height) {
        player_x=*cg_fire2_player->x100/100+cg_fire2_player->offset_x;
        player_y=*cg_fire2_player->y100/100+cg_fire2_player->offset_y;
        player_w=cg_fire2_player->width;
        player_h=cg_fire2_player->height;
    }
    return game_world_objects_fire2_action(cg_gwi_platforms, @IDE{WORLD_OBJECT_COUNT},
        player_x, player_y, player_w, player_h);
}

void gameworlditems_before(game_world_player_t *player)
{
@IDE_IF{HAS_WORLDS}
    cg_fire2_player=player;
@IDE_END
@IDE_IF{HAS_TILEMAP_WORLDS}
    if (game_death_is_dead()) return;
    if (player) {
        player->position_blocked = cg_world_player_blocked;
        player->collision_context = &@IDE{WORLD_SYMBOL};
    }
@IDE_END
    game_world_objects_before(cg_gwi_platforms, @IDE{WORLD_OBJECT_COUNT}, player);
}

void gameworlditems_after(game_world_player_t *player)
{
@IDE_IF{HAS_TILEMAP_WORLDS}
    if (game_death_is_dead()) return;
@IDE_END
    game_world_objects_after(cg_gwi_platforms, @IDE{WORLD_OBJECT_COUNT}, player);
    game_world_objects_hazards(cg_gwi_platforms, @IDE{WORLD_OBJECT_COUNT}, player);
@IDE{REWARD_SPAWN_ACTIONS}
@IDE_IF{HAS_TILEMAP_WORLDS}
    /* Hazard Zone: ENTERED once, INSIDE each frame, EXITED on leaving. */
    uint8_t in_hazard_zone = (uint8_t)(player && player->x100 && player->y100 &&
        player->width && player->height &&
        game_world_objects_death_zone(cg_gwi_platforms, @IDE{WORLD_OBJECT_COUNT}, *player->x100 / 100 + player->offset_x, *player->y100 / 100 + player->offset_y, player->width, player->height));
    uint8_t was_in_hazard_zone = cg_hazard_zone_contact;
    cg_hazard_zone_contact = in_hazard_zone;
    if (player && player->x100 && player->y100) {
        if (in_hazard_zone && !was_in_hazard_zone)
            game_hazard_notify(GAME_HAZARD_ZONE_ENTERED, *player->x100 / 100 + player->offset_x, *player->y100 / 100 + player->offset_y);
        else if (in_hazard_zone)
            game_hazard_notify(GAME_HAZARD_ZONE_INSIDE, *player->x100 / 100 + player->offset_x, *player->y100 / 100 + player->offset_y);
        else if (was_in_hazard_zone)
            game_hazard_notify(GAME_HAZARD_ZONE_EXITED, *player->x100 / 100 + player->offset_x, *player->y100 / 100 + player->offset_y);
        /* Callback may explicitly kill or teleport the player. */
        if (game_death_is_dead()) return;
    }
@IDE_END
@IDE{WORLD_EVENT_ACTIONS}
@IDE_IF{HAS_TRIGGERS}
    if (player && player->x100 && player->y100 && player->width && player->height)
        gameworlditems_trigger(*player->x100 / 100 + player->offset_x, *player->y100 / 100 + player->offset_y,
            player->width, player->height, (getjoyport() & BTN_FIRE2) != 0);
@IDE_END
}

@IDE_END
@IDE_IF{HAS_PICKUPS}
uint16_t gameworlditems_check(int32_t x, int32_t y, uint16_t w, uint16_t h,
    game_pickup_callback_t callback, void *user)
{
@IDE_IF{HAS_TILEMAP_PICKUPS}
    if (game_death_is_dead()) return 0;
@IDE_END
@IDE_IF{SAVE_PICKUP_ACTIVE}
    uint8_t was_active[@IDE{PICKUP_COUNT}];
    for (uint16_t i = 0; i < @IDE{PICKUP_COUNT}; ++i) was_active[i] = cg_gwi_pickups[i].active;
@IDE_END
    uint8_t persistent_was_active[@IDE{PICKUP_COUNT}];
    for(uint16_t i=0;i<@IDE{PICKUP_COUNT};++i)
        persistent_was_active[i]=cg_gwi_pickups[i].active;
    uint16_t count = game_collectables_check(cg_gwi_pickups, @IDE{PICKUP_COUNT}, x, y, w, h, callback, user);
    for(uint16_t i=0;i<@IDE{PICKUP_COUNT};++i){
        /* Ignore hidden rewards that have not actually been picked up. */
        if(persistent_was_active[i] && !cg_gwi_pickups[i].active && cg_gwi_pickups[i].persistent)
            cg_pickup_permanently_collected[i]=1;
    }
@IDE{CHECK_ACTIONS}    return count;
}

@IDE_END
@IDE_IF{HAS_WORLDS}
/* Deferred world changes are implemented by the shared world manager. */
uint8_t gameworlds_request(const char *name);
uint8_t gameworlds_request_at(const char *name, const char *start_id);
uint8_t gameworlds_request_at_from(const char *name, const char *start_id, int32_t exit_x, int32_t exit_y);
static void cg_run_trigger_actions(void)
{
@IDE{TRIGGER_ACTIONS}}
/* FIRE2 near an interactive Trigger opens the Adventure item's USE list.
 * The closest eligible object wins; detection uses distance to the hitbox
 * EDGES so solid doors can be interacted with without entering their body. */
uint8_t gameworlditems_interaction_probe(int32_t x, int32_t y, uint16_t w, uint16_t h)
{
    cg_interaction_target=UINT16_MAX;
    /* Match the LIVE physics hitbox used by normal door triggers. */
    if (cg_fire2_player && cg_fire2_player->x100 && cg_fire2_player->y100 &&
        cg_fire2_player->width && cg_fire2_player->height) {
        x=*cg_fire2_player->x100/100+cg_fire2_player->offset_x;
        y=*cg_fire2_player->y100/100+cg_fire2_player->offset_y;
        w=cg_fire2_player->width; h=cg_fire2_player->height;
    }
    if (!w || !h) return 0;
    int64_t best=INT64_MAX;
    for (uint16_t n=0; n<sizeof(cg_interaction_rules)/sizeof(cg_interaction_rules[0]); ++n) {
        const cg_interaction_rule_t *r=&cg_interaction_rules[n];
        if (r->object>=@IDE{WORLD_OBJECT_COUNT} || !r->item || !r->item[0]) continue;
        const game_world_object_t *o=&cg_gwi_platforms[r->object];
        if (!o->active || !o->width || !o->height) continue;
        int64_t dx=(int64_t)o->x-(x+(int64_t)w);
        if (dx<0) dx=(int64_t)x-(o->x+(int64_t)o->width);
        if (dx<0) dx=0;
        int64_t dy=(int64_t)o->y-(y+(int64_t)h);
        if (dy<0) dy=(int64_t)y-(o->y+(int64_t)o->height);
        if (dy<0) dy=0;
        const int64_t distance=dx*dx+dy*dy;
        if (distance>(int64_t)r->reach*r->reach || distance>=best) continue;
        best=distance;
        cg_interaction_target=n;
    }
    return cg_interaction_target!=UINT16_MAX;
}
void gameworlditems_interaction_sound(uint8_t event)
{
    if (cg_interaction_target>=sizeof(cg_interaction_rules)/sizeof(cg_interaction_rules[0])) return;
    const cg_interaction_rule_t *r=&cg_interaction_rules[cg_interaction_target];
    if (r->object>=@IDE{WORLD_OBJECT_COUNT}) return;
    (void)event;
@IDE{INTERACT_SOUND_ACTIONS}}
uint8_t gameworlditems_interaction_use(const char *item_name)
{
    if (cg_interaction_target>=sizeof(cg_interaction_rules)/sizeof(cg_interaction_rules[0]) || !item_name) return 0;
    const cg_interaction_rule_t *r=&cg_interaction_rules[cg_interaction_target];
    if (r->object>=@IDE{WORLD_OBJECT_COUNT}) return 0;
    game_world_object_t *o=&cg_gwi_platforms[r->object];
    if (!o->active || !r->item) return 0u;
    if (strcmp(item_name,r->item)!=0) {
        gameworlditems_interaction_sound(0u); /* Wrong item. */
@IDE{INTERACT_WRONG_DIALOGUE_ACTIONS}        return 0u;
    }
    uint8_t consumed_here=0u;
@IDE{INTERACT_PREFLIGHT_ACTIONS}
    o->trigger_fired=1;
    if (o->trigger_one_shot) o->active=0;
    cg_run_trigger_actions();
    o->trigger_fired=0;
    gameworlditems_interaction_sound(1u); /* Success, before clearing target. */
@IDE{INTERACT_DIALOGUE_ACTIONS}
    cg_interaction_target=UINT16_MAX;
    return consumed_here ? 1u : (r->consume ? 2u : 1u);
}
@IDE_END
@IDE_IF{HAS_TRIGGERS}
uint16_t gameworlditems_trigger(int32_t x, int32_t y, uint16_t w, uint16_t h, uint8_t pressed)
{
    uint16_t fired=game_world_objects_trigger(cg_gwi_platforms, @IDE{WORLD_OBJECT_COUNT}, x, y, w, h, pressed);
    cg_run_trigger_actions();
    return fired;
}

@IDE_END
@IDE_IF{HAS_STAMPS}
/* Address the source tile DIRECTLY: index is 16-bit in the design and can
   exceed gfxbob_t.index's 8-bit limit. The PPB pixels remain shared. */
static int16_t cg_stamp_clamp(int64_t n)
{ return (int16_t)(n < -32768 ? -32768 : n > 32767 ? 32767 : n); }

static void cg_draw_stamp(const gfxbob_t *source, const cg_stamp_t *stamp,
                          int32_t x, int32_t y, int32_t camera_x, int32_t camera_y)
{
    if (!source || !source->imgdat) return;
    if (!stamp->cells) {
        gfxbob_t bob = *source;
        bob.drawx = cg_stamp_clamp((int64_t)x-camera_x);
        bob.drawy = cg_stamp_clamp((int64_t)y-camera_y);
        gfx_drawbob(&bob);
        return;
    }
    const uint16_t columns = source->atlas_stride/8u;
    const uint16_t rows = source->atlas_height/8u;
    if (!columns || !rows) return;
    const uint8_t mirror_x = !!(source->flags & BLIT_FLAG_FLIP_X);
    const uint8_t mirror_y = !!(source->flags & BLIT_FLAG_FLIP_Y);
    const int32_t left = x-camera_x, top = y-camera_y;
    for (uint16_t cy=0; cy<stamp->rows; ++cy)
        for (uint16_t cx=0; cx<stamp->columns; ++cx) {
            const uint32_t code = stamp->cells[cy*stamp->columns+cx];
            if (code == 0xFFFFFFFFu) continue;
            const uint32_t index = code & 0xFFFFu;
            if (index >= (uint32_t)columns*rows) continue;
            const int32_t dx = left+(int32_t)(mirror_x ? stamp->columns-1u-cx : cx)*8;
            const int32_t dy = top +(int32_t)(mirror_y ? stamp->rows-1u-cy : cy)*8;
            if (dx <= -8 || dy <= -8 || dx >= 480 || dy >= 320) continue;
            gfxbob_t bob = *source;
            bob.imgdat = source->imgdat + (index/columns)*8u*source->atlas_stride
                                         + (index%columns)*8u;
            bob.width=8; bob.height=8; bob.atlas_height=8; bob.index=0;
            bob.drawx=cg_stamp_clamp(dx); bob.drawy=cg_stamp_clamp(dy);
            bob.flags = (uint8_t)((source->flags & ~(BLIT_FLAG_FLIP_X | BLIT_FLAG_FLIP_Y))
                | ((mirror_x ^ !!(code & 0x10000u)) ? BLIT_FLAG_FLIP_X : 0)
                | ((mirror_y ^ !!(code & 0x20000u)) ? BLIT_FLAG_FLIP_Y : 0));
            gfx_drawbob(&bob);
        }
}
/* Replaces only drawing, not the world-object/pickup physics helpers.
   Non-stamped objects still receive their original single BOB draw. */
static void cg_draw_world_layer(int32_t camera_x, int32_t camera_y, uint8_t behind)
{
@IDE_IF{HAS_WORLDS}
    for (uint16_t i=0; i<@IDE{WORLD_OBJECT_COUNT}; ++i) {
        const game_world_object_t *o=&cg_gwi_platforms[i];
        if ((!o->active && !o->enemy_dying) || !o->sprite ||
            !!o->draw_behind_tiles != !!behind) continue;
        cg_draw_stamp(o->sprite,&cg_platform_stamps[i],o->x,o->y,camera_x,camera_y);
    }
@IDE_END
@IDE_IF{HAS_PICKUPS}
    for (uint16_t i=0; i<@IDE{PICKUP_COUNT}; ++i) {
        const game_collectable_t *o=&cg_gwi_pickups[i];
        if (!o->active || !o->sprite || !!o->draw_behind_tiles != !!behind) continue;
        cg_draw_stamp(o->sprite,&cg_pickup_stamps[i],o->x,o->y,camera_x,camera_y);
    }
@IDE_END
}
@IDE_END
@IDE_IF{HAS_INACTIVE_STATE_FRAMES}
static void cg_draw_inactive_state_frames(int32_t camera_x,int32_t camera_y,uint8_t behind)
{
    for(uint16_t i=0;i<@IDE{WORLD_OBJECT_COUNT};++i) {
        const game_world_object_t *o=&cg_gwi_platforms[i];
        if(o->active || !o->sprite || !!o->draw_behind_tiles!=!!behind ||
           cg_inactive_state_frames[i]==UINT16_MAX) continue;
        const int32_t draw_x=o->x-camera_x, draw_y=o->y-camera_y;
        if (draw_x<=-(int32_t)o->sprite->width || draw_y<=-(int32_t)o->sprite->height ||
            draw_x>=480 || draw_y>=320) continue;
        gfxbob_t bob=*o->sprite; /* Never change sprite or physics state. */
        bob.index=(uint8_t)cg_inactive_state_frames[i];
        bob.drawx=(int16_t)draw_x;
        bob.drawy=(int16_t)draw_y;
        gfx_drawbob(&bob);
    }
}
@IDE_END
void gameworlditems_draw_behind(int32_t camera_x, int32_t camera_y)
{
@IDE_IF{HAS_INACTIVE_STATE_FRAMES}
    cg_draw_inactive_state_frames(camera_x,camera_y,1u);
@IDE_END
@IDE_IF{HAS_STAMPS}
    cg_draw_world_layer(camera_x, camera_y, 1);
@IDE_ELSE
@IDE_IF{HAS_WORLDS}
    game_world_objects_draw_layer(cg_gwi_platforms, @IDE{WORLD_OBJECT_COUNT}, camera_x, camera_y, 1);
@IDE_END
@IDE_IF{HAS_PICKUPS}
    game_collectables_draw_layer(cg_gwi_pickups, @IDE{PICKUP_COUNT}, camera_x, camera_y, 1);
@IDE_END
@IDE_END
@IDE{DRAW_BEHIND_BODY}}

void gameworlditems_draw(int32_t camera_x, int32_t camera_y)
{
@IDE_IF{HAS_INACTIVE_STATE_FRAMES}
    cg_draw_inactive_state_frames(camera_x,camera_y,0u);
@IDE_END
@IDE_IF{HAS_STAMPS}
    cg_draw_world_layer(camera_x, camera_y, 0);
@IDE_ELSE
@IDE_IF{HAS_WORLDS}
    game_world_objects_draw_layer(cg_gwi_platforms, @IDE{WORLD_OBJECT_COUNT}, camera_x, camera_y, 0);
@IDE_END
@IDE_IF{HAS_PICKUPS}
    game_collectables_draw_layer(cg_gwi_pickups, @IDE{PICKUP_COUNT}, camera_x, camera_y, 0);
@IDE_END
@IDE_END
@IDE_IF{HAS_AUDIO}
    cg_audio_camera_x = camera_x;
@IDE_END
@IDE{DRAW_BODY}}
@IDE_ELSE
/* GENERATED by CoderGirl. No managed world objects. */
#include "gameworlditems.h"
#include "../gameassets/gameassets.h"
uint8_t gameworlditems_init(void) { return 1; }
void gameworlditems_update(uint16_t frames) { gameassets_fade_update(frames); }
void gameworlditems_draw(int32_t cx, int32_t cy) { (void)cx; (void)cy; }
void gameworlditems_save_state(void) {}
void gameworlditems_restore_state(void) {}
@IDE_END

