{
    playsound@IDE{SOUND_SYMBOL}();
    sound_setvolume(@IDE{SOUND_CHANNEL}, cg_audio_volume(@IDE{SOUND_VOLUME}, x, radius));
    sound_setpanning(@IDE{SOUND_CHANNEL}, cg_audio_pan(@IDE{SOUND_PAN}, x, radius));
}
@IDE_SECTION_END

@IDE_SECTION{OBJECT_DECLARATION}
