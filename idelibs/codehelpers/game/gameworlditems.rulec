@IDE_IF{HAS_STAT_COMPARE}
static uint32_t cg_logic_seen_stat_revision;
static uint32_t cg_logic_seen_health;
static uint8_t cg_logic_stat_compare(const char *name,const char *op,int32_t threshold)
{
    int32_t value=0;
    if(strcmp(name,"@health")==0) {
        const uint32_t health=gameworlds_state()->health;
        value=(int32_t)(health>2147483647u ? 2147483647u : health);
    } else if(!gameplayer_stat_get(name,&value))return 0u;
    if(strcmp(op,"<")==0)return value<threshold;
    if(strcmp(op,"<=")==0)return value<=threshold;
    if(strcmp(op,"==")==0)return value==threshold;
    if(strcmp(op,"!=")==0)return value!=threshold;
    if(strcmp(op,">=")==0)return value>=threshold;
    if(strcmp(op,">")==0)return value>threshold;
    return 0u;
}
@IDE_END
@IDE_IF{HAS_QUEST_CONDITION}
static uint32_t cg_logic_seen_quest_revision;
static uint8_t cg_logic_quest_done(const char *id)
{
    for(uint16_t i=0u;i<gameworlds_quest_count();++i) {
        const char *candidate=gameworlds_quest_id(i);
        if(candidate && strcmp(candidate,id)==0)
            return gameworlds_quest_status(i)==2u;
    }
    return 0u;
}
