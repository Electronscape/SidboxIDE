/* Each dialogue node may offer a quest without consuming a choice action. */
static const char *const quest_node_enable_ids[] = {
    @IDE{QUEST_NODE_ENABLE_IDS}
};
static void on_quest_node(uint16_t node)
{
    if(node>=@IDE{STORY_NODE_COUNT}u)return;
    const char *id=quest_node_enable_ids[node];
    if(id && *id)gameworlds_quest_enable(id);
}
static void on_quest_choice(uint16_t node, uint8_t answer)
{
    const uint32_t index=(uint32_t)node*3u+(uint32_t)answer;
    if (index>=@IDE{STORY_NODE_COUNT}u*3u)return;
    const char *id=quest_choice_ids[index];
    if (id && *id)gameworlds_quest_dialogue_choice(id);
}

