/* This callback can be overridden in user game code if a custom main.c owns
   the live health/score variables rather than reading gameworlds_state().
   Returning 0 means using the item failed and it must not be consumed. */
__attribute__((weak)) uint8_t gameadventure_apply_item_stat(const char *stat, int32_t delta)
{
    gameworlds_player_state_t *state=gameworlds_state();
    if (!stat || !state) return 0;
    uint32_t *built_in=0;
    if (strcmp(stat,"health")==0) built_in=&state->health;
    else if (strcmp(stat,"lives")==0) built_in=&state->lives;
    else if (strcmp(stat,"score")==0) built_in=&state->score;
    if (built_in) {
        int64_t updated=(int64_t)*built_in+(int64_t)delta;
        if (updated<0) updated=0;
        if (updated>UINT32_MAX) updated=UINT32_MAX;
        *built_in=(uint32_t)updated;
        return 1;
    }
@IDE_IF{HAS_SHARED_PLAYER}
    int32_t previous=0;
    if (!gameplayer_stat_get(stat,&previous)) return 0;
    int64_t updated=(int64_t)previous+(int64_t)delta;
    if (updated<INT32_MIN) updated=INT32_MIN;
    if (updated>INT32_MAX) updated=INT32_MAX;
    return gameplayer_stat_set(stat,(int32_t)updated);
@IDE_END
    return 0;
}
static uint8_t on_use_item(const char *stat, int32_t delta, void *user)
{
    (void)user;
    return gameadventure_apply_item_stat(stat,delta);
}

