/* The user may override this weak callback in a file they own. */
__attribute__((weak)) void gameadventure_on_event(uint16_t event_id)
{
    (void)event_id;
}

static void on_event(uint16_t event_id, void *user)
{
    (void)user;
    /* Project-wide quest objectives can follow Adventure numeric callbacks
     * without hand-edited main.c or a second event dispatcher. */
    gameworlds_quest_event_number(event_id);
    switch (event_id) {
@IDE{LINKED_ACTION_CASES}
    default: gameadventure_on_event(event_id); break;
    }
}

/* Static RAM belongs to this world, not to the shared Adventure renderer. */
static uint8_t cg_saved_story_choices[GAME_ADVENTURE_USED_CHOICE_BYTES];
static uint8_t cg_saved_story_npcs[GAME_ADVENTURE_COMPLETED_NPC_BYTES];
static uint8_t cg_saved_npc_visibility[GAME_ADVENTURE_NPC_VISIBILITY_BYTES];
static uint8_t cg_saved_close_gifts[GAME_ADVENTURE_CLOSE_GIFT_BYTES];
static uint8_t cg_saved_story_valid;
/* Remote NPC actions must NOT initialise unrelated story progress on a first visit.
 * Pending overrides are resolved against the saved state, or NPC defaults. */
static uint8_t cg_pending_npc_mask[GAME_ADVENTURE_NPC_VISIBILITY_BYTES];
static uint8_t cg_pending_npc_state[GAME_ADVENTURE_NPC_VISIBILITY_BYTES];
void gameadventure_npc_action(uint16_t npc, uint8_t action)
{
    if (npc < GAME_ADVENTURE_STORY_NPC_COUNT && action <= 2u)
        game_adventure_npc_action(npc, action);
}
void gameadventure_npc_remote_action(uint16_t npc, uint8_t action)
{
    if (npc >= GAME_ADVENTURE_STORY_NPC_COUNT || action > 2u) return;
    uint8_t value = cg_pending_npc_mask[npc] ? cg_pending_npc_state[npc]
        : (cg_saved_story_valid ? cg_saved_npc_visibility[npc] : npc_initial_visibility[npc]);
    if (action == 0u) value = 0u;
    else if (action == 1u) value = 1u;
    else value ^= 1u;
    cg_pending_npc_mask[npc] = 1u;
    cg_pending_npc_state[npc] = value;
}
void gameadventure_npc_remote_reset(void)
{
    memset(cg_pending_npc_mask, 0, sizeof(cg_pending_npc_mask));
    memset(cg_pending_npc_state, 0, sizeof(cg_pending_npc_state));
    /* gameworlds_shutdown() ends this session; a later Start must use
       the world's defaults, not the preceding playthrough's story. */
    cg_saved_story_valid = 0u;
}
static game_adventure_drop_t cg_saved_world_drops[GAME_ADVENTURE_MAX_DROPS];
static uint8_t cg_saved_exchanges[GAME_ADVENTURE_EXCHANGE_SLOTS];
static uint8_t cg_saved_wrong_repeats[GAME_ADVENTURE_EXCHANGE_SLOTS];

/* Static per-world Adventure progress, excluding pointers and live renderer. */
void gameadventure_disk_export(void (*emit)(const void *, uint32_t, void *), void *ctx)
{
    if (!emit) return;
#define CG_STORY_SAVE(v) emit(&(v), (uint32_t)sizeof(v), ctx)
    CG_STORY_SAVE(cg_saved_story_valid);
    CG_STORY_SAVE(cg_saved_story_choices);
    CG_STORY_SAVE(cg_saved_story_npcs);
    CG_STORY_SAVE(cg_saved_npc_visibility);
    CG_STORY_SAVE(cg_saved_close_gifts);
    CG_STORY_SAVE(cg_saved_world_drops);
    CG_STORY_SAVE(cg_saved_exchanges);
    CG_STORY_SAVE(cg_saved_wrong_repeats);
    CG_STORY_SAVE(cg_pending_npc_mask);
    CG_STORY_SAVE(cg_pending_npc_state);
#undef CG_STORY_SAVE
}
uint8_t gameadventure_disk_import(uint8_t (*take)(void *, uint32_t, void *), void *ctx)
{
    if (!take) return 0;
#define CG_STORY_LOAD(v) if (!take(&(v), (uint32_t)sizeof(v), ctx)) return 0
    CG_STORY_LOAD(cg_saved_story_valid);
    CG_STORY_LOAD(cg_saved_story_choices);
    CG_STORY_LOAD(cg_saved_story_npcs);
    CG_STORY_LOAD(cg_saved_npc_visibility);
    CG_STORY_LOAD(cg_saved_close_gifts);
    CG_STORY_LOAD(cg_saved_world_drops);
    CG_STORY_LOAD(cg_saved_exchanges);
    CG_STORY_LOAD(cg_saved_wrong_repeats);
    CG_STORY_LOAD(cg_pending_npc_mask);
    CG_STORY_LOAD(cg_pending_npc_state);
#undef CG_STORY_LOAD
    return 1;
}

void gameadventure_save_progress(void)
{
    game_adventure_save_progress(cg_saved_story_choices, cg_saved_story_npcs);
    game_adventure_save_npc_visibility(cg_saved_npc_visibility);
    game_adventure_save_close_gifts(cg_saved_close_gifts);
    game_adventure_save_drops(cg_saved_world_drops);
    game_adventure_save_exchanges(cg_saved_exchanges);
    game_adventure_save_wrong_repeats(cg_saved_wrong_repeats);
    cg_saved_story_valid = 1;
}
void gameadventure_restore_progress(void)
{
    if (cg_saved_story_valid) {
        game_adventure_restore_progress(cg_saved_story_choices, cg_saved_story_npcs);
        game_adventure_restore_npc_visibility(cg_saved_npc_visibility);
        game_adventure_restore_close_gifts(cg_saved_close_gifts);
        game_adventure_restore_drops(cg_saved_world_drops);
        game_adventure_restore_exchanges(cg_saved_exchanges);
        game_adventure_restore_wrong_repeats(cg_saved_wrong_repeats);
    }
    for (uint16_t npc=0; npc<GAME_ADVENTURE_STORY_NPC_COUNT; ++npc) {
        if (!cg_pending_npc_mask[npc]) continue;
        game_adventure_set_npc_visible(npc, cg_pending_npc_state[npc]);
        cg_pending_npc_mask[npc] = 0u;
    }
}

void gameadventure_setup(void)
{
    const uint8_t *skin = 0;
    uint16_t width = 0, height = 0;
@IDE_IF{HAS_SKIN}
    skin = gameassets_find_ppb(@IDE{SKIN_PATH}, &width, &height);
@IDE_END
    game_adventure_start(items, GAME_ADVENTURE_STORY_ITEM_COUNT,
        nodes, GAME_ADVENTURE_STORY_NODE_COUNT,
        npcs, GAME_ADVENTURE_STORY_NPC_COUNT,
        skin, width, height, @IDE{SKIN_TILE_SIZE}u, skin_cells,
        @IDE{FRAMES_PER_CHAR}u, on_event, 0);
    game_adventure_set_choice_signal(on_quest_choice);
    game_adventure_set_node_signal(on_quest_node);
    game_adventure_save_slot_callbacks(gameworlds_checkpoint_request,
                                        gameworlds_slot_exists);
    game_adventure_defeat_setup(&gameworlds_state()->health,
        gameworlds_reload_request,gameworlds_slot_exists,gameworlds_last_saved_slot,
        @IDE{DEFEAT_ENABLED}u,@IDE{DEFEAT_TITLE},@IDE{DEFEAT_SUBTITLE},
        @IDE{DEFEAT_BG}u,@IDE{DEFEAT_BORDER}u,@IDE{DEFEAT_TEXT}u,
        @IDE{DEFEAT_ACCENT}u,@IDE{DEFEAT_X}u,@IDE{DEFEAT_Y}u);
    game_adventure_defeat_note_source(gameworlds_fatal_hit_note);
    gameworlds_fresh_start_enable(@IDE{DEFEAT_ENABLED}u);
    game_adventure_defeat_session(gameworlds_session_can_reload,
                                  gameworlds_title_request,gameworlds_ui_fade);
    {
        static const uint16_t defeat_cells[9]={@IDE{DEFEAT_CELLS}};
        static const uint8_t defeat_flips[9]={@IDE{DEFEAT_FLIPS}};
        uint16_t defeat_aw=0u,defeat_ah=0u;
        const uint8_t *defeat_pixels=gameassets_find_ppb(@IDE{DEFEAT_ATLAS},&defeat_aw,&defeat_ah);
        game_adventure_defeat_style(@IDE{DEFEAT_SCALE_X}u,@IDE{DEFEAT_SCALE_Y}u,
            @IDE{DEFEAT_OUTLINE}u,@IDE{DEFEAT_OUTLINE_COLOUR}u,
            defeat_pixels,@IDE{DEFEAT_ATLAS},@IDE{DEFEAT_ATLAS_W}u,@IDE{DEFEAT_ATLAS_H}u,
            @IDE{DEFEAT_TILE}u,defeat_cells,defeat_flips);
    }
    {
        static const game_adventure_map_point_t map_points[]={@IDE{WORLD_MAP_POINTS}};
        static const uint16_t map_tiles[]={@IDE{WORLD_MAP_TILES}};
        static const game_adventure_map_animation_t map_animations[]={@IDE{WORLD_MAP_ANIMATIONS}};
        uint16_t map_aw=0u,map_ah=0u;
        const uint8_t *map_pixels=gameassets_find_ppb(@IDE{WORLD_MAP_ATLAS},&map_aw,&map_ah);
        game_adventure_world_map_boundary(@IDE{WORLD_MAP_BORDER_COLOUR}u);
        game_adventure_world_map_flag_flash(@IDE{WORLD_MAP_FLAG_FLASH_COLOUR}u);
        game_adventure_world_map_animations(map_animations,@IDE{WORLD_MAP_ANIM_COUNT}u);
        game_adventure_world_map(map_points,@IDE{WORLD_MAP_COUNT}u,
           @IDE{WORLD_MAP_WIDTH}u,@IDE{WORLD_MAP_HEIGHT}u,gameworlds_active);
        game_adventure_world_map_tiles(map_tiles,@IDE{WORLD_MAP_COLS}u,@IDE{WORLD_MAP_ROWS}u,
             map_pixels,@IDE{WORLD_MAP_ATLAS},@IDE{WORLD_MAP_ATLAS_W}u,
             @IDE{WORLD_MAP_ATLAS_H}u,@IDE{WORLD_MAP_TILE_SIZE}u);
    }
    /* Keep the runtime journal pointed at the project-wide quest manager.
     * Registration follows game_adventure_start() because a world load resets
     * the previous world's renderer state. */
    static const game_adventure_quest_ui_t quest_journal = {
        gameworlds_quest_count, gameworlds_quest_id,
        gameworlds_quest_title, gameworlds_quest_description,
        gameworlds_quest_objective, gameworlds_quest_status,
        gameworlds_quest_tracked, gameworlds_quest_track,
        gameworlds_quest_visible
    };
    game_adventure_quest_notices(gameworlds_quest_notice);
    game_adventure_set_quest_journal(&quest_journal);
    static const game_adventure_quest_style_t quest_style={
        @IDE{QUEST_MARGIN}u,@IDE{QUEST_SPLIT}u,@IDE{QUEST_BG}u,
        @IDE{QUEST_BORDER}u,@IDE{QUEST_TEXT}u,@IDE{QUEST_HIGHLIGHT}u,
        @IDE{QUEST_LIST_LEFT}u,@IDE{QUEST_TITLE_X}u,@IDE{QUEST_TITLE_Y}u,
        @IDE{QUEST_TITLE_FONT_X}u,@IDE{QUEST_TITLE_FONT_Y}u,
        @IDE{QUEST_OUTLINE_ENABLED}u,@IDE{QUEST_OUTLINE_COLOUR}u
    };
    game_adventure_quest_style(&quest_style);
    {
        static const uint16_t quest_icons[5]={@IDE{QUEST_ICON_CELLS}};
        static const uint8_t quest_icon_flips[5]={@IDE{QUEST_ICON_FLIPS}};
        static const uint8_t quest_icon_modes[5]={@IDE{QUEST_ICON_MODES}};
        static const uint16_t quest_icon_parts[5][4]={@IDE{QUEST_ICON_PARTS}};
        game_adventure_quest_icons(quest_icons,quest_icon_flips);
        game_adventure_quest_icon_composites(quest_icon_modes,quest_icon_parts);
    }
@IDE_IF{HAS_QUEST_ATLAS}
    {
        static const uint16_t quest_cells[9]={@IDE{QUEST_CELLS}};
        static const uint8_t quest_flips[9]={@IDE{QUEST_FLIPS}};
        uint16_t quest_w=0u,quest_h=0u;
        const uint8_t *quest_pixels=gameassets_find_ppb(@IDE{QUEST_ATLAS_PATH},&quest_w,&quest_h);
        game_adventure_quest_skin_file(quest_pixels,@IDE{QUEST_ATLAS_PATH},quest_w,quest_h,
            @IDE{QUEST_ATLAS_WIDTH}u,@IDE{QUEST_ATLAS_HEIGHT}u,@IDE{QUEST_ATLAS_TILE}u,
            quest_cells,quest_flips);
    }
@IDE_ELSE
    game_adventure_quest_skin_file(0,0,0u,0u,0u,0u,0u,0,0);
@IDE_END
@IDE_IF{HAS_PROJECT_HUD}
    {
        const uint16_t dock=gamehud_dock_height();
        /* gamehud_apply_dock() already shifts the top-docked framebuffer.
         * A second top offset in the journal displaced it by twice the dock. */
        game_adventure_quest_viewport(0u,
                                      dock<320u?(uint16_t)(320u-dock):320u);
    }
@IDE_ELSE
    game_adventure_quest_viewport(0u,320u);
@IDE_END
    game_adventure_set_modal_fullbright(gameworlds_ui_full_brightness);

@IDE_IF{HAS_SHARED_PLAYER}
    game_adventure_set_drop_anchor(gameadventure_live_sprite_origin,
        @IDE{DROP_FOOT_X}, @IDE{DROP_FOOT_Y},
        @IDE{DROP_HITBOX_W}u, @IDE{DROP_HITBOX_H}u);
    game_adventure_set_pickup_rect(gameadventure_live_pickup_rect);
@IDE_END
@IDE_IF{HAS_DROP_TILEMAP}
    game_adventure_set_drop_floor(gameadventure_drop_floor);
    game_adventure_set_drop_sweep(gameadventure_drop_sweep);
@IDE_END
@IDE{ITEM_ICON_SETUP}
@IDE_IF{HAS_WORLD_OBJECTS}
    /* Let nearby FIRE2 doors/switches handle the button before inventory. */
    game_adventure_set_fire2_action(gameworlditems_fire2_action);
    game_adventure_set_interaction(gameworlditems_interaction_probe,
                                   gameworlditems_interaction_use);
    game_adventure_set_interaction_sound(gameworlditems_interaction_sound);
    game_adventure_set_drop_contact(gameworlditems_drop_contact);
@IDE_END
    /* Restore this world's appearance every time the world manager loads it.
     * The shared Adventure renderer must never inherit forest's settings
     * from world1 (or vice versa). Applied AFTER game_adventure_start(),
     * because that call resets common renderer state.
     * This includes the inventory window, not just NPC conversations. */
    game_adventure_text_style(@IDE{TEXT_COLOUR_INDEX}u,
        @IDE{TEXT_OUTLINE_ENABLED}u, @IDE{OUTLINE_COLOUR_INDEX}u);
    game_adventure_thought_text_colour(@IDE{THOUGHT_TEXT_COLOUR_INDEX}u);
    game_adventure_dialogue_box(@IDE{DIALOG_X}, @IDE{DIALOG_Y},
        @IDE{DIALOG_WIDTH}u, @IDE{DIALOG_HEIGHT}u);
    game_adventure_item_styles(item_styles, GAME_ADVENTURE_STORY_ITEM_COUNT);
    game_adventure_inventory_max_slots(@IDE{MAX_INVENTORY_SLOTS}u);
    game_adventure_use_effects(item_uses, GAME_ADVENTURE_STORY_ITEM_COUNT, on_use_item, 0);
    game_adventure_text_padding(@IDE{DIALOG_PADDING}u);
    game_adventure_dialogue_typography(@IDE{DIALOG_FONT_SCALE_X}u,
        @IDE{DIALOG_FONT_SCALE_Y}u,@IDE{THOUGHT_FONT_SCALE_X}u,
        @IDE{THOUGHT_FONT_SCALE_Y}u,@IDE{THOUGHT_ABOVE}u);
    game_adventure_npc_initial_visibility(npc_initial_visibility, GAME_ADVENTURE_STORY_NPC_COUNT);
    game_adventure_story_flags(story_choice_flags, npc_completed_nodes);
    game_adventure_npc_choice_actions(npc_choice_actions, @IDE{NPC_CHOICE_ACTION_COUNT}u);
    game_adventure_remote_npc_actions(remote_npc_actions,
        @IDE{REMOTE_NPC_ACTION_COUNT}u, gameworlds_npc_action);
    game_adventure_spotlight_actions(spotlight_actions, @IDE{SPOTLIGHT_ACTION_COUNT}u,
                                      gameworlds_spotlight_action);
    game_adventure_close_gifts(close_gifts, @IDE{CLOSE_GIFT_COUNT}u);
    game_adventure_exchange_rules(exchanges, GAME_ADVENTURE_STORY_NODE_COUNT*3u);
    game_adventure_wrong_repeat_rules(wrong_repeat_rules, @IDE{WRONG_REPEAT_COUNT}u);
    game_adventure_skin_flips(skin_flips);
    game_adventure_thought_choices(thought_choice_flags,
        (uint16_t)(sizeof(thought_choice_flags)/sizeof(thought_choice_flags[0])));
    game_adventure_thought_box(@IDE{THOUGHT_X}, @IDE{THOUGHT_Y},
        @IDE{THOUGHT_WIDTH}u, @IDE{THOUGHT_HEIGHT}u,
        thought_skin_cells, thought_skin_flips);
    game_adventure_npc_animations(npc_animations, GAME_ADVENTURE_STORY_NPC_COUNT);
    /* Starting items may be owned before any cross-world inventory restore. */
    game_adventure_prepare_owned_icons();
    (void)npc_animation_frames; /* Valid even when no NPC animations exist. */
}

/* Exported inventories use stable item names; world-local list positions
 * may differ. Zero counts are meaningful (consumed inventory remains empty). */
void gameadventure_store_inventory(gameworlds_inventory_put_t sink, void *user)
{
    if (!sink) return;
    const uint16_t count = GAME_ADVENTURE_STORY_ITEM_COUNT;
    for (uint16_t i = 0; i < count; ++i)
        if (items[i].name && *items[i].name)
            sink(items[i].name, game_adventure_quantity(i), user);
}
void gameadventure_load_inventory(gameworlds_inventory_get_t lookup, void *user)
{
    if (!lookup) return;
    const uint16_t count = GAME_ADVENTURE_STORY_ITEM_COUNT;
    game_adventure_inventory_restore_begin();
    for (uint16_t i = 0; i < count; ++i) {
        if (!items[i].name || !*items[i].name) continue;
        const uint32_t incoming = lookup(items[i].name, user);
        if (incoming == UINT32_MAX) continue;
        const uint16_t target = (uint16_t)incoming;
        const uint16_t current = game_adventure_quantity(i);
        if (target > current) game_adventure_add(i, (uint16_t)(target - current));
        else if (current > target) game_adventure_remove(i, (uint16_t)(current - target));
    }
    game_adventure_inventory_restore_end();
    /* Load only art actually carried into this world, not every world PPB. */
    game_adventure_prepare_owned_icons();
}

@IDE_SECTION{LINKED_ACTION}
    case @IDE{EVENT_ID}: gameworlditems_set_active(@IDE{WORLD_SLOT}u, @IDE{ACTION_MODE}u); break;
@IDE_SECTION_END
