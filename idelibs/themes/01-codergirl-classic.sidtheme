# CoderGirl IDE colour theme
# Edit the hex colours, save and click Options > Refresh Presets.
# For transparency use #AARRGGBB.

[theme]
name=CoderGirl Classic
version=1

[colours]
windowBackground="#101010"
panelBackground="#101010"
inputBackground="#050505"
alternateBackground="#0B0B0B"
menuBackground="#080808"
text="#D8D8D8"
brightText="#FFFFFF"
mutedText="#AAAAAA"
accent="#2858A8"
hover="#202020"
border="#303030"
treeBorder="#102048"
scrollHandle="#303030"
scrollHandleHover="#505050"
tooltipBackground="#07090D"
tooltipText="#F2F2F2"
editorBackground="#001020"
editorText="#D8E8D0"
currentLine="#00172D"
gutterBackground="#002030"
lineNumber="#00FF40"
indentGuide="#103838"
selectionBackground="#2858A8"
selectionText="#FFFFFF"
syntaxKeyword="#FFC800"
syntaxSTM32="#48B0B0"
syntaxAPI="#FF00FF"
syntaxType="#50FF50"
syntaxPreprocessor="#00FFFF"
syntaxString="#CE9178"
syntaxNumber="#00CE00"
syntaxFunction="#C884C0"
syntaxComment="#6A9955"
syntaxMultiComment="#82967D"
diagnosticError="#FF4646"
diagnosticWarning="#FFCD37"
diagnosticPopupBackground="#08090D"
diagnosticPopupText="#F2F2F2"
diagnosticColumn="#9FB7D7"
minimapBackground="#030303"
minimapText="#697887"
minimapComment="#5A874E"
minimapPreprocessor="#00BED2"
minimapType="#DCAF2D"
minimapString="#BE7D69"
minimapFunction="#AF73AA"
minimapViewportFill="#2D2858A8"
minimapViewportBorder="#B45082DC"
minimapDivider="#232323"
outputBackground="#000000"
outputNormal="#DCEBD2"
outputHeader="#78DCFF"
outputPath="#AACDFF"
outputSuccess="#50FF78"
outputError="#FF5A5A"
outputWarning="#FFD25A"
outputMuted="#96A596"
quickTipBackground="#020402"
quickTipText="#66FF8A"
quickTipBorder="#15351A"
