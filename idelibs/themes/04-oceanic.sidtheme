# CoderGirl IDE colour theme
# Edit the hex colours, save and click Options > Refresh Presets.
# For transparency use #AARRGGBB.

[theme]
name=Oceanic
version=1

[colours]
windowBackground="#101D27"
panelBackground="#152631"
inputBackground="#091721"
alternateBackground="#1A3039"
menuBackground="#10202B"
text="#C9E3E7"
brightText="#F1FFFF"
mutedText="#8FACB5"
accent="#31C6CB"
hover="#24424C"
border="#2D5560"
treeBorder="#276775"
scrollHandle="#37616B"
scrollHandleHover="#4A8796"
tooltipBackground="#0E2935"
tooltipText="#E3FFFF"
editorBackground="#061C28"
editorText="#E1F2F3"
currentLine="#143240"
gutterBackground="#102934"
lineNumber="#6BD6D6"
indentGuide="#2A4C57"
selectionBackground="#287C89"
selectionText="#FFFFFF"
syntaxKeyword="#F5D18C"
syntaxSTM32="#6EE2BE"
syntaxAPI="#80D6FF"
syntaxType="#AAE1B8"
syntaxPreprocessor="#56CFE4"
