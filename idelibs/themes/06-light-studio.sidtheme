accent="#3A5FAF"
hover="#D4DDEE"
border="#AEBBCD"
treeBorder="#AAB6CC"
scrollHandle="#B1BFCE"
scrollHandleHover="#8599B3"
tooltipBackground="#FFFFFF"
tooltipText="#1C293E"
editorBackground="#FFFFFF"
editorText="#1E2B42"
currentLine="#EAF0FC"
gutterBackground="#F1F4FA"
lineNumber="#596AA0"
indentGuide="#C9D4E5"
