# CoderGirl IDE colour theme
# Edit the hex colours, save and click Options > Refresh Presets.
# For transparency use #AARRGGBB.

[theme]
name=Amber CRT
version=1

[colours]
windowBackground="#1C1914"
panelBackground="#242016"
inputBackground="#120F0A"
alternateBackground="#2A2319"
menuBackground="#211A11"
text="#E2D4B5"
brightText="#FFE9BA"
mutedText="#AC986E"
accent="#E9A13A"
hover="#403020"
border="#594329"
treeBorder="#68502D"
scrollHandle="#634C2E"
scrollHandleHover="#97723D"
tooltipBackground="#22180E"
tooltipText="#FFE2A0"
editorBackground="#161006"
editorText="#F6DDA2"
currentLine="#2D2010"
gutterBackground="#21170B"
lineNumber="#EDA84B"
indentGuide="#544025"
selectionBackground="#865927"
selectionText="#FFFFFF"
syntaxKeyword="#FFD46A"
syntaxSTM32="#CDBE79"
syntaxAPI="#FFB24A"
syntaxType="#E9C68E"
syntaxPreprocessor="#ECA843"
syntaxString="#F2A966"
