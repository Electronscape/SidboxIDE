mutedText="#B2A3C6"
accent="#DB4FC8"
hover="#382249"
border="#50345D"
treeBorder="#793A8D"
scrollHandle="#503360"
scrollHandleHover="#9253A5"
tooltipBackground="#23142E"
tooltipText="#FFE7FB"
editorBackground="#100F24"
editorText="#F1E8FA"
currentLine="#261636"
gutterBackground="#19152B"
lineNumber="#CB76ED"
indentGuide="#382754"
