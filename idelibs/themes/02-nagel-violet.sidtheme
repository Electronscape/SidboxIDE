# CoderGirl IDE colour theme
# Edit the hex colours, save and click Options > Refresh Presets.
# For transparency use #AARRGGBB.

[theme]
name=Nagel Violet
version=1

[colours]
windowBackground="#151023"
panelBackground="#190F28"
inputBackground="#0C0A19"
alternateBackground="#21142E"
menuBackground="#190F28"
text="#D8CDE9"
